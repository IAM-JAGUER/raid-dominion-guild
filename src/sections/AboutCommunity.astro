---
// ImageComponent no se está utilizando
---

<section id="about_community" class="mt-4 w-full">
  <div class="max-w-7xl mx-auto">

<!-- Community Section -->
<div class="w-full max-w-7xl mx-auto py-12">
  <!-- Welcome Card -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <!-- Welcome Message -->
    <div class="lg:col-span-2 p-6 rounded-xl border border-amber-600/30 bg-gray-900/50 backdrop-blur-sm transform transition-all duration-300 hover:scale-[1.01] hover:shadow-amber-500/20">
      <div class="flex flex-col h-full justify-center">
        <h2 class="text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-4">
          ¡Bienvenidos a Colmillo de Acero!
        </h2>
        <p class="text-gray-300 mb-6">
          Una comunidad apasionada de World of Warcraft dedicada al progreso en raid y al juego en equipo. 
          Únete a nosotros en nuestras aventuras épicas y forma parte de nuestra familia de jugadores.
        </p>
        <div id="player-count" class="mt-auto">
          <span class="font-bold text-amber-300">¡Ya somos <span id="member-count" class="text-4xl text-yellow-400">0</span> miembros!</span>
          <p class="text-sm text-amber-100/70 mt-2">Actualizado diariamente</p>
        </div>
      </div>
    </div>

    <!-- Discord CTA -->
    <div class="p-6 rounded-xl border border-amber-600/30 bg-amber-900/20 backdrop-blur-sm transform transition-all duration-300 hover:scale-[1.01] hover:shadow-amber-500/20 flex flex-col">
      <div class="mb-6">
        <h3 class="text-2xl font-bold text-amber-300 mb-2">¡Únete a nuestro Discord!</h3>
        <p class="text-gray-300">Conéctate con la comunidad, organiza raids y mantente al día con todos los eventos.</p>
      </div>
      <a 
        href="https://discord.gg/BwdpNV9sky"
        target="_blank"
        rel="noopener noreferrer" 
        class="mt-auto inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-amber-600 to-amber-700 text-white font-medium rounded-lg hover:from-amber-500 hover:to-amber-600 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-amber-500/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.872-1.295 1.226-1.994a.076.076 0 00-.041-.1 13.107 13.107 0 01-1.872-1.077.078.078 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.192.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873 1.08.077.077 0 00-.04.1c.36.698.77 1.362 1.225 1.993a.076.076 0 00.084.028 19.84 19.84 0 006.002-3.03.077.077 0 00.032-.054c.5-5.053-.838-9.588-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.95-2.419 2.157-2.419 1.21 0 2.175 1.1 2.157 2.42 0 1.333-.95 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.949-2.419 2.157-2.419 1.21 0 2.175 1.1 2.157 2.42 0 1.333-.95 2.418-2.157 2.418z"/>
        </svg>
        Unirse al Discord
      </a>
    </div>
  </div>

  <!-- Guild Rules -->
  <div class="">
    <!-- Guild Rules -->
    <div class="p-6 rounded-xl border border-amber-600/30 bg-gray-900/50 backdrop-blur-sm transform transition-all duration-300 hover:scale-[1.01] hover:shadow-amber-500/20">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-amber-300 mb-2">Normas de la Hermandad</h2>
        <div class="h-1 w-20 bg-gradient-to-r from-amber-500 to-yellow-600 mx-auto my-3 rounded-full"></div>
      </div>
      

    <!-- Guild Rules Section - Compacta -->
    <div class="w-full max-w-4xl mx-auto mb-8">
      <div>        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Norma 1 -->
          <div class="flex items-start space-x-4 p-4 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-sm font-bold">1</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300 text-base">Notas Públicas</h4>
              <p class="text-gray-300">Mantén actualizada tu nota con tu rol principal (DPS/Heal/Tank) GS y profesiones.</p>
            </div>
          </div>
          
          <!-- Norma 2 -->
          <div class="flex items-start space-x-4 p-4 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-sm font-bold">2</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300 text-base">Discord en Raids</h4>
              <p class="text-gray-300">Obligatorio para raids. Micrófono funcional y silencio cuando no debas hablar.</p>
            </div>
          </div>
          
          <!-- Norma 3 -->
          <div class="flex items-start space-x-4 p-4 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-sm font-bold">3</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300 text-base">Puntualidad</h4>
              <p class="text-gray-300">Asistencia puntual a eventos. Avisar con anticipación si no puedes asistir.</p>
            </div>
          </div>
          
          <!-- Norma 4 -->
          <div class="flex items-start space-x-4 p-4 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-sm font-bold">4</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300 text-base">Preparación</h4>
              <p class="text-gray-300">Consumibles, reparaciones y conocimiento de mecánicas listos.</p>
            </div>
          </div>
          
          <!-- Norma 5 -->
          <div class="flex items-start space-x-4 p-4 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-sm font-bold">5</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300 text-base">Trabajo en Equipo</h4>
              <p class="text-gray-300">Respeto y colaboración con todos los miembros de la hermandad.</p>
            </div>
          </div>
          
          <!-- Norma 6 -->
          <div class="flex items-start space-x-4 p-4 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-sm font-bold">6</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300 text-base">Conducta</h4>
              <p class="text-gray-300">No se tolera acoso, lenguaje ofensivo o comportamiento tóxico.</p>
            </div>
          </div>
        </div>
        
        <!-- Sección de Reconocimiento Oficial -->
        <div class="mt-6 p-4 bg-amber-900/30 border border-amber-700/50 rounded-lg">
          <div class="flex items-center space-x-3 mb-2">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              </div>
            </div>
            <h3 class="font-semibold text-amber-300">Reconocimiento Oficial</h3>
          </div>
          <p class="text-gray-200 text-xs ml-11">
            Los oficiales pueden otorgar reconocimientos especiales a los miembros destacados. 
            Busca el ícono de medalla <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 inline text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg> junto al nombre de un jugador para ver su reconocimiento oficial.
          </p>
        </div>
        
        <p class="text-xs text-amber-400/70 text-center mt-4">
          Los nombres de los miembros se actualizan diariamente para mantener la información al día.
        </p>
      </div>
    </div>
  </div>
</div>
  <div class="relative w-full text-center py-6">
    <!-- Members Table Title -->
    <div class="w-full max-w-4xl mx-auto mt-12 mb-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-2">
        Miembros de Colmillo de Acero
      </h2>
      <div class="h-1 w-24 bg-gradient-to-r from-amber-500 to-yellow-600 mx-auto my-3 rounded-full"></div>
      <p class="text-gray-300 max-w-2xl mx-auto">
        Filtra por nombre, clase, rango o reconocimiento para encontrar a tus compañeros de la hermandad.
      </p>
    </div>
    <div class="flex flex-wrap mt-6 space-y-4">
      <div class="flex flex-row w-full max-w-2xl mx-auto">
        <input
          list="player-list"
          id="player-select"
          class="flex-grow px-4 py-2 bg-gray-800/80 border border-amber-600/30 text-white rounded-l-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent placeholder-gray-400"
          placeholder="Buscar jugador por nombre"
        />
        <datalist id="player-list"></datalist>
        <button
          type="reset"
          class="px-4 bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-r-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-gray-900"
        >
          X
        </button>
      </div>

      <div class="flex w-full flex-col sm:flex-row justify-between space-y-4 sm:space-y-0 sm:space-x-4 max-w-2xl mx-auto">
        <div class="w-full sm:w-1/3">
          <label class="block text-amber-300 text-sm font-medium mb-1">Rango o Reconocimiento:</label>
          <select id="rank-filter" class="w-full px-4 py-2 bg-gray-800/80 border border-amber-600/30 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent">
            <option value="">Todos los rangos</option>
            <option value="RECONOCIMIENTO">Reconocimiento Oficial</option>
          </select>
        </div>
        <div class="w-full sm:w-1/2">
          <label class="block text-amber-300 text-sm font-medium mb-1">Clase:</label>
          <select
            id="class-filter"
            class="w-full px-4 py-2 bg-gray-800/80 border border-amber-600/30 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent"
          >
            <option value="">Todas las clases</option>
          </select>
        </div>
      </div>
    </div>

    

    <div id="player-info" class="w-full max-w-6xl mx-auto text-white mt-6">
      <div class="w-full overflow-hidden rounded-xl bg-gray-900/70 backdrop-blur-sm border border-amber-600/30 shadow-lg hover:shadow-amber-500/20 transition-all duration-300">
        <style>
          /* Contenedor con scroll horizontal */
          .table-container {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
          }
          /* Estilos para la barra de desplazamiento */
          .table-container::-webkit-scrollbar {
            height: 8px;
          }
          .table-container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
          }
          .table-container::-webkit-scrollbar-thumb {
            background: rgba(217, 119, 6, 0.5);
            border-radius: 4px;
          }
          .table-container::-webkit-scrollbar-thumb:hover {
            background: rgba(217, 119, 6, 0.7);
          }
          /* Asegurar que la tabla sea lo suficientemente ancha */
          #player-table {
            min-width: 100%;
            table-layout: auto;
            width: max-content;
          }
          #player-table th, #player-table td {
            padding: 0.5rem 0.75rem;
            white-space: nowrap;
          }
        </style>
        <div class="table-container">
          <table id="player-table">
          <thead class="bg-gradient-to-r from-amber-900/50 to-amber-800/30">
            <tr class="text-sm font-medium">
              <th data-column="class" class="text-center text-xs font-semibold text-amber-300/90 uppercase tracking-wider cursor-pointer hover:text-amber-200 transition-colors">
                <div class="flex items-center justify-center">
                  <span class="py-2">Clase</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
              <th data-column="name" class="text-center text-xs font-semibold text-amber-300/90 uppercase tracking-wider cursor-pointer hover:text-amber-200 transition-colors">
                <div class="flex items-center justify-center">
                  <span>Nombre</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
              <th data-column="publicNote" class="text-center text-xs font-semibold text-amber-300/90 uppercase tracking-wider cursor-pointer hover:text-amber-200 transition-colors">
                <div class="flex items-center justify-center">
                  <span>Spec & Profesión</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
              <th data-column="rank" class="text-center text-xs font-semibold text-amber-300/90 uppercase tracking-wider cursor-pointer hover:text-amber-200 transition-colors">
                <div class="flex items-center justify-center">
                  <span>Rango</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  </svg>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-amber-600/10">
            <!-- Las filas se agregarán aquí dinámicamente -->
          </tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="pagination" class="flex justify-center mt-6 space-x-1.5 px-2">
      <!-- Los controles de paginación se insertarán aquí -->
    </div>

    <div id="indicators" class="bg-gray-900/70 border border-amber-600/30 rounded-xl p-4 sm:p-6 mt-6 w-full max-w-6xl mx-auto backdrop-blur-sm">
      <h2 class="text-xl font-bold text-amber-300 mb-6 text-center uppercase tracking-wider">Distribución de la Hermandad</h2>
      
      <!-- Distribución por Clases -->
      <div class="mb-8">
        <h3 class="text-sm font-semibold text-amber-300 mb-4 uppercase tracking-wider">Clases</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 sm:gap-3 md:gap-4" id="class-distribution">
          <!-- Se llenará dinámicamente -->
        </div>
      </div>
      
      <!-- Distribución por Rangos -->
      <div class="mb-8 pt-6 border-t border-amber-600/20">
        <h3 class="text-sm font-semibold text-amber-300 mb-4 uppercase tracking-wider">Rangos</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 sm:gap-3 md:gap-4" id="rank-distribution">
          <!-- Se llenará dinámicamente -->
        </div>
      </div>
      
      <!-- Reconocimientos de la Hermandad -->
      <div class="pt-6 border-t border-amber-600/20">
        <h3 class="text-sm font-semibold text-amber-300 mb-4 uppercase tracking-wider">Reconocimientos</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4" id="achievements">
          <!-- Se llenará dinámicamente con los reconocimientos -->
        </div>
      </div>
    </div>
  </div>

  <!-- Sección de Hitos Destacados -->
  <div class="w-full max-w-6xl mx-auto mt-16 mb-12">
    <h2 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-6 text-center">
      Hitos de la Hermandad
    </h2>
    <p class="text-gray-300 text-center max-w-3xl mx-auto mb-8">
      Reconocimientos otorgados a los miembros que han demostrado un compromiso excepcional con la Hermandad.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6" id="milestonesContainer">
      <!-- Los hitos se cargarán dinámicamente con JavaScript -->
    </div>
  </div>
</section>

<!-- Officer Note Modal -->
<!-- Modal de Reconocimiento Oficial -->
<div id="officerNoteModal" class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-[100] p-4">
  <div class="bg-gradient-to-br from-amber-900 via-amber-800 to-amber-900 rounded-xl border-2 border-amber-500 p-6 max-w-md w-full mx-4 relative overflow-hidden">
    <!-- Botón de cierre extra grande y fácil de hacer clic -->
    <button 
      id="closeModalButton" 
      aria-label="Cerrar modal"
      title="Cerrar"
      class="absolute -top-3 -right-3 w-16 h-16 bg-amber-600/80 hover:bg-amber-500 text-white rounded-full flex items-center justify-center shadow-lg z-50 transition-all duration-200 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <!-- Decoración de esquina -->
    <div class="absolute -top-6 -right-6 w-24 h-24 bg-amber-500/10 rounded-full"></div>
    <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-amber-500/5 rounded-full"></div>
    
    <div class="relative z-10 text-center">
      <!-- Icono de reconocimiento -->
      <div class="w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      
      <!-- Título con efecto de brillo -->
      <h3 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-yellow-400 mb-2">
        ¡Reconocimiento Oficial!
      </h3>
      
      <!-- Nombre y rango del jugador -->
      <div class="mb-4 text-center">
        <p class="text-amber-200 text-sm">Para</p>
        <p id="playerName" class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-yellow-400"></p>
        <div id="playerRank" class="inline-block mt-1 px-3 py-1 text-xs font-medium rounded-full bg-amber-900/50 text-amber-200 border border-amber-700/50">
          <!-- El rango se llenará dinámicamente -->
        </div>
      </div>
      
      <!-- Contenido del reconocimiento -->
      <div class="bg-amber-900/30 border border-amber-700/50 rounded-lg p-4 mb-4">
        <p id="officerNoteContent" class="text-gray-100 italic"></p>
      </div>
      
      <!-- Contenedor para los reconocimientos -->
      <div id="recognitionsContainer" class="mt-2">
        <!-- Los reconocimientos se insertarán aquí dinámicamente -->
      </div>
      
      <!-- Firma -->
      <div class="mt-6 pt-4 border-t border-amber-800">
        <p class="text-sm text-amber-200">Con aprecio, el equipo de oficiales</p>
        <p class="text-xs text-amber-400 mt-1">Hermandad Colmillo de Acero</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Definir tipos
  interface Recognition {
    id: string;
    title: string;
    keyword: string;
    icon: string;
    color: string;
    description: string;
  }

  // Extender la interfaz Window
  declare global {
    interface Window {
      RECOGNITIONS: Recognition[];
      getPlayerRecognitions: (note: string) => Recognition[];
    }
  }

  // Definir la estructura de reconocimientos
  // Función para obtener el ícono según el rango
  function getRankIcon(rank: string): string {
    const rankIcons: Record<string, string> = {
      'Guild Master': '👑',
      'Oficial': '⚔️',
      'Comandante': '🎖️',
      'Guerrero Elite': '🛡️',
      'Recluta': '🔰'
    };
    return rankIcons[rank] || '🔸';
  }

  const RECOGNITIONS: Recognition[] = [
    {
      id: 'dominion',
      title: 'Dominion de la Hermandad',
      keyword: 'DOMINION',
      icon: '👑',
      color: 'from-amber-400 to-yellow-500',
      description: 'Máximo honor por liderazgo excepcional y dedicación inquebrantable.'
    },
    {
      id: 'guardian',
      title: 'Guardián de la Hermandad',
      keyword: 'GUARDIAN',
      icon: '🛡️',
      color: 'from-blue-400 to-cyan-500',
      description: 'Por proteger y guiar a los miembros en momentos cruciales.'
    },
    {
      id: 'cazador',
      title: 'Cazador de la Hermandad',
      keyword: 'CAZADOR',
      icon: '🏹',
      color: 'from-red-400 to-orange-500',
      description: 'Por logros excepcionales en batalla y mazmorras.'
    },
    {
      id: 'sabio',
      title: 'Sabio de la Hermandad',
      keyword: 'SABIO',
      icon: '📚',
      color: 'from-purple-400 to-indigo-500',
      description: 'Por compartir conocimiento y ayudar a otros a mejorar.'
    },
    {
      id: 'espiritu',
      title: 'Espíritu de la Hermandad',
      keyword: 'ESPIRITU',
      icon: '✨',
      color: 'from-green-400 to-emerald-500',
      description: 'Por mantener alto el espíritu y la moral del grupo.'
    }
  ];

  // Hacer reconocimientos disponibles globalmente
  if (typeof window !== 'undefined') {
    window.RECOGNITIONS = RECOGNITIONS;
  }

  // Definir tipos
  type Player = {
    name: string;
    class: string;
    rank: string;
    publicNote?: string;
    officerNote?: string;
  };

  // La constante RECOGNITIONS ya está definida al inicio del script

  // Función para obtener reconocimientos de un jugador
  function getPlayerRecognitions(note: string): Recognition[] {
    if (!note || typeof note !== 'string') return [];
    
    console.log('Nota del jugador:', note); // Debug
    
    const upperNote = note.toUpperCase().trim();
    const recognitions = (window as any).RECOGNITIONS as Recognition[] || [];
    
    // Buscar reconocimientos cuyas palabras clave estén en la nota
    const foundRecognitions = recognitions.filter((rec: Recognition) => {
      // Verificar si la palabra clave está en la nota (insensible a mayúsculas/minúsculas)
      const keywordFound = upperNote.includes(rec.keyword.toUpperCase());
      console.log(`Buscando ${rec.keyword}: ${keywordFound ? 'Encontrado' : 'No encontrado'}`); // Debug
      return keywordFound;
    });
    
    console.log('Reconocimientos encontrados:', foundRecognitions.map(r => r.title)); // Debug
    return foundRecognitions;
  }

  // Función para renderizar los hitos de reconocimiento
  function renderMilestones() {
    const container = document.getElementById('milestonesContainer');
    if (!container) return;

    container.innerHTML = RECOGNITIONS.map(recognition => `
      <div class="bg-gradient-to-br from-amber-900/50 to-amber-800/30 border border-amber-700/30 rounded-xl p-6 transform transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-amber-500/10">
        <div class="text-4xl text-center mb-3">${recognition.icon}</div>
        <h3 class="text-xl font-bold text-amber-300 mb-2 text-center">${recognition.title}</h3>
        <p class="text-sm text-amber-100/80 text-center">${recognition.description}</p>
        </div>
      </div>
    `).join('');
  }

  // Hacer las funciones accesibles globalmente
  if (typeof window !== 'undefined') {
    (window as any).getPlayerRecognitions = getPlayerRecognitions;
    (window as any).showOfficerNote = showOfficerNote;
  }

  // Función para mostrar la nota del oficial con reconocimientos
  function showOfficerNote(note: string, playerName: string, playerRank?: string) {
    // Obtener elementos del DOM
    const modal = document.getElementById('officerNoteModal');
    const playerNameElement = document.getElementById('playerName');
    const officerNoteContent = document.getElementById('officerNoteContent');
    const recognitionsContainer = document.getElementById('recognitionsContainer');
    
    // Verificar que todos los elementos existen
    if (!modal || !playerNameElement || !officerNoteContent || !recognitionsContainer) {
      console.error('No se encontraron todos los elementos del modal');
      return;
    }
    
    try {
      // Actualizar el contenido del modal
      playerNameElement.textContent = playerName || 'Jugador';
      officerNoteContent.textContent = note || 'Sin nota oficial';
      
      // Actualizar el rango del jugador
      const playerRankElement = document.getElementById('playerRank');
      if (playerRankElement) {
        const rankText = playerRank || 'Recluta';
        const rankIcon = getRankIcon(rankText);
        playerRankElement.innerHTML = `${rankIcon} ${rankText}`;
        playerRankElement.className = 'inline-flex items-center gap-1.5 mt-1 px-3 py-1 text-xs font-medium rounded-full bg-amber-900/50 text-amber-200 border border-amber-700/50';
      }
      
      // Obtener reconocimientos de la nota
      const recognitions = getPlayerRecognitions(note);
      
      // Limpiar contenedor de reconocimientos
      recognitionsContainer.innerHTML = '';
      
      if (recognitions && recognitions.length > 0) {
        // Crear contenedor de reconocimientos
        const container = document.createElement('div');
        container.className = 'mt-4 pt-4 border-t border-amber-700/50';
        
        // Título de la sección
        const title = document.createElement('h4');
        title.className = 'text-amber-300 font-medium mb-3 text-lg text-center';
        title.textContent = 'Reconocimientos';
        container.appendChild(title);
        
        // Contenedor para los iconos de reconocimiento
        const iconsContainer = document.createElement('div');
        iconsContainer.className = 'flex flex-wrap justify-center gap-3';
        
        // Crear un ícono para cada reconocimiento
        recognitions.forEach(rec => {
          const icon = document.createElement('div');
          icon.className = 'flex flex-col items-center group relative';
          icon.title = rec.title;
          
          icon.innerHTML = `
            <div class="w-12 h-12 bg-amber-900/50 rounded-full flex items-center justify-center text-2xl text-amber-300 group-hover:text-yellow-300 transition-colors">
              ${rec.icon}
            </div>
            <div class="absolute -bottom-6 opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="bg-amber-900 text-amber-100 text-xs px-2 py-1 rounded whitespace-nowrap">
                ${rec.title}
              </div>
            </div>
          `;
          
          iconsContainer.appendChild(icon);
        });
        
        container.appendChild(iconsContainer);
        recognitionsContainer.appendChild(container);
      }
      
      // Mostrar el modal
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      
    } catch (error) {
      console.error('Error al mostrar el modal:', error);
    }
  }
  
  // Las funciones ya están disponibles a través de la interfaz Window

  // Cerrar modal al hacer clic fuera del contenido o en el botón de cierre
  function setupModal() {
    const modal = document.getElementById('officerNoteModal');
    const closeButton = document.getElementById('closeModalButton');
    
    // Verificar que el modal existe
    if (!modal) {
      console.error('No se encontró el elemento del modal');
      return () => {}; // Retornar función de limpieza vacía
    }
    
    // Configurar botón de cierre
    const handleClose = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    };
    
    // Configurar eventos
    if (closeButton) {
      closeButton.addEventListener('click', handleClose);
    }
    
    // Cerrar al hacer clic fuera del contenido
    const handleClickOutside = (e: Event) => {
      if (e.target === modal) {
        handleClose();
      }
    };
    
    // Cerrar con tecla Escape
    const handleEscape = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        handleClose();
      }
    };
    
    // Agregar event listeners
    modal.addEventListener('click', handleClickOutside as EventListener);
    document.addEventListener('keydown', handleEscape as EventListener);
    
    // Prevenir que el clic en el contenido cierre el modal
    const modalContent = modal.querySelector('.modal-content');
    let contentClickHandler: ((e: Event) => void) | null = null;
    
    if (modalContent) {
      contentClickHandler = (e: Event) => {
        e.stopPropagation();
      };
      modalContent.addEventListener('click', contentClickHandler);
    }
    
    // Retornar función de limpieza
    return () => {
      if (closeButton) closeButton.removeEventListener('click', handleClose);
      modal.removeEventListener('click', handleClickOutside as EventListener);
      document.removeEventListener('keydown', handleEscape as EventListener);
      
      if (modalContent && contentClickHandler) {
        modalContent.removeEventListener('click', contentClickHandler);
      }
    };
  }
  
  // Inicializar cuando el DOM esté listo
  // Función para manejar los filtros
  function setupFilters() {
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const filterBtn = target.closest('.filter-btn') as HTMLElement;
      if (!filterBtn) return;
      
      e.preventDefault();
      
      const filterType = filterBtn.getAttribute('data-filter');
      const filterValue = filterBtn.getAttribute('data-value');
      if (!filterType || !filterValue) return;
      
      // Alternar filtro
      if (filterBtn.classList.contains('active')) {
        filterBtn.classList.remove('active');
        filterBtn.classList.remove('bg-amber-700/50', 'border-amber-500', 'text-white');
        filterBtn.classList.add('border-gray-600', 'text-gray-300');
      } else {
        filterBtn.classList.add('active');
        filterBtn.classList.remove('border-gray-600', 'text-gray-300');
        filterBtn.classList.add('bg-amber-700/50', 'border-amber-500', 'text-white');
      }
      
      // Aplicar filtros
      applyFilters();
    });
    
    // Configurar clics en los contadores principales
    const mainCounters = document.querySelectorAll('[data-filter]');
    mainCounters.forEach(counter => {
      counter.addEventListener('click', (e) => {
        e.preventDefault();
        const filterType = counter.getAttribute('data-filter');
        if (!filterType) return;
        
        // Limpiar otros filtros
        document.querySelectorAll('.filter-btn').forEach(btn => {
          btn.classList.remove('active', 'bg-amber-700/50', 'border-amber-500', 'text-white');
          btn.classList.add('border-gray-600', 'text-gray-300');
        });
        
        // Aplicar filtro específico
        if (filterType === 'officer') {
          filteredPlayers = players.filter((p: Player) => p.rank?.toLowerCase().includes('oficial'));
        } else if (filterType === 'spirit') {
          filteredPlayers = players.filter((p: Player) => 
            p.publicNote?.toLowerCase().includes('espíritu') || 
            p.publicNote?.toLowerCase().includes('espiritu')
          );
        } else {
          filteredPlayers = [...players];
        }
        
        currentPage = 1;
        renderTable();
      });
    });
  }
  
  function applyFilters() {
    const activeFilters: { class: string[], rank: string[] } = {
      class: [],
      rank: []
    };
    
    // Obtener filtros activos
    document.querySelectorAll('.filter-btn.active').forEach(btn => {
      const type = btn.getAttribute('data-filter');
      const value = btn.getAttribute('data-value');
      if (type && value && (type === 'class' || type === 'rank')) {
        activeFilters[type].push(value);
      }
    });
    
    // Aplicar filtros
    filteredPlayers = players.filter((player: PlayerType) => {
      const classMatch = activeFilters.class.length === 0 || activeFilters.class.includes(player.class);
      const rankMatch = activeFilters.rank.length === 0 || activeFilters.rank.includes(player.rank);
      return classMatch && rankMatch;
    });
    
    currentPage = 1;
    if (typeof renderTable === 'function') {
      renderTable();
    }
  }
  
  function updateActiveFilters() {
    document.querySelectorAll<HTMLElement>('.filter-btn').forEach((btn: HTMLElement) => {
      btn.classList.add('border-gray-600', 'text-gray-300', 'hover:border-amber-500/50', 'hover:text-amber-200');
      if (btn.classList.contains('active')) {
        btn.classList.add('bg-amber-700/50', 'border-amber-500', 'text-white');
        btn.classList.remove('border-gray-600', 'text-gray-300');
      }
    });
  }

    // Definir tipos
  interface PlayerType {
    name: string;
    class: string;
    rank: string;
    publicNote?: string;
    officerNote?: string;
  }

  // Variables globales
  let players: PlayerType[] = [];
  let filteredPlayers: PlayerType[] = [];
  let currentPage = 1;
  const playersPerPage = 10;
  let sortBy: keyof PlayerType = 'name';
  let sortOrder: 'asc' | 'desc' = 'asc';

  // Obtener elementos del DOM una vez
  const playerTableBody = document.querySelector('#player-table tbody');
  const pagination = document.getElementById('pagination');
  const indicators = document.getElementById('indicators');
  const rankFilter = document.getElementById('rank-filter') as HTMLSelectElement;
  const classFilter = document.getElementById('class-filter') as HTMLSelectElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const playerSelect = document.getElementById('player-select') as HTMLInputElement;

  // Funciones de utilidad
  const renderTable = (): void => {
    if (!playerTableBody) return;
    
    // Lógica de renderizado de la tabla
    playerTableBody.innerHTML = '';
    
    // Ordenar jugadores
    const sortedPlayers = [...filteredPlayers].sort((a, b) => {
      const aValue = a[sortBy] || '';
      const bValue = b[sortBy] || '';
      
      if (sortOrder === 'asc') {
        return String(aValue).localeCompare(String(bValue));
      } else {
        return String(bValue).localeCompare(String(aValue));
      }
    });
    
    // Paginación
    const start = (currentPage - 1) * playersPerPage;
    const paginatedPlayers = sortedPlayers.slice(start, start + playersPerPage);
    
    // Renderizar filas
    // ... (código existente de renderizado de filas)
  }

  // Inicialización
  document.addEventListener('DOMContentLoaded', () => {
    // Configurar filtros
    if (typeof setupFilters === 'function') {
      setupFilters();
    }
    
    // Renderizar hitos
    if (typeof renderMilestones === 'function') {
      renderMilestones();
    }
    
    // Inicializar el modal
    if (typeof setupModal === 'function') {
      setupModal();
    }
    
    // Obtener elementos del DOM
    const resetButton = document.querySelector('input[type="reset"]') as HTMLInputElement;
    
    // Inicializar eventos
    if (resetButton) {
      resetButton.addEventListener('click', () => {
        if (classFilter) classFilter.value = '';
        if (rankFilter) rankFilter.value = '';
        if (searchInput) searchInput.value = '';
        filteredPlayers = [...players];
        currentPage = 1;
        renderTable();
      });
    }

    function renderTable() {
      if (!playerTableBody) return;
      playerTableBody.innerHTML = "";

      const sortedPlayers = [...filteredPlayers].sort((a, b) => {
        const aValue = a[sortBy] ?? '';
        const bValue = b[sortBy] ?? '';
        if (sortOrder === "asc") {
          return String(aValue).localeCompare(String(bValue));
        } else {
          return String(bValue).localeCompare(String(aValue));
        }
      });

      const start = (currentPage - 1) * playersPerPage;
      const end = start + playersPerPage;
      const paginatedPlayers = sortedPlayers.slice(start, end);

      paginatedPlayers.forEach((player) => {
        const row = document.createElement("tr");
        row.className = "group hover:bg-amber-900/20 transition-colors duration-200 border-b border-amber-900/20 last:border-0";
        
        // Celda de Clase
        const classCell = document.createElement("td");
        classCell.className = "whitespace-nowrap text-center";
        classCell.innerHTML = `
          <div class="flex flex-row items-center">
            <img class="w-6 h-6 rounded m-1 object-cover border border-amber-600/30 mb-1" 
                 src="gallery/class_${player.class}.jpg" 
                 alt="${player.class}"
                 title="${player.class}">
            <span class="text-xs font-medium text-gray-200">${player.class}</span>
          </div>
        `;
        
        // Celda de Nombre
        const nameCell = document.createElement("td");
        nameCell.className = "whitespace-nowrap text-center";
        
        const nameContainer = document.createElement("div");
        nameContainer.className = "flex flex-row gap-2 items-center";
        
        const nameSpan = document.createElement("div");
        nameSpan.className = "text-sm font-medium text-white group-hover:text-amber-100 transition-colors";
        nameSpan.textContent = player.name;
        
        nameContainer.appendChild(nameSpan);
        
        // Botón de reconocimiento si hay nota de oficial
        if (player.officerNote) {
          const button = document.createElement("button");
          button.className = "text-amber-400 hover:text-yellow-300";
          button.title = "Ver reconocimiento oficial";
          button.innerHTML = `
            <div class="flex items-center text-xs text-amber-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Ver reconocimiento
            </div>
          `;
          
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            showOfficerNote(player.officerNote || '', player.name, player.rank);
          });
          
          nameContainer.appendChild(button);
        }
        
        nameCell.appendChild(nameContainer);
        
        // Celda de Especificación y Profesión
        const noteCell = document.createElement("td");
        noteCell.className = "text-center";
        
        // Celda de Rango (movida después de Spec & Profesión)
        const rankCell = document.createElement("td");
        rankCell.className = "whitespace-nowrap text-center";
        
        if (player.publicNote) {
          const noteParts = player.publicNote.split('|').map(part => part.trim());
          noteCell.innerHTML = `
            <div class="flex flex-wrap justify-center gap-1 max-w-full">
              ${noteParts.map(part => 
                `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-900/30 text-amber-100 border border-amber-700/50">
                  ${part}
                </span>`
              ).join('')}
            </div>
          `;
        } else {
          noteCell.innerHTML = '<span class="text-gray-400 text-sm">-</span>';
        }
        
        // Rango (ahora después de Spec & Profesión)
        rankCell.innerHTML = `
          <div class="flex justify-center">
            <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-amber-900/50 text-amber-200 border border-amber-700/50">
              ${player.rank}
            </span>
          </div>
        `;
        
        // Ensamblar la fila
        row.appendChild(classCell);
        row.appendChild(nameCell);
        row.appendChild(noteCell);
        row.appendChild(rankCell);
        
        playerTableBody.appendChild(row);
      });

      updatePagination();
    }

    function updatePagination() {
      if (!pagination) return;
      pagination.innerHTML = "";

      const totalPages = Math.ceil(filteredPlayers.length / playersPerPage);

      const createPageLink = (page: number) => {
        const link = document.createElement("a");
        link.href = "#";
        link.className = `w-8 h-8 flex items-center justify-center rounded-md text-sm font-medium transition-colors ${
          page === currentPage 
            ? 'bg-amber-600 text-white shadow-inner' 
            : 'text-gray-300 hover:bg-gray-700/50 hover:text-white'
        }`;
        link.textContent = page.toString();
        link.addEventListener("click", (e) => {
          e.preventDefault();
          currentPage = page;
          renderTable();
        });
        return link;
      };

      if (currentPage > 1) {
        const prevLink = createPageLink(currentPage - 1);
        prevLink.textContent = "<";
        pagination.appendChild(prevLink);
      }

      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || Math.abs(i - currentPage) < 2) {
          pagination.appendChild(createPageLink(i));
        } else if (i === currentPage - 2 || i === currentPage + 2) {
          const ellipsis = document.createElement("span");
          ellipsis.textContent = "...";
          ellipsis.className = "flex items-center px-2 text-gray-400 text-sm";
          pagination.appendChild(ellipsis);
        }
      }

      if (currentPage < totalPages) {
        const nextLink = createPageLink(currentPage + 1);
        nextLink.textContent = ">";
        pagination.appendChild(nextLink);
      }
    }

    function updateIndicators() {
      if (!indicators) return;
      
      // Usar TODOS los jugadores, no los filtrados
      const totalPlayers = players.length;
      const classes = [...new Set(players.map((player) => player.class))];
      const ranks = [...new Set(players.map((player) => player.rank))];
      
      // Contar miembros por categoría
      const officers = players.filter(p => p.rank?.toLowerCase().includes('oficial')).length;
      // Contar espíritus (no se usa la variable, pero mantenemos la lógica)
players.filter((p: PlayerType) => {
        const note = p.publicNote?.toLowerCase() || '';
        return note.includes('espíritu de la hermandad') || note.includes('espiritu de la hermandad');
      }).length;
      
      // Actualizar distribución de clases
      const classDistribution = document.getElementById('class-distribution');
      if (classDistribution) {
        const classCounts: Record<string, number> = {};
        players.forEach(player => {
          classCounts[player.class] = (classCounts[player.class] || 0) + 1;
        });
        
        // Ordenar clases por cantidad (de mayor a menor)
        const sortedClasses = Object.entries(classCounts)
          .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
        
        classDistribution.innerHTML = sortedClasses.map(([className, count]) => `
          <div class="bg-amber-900/30 rounded-lg p-3 border border-amber-700/30 hover:border-amber-500/50 transition-colors">
            <div class="flex items-center justify-center mb-2">
              <img class="w-8 h-8 rounded-sm object-cover border border-amber-600/30" 
                   src="gallery/class_${className}.jpg" 
                   alt="${className}"
                   title="${className}">
            </div>
            <div class="text-2xl font-bold text-amber-400 text-center">${count}</div>
            <div class="text-xs font-medium text-amber-200 text-center mt-1">${className}</div>
            <div class="h-1 bg-amber-900/50 rounded-full mt-2 overflow-hidden">
              <div class="h-full bg-amber-500/80" style="width: ${(count / totalPlayers * 100).toFixed(0)}%"></div>
            </div>
          </div>
        `).join('');
      }
      
      // Actualizar distribución de rangos
      const rankDistribution = document.getElementById('rank-distribution');
      if (rankDistribution) {
        const rankCounts: Record<string, number> = {};
        players.forEach(player => {
          rankCounts[player.rank] = (rankCounts[player.rank] || 0) + 1;
        });
        
        // Ordenar rangos por jerarquía definida
        const rankOrder = [
          'Guild Master',
          'Oficial',
          'Comandante',
          'Guerrero Elite',
          'Recluta'
        ];
        
        const sortedRanks = Object.entries(rankCounts)
          .sort((a, b) => {
            const indexA = rankOrder.indexOf(a[0]);
            const indexB = rankOrder.indexOf(b[0]);
            if (indexA !== -1 && indexB !== -1) return indexA - indexB;
            if (indexA !== -1) return -1;
            if (indexB !== -1) return 1;
            return a[0].localeCompare(b[0]);
          });
        
        rankDistribution.innerHTML = sortedRanks.map(([rank, count]) => `
          <div class="bg-amber-900/30 rounded-lg p-3 border border-amber-700/30 hover:border-amber-500/50 transition-colors">
            <div class="text-2xl font-bold text-amber-400 text-center">${count}</div>
            <div class="text-xs font-medium text-amber-200 text-center mt-1">${rank}</div>
            <div class="h-1 bg-amber-900/50 rounded-full mt-2 overflow-hidden">
              <div class="h-full bg-amber-500/80" style="width: ${(count / totalPlayers * 100).toFixed(0)}%"></div>
            </div>
          </div>
        `).join('');
      }
      
      // Actualizar contadores principales
      const totalMembersEl = document.getElementById('total-members');
      const totalOfficersEl = document.getElementById('total-officers');
      // totalProgressEl no se está utilizando
      const officerProgressEl = document.getElementById('officer-progress');
      
      if (totalMembersEl) totalMembersEl.textContent = totalPlayers.toString();
      if (totalOfficersEl) totalOfficersEl.textContent = officers.toString();
      if (officerProgressEl && totalPlayers > 0) {
        const officerPercentage = (officers / totalPlayers) * 100;
        officerProgressEl.style.width = `${officerPercentage}%`;
      }
      
      // Actualizar filtros de clase
      const classFilters = document.getElementById('class-filters');
      if (classFilters) {
        classFilters.innerHTML = classes.map(c => {
          const count = filteredPlayers.filter(p => p.class === c).length;
          return `
            <button class="filter-btn px-3 py-1.5 text-xs rounded-full border border-gray-600 text-gray-300 hover:border-amber-500/50 hover:text-amber-200 transition-colors" 
                    data-filter="class" 
                    data-value="${c}"
                    title="Filtrar por ${c}">
              ${c} <span class="bg-amber-900/50 text-amber-200 rounded-full px-1.5 py-0.5 ml-1 text-xs">${count}</span>
            </button>
          `;
        }).join('');
      }
      
      // Actualizar filtros de rango
      const rankFilters = document.getElementById('rank-filters');
      if (rankFilters) {
        rankFilters.innerHTML = ranks.map(r => {
          const count = filteredPlayers.filter(p => p.rank === r).length;
          return `
            <button class="filter-btn px-3 py-1.5 text-xs rounded-full border border-gray-600 text-gray-300 hover:border-amber-500/50 hover:text-amber-200 transition-colors" 
                    data-filter="rank" 
                    data-value="${r}"
                    title="Filtrar por ${r}">
              ${r} <span class="bg-amber-900/50 text-amber-200 rounded-full px-1.5 py-0.5 ml-1 text-xs">${count}</span>
            </button>
          `;
        }).join('');
      }
      
      // Actualizar logros
      const achievementsEl = document.getElementById('achievements');
      if (achievementsEl) {
        // Contar reconocimientos (insensible a mayúsculas/minúsculas)
        // Buscamos en officerNote que es donde están los reconocimientos
        const dominionCount = players.filter(p => {
          const note = p.officerNote?.toLowerCase() || '';
          return note.includes('dominion');
        }).length;
        
        const guardianCount = players.filter(p => {
          const note = p.officerNote?.toLowerCase() || '';
          return note.includes('guardián') || note.includes('guardian');
        }).length;
        
        const cazadorCount = players.filter(p => {
          const note = p.officerNote?.toLowerCase() || '';
          return note.includes('cazador');
        }).length;
        
        const sabioCount = players.filter(p => {
          const note = p.officerNote?.toLowerCase() || '';
          return note.includes('sabio');
        }).length;
        
        const espirituCount = players.filter(p => {
          const note = p.officerNote?.toLowerCase() || '';
          return note.includes('espíritu') || note.includes('espiritu');
        }).length;
        
        const achievements = [
          { 
            title: 'Dominion', 
            subtitle: 'de la Hermandad',
            icon: '👑',
            count: dominionCount,
            color: 'text-yellow-400',
            bg: 'bg-gradient-to-br from-yellow-900/30 to-amber-900/20',
            border: 'border-yellow-600/30',
            iconBg: 'from-yellow-600 to-amber-500'
          },
          { 
            title: 'Guardián', 
            subtitle: 'de la Hermandad',
            icon: '🛡️',
            count: guardianCount,
            color: 'text-blue-400',
            bg: 'bg-gradient-to-br from-blue-900/30 to-indigo-900/20',
            border: 'border-blue-600/30',
            iconBg: 'from-blue-600 to-indigo-500'
          },
          { 
            title: 'Cazador', 
            subtitle: 'de la Hermandad',
            icon: '🏹',
            count: cazadorCount,
            color: 'text-green-400',
            bg: 'bg-gradient-to-br from-green-900/30 to-emerald-900/20',
            border: 'border-green-600/30',
            iconBg: 'from-green-600 to-emerald-500'
          },
          { 
            title: 'Sabio', 
            subtitle: 'de la Hermandad',
            icon: '📚',
            count: sabioCount,
            color: 'text-purple-400',
            bg: 'bg-gradient-to-br from-purple-900/30 to-violet-900/20',
            border: 'border-purple-600/30',
            iconBg: 'from-purple-600 to-violet-500'
          },
          { 
            title: 'Espíritu', 
            subtitle: 'de la Hermandad',
            icon: '✨',
            count: espirituCount,
            color: 'text-pink-400',
            bg: 'bg-gradient-to-br from-pink-900/30 to-rose-900/20',
            border: 'border-pink-600/30',
            iconBg: 'from-pink-600 to-rose-500'
          }
        ];
        
        achievementsEl.innerHTML = achievements.map(ach => `
          <div class="relative overflow-hidden rounded-xl border ${ach.border} ${ach.bg} group hover:shadow-lg transition-all duration-300">
            <div class="absolute -right-4 -top-4 w-20 h-20 rounded-full bg-gradient-to-br ${ach.iconBg} opacity-20 transform group-hover:scale-110 transition-transform"></div>
            <div class="relative z-10 p-4">
              <div class="w-12 h-12 rounded-lg bg-gradient-to-br ${ach.iconBg} flex items-center justify-center text-white text-2xl mb-3">
                ${ach.icon}
              </div>
              <div class="text-sm font-medium text-gray-300">${ach.title}</div>
              <div class="text-xs text-gray-400 mb-2">${ach.subtitle}</div>
              <div class="text-2xl font-bold ${ach.color}">${ach.count}</div>
              <div class="h-1 bg-amber-900/30 rounded-full mt-2 overflow-hidden">
                <div class="h-full ${ach.color.replace('text-', 'bg-')} opacity-70" style="width: ${(totalPlayers > 0 ? (ach.count / totalPlayers * 100) : 0).toFixed(0)}%"></div>
              </div>
            </div>
          </div>
        `).join('');
        
        // Mostrar en consola para depuración
        console.log('Reconocimientos contados:', {
          dominion: dominionCount,
          guardian: guardianCount,
          cazador: cazadorCount,
          sabio: sabioCount,
          espiritu: espirituCount,
          totalPlayers: totalPlayers
        });
      }
      
      // Aplicar estilos a los botones de filtro activos
      updateActiveFilters();
    }

    function filterPlayers() {
      const selectedRank = rankFilter.value;
      const selectedClass = classFilter.value;
      const searchTerm = playerSelect.value.toLowerCase();

      filteredPlayers = players.filter((player) => {
        // Filtro por rango (incluyendo reconocimiento oficial)
        const rankMatch = selectedRank === "" || 
                         (selectedRank === "RECONOCIMIENTO" ? player.officerNote : player.rank === selectedRank);
        
        // Filtro por clase
        const classMatch = selectedClass === "" || player.class === selectedClass;
        
        // Filtro por nombre
        const nameMatch = player.name.toLowerCase().includes(searchTerm);
        
        return rankMatch && classMatch && nameMatch;
      });

      currentPage = 1;
      renderTable();
    }

    function updateSelectOptions() {
      const ranks: Record<string, number> = {};
      const classes: Record<string, number> = {};
      let hasOfficerNotes = false;

      // Contar rangos y clases
      players.forEach((player) => {
        ranks[player.rank] = (ranks[player.rank] || 0) + 1;
        classes[player.class] = (classes[player.class] || 0) + 1;
        if (player.officerNote) hasOfficerNotes = true;
      });

      const currentRankValue = rankFilter.value;
      const currentClassValue = classFilter.value;

      // Orden jerárquico de rangos
      const rankOrder = [
        'Guild Master',
        'Oficial',
        'Comandante',
        'Guerrero Elite',
        'Recluta'
      ];

      rankFilter.innerHTML = `
        <option value="">Todos los rangos</option>
        ${hasOfficerNotes ? '<option value="RECONOCIMIENTO">Reconocimiento Oficial</option>' : ''}
      `;
      
      // Agregar rangos en orden jerárquico
      rankOrder.forEach(rank => {
        if (ranks[rank]) {
          rankFilter.innerHTML += `<option value="${rank}">${rank}</option>`;
        }
      });
      
      // Agregar cualquier otro rango que no esté en la lista ordenada
      Object.entries(ranks).forEach(([rank]) => {
        if (!rankOrder.includes(rank)) {
          rankFilter.innerHTML += `<option value="${rank}">${rank}</option>`;
        }
      });

      classFilter.innerHTML = `<option value="">Todas las clases</option>`;
      Object.entries(classes).forEach(([className]) => {
        classFilter.innerHTML += `<option value="${className}">${className}</option>`;
      });

      rankFilter.value = currentRankValue;
      classFilter.value = currentClassValue;
    }

    function handleSort(column: keyof Player) {
      if (sortBy === column) {
        sortOrder = sortOrder === "asc" ? "desc" : "asc";
      } else {
        sortBy = column;
        sortOrder = "asc";
      }
      renderTable();
    }

    fetch("players.json")
      .then((response) => response.json())
      .then((data: Player[]) => {
        players = data;
        filteredPlayers = [...players];
        updateSelectOptions();
        
        // Actualizar primero los indicadores con TODOS los jugadores
        updateIndicators();
        
        // Luego renderizar la tabla con los jugadores filtrados
        renderTable();
        
        // Actualizar contador de miembros con animación
        const playerCount = players.length;
        const memberCountElement = document.getElementById("member-count");
        
        if (memberCountElement) {
          // Animar el contador
          let current = 0;
          const duration = 2000; // 2 segundos
          const increment = playerCount / (duration / 16); // 60fps
          
          const updateCount = () => {
            current = Math.min(Math.ceil(current + increment), playerCount);
            memberCountElement.textContent = current.toString();
            
            if (current < playerCount) {
              requestAnimationFrame(updateCount);
            }
          };
          
          updateCount();
        }
      })
      .catch((error) => console.error("Error al cargar los jugadores:", error));

    document.querySelectorAll("th").forEach((th) => {
      th.addEventListener("click", () => {
        const column = th.getAttribute("data-column") as keyof Player;
        handleSort(column);
      });
    });

    rankFilter.addEventListener("change", filterPlayers);
    classFilter.addEventListener("change", filterPlayers);
    playerSelect.addEventListener("input", filterPlayers);

    resetButton.addEventListener("click", () => {
      playerSelect.value = "";
      classFilter.value = "";
      rankFilter.value = "";
      filteredPlayers = players;
      currentPage = 1;
      renderTable();
    });

    // Las funciones ya están disponibles a través de la interfaz Window

    // Member counter is now handled in the main players.json fetch
  });
</script>
</section>