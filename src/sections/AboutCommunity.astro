---
import ImageComponent from "@/components/ImageComponent.astro";
---

<section id="about_community" class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="max-w-4xl mx-auto">

<!-- Raid Schedule Card -->
<div class="w-full">
  <div class="flex flex-col items-center mb-6">
    <div class="w-full max-w-2xl p-4 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 rounded-xl border border-amber-600/30 transform transition-all duration-300 hover:scale-[1.01] hover:shadow-amber-500/20 text-center">
      <h3 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-2">¡Bienvenidos!</h3>
      <div id="player-count" class="text-lg">
        <span class="font-bold text-amber-300">¡Ya somos <span id="member-count" class="text-3xl text-yellow-400">0</span> miembros!</span>
      </div>
    </div>
  </div>
  <div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 rounded-xl overflow-hidden border border-amber-600/30 transform transition-all duration-300 hover:scale-[1.01] hover:shadow-amber-500/20">
    <div class="p-6 sm:p-8">
      <div class="text-center mb-6">
        <h2 class="text-2xl sm:text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-2">
          Horario de Raids
        </h2>
        <div class="h-1 w-20 bg-gradient-to-r from-amber-500 to-yellow-600 mx-auto my-3 rounded-full"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
        <div class="space-y-4">
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-amber-900/50 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-amber-300">Horarios</h3>
              <p class="text-gray-300">18:00 - 21:00 - 00:00</p>
              <p class="text-sm text-amber-100/80">Hora del servidor</p>
            </div>
          </div>
          
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-amber-900/50 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-amber-300">Comunidad Activa</h3>
              <p class="text-gray-300">Únete a nuestra hermandad</p>
            </div>
          </div>
        </div>
        
        <div class="text-center md:border-l md:border-amber-700/50 md:pl-8">
          <h3 class="text-xl font-bold text-amber-300 mb-4">¡Únete a nuestro Discord!</h3>
          <p class="text-gray-300 mb-6">Conéctate con la comunidad, organiza raids y mantente al día con todos los eventos.</p>
          <a 
            href="https://discord.gg/BwdpNV9sky"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-amber-600 to-amber-700 text-white font-medium rounded-lg hover:from-amber-500 hover:to-amber-600 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-amber-500/30"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.872-1.295 1.226-1.994a.076.076 0 00-.041-.1 13.107 13.107 0 01-1.872-1.077.078.078 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.192.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873 1.08.077.077 0 00-.04.1c.36.698.77 1.362 1.225 1.993a.076.076 0 00.084.028 19.84 19.84 0 006.002-3.03.077.077 0 00.032-.054c.5-5.053-.838-9.588-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.95-2.419 2.157-2.419 1.21 0 2.175 1.1 2.157 2.42 0 1.333-.95 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.949-2.419 2.157-2.419 1.21 0 2.175 1.1 2.157 2.42 0 1.333-.95 2.418-2.157 2.418z"/>
            </svg>
            Unirse al Discord
          </a>
        </div>
      </div>
    </div>

    <!-- Guild Rules Section - Compacta -->
    <div class="w-full max-w-4xl mx-auto mb-8 overflow-hidden">
      <div class="p-6">
        <h2 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-4 text-center">
          Normas de la Hermandad
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <!-- Norma 1 -->
          <div class="flex items-start space-x-3 p-3 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-6 h-6 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-xs font-bold">1</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300">Notas Públicas</h4>
              <p class="text-gray-300 text-xs">Mantén actualizada tu nota con tu rol principal (DPS/Heal/Tank) y profesiones.</p>
            </div>
          </div>
          
          <!-- Norma 2 -->
          <div class="flex items-start space-x-3 p-3 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-6 h-6 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-xs font-bold">2</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300">Discord en Raids</h4>
              <p class="text-gray-300 text-xs">Obligatorio para raids. Micrófono funcional y silencio cuando no hables.</p>
            </div>
          </div>
          
          <!-- Norma 3 -->
          <div class="flex items-start space-x-3 p-3 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-6 h-6 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-xs font-bold">3</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300">Puntualidad</h4>
              <p class="text-gray-300 text-xs">Asistencia puntual a eventos. Avisar con anticipación si no puedes asistir.</p>
            </div>
          </div>
          
          <!-- Norma 4 -->
          <div class="flex items-start space-x-3 p-3 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-6 h-6 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-xs font-bold">4</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300">Preparación</h4>
              <p class="text-gray-300 text-xs">Consumibles, reparaciones y conocimiento de mecánicas listos.</p>
            </div>
          </div>
          
          <!-- Norma 5 -->
          <div class="flex items-start space-x-3 p-3 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-6 h-6 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-xs font-bold">5</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300">Trabajo en Equipo</h4>
              <p class="text-gray-300 text-xs">Respeto y colaboración con todos los miembros de la hermandad.</p>
            </div>
          </div>
          
          <!-- Norma 6 -->
          <div class="flex items-start space-x-3 p-3 bg-gray-800/50 rounded-lg">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-6 h-6 bg-amber-500/20 rounded-full flex items-center justify-center">
                <span class="text-amber-400 text-xs font-bold">6</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-amber-300">Conducta</h4>
              <p class="text-gray-300 text-xs">No se tolera acoso, lenguaje ofensivo o comportamiento tóxico.</p>
            </div>
          </div>
        </div>
        
        <!-- Sección de Reconocimiento Oficial -->
        <div class="mt-6 p-4 bg-amber-900/30 border border-amber-700/50 rounded-lg">
          <div class="flex items-center space-x-3 mb-2">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-amber-500/20 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              </div>
            </div>
            <h3 class="font-semibold text-amber-300">Reconocimiento Oficial</h3>
          </div>
          <p class="text-gray-200 text-xs ml-11">
            Los oficiales pueden otorgar reconocimientos especiales a los miembros destacados. 
            Busca el ícono de medalla <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 inline text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg> junto al nombre de un jugador para ver su reconocimiento oficial.
          </p>
        </div>
        
        <p class="text-xs text-amber-400/70 text-center mt-4">
          Los nombres de los miembros se actualizan diariamente para mantener la información al día.
        </p>
      </div>
    </div>
  </div>
</div>
  <div class="relative w-full text-center py-6">
    <!-- Members Table Title -->
    <div class="w-full max-w-4xl mx-auto mt-12 mb-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-2">
        Miembros de la Hermandad
      </h2>
      <div class="h-1 w-24 bg-gradient-to-r from-amber-500 to-yellow-600 mx-auto my-3 rounded-full"></div>
      <p class="text-gray-300 max-w-2xl mx-auto">
        Filtra por nombre, clase o rango para encontrar a tus compañeros de manada.
      </p>
    </div>
    <div class="flex flex-wrap mt-6 space-y-4">
      <div class="flex flex-row w-full max-w-2xl mx-auto">
        <input
          list="player-list"
          id="player-select"
          class="flex-grow px-4 py-2 bg-gray-800/80 border border-amber-600/30 text-white rounded-l-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent placeholder-gray-400"
          placeholder="Buscar jugador por nombre"
        />
        <datalist id="player-list"></datalist>
        <button
          type="reset"
          class="px-4 bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-r-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-gray-900"
        >
          X
        </button>
      </div>

      <div class="flex w-full flex-col sm:flex-row justify-between space-y-4 sm:space-y-0 sm:space-x-4 max-w-2xl mx-auto">
        <div class="w-full sm:w-1/3">
          <label class="block text-amber-300 text-sm font-medium mb-1">Filtrar por Rango:</label>
          <select id="rank-filter" class="w-full px-4 py-2 bg-gray-800/80 border border-amber-600/30 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent">
            <option value="">Todos los rangos</option>
            <option value="RECONOCIMIENTO">Reconocimiento Oficial</option>
          </select>
        </div>
        <div class="w-full sm:w-1/2">
          <label class="block text-amber-300 text-sm font-medium mb-1">Filtrar por Clase:</label>
          <select
            id="class-filter"
            class="w-full px-4 py-2 bg-gray-800/80 border border-amber-600/30 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent"
          >
            <option value="">Todas las clases</option>
          </select>
        </div>
      </div>
    </div>

    

    <div id="player-info" class="w-full max-w-6xl mx-auto text-white mt-4">
      <div class="overflow-hidden rounded-xl border border-amber-600/30 bg-gradient-to-br from-gray-900/80 to-gray-800/80">
        <table id="player-table" class="min-w-full divide-y divide-amber-600/30">
          <thead class="bg-gray-800/80">
            <tr>
              <th data-column="class" class="px-6 py-3 text-left text-xs font-medium text-amber-300 uppercase tracking-wider cursor-pointer">Clase</th>
              <th data-column="rank" class="px-6 py-3 text-left text-xs font-medium text-amber-300 uppercase tracking-wider cursor-pointer">Rango</th>
              <th data-column="name" class="px-6 py-3 text-left text-xs font-medium text-amber-300 uppercase tracking-wider cursor-pointer">Nombre</th>
              <th data-column="publicNote" class="px-6 py-3 text-left text-xs font-medium text-amber-300 uppercase tracking-wider cursor-pointer">Función GS & Profesión</th>
            </tr>
          </thead>
          <tbody class="bg-gray-900/50 divide-y divide-amber-600/20">
            <!-- Las filas se agregarán aquí dinámicamente -->
          </tbody>
        </table>
      </div>
    </div>

    <div id="pagination" class="flex justify-center mt-6 space-x-1.5 px-2">
      <!-- Los controles de paginación se insertarán aquí -->
    </div>

    <div id="indicators" class="bg-gray-900/70 border border-amber-600/30 rounded-xl p-3 mt-6 max-w-4xl mx-auto backdrop-blur-sm">
      <!-- Indicadores de la cantidad total de jugadores, por clase y por rango -->
    </div>
  </div>

  <!-- Sección de Hitos Destacados -->
  <div class="w-full max-w-6xl mx-auto mt-16 mb-12">
    <h2 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-yellow-500 mb-6 text-center">
      Hitos de la Hermandad
    </h2>
    <p class="text-gray-300 text-center max-w-3xl mx-auto mb-8">
      Reconocimientos otorgados a los miembros que han demostrado un compromiso excepcional con la Hermandad.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 px-4" id="milestonesContainer">
      <!-- Los hitos se cargarán dinámicamente con JavaScript -->
    </div>
  </div>
</section>

<!-- Officer Note Modal -->
<!-- Modal de Reconocimiento Oficial -->
<div id="officerNoteModal" class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-[100] p-4">
  <div class="bg-gradient-to-br from-amber-900 via-amber-800 to-amber-900 rounded-xl border-2 border-amber-500 p-6 max-w-md w-full mx-4 relative overflow-hidden">
    <!-- Botón de cierre -->
    <button id="closeModalButton" class="absolute top-4 right-4 text-amber-300 hover:text-white transition-colors z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <!-- Decoración de esquina -->
    <div class="absolute -top-6 -right-6 w-24 h-24 bg-amber-500/10 rounded-full"></div>
    <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-amber-500/5 rounded-full"></div>
    
    <div class="relative z-10 text-center">
      <!-- Icono de reconocimiento -->
      <div class="w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      
      <!-- Título con efecto de brillo -->
      <h3 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-yellow-400 mb-2">
        ¡Reconocimiento Oficial!
      </h3>
      
      <!-- Nombre del jugador -->
      <div class="mb-4">
        <p class="text-amber-200 text-sm">Para:</p>
        <p id="playerName" class="text-xl font-semibold text-white"></p>
      </div>
      
      <!-- Contenido del reconocimiento -->
      <div class="bg-amber-900/30 border border-amber-700/50 rounded-lg p-4 mb-4">
        <p id="officerNoteContent" class="text-gray-100 italic"></p>
      </div>
      
      <!-- Contenedor para los reconocimientos -->
      <div id="recognitionsContainer" class="mt-2">
        <!-- Los reconocimientos se insertarán aquí dinámicamente -->
      </div>
      
      <!-- Firma -->
      <div class="mt-6 pt-4 border-t border-amber-800">
        <p class="text-sm text-amber-200">Con aprecio, el equipo de oficiales</p>
        <p class="text-xs text-amber-400 mt-1">Hermandad Colmillo de Acero</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Definir tipos
  interface Recognition {
    id: string;
    title: string;
    keyword: string;
    icon: string;
    color: string;
    description: string;
  }

  // Extender la interfaz Window
  declare global {
    interface Window {
      RECOGNITIONS: Recognition[];
      getPlayerRecognitions: (note: string) => Recognition[];
    }
  }

  // Definir la estructura de reconocimientos
  const RECOGNITIONS: Recognition[] = [
    {
      id: 'dominion',
      title: 'Dominion del León',
      keyword: 'DOMINION',
      icon: '👑',
      color: 'from-amber-400 to-yellow-500',
      description: 'Máximo honor por liderazgo excepcional y dedicación inquebrantable.'
    },
    {
      id: 'guardian',
      title: 'Guardián de la Manada',
      keyword: 'GUARDIAN',
      icon: '🛡️',
      color: 'from-blue-400 to-cyan-500',
      description: 'Por proteger y guiar a los miembros en momentos cruciales.'
    },
    {
      id: 'cazador',
      title: 'Cazador de Trofeos',
      keyword: 'CAZADOR',
      icon: '🏹',
      color: 'from-red-400 to-orange-500',
      description: 'Por logros excepcionales en batalla y mazmorras.'
    },
    {
      id: 'sabio',
      title: 'Sabio de la Manada',
      keyword: 'SABIO',
      icon: '📚',
      color: 'from-purple-400 to-indigo-500',
      description: 'Por compartir conocimiento y ayudar a otros a mejorar.'
    },
    {
      id: 'espiritu',
      title: 'Espíritu de la Manada',
      keyword: 'ESPIRITU',
      icon: '✨',
      color: 'from-green-400 to-emerald-500',
      description: 'Por mantener alto el espíritu y la moral del grupo.'
    }
  ];

  // Hacer reconocimientos disponibles globalmente
  if (typeof window !== 'undefined') {
    window.RECOGNITIONS = RECOGNITIONS;
  }

  // Definir tipos
  type Player = {
    name: string;
    class: string;
    rank: string;
    publicNote?: string;
    officerNote?: string;
  };

  // La constante RECOGNITIONS ya está definida al inicio del script

  // Función para obtener reconocimientos de un jugador
  function getPlayerRecognitions(note: string): Recognition[] {
    if (!note || typeof note !== 'string') return [];
    
    console.log('Nota del jugador:', note); // Debug
    
    const upperNote = note.toUpperCase().trim();
    const recognitions = (window as any).RECOGNITIONS as Recognition[] || [];
    
    // Buscar reconocimientos cuyas palabras clave estén en la nota
    const foundRecognitions = recognitions.filter((rec: Recognition) => {
      // Verificar si la palabra clave está en la nota (insensible a mayúsculas/minúsculas)
      const keywordFound = upperNote.includes(rec.keyword.toUpperCase());
      console.log(`Buscando ${rec.keyword}: ${keywordFound ? 'Encontrado' : 'No encontrado'}`); // Debug
      return keywordFound;
    });
    
    console.log('Reconocimientos encontrados:', foundRecognitions.map(r => r.title)); // Debug
    return foundRecognitions;
  }

  // Función para renderizar los hitos de reconocimiento
  function renderMilestones() {
    const container = document.getElementById('milestonesContainer');
    if (!container) return;

    container.innerHTML = RECOGNITIONS.map(recognition => `
      <div class="bg-gradient-to-br from-amber-900/50 to-amber-800/30 border border-amber-700/30 rounded-xl p-6 transform transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-amber-500/10">
        <div class="text-4xl mb-3">${recognition.icon}</div>
        <h3 class="text-xl font-bold text-amber-300 mb-2">${recognition.title}</h3>
        <p class="text-sm text-amber-100/80">${recognition.description}</p>
        </div>
      </div>
    `).join('');
  }

  // Hacer las funciones accesibles globalmente
  if (typeof window !== 'undefined') {
    (window as any).getPlayerRecognitions = getPlayerRecognitions;
    (window as any).showOfficerNote = showOfficerNote;
  }

  // Función para mostrar la nota del oficial con reconocimientos
  function showOfficerNote(note: string, playerName: string) {
    // Obtener elementos del DOM
    const modal = document.getElementById('officerNoteModal');
    const playerNameElement = document.getElementById('playerName');
    const officerNoteContent = document.getElementById('officerNoteContent');
    const recognitionsContainer = document.getElementById('recognitionsContainer');
    
    // Verificar que todos los elementos existen
    if (!modal || !playerNameElement || !officerNoteContent || !recognitionsContainer) {
      console.error('No se encontraron todos los elementos del modal');
      return;
    }
    
    try {
      // Actualizar el contenido del modal
      playerNameElement.textContent = playerName || 'Jugador';
      officerNoteContent.textContent = note || 'Sin nota oficial';
      
      // Obtener reconocimientos de la nota
      const recognitions = getPlayerRecognitions(note);
      
      // Limpiar contenedor de reconocimientos
      recognitionsContainer.innerHTML = '';
      
      if (recognitions && recognitions.length > 0) {
        // Crear contenedor de reconocimientos
        const container = document.createElement('div');
        container.className = 'mt-4 pt-4 border-t border-amber-700/50';
        
        // Título de la sección
        const title = document.createElement('h4');
        title.className = 'text-amber-300 font-medium mb-3 text-lg text-center';
        title.textContent = 'Reconocimientos';
        container.appendChild(title);
        
        // Contenedor para los iconos de reconocimiento
        const iconsContainer = document.createElement('div');
        iconsContainer.className = 'flex flex-wrap justify-center gap-3';
        
        // Crear un ícono para cada reconocimiento
        recognitions.forEach(rec => {
          const icon = document.createElement('div');
          icon.className = 'flex flex-col items-center group relative';
          icon.title = rec.title;
          
          icon.innerHTML = `
            <div class="w-12 h-12 bg-amber-900/50 rounded-full flex items-center justify-center text-2xl text-amber-300 group-hover:text-yellow-300 transition-colors">
              ${rec.icon}
            </div>
            <div class="absolute -bottom-6 opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="bg-amber-900 text-amber-100 text-xs px-2 py-1 rounded whitespace-nowrap">
                ${rec.title}
              </div>
            </div>
          `;
          
          iconsContainer.appendChild(icon);
        });
        
        container.appendChild(iconsContainer);
        recognitionsContainer.appendChild(container);
      }
      
      // Mostrar el modal
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      
    } catch (error) {
      console.error('Error al mostrar el modal:', error);
    }
  }
  
  // Las funciones ya están disponibles a través de la interfaz Window

  // Cerrar modal al hacer clic fuera del contenido o en el botón de cierre
  function setupModal() {
    const modal = document.getElementById('officerNoteModal');
    const closeButton = document.getElementById('closeModalButton');
    
    // Verificar que el modal existe
    if (!modal) {
      console.error('No se encontró el elemento del modal');
      return () => {}; // Retornar función de limpieza vacía
    }
    
    // Configurar botón de cierre
    const handleClose = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    };
    
    // Configurar eventos
    if (closeButton) {
      closeButton.addEventListener('click', handleClose);
    }
    
    // Cerrar al hacer clic fuera del contenido
    const handleClickOutside = (e: Event) => {
      if (e.target === modal) {
        handleClose();
      }
    };
    
    // Cerrar con tecla Escape
    const handleEscape = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        handleClose();
      }
    };
    
    // Agregar event listeners
    modal.addEventListener('click', handleClickOutside as EventListener);
    document.addEventListener('keydown', handleEscape as EventListener);
    
    // Prevenir que el clic en el contenido cierre el modal
    const modalContent = modal.querySelector('.modal-content');
    let contentClickHandler: ((e: Event) => void) | null = null;
    
    if (modalContent) {
      contentClickHandler = (e: Event) => {
        e.stopPropagation();
      };
      modalContent.addEventListener('click', contentClickHandler);
    }
    
    // Retornar función de limpieza
    return () => {
      if (closeButton) closeButton.removeEventListener('click', handleClose);
      modal.removeEventListener('click', handleClickOutside as EventListener);
      document.removeEventListener('keydown', handleEscape as EventListener);
      
      if (modalContent && contentClickHandler) {
        modalContent.removeEventListener('click', contentClickHandler);
      }
    };
  }
  
  // Inicializar cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    // Renderizar hitos
    renderMilestones();
    
    // Inicializar el modal
    const cleanupModal = setupModal();
    
    // Obtener elementos del DOM
    const playerSelect = document.getElementById('player-select') as HTMLInputElement;
    const playerTableBody = document.querySelector('#player-table tbody') as HTMLTableSectionElement;
    const pagination = document.getElementById('pagination') as HTMLDivElement;
    const resetButton = document.querySelector('input[type="reset"]') as HTMLInputElement;
    const rankFilter = document.getElementById('rank-filter') as HTMLSelectElement;
    const classFilter = document.getElementById('class-filter') as HTMLSelectElement;
    const indicators = document.getElementById('indicators') as HTMLDivElement;

    let players: Player[] = [];
    let filteredPlayers: Player[] = [];
    let currentPage = 1;
    const playersPerPage = 10;
    let sortBy: keyof Player = "name";
    let sortOrder: "asc" | "desc" = "asc";

    function renderTable() {
      if (!playerTableBody) return;
      playerTableBody.innerHTML = "";

      const sortedPlayers = [...filteredPlayers].sort((a, b) => {
        const aValue = a[sortBy] ?? '';
        const bValue = b[sortBy] ?? '';
        if (sortOrder === "asc") {
          return String(aValue).localeCompare(String(bValue));
        } else {
          return String(bValue).localeCompare(String(aValue));
        }
      });

      const start = (currentPage - 1) * playersPerPage;
      const end = start + playersPerPage;
      const paginatedPlayers = sortedPlayers.slice(start, end);

      paginatedPlayers.forEach((player, index) => {
        const row = document.createElement("tr");
        row.className = index % 2 === 0 ? "bg-gray-900" : "bg-gray-700";
        
        // Crear la celda del nombre con el botón de reconocimiento
        const nameCell = document.createElement("td");
        nameCell.className = "text-white text-left truncate max-w-[200px] flex items-center";
        nameCell.title = player.name;
        
        const nameSpan = document.createElement("span");
        nameSpan.textContent = player.name;
        
        nameCell.appendChild(nameSpan);
        
        // Agregar botón de reconocimiento si hay una nota de oficial
        if (player.officerNote) {
          const button = document.createElement("button");
          button.className = "ml-2 text-amber-400 hover:text-yellow-300 transition-colors";
          button.title = "Ver reconocimiento oficial";
          button.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          `;
          
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            showOfficerNote(player.officerNote || '', player.name);
          });
          
          nameCell.appendChild(button);
        }
        
        // Crear la fila completa
        row.innerHTML = `
          <td class="text-white flex items-center">
            <img class="max-w-[25px] drop-shadow-4xl px-1 dsm:pt-1 sm:mx-0 dsm:mx-auto sm:pb-1" 
                 src="gallery/class_${player.class}.jpg" 
                 alt="${player.class}">
            <span class="sm:inline hidden pr-4">${player.class}</span>
          </td>
          <td class="text-white text-left">${player.rank}</td>
        `;
        
        // Agregar la celda del nombre que ya creamos
        row.appendChild(nameCell);
        
        // Agregar celda de nota pública
        const noteCell = document.createElement("td");
        noteCell.className = "text-white text-left px-2";
        noteCell.title = player.publicNote || '';
        noteCell.textContent = player.publicNote || '';
        row.appendChild(noteCell);
        
        playerTableBody.appendChild(row);
      });

      updatePagination();
      updateIndicators();
    }

    function updatePagination() {
      if (!pagination) return;
      pagination.innerHTML = "";

      const totalPages = Math.ceil(filteredPlayers.length / playersPerPage);

      const createPageLink = (page: number) => {
        const link = document.createElement("a");
        link.href = "#";
        link.className = `w-8 h-8 flex items-center justify-center rounded-md text-sm font-medium transition-colors ${
          page === currentPage 
            ? 'bg-amber-600 text-white shadow-inner' 
            : 'text-gray-300 hover:bg-gray-700/50 hover:text-white'
        }`;
        link.textContent = page.toString();
        link.addEventListener("click", (e) => {
          e.preventDefault();
          currentPage = page;
          renderTable();
        });
        return link;
      };

      if (currentPage > 1) {
        const prevLink = createPageLink(currentPage - 1);
        prevLink.textContent = "<";
        pagination.appendChild(prevLink);
      }

      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || Math.abs(i - currentPage) < 2) {
          pagination.appendChild(createPageLink(i));
        } else if (i === currentPage - 2 || i === currentPage + 2) {
          const ellipsis = document.createElement("span");
          ellipsis.textContent = "...";
          ellipsis.className = "flex items-center px-2 text-gray-400 text-sm";
          pagination.appendChild(ellipsis);
        }
      }

      if (currentPage < totalPages) {
        const nextLink = createPageLink(currentPage + 1);
        nextLink.textContent = ">";
        pagination.appendChild(nextLink);
      }
    }

    function updateIndicators() {
      if (!indicators) return;
      const totalPlayers = filteredPlayers.length;
      const classes = [...new Set(filteredPlayers.map((player) => player.class))];
      const ranks = [...new Set(filteredPlayers.map((player) => player.rank))];

      const totalByClass = classes.map((c) => ({
        class: c,
        count: filteredPlayers.filter((player) => player.class === c).length,
      }));

      const totalByRank = ranks.map((r) => ({
        rank: r,
        count: filteredPlayers.filter((player) => player.rank === r).length,
      }));

      indicators.innerHTML = `
        <div class="flex flex-wrap items-center justify-center gap-2 text-sm">
          <div class="bg-gray-800/80 px-3 py-1.5 rounded-lg border border-amber-600/30 text-amber-300 font-medium">
            Total: <span class="text-yellow-400 font-bold">${totalPlayers}</span>
          </div>
          ${totalByClass
            .map((c) => `
              <div class="bg-gray-800/80 px-2.5 py-1 rounded-lg border border-amber-600/30 flex items-center">
                <img src="gallery/class_${c.class}.jpg" alt="${c.class}" class="w-4 h-4 mr-1.5 rounded-sm" />
                <span class="text-amber-100">${c.class}:</span>
                <span class="ml-1 font-semibold text-yellow-400">${c.count}</span>
              </div>
            `).join('')}
          ${totalByRank
            .map((r) => `
              <div class="bg-gray-800/80 px-2.5 py-1 rounded-lg border border-amber-600/30 text-amber-100">
                ${r.rank}: <span class="font-semibold text-yellow-400">${r.count}</span>
              </div>
            `).join('')}
        </div>
      `;
    }

    function filterPlayers() {
      const selectedRank = rankFilter.value;
      const selectedClass = classFilter.value;
      const searchTerm = playerSelect.value.toLowerCase();

      filteredPlayers = players.filter((player) => {
        // Filtro por rango (incluyendo reconocimiento oficial)
        const rankMatch = selectedRank === "" || 
                         (selectedRank === "RECONOCIMIENTO" ? player.officerNote : player.rank === selectedRank);
        
        // Filtro por clase
        const classMatch = selectedClass === "" || player.class === selectedClass;
        
        // Filtro por nombre
        const nameMatch = player.name.toLowerCase().includes(searchTerm);
        
        return rankMatch && classMatch && nameMatch;
      });

      currentPage = 1;
      renderTable();
    }

    function updateSelectOptions() {
      const ranks: Record<string, number> = {};
      const classes: Record<string, number> = {};
      let hasOfficerNotes = false;

      players.forEach((player) => {
        ranks[player.rank] = (ranks[player.rank] || 0) + 1;
        classes[player.class] = (classes[player.class] || 0) + 1;
        if (player.officerNote) hasOfficerNotes = true;
      });

      const currentRankValue = rankFilter.value;
      const currentClassValue = classFilter.value;

      rankFilter.innerHTML = `
        <option value="">Todos los rangos</option>
        ${hasOfficerNotes ? '<option value="RECONOCIMIENTO">Reconocimiento Oficial</option>' : ''}
      `;
      
      // Agregar rangos existentes
      Object.entries(ranks).forEach(([rank]) => {
        rankFilter.innerHTML += `<option value="${rank}">${rank}</option>`;
      });

      classFilter.innerHTML = `<option value="">Todas las clases</option>`;
      Object.entries(classes).forEach(([className]) => {
        classFilter.innerHTML += `<option value="${className}">${className}</option>`;
      });

      rankFilter.value = currentRankValue;
      classFilter.value = currentClassValue;
    }

    function handleSort(column: keyof Player) {
      if (sortBy === column) {
        sortOrder = sortOrder === "asc" ? "desc" : "asc";
      } else {
        sortBy = column;
        sortOrder = "asc";
      }
      renderTable();
    }

    fetch("players.json")
      .then((response) => response.json())
      .then((data: Player[]) => {
        players = data;
        filteredPlayers = players;
        updateSelectOptions();
        renderTable();
        
        // Update member count with animation
        const playerCount = players.length;
        const memberCountElement = document.getElementById("member-count");
        
        if (memberCountElement) {
          // Animate the counter
          let current = 0;
          const duration = 2000; // 2 seconds
          const increment = playerCount / (duration / 16); // 60fps
          
          const updateCount = () => {
            current = Math.min(Math.ceil(current + increment), playerCount);
            memberCountElement.textContent = current.toString();
            
            if (current < playerCount) {
              requestAnimationFrame(updateCount);
            }
          };
          
          updateCount();
        }
      })
      .catch((error) => console.error("Error al cargar los jugadores:", error));

    document.querySelectorAll("th").forEach((th) => {
      th.addEventListener("click", () => {
        const column = th.getAttribute("data-column") as keyof Player;
        handleSort(column);
      });
    });

    rankFilter.addEventListener("change", filterPlayers);
    classFilter.addEventListener("change", filterPlayers);
    playerSelect.addEventListener("input", filterPlayers);

    resetButton.addEventListener("click", () => {
      playerSelect.value = "";
      classFilter.value = "";
      rankFilter.value = "";
      filteredPlayers = players;
      currentPage = 1;
      renderTable();
    });

    // Las funciones ya están disponibles a través de la interfaz Window

    // Member counter is now handled in the main players.json fetch
  });
</script>
