---
import YoutubeIcon from '@/components/YoutubeIcon.astro'
---

<footer class="relative w-full pt-12 pb-8">
    <div class="container mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center gap-8">
            <!-- Información de derechos de autor -->
            <div class="text-center md:text-left">
                <h3 class="text-xl font-bold text-amber-400 mb-2">Colmillo de Acero</h3>
                <p class="text-gray-300 text-sm">
                    &copy; 2025 Todos los derechos reservados
                </p>
                <p class="text-xs text-gray-400 mt-1">
                    Una comunidad de World of Warcraft
                </p>
            </div>

            <!-- Redes sociales -->
            <div class="flex flex-col items-center md:items-end">
                <h4 class="text-gray-300 text-sm font-medium mb-3">Síguenos</h4>
                <ul class="flex space-x-6">
                    <li>
                        <a 
                            href="https://www.youtube.com/@IAM-GAMECODE" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="p-2 block text-amber-400 hover:text-amber-300 transition-colors"
                            aria-label="Canal de YouTube"
                        >
                            <YoutubeIcon class="w-6 h-6" />
                            <span class="sr-only">YouTube</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        
        <!-- Línea divisoria -->
        <div class="w-full h-px bg-amber-600/30 my-8"></div>
        
        <!-- Enlaces adicionales -->
        <div class="text-center">
            <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
                <li><a href="#" class="text-gray-300 hover:text-amber-400 transition-colors">Inicio</a></li>
                <li><a href="#about_community" class="text-gray-300 hover:text-amber-400 transition-colors">Comunidad</a></li>
                <li><a href="#about_addon" class="text-gray-300 hover:text-amber-400 transition-colors">Addon</a></li>
            </ul>
        </div>
    </div>
</footer>
