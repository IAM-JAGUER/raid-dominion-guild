---
import YoutubeIcon from '@/components/shared/icons/YoutubeIcon.astro'
import Icon from '@/components/ui/Icon.astro'
import { SITE_CONFIG } from '@/utils/constants'
---

<footer class="bg-gradient-to-r from-brand-900/95 to-brand-950/95 backdrop-blur border-t border-brand-600/30 shadow-lg transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <!-- Información de derechos de autor -->
            <div class="text-center md:text-left">
                <div class="flex items-center justify-center md:justify-start">
                    <img
                        src="/logo.png"
                        alt="Logo RaidDominion"
                        class="h-8 w-auto mr-2 rounded"
                        loading="lazy"
                        decoding="async"
                    />
                    <h3 class="text-lg font-bold bg-clip-text text-brand-200 bg-gradient-to-r from-brand-400 to-brand-500">
                        {SITE_CONFIG.TITLE}
                    </h3>
                </div>
                <p class="text-xs text-gray-300 mt-1">
                    &copy; 2025 Todos los derechos reservados
                </p>
            </div>

            <!-- Redes sociales -->
            <div class="flex items-center space-x-6">
                <a 
                    href="https://www.youtube.com/@IAM-GAMECODE" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-brand-300 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md"
                    aria-label="Canal de YouTube"
                >
                    <YoutubeIcon class="w-6 h-6" />
                    <span class="sr-only">YouTube</span>
                </a>
                <a 
                    href="https://discord.gg/BwdpNV9sky" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-brand-300 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md"
                    aria-label="Servidor de Discord"
                >
                    <Icon name="discord" size="lg" />
                    <span class="sr-only">Discord</span>
                </a>
            </div>
        </div>
        
        <!-- Enlaces de navegación -->
        <div class="mt-4 pt-4 border-t border-brand-600/20">
            <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm">
                <li><a href="/" class="text-brand-200 hover:text-white transition-colors font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Inicio</a></li>
                <li><a href="/#addon" class="text-brand-200 hover:text-white transition-colors font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Guía del Addon</a></li>
                <li><a href="/upload" class="text-brand-200 hover:text-white transition-colors font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Subir SavedVariables</a></li>
            </ul>
            <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm mt-2">
                <li><a href="/bandas" class="text-gray-400 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Bandas</a></li>
                <li><a href="/hermandades" class="text-gray-400 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Hermandades</a></li>
                <li><a href="/personajes" class="text-gray-400 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Personajes</a></li>
                <li><a href="/servidores" class="text-gray-400 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Servidores</a></li>
                <li><a href="/jugadores" class="text-gray-400 hover:text-brand-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-md">Jugadores</a></li>
            </ul>
        </div>
    </div>
</footer>
