---
import YoutubeIcon from '@/components/shared/icons/YoutubeIcon.astro'
import { SITE_CONFIG } from '@/utils/constants'
---

<footer class="bg-gradient-to-r from-gray-900/95 to-#78350f/95 backdrop-blur border-t border-#d97706/30 shadow-lg transition-all duration-300 ">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <!-- Información de derechos de autor -->
            <div class="text-center md:text-left">
                <div class="flex items-center justify-center md:justify-start">
                    <img
                        src="/logo.png"
                        alt="Logo RaidDominion"
                        class="h-8 w-auto mr-2 rounded"
                        loading="lazy"
                        decoding="async"
                    />
                    <h3 class="text-lg font-bold bg-clip-text text-amber-200 bg-gradient-to-r from-amber-400 to-yellow-500">
                        {SITE_CONFIG.TITLE}
                    </h3>
                </div>
                <p class="text-xs text-gray-300 mt-1">
                    &copy; 2025 Todos los derechos reservados
                </p>
            </div>

            <!-- Redes sociales -->
            <div class="flex items-center space-x-6">
                <a 
                    href="https://www.youtube.com/@IAM-GAMECODE" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-amber-300 hover:text-amber-200 transition-colors"
                    aria-label="Canal de YouTube"
                >
                    <YoutubeIcon class="w-6 h-6" />
                    <span class="sr-only">YouTube</span>
                </a>
                <a 
                    href="https://discord.gg/BwdpNV9sky" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-indigo-300 hover:text-indigo-200 transition-colors"
                    aria-label="Servidor de Discord"
                >
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.8 8.18 1.8 12.062 0a.074.074 0 01.078.01c.12.098.246.192.373.292a.077.077 0 01-.006.127 12.3 12.3 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.84 19.84 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.95-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.951 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.951-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.951 2.418-2.157 2.418z"/>
                    </svg>
                    <span class="sr-only">Discord</span>
                </a>
            </div>
        </div>
        
        <!-- Enlaces de navegación -->
        <div class="mt-4 pt-4 border-t border-amber-600/20">
            <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm">
                <li><a href="#inicio" class="text-amber-200 hover:text-white transition-colors font-medium">Inicio</a></li>
                <li><a href="#addon" class="text-amber-200 hover:text-white transition-colors font-medium">Addon</a></li>
                <li><a href="#donaciones" class="text-amber-200 hover:text-white transition-colors font-medium">Donaciones</a></li>
            </ul>
        </div>
    </div>
</footer>
