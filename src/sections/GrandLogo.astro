---
  ---

<section class="flex flex-col justify-center items-center relative">
  <div class="relative">
    <img
      class="mt-8 animate-slide-up-fade drop-shadow-[0_0_25px_rgba(245,158,11,0.5)]"
      src="gallery/lider.png"
      alt="Raid Dominion"
      width="230"
      height="230"
    />
    <div class="absolute -inset-4 -z-10 bg-gradient-to-r from-amber-500/20 to-amber-600/20 rounded-full blur-xl opacity-70 animate-pulse"></div>
  </div>
  
  <div class="relative mt-6 group opacity-0 animate-fade-in-delayed">
    <div class="absolute -inset-1 bg-gradient-to-r from-amber-500 to-amber-600 rounded-lg blur opacity-0 group-hover:opacity-30 transition-all duration-300 group-hover:opacity-30"></div>
    <div class="relative">
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-amber-500 text-sm font-bold uppercase tracking-wider font-['Arial_Black']">
        <span class="relative">
          <span class="text-outline">Colmillo de Acero</span>
          <span class="absolute inset-0 text-transparent bg-clip-text bg-gradient-to-r from-amber-100 to-white animate-text-shimmer bg-[length:200%_auto] bg-clip-text animation-delay-200">
            Colmillo de Acero
          </span>
        </span>
      </span>
      
      <div class="absolute -bottom-2 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
    </div>
    
    <div class="absolute -bottom-3 left-1/2 w-16 h-1 bg-amber-400 transform -translate-x-1/2 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
  </div>
  
  <style>
    @keyframes fadeInDelayed {
      0% { opacity: 0; transform: translateY(5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-delayed {
      animation: fadeInDelayed 0.8s ease-out 0.3s forwards;
    }
    @keyframes text-shimmer {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .animate-text-shimmer {
      animation: text-shimmer 8s ease-in-out infinite;
    }
    .text-outline {
      -webkit-text-stroke: 1px rgba(245, 158, 11, 0.5);
      text-stroke: 1px rgba(245, 158, 11, 0.5);
    }
    .animation-delay-200 {
      animation-delay: 0.2s;
    }
  </style>
</section>
