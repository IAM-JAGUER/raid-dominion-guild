---
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/lib/ui/design';
---

<section class="flex flex-col justify-center items-center relative py-16">
  <!-- Lore Text -->
  <div class="text-center mt-8 mb-8 max-w-2xl px-4">
    <h1 class={`${ui.gradientTitle} ${ui.ornament} text-md md:text-lg font-black italic animate-fade-in-1`}>
      Addon de World of Warcraft 3.3.5a
    </h1>
  </div>

  <!-- Logo limpio: sin marco ni sombra -->
  <div class="relative mb-8 animate-fade-in-1" style="animation-delay: 0.3s">
    <img
      src="gallery/logo.png"
      alt="Raid Dominion"
      width="280"
      height="280"
      fetchpriority="high"
      class="relative"
    />
  </div>

  <!-- Call to Action — jerarquía: subir SV primario, descarga secundaria -->
  <div class="flex flex-col sm:flex-row items-center gap-4 mb-4 animate-fade-in-1" style="animation-delay: 0.6s">
    <div class="flex flex-col items-center gap-2">
      <a
        href="/upload"
        class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.lg}`}
      >
        <Icon name="subir" size="md" />
        Sube tu SavedVariables
      </a>
    </div>
    <a
      href="https://github.com/IAM-DEV88/RaidDominion/archive/refs/heads/main.zip"
      target="_blank"
      rel="noopener noreferrer"
      class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.lg}`}
    >
      <Icon name="descargar" size="md" />
      Descargar Ahora
    </a>
  </div>

  <!-- Franja de stats: cifras reales del producto (ui.statValue) -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 w-full max-w-3xl mx-auto px-4 mb-10 animate-fade-in-1" style="animation-delay: 0.7s">
    <div class="text-center">
      <p class={`${ui.statValue} text-2xl`}>3.3.5a</p>
      <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mt-1">cliente WoW</p>
    </div>
    <div class="text-center">
      <p class={`${ui.statValue} text-2xl`}>100%</p>
      <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mt-1">gratis</p>
    </div>
    <div class="text-center">
      <p class={`${ui.statValue} text-2xl`}>∞</p>
      <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mt-1">multiservidor</p>
    </div>
    <div class="text-center">
      <p class={`${ui.statValue} text-2xl`}>3</p>
      <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mt-1">pasos: registrar · subir · compartir</p>
    </div>
  </div>

  <!-- Inicio de sesión -->
  <div class="flex justify-center mb-12 animate-fade-in-1" style="animation-delay: 0.8s">
    <a
      href="/login"
      class={`border border-gray-700 ${ui.btnBase} ${ui.btnGhost} ${ui.btnSizes.md}`}
    >
      <Icon name="perfil-alt" size="md" />
      Iniciar Sesión
    </a>
  </div>

</section>
