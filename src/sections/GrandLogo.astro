---
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/lib/ui/design';
import { APP_URLS } from '@/utils/constants';
import StatCell from '@/components/ui/StatCell.astro';
---

<section class="flex flex-col justify-center items-center relative py-16">
  <!-- Placa de identidad: el título no se disuelve sobre la imagen -->
  <div class={`relative mt-8 mb-8 max-w-2xl px-6 py-5 text-center ${ui.plaque} animate-fade-in-1`}>
    <span class={ui.cardTop} aria-hidden="true"></span>
    <p class={ui.eyebrow}>Addon para World of Warcraft 3.3.5a (WotLK)</p>
    <h1 class={`${ui.gradientTitle} ${ui.ornament} mt-2 text-3xl md:text-4xl`}>
      RaidDominion: addon de bandas y hermandades
    </h1>
    <p class="font-editorial text-base text-gray-300 mt-3 max-w-lg mx-auto italic">
      Organiza roles, buffs, reglas y botín en tu banda. Sube el archivo del addon y publica el
      roster de tu hermandad en un portal web gratuito.
    </p>
  </div>

  <!-- Logo limpio: sin marco ni sombra -->
  <div class="relative mb-8 animate-fade-in-1" style="animation-delay: 0.3s">
    <img
      src="/logo.png"
      alt="RaidDominion, addon de bandas para World of Warcraft 3.3.5a"
      width="280"
      height="280"
      fetchpriority="high"
      class="relative"
    />
  </div>

  {/* Call to Action — jerarquía: subir archivo primario, descarga secundaria */}
  <div class="flex flex-col sm:flex-row items-center gap-4 mb-4 animate-fade-in-1" style="animation-delay: 0.6s">
    <div class="flex flex-col items-center gap-2">
      <a
        href="/upload"
        class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.lg}`}
      >
        <Icon name="subir" size="md" />
        Sube el archivo del addon
      </a>
    </div>
    <a
      href={APP_URLS.DOWNLOAD}
      target="_blank"
      rel="noopener noreferrer"
      class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.lg}`}
    >
      <Icon name="descargar" size="md" />
      Descargar Ahora
    </a>
  </div>

  <a href="#capturas" class={`${ui.btnBase} ${ui.btnGhost} ${ui.btnSizes.sm} mb-2`}>
    <Icon name="visibilidad" size="sm" />
    Ver el addon en acción
  </a>

  <!-- Cifras del producto en placa (ui.statBlock). El span cardTop vive FUERA
       de la tira: dentro seria el primer hijo del flex y los `first:`/`last:`
       del token no alcanzarian a las celdas. Celdas centradas (label y cifra):
       padding simetrico propio + text-center; hairline solo desde `sm` para
       que un wrap estrecho no deje un separador suelto al inicio de fila. -->
  <div class={`relative mx-4 max-w-2xl px-6 py-4 mb-10 animate-fade-in-1 ${ui.plaque} ${ui.tone.valor} ${ui.toneHead}`} style="animation-delay: 0.7s">
    <span class={`${ui.cardTop} ${ui.toneTop}`} aria-hidden="true"></span>
    <div class="flex items-center justify-center sm:gap-x-0 max-sm:grid max-sm:grid-cols-3 max-sm:gap-0 max-sm:[&>*]:border-l-0">
      <StatCell label="cliente" value="3.3.5a" cellCls="!px-2 sm:!px-4 text-center" valueCls={ui.toneTitle} />
      <StatCell label="gratis" value="100%" cellCls="!px-2 sm:!px-4 text-center" valueCls={ui.toneTitle} />
      <StatCell label="formularios" value="0" cellCls="!px-2 sm:!px-4 text-center" valueCls={ui.toneTitle} />
    </div>
  </div>

  <!-- Acceso secundario: el CTA principal es subir el archivo; login vive en la nav -->
  <p class="text-xs text-gray-300 mb-12 animate-fade-in-1" style="animation-delay: 0.8s">
    ¿Ya tienes cuenta?
    <a href="/login" class="text-valor-300 font-bold underline decoration-brand-600/60 underline-offset-2 hover:text-valor-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-sm">
      Inicia sesión
    </a>
  </p>

</section>
