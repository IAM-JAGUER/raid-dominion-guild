---
import { ui } from '@/lib/ui/design';
---

<section class="flex flex-col justify-center items-center relative py-16">
  <!-- Lore Text -->
  <div class="text-center mt-10 mb-8 max-w-2xl px-4">
    <p class="text-amber-400 text-xl md:text-2xl font-medium mb-6 italic animate-fade-in-1">
      "Raid Dominion — Macrea tus bandas rapido"
    </p>

      <!-- Indicadores vivos de comunidad -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-5 animate-fade-in-1" style="animation-delay: 0.15s">
        <a href="/guilds" class={`group ${ui.badge} backdrop-blur-sm hover:border-amber-400/60 hover:bg-amber-950/40 transition-all duration-300 hover:scale-105`}>
          <svg class="w-3.5 h-3.5 text-amber-300 group-hover:text-amber-200 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
          <span class="text-xs sm:text-sm text-gray-300"><span id="hero-guild-count" class="font-black text-amber-300">&ndash;</span> Hermandades</span>
        </a>
        <span class="text-amber-600/40 select-none" aria-hidden="true">&middot;</span>
        <a href="/personajes" class={`group ${ui.badge} backdrop-blur-sm hover:border-amber-400/60 hover:bg-amber-950/40 transition-all duration-300 hover:scale-105`}>
          <svg class="w-3.5 h-3.5 text-amber-300 group-hover:text-amber-200 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="text-xs sm:text-sm text-gray-300"><span id="hero-char-count" class="font-black text-amber-300">&ndash;</span> Personajes</span>
        </a>
      </div>
  </div>

  <!-- Logo -->
  <div class="relative mb-8 animate-fade-in-1" style="animation-delay: 0.3s">
    <img
      src="gallery/logo.png"
      alt="Raid Dominion"
      width="280"
      height="auto"
      class="drop-shadow-[0_0_15px_rgba(245,158,11,0.4)]"
    />
  </div>

  <!-- Call to Action — jerarquía: subir SV primario, descarga secundaria -->
  <div class="flex flex-col sm:flex-row items-center gap-4 mb-4 animate-fade-in-1" style="animation-delay: 0.6s">
    <div class="flex flex-col items-center gap-2">
      <a
        href="/upload"
        class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.lg}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        Sube tu SavedVariables
      </a>
      <p class="text-xs sm:text-sm text-gray-400">Descubre tu roster y reclama tu hermandad</p>
    </div>
    <a
      href="https://github.com/IAM-DEV88/RaidDominion/archive/refs/heads/main.zip"
      target="_blank"
      rel="noopener noreferrer"
      class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.lg}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
      Descargar Ahora
    </a>
  </div>

  <!-- Inicio de sesión -->
  <div class="flex justify-center mb-12 animate-fade-in-1" style="animation-delay: 0.8s">
    <a
      href="/login"
      class={`border border-gray-700 ${ui.btnBase} ${ui.btnGhost} ${ui.btnSizes.md}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      Iniciar Sesión
    </a>
  </div>
  
  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-1 {
      opacity: 0;
      animation: fadeIn 1s ease-out forwards;
    }

    @keyframes text-shimmer {
      0% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
      100% {
        background-position: 0% 50%;
      }
    }

    .animate-text-shimmer {
      animation: text-shimmer 8s ease-in-out infinite;
    }
    
    .text-outline {
      -webkit-text-stroke: 1px rgba(245, 158, 11, 0.5);
      text-stroke: 1px rgba(245, 158, 11, 0.5);
    }
    
    .animation-delay-200 {
      animation-delay: 0.2s;
    }
    
    /* Smooth scroll behavior */
    html {
      scroll-behavior: smooth;
    }
  </style>

<script>
  // Indicador compuesto por personajes VALIDADOS y hermandades públicas
  import('@/lib/supabase').then(async ({ supabase }) => {
    const { getPublicStats } = await import('@/lib/api');
    const stats = await getPublicStats();
    const g = document.getElementById('hero-guild-count');
    const c = document.getElementById('hero-char-count');
    if (g) g.textContent = String(stats.guilds);
    if (c) c.textContent = String(stats.characters);
  }).catch(() => {
    const g = document.getElementById('hero-guild-count');
    const c = document.getElementById('hero-char-count');
    if (g) g.textContent = '0';
    if (c) c.textContent = '0';
  });
</script>


</section>
