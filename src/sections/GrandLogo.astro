---
  ---

<section class="flex flex-col justify-center items-center relative">  
  <div class="relative mt-20 group animate-fade-in-delayed text-center">  
    <div class="relative mt-8 px-6 py-2 pb-2">
      <div class="relative mt-2 inline-block">
        <!-- Outline text -->
        <span class="text-outline text-white/90 text-lg sm:text-xl font-bold uppercase tracking-widest font-['Arial_Black']">
          <span class="relative inline-block">
            Hermandad
          </span>
        </span>
        <!-- Animated gradient overlay -->
        <span class="absolute inset-0 text-transparent bg-clip-text bg-gradient-to-r from-amber-100 via-amber-300 to-amber-100 bg-[length:200%_auto] animate-text-shimmer">
          <span class="relative inline-block">
            Hermandad
            <span aria-hidden class="inline-block mx-2">&bull;</span>
            Colmillo de Acero
          </span>
        </span>
      </div>
      
      <!-- Permanent underline -->
      <div class="absolute bottom-0 left-1/2 w-full h-[2px] bg-gradient-to-r from-transparent via-amber-400 to-transparent transform -translate-x-1/2"></div>
    </div>
  </div>
  <div class="relative">
    <img
      class="animate-slide-up-fade drop-shadow-[0_0_25px_rgba(245,158,11,0.5)]"
      src="gallery/lider.png"
      alt="Raid Dominion"
      width="450"
      height="auto"
    />
    <div class="absolute -inset-4 -z-10 bg-gradient-to-r from-amber-500/20 to-amber-600/20 rounded-full blur-xl opacity-70 animate-pulse"></div>
  </div>
  <style>
    @keyframes fadeInDelayed {
      0% { opacity: 0; transform: translateY(5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-delayed {
      animation: fadeInDelayed 0.8s ease-out 0.3s forwards;
    }
    @keyframes text-shimmer {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .animate-text-shimmer {
      animation: text-shimmer 8s ease-in-out infinite;
    }
    .text-outline {
      -webkit-text-stroke: 1px rgba(245, 158, 11, 0.5);
      text-stroke: 1px rgba(245, 158, 11, 0.5);
    }
    .animation-delay-200 {
      animation-delay: 0.2s;
    }
  </style>
</section>
