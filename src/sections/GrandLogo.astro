---
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/lib/ui/design';
import { APP_URLS } from '@/utils/constants';
---

<section class="flex flex-col justify-center items-center relative py-16">
  <!-- Placa de identidad: el título no se disuelve sobre la imagen -->
  <div class={`relative mt-8 mb-8 max-w-2xl px-6 py-5 text-center ${ui.plaque} animate-fade-in-1`}>
    <span class={ui.cardTop} aria-hidden="true"></span>
    <p class={ui.eyebrow}>Addon de World of Warcraft 3.3.5a</p>
    <h1 class={`${ui.gradientTitle} ${ui.ornament} mt-2 text-3xl md:text-4xl font-black italic`}>
      RaidDominion
    </h1>
  </div>

  <!-- Logo limpio: sin marco ni sombra -->
  <div class="relative mb-8 animate-fade-in-1" style="animation-delay: 0.3s">
    <img
      src="/logo.png"
      alt="Raid Dominion"
      width="280"
      height="280"
      fetchpriority="high"
      class="relative"
    />
  </div>

  <!-- Call to Action — jerarquía: subir SV primario, descarga secundaria -->
  <div class="flex flex-col sm:flex-row items-center gap-4 mb-4 animate-fade-in-1" style="animation-delay: 0.6s">
    <div class="flex flex-col items-center gap-2">
      <a
        href="/upload"
        class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.lg}`}
      >
        <Icon name="subir" size="md" />
        Sube tu SavedVariables
      </a>
    </div>
    <a
      href={APP_URLS.DOWNLOAD}
      target="_blank"
      rel="noopener noreferrer"
      class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.lg}`}
    >
      <Icon name="descargar" size="md" />
      Descargar Ahora
    </a>
  </div>

  <!-- Cifras del producto en placa (ui.statBlock) -->
  <div class={`relative flex flex-wrap justify-center items-center gap-x-6 gap-y-4 mx-4 px-6 py-4 mb-10 animate-fade-in-1 ${ui.plaque}`} style="animation-delay: 0.7s">
    <span class={ui.cardTop} aria-hidden="true"></span>
    <div class={ui.statBlock.cell}>
      <p class={ui.statBlock.label}>cliente WoW</p>
      <p class={`${ui.statValue} ${ui.statBlock.value}`}>3.3.5a</p>
    </div>
    <div class={ui.statBlock.cell}>
      <p class={ui.statBlock.label}>gratis</p>
      <p class={`${ui.statValue} ${ui.statBlock.value}`}>100%</p>
    </div>
    <div class={ui.statBlock.cell}>
      <p class={ui.statBlock.label}>multiservidor</p>
      <p class={`${ui.statValue} ${ui.statBlock.value}`}>∞</p>
    </div>
    <div class={ui.statBlock.cell}>
      <p class={ui.statBlock.label}>pasos: registrar · subir · compartir</p>
      <p class={`${ui.statValue} ${ui.statBlock.value}`}>3</p>
    </div>
  </div>

  <!-- Inicio de sesión -->
  <div class="flex justify-center mb-12 animate-fade-in-1" style="animation-delay: 0.8s">
    <a
      href="/login"
      class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.md}`}
    >
      <Icon name="perfil-alt" size="md" />
      Iniciar Sesión
    </a>
  </div>

</section>
