---
import ImageComponent from "@/components/shared/ImageComponent.astro";
import AddonGuidesGrid from "@/components/features/addon/AddonGuidesGrid.astro";
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import VideoEmbed from '@/components/shared/VideoEmbed.astro';
import { ui } from '@/lib/ui/design';
import { ADDON_VIDEO, APP_URLS } from '@/utils/constants';
---

<section id="addon" class="scroll-mt-16 py-8">
  <div class="w-full">
      <div class="w-full">
        <div class={`${ui.card} ${ui.cut} rounded-none relative overflow-hidden p-4 sm:p-6 md:p-8`}>
          <span class={ui.cardTop} aria-hidden="true"></span>
          <!-- Textura de la sección (addonBg): bajo el contenido y sobre la
               superficie de la card (rd-card aísla el contexto de apilado). -->
          <div
            class="absolute inset-0 -z-10 bg-cover bg-center opacity-[0.14]"
            style="background-image:url('/images/addonBg.jpg')"
            aria-hidden="true"
          >
          </div>
          <!-- Header with Logo -->
          <div class="text-center mb-10">
            <div class="mb-6">
              <ImageComponent classes="h-16 mx-auto drop-shadow-lg" imageName="logo.png" />
            </div>
            <SectionHeader title="Guía del Addon" />
          </div>

          <!-- Guías del Addon -->
          <AddonGuidesGrid />
          <div id="addon-video" class="mt-10 w-full max-w-lg mx-auto scroll-mt-16">
            <article class="animate-blurred-fade-in rounded-md overflow-hidden border border-brand-600/30 bg-gradient-to-br from-brand-900 to-brand-800">
              <!-- Header -->
              <div class="bg-gradient-to-r from-brand-600/80 to-brand-800/80 px-6 py-2">
                <h2 class="text-center text-sm font-bold text-white tracking-wider">
                  ADDON WOW 3.3.5A
                </h2>
              </div>

              <!-- Video del addon (se reproduce aquí mismo al hacer clic) -->
              <div class="p-3 sm:p-4">
                <VideoEmbed videoId={ADDON_VIDEO.id} title={ADDON_VIDEO.title} />
                <p class="mt-3 text-xs text-gray-400 text-center max-w-sm mx-auto italic">
                  Aprende a aprovechar al máximo el addon con nuestros tutoriales.
                </p>
                <p class="mt-1.5 text-center">
                  <a
                    href={APP_URLS.YOUTUBE}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[10px] font-black uppercase tracking-widest text-brand-300 hover:text-brand-200 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                  >
                    Ver más videos en YouTube →
                  </a>
                </p>
              </div>

              <!-- Discord Button -->
              <a
                href="https://discord.gg/BwdpNV9sky"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-center px-8 py-6 bg-gradient-to-br from-brand-800 to-brand-900 hover:from-brand-900/30 hover:to-brand-800/20 transition-all duration-300 border-t border-gray-700/50"
              >
                <div class="relative mr-3">
                  <div class="absolute -inset-1 bg-gradient-to-r from-brand-500 to-brand-600 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-200"></div>
                  <div class="relative p-3 bg-gradient-to-br from-brand-600 to-brand-700 rounded-full text-brand-950 group-hover:from-brand-700 group-hover:to-brand-800 transition-colors duration-300">
                    <Icon name="discord" size="lg" />
                  </div>
                </div>
                <div>
                  <span class="block text-lg font-semibold text-brand-300 group-hover:text-brand-200 transition-colors duration-300">Únete a Discord</span>
                  <span class="text-xs text-gray-400">Soporte y actualizaciones</span>
                </div>
              </a>
            </article>
          </div>
        </div>
      </div>
    </div>
</section>