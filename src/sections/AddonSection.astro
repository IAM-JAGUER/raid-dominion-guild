---
import ImageComponent from "@/components/shared/ImageComponent.astro";
import AddonGuidesGrid from "@/components/features/addon/AddonGuidesGrid.astro";
import SectionHeader from '@/components/ui/SectionHeader.astro';
import YoutubeIcon from "@/components/shared/icons/YoutubeIcon.astro";
import { ui } from '@/lib/ui/design';
---

<section id="addon" class="scroll-mt-16 py-8">
  <div class="w-full">
      <div class="w-full">
        <div class={`${ui.card} ${ui.cut} rounded-none relative overflow-hidden p-4 sm:p-6 md:p-8`}>
          <span class={ui.cardTop} aria-hidden="true"></span>
          <!-- Header with Logo -->
          <div class="text-center mb-10">
            <div class="mb-6">
              <ImageComponent classes="h-16 mx-auto drop-shadow-lg" imageName="logo.png" />
            </div>
            <SectionHeader title="Guía del Addon" />
          </div>

          <!-- Guías del Addon -->
          <AddonGuidesGrid />
          <div class="mt-10 w-full max-w-lg mx-auto">
            <article class="animate-blurred-fade-in rounded-md overflow-hidden border border-amber-600/30 bg-gradient-to-br from-gray-900 to-gray-800 transform transition-all duration-300 hover:scale-[1.01] hover:shadow-amber-500/20">
              <!-- Header -->
              <div class="bg-gradient-to-r from-amber-600/80 to-amber-800/80 px-6 py-2">
                <h2 class="text-center text-sm font-bold text-white tracking-wider">
                  ADDON WOW 3.3.5A
                </h2>
              </div>

              <!-- YouTube Button -->
              <a
                href="https://www.youtube.com/@IAM-GAMECODE"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center justify-center px-8 py-10 bg-gradient-to-br from-gray-800 to-gray-900 hover:from-amber-900/30 hover:to-amber-800/20 transition-all duration-300"
              >
                <div class="relative">
                  <div class="absolute -inset-1 bg-gradient-to-r from-amber-500 to-yellow-600 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-200"></div>
                  <div class="relative p-4 bg-gradient-to-br from-red-600 to-red-700 rounded-full text-white group-hover:from-red-700 group-hover:to-red-800 transition-colors duration-300">
                    <YoutubeIcon class="w-8 h-8" />
                  </div>
                </div>
                <span class="mt-4 text-lg font-semibold text-amber-300 group-hover:text-amber-200 transition-colors duration-300">
                  Tutorial en YouTube
                </span>
                <p class="mt-1 text-xs text-gray-400 text-center max-w-xs">
                  Aprende a aprovechar al máximo el addon con nuestros tutoriales
                </p>
              </a>

              <!-- Discord Button -->
              <a
                href="https://discord.gg/BwdpNV9sky"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-center px-8 py-6 bg-gradient-to-br from-gray-800 to-gray-900 hover:from-amber-900/30 hover:to-amber-800/20 transition-all duration-300 border-t border-gray-700/50"
              >
                <div class="relative mr-3">
                  <div class="absolute -inset-1 bg-gradient-to-r from-amber-500 to-yellow-600 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-200"></div>
                  <div class="relative p-3 bg-gradient-to-br from-amber-600 to-amber-700 rounded-full text-white group-hover:from-amber-700 group-hover:to-amber-800 transition-colors duration-300">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.8 8.18 1.8 12.062 0a.074.074 0 01.078.01c.12.098.246.192.373.292a.077.077 0 01-.006.127 12.3 12.3 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.84 19.84 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.95-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.951 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.951-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.951 2.418-2.157 2.418z"/>
                    </svg>
                  </div>
                </div>
                <div>
                  <span class="block text-lg font-semibold text-amber-300 group-hover:text-amber-200 transition-colors duration-300">Únete a Discord</span>
                  <span class="text-xs text-gray-400">Soporte y actualizaciones</span>
                </div>
              </a>
            </article>
          </div>
        </div>
      </div>
    </div>
</section>