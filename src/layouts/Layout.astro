---
import Footer from "@/sections/Footer.astro";
import ChatWidget from "@/components/features/ChatWidget.astro";
import ToastContainer from "@/components/ui/ToastContainer.astro";
import PageAtmosphere from "@/components/ui/PageAtmosphere.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { ParticleVariant } from "@/lib/ui/particles";
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  LOCALE,
  SITE_NAME,
  absoluteUrl,
  metaFor,
  normalizeRoute,
  robotsContent,
  type JsonLdNode,
} from "@/lib/seo";
import "@fontsource-variable/jost";
import "@/styles/material.css";
import "@/styles/icons.css";

interface Props {
  title: string;
  description?: string;
  // Canonical explícito para rutas estáticas. Si se omite, se usa la ruta
  // actual del build (Astro.url.pathname).
  canonicalPath?: string;
  // Shells con rewrite (/personaje/:slug, /hermandad/:slug…): el canonical
  // real se resuelve en cliente desde location.pathname; el HTML estático no
  // declara un canonical ajeno.
  autoCanonical?: boolean;
  // 404: no declara canonical (la URL solicitada es arbitraria y no indexable).
  omitCanonical?: boolean;
  image?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  jsonLd?: JsonLdNode | JsonLdNode[];
  // Atmósfera de la página (imagen + partículas). La fuente única
  // del markup/engine vive en PageAtmosphere + src/lib/ui/particles.ts.
  // El fondo es GameLoginBg en TODO el portal (default); las páginas solo
  // afinan `particles`/`veil`.
  background?: string;
  particles?: ParticleVariant;
  // Intensidad del velo oscuro sobre la imagen (0..1).
  veil?: number;
}

const {
  title,
  description = metaFor('/').description,
  canonicalPath,
  autoCanonical = false,
  omitCanonical = false,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
  jsonLd,
  background = '/images/GameLoginBg.jpg',
  particles,
  veil,
} = Astro.props;

const canonical =
  autoCanonical || omitCanonical
    ? null
    : absoluteUrl(normalizeRoute(canonicalPath ?? Astro.url.pathname));
const ogImage = absoluteUrl(image);
const robots = robotsContent(noindex);

// En dev el pipeline cliente no expone VITE_* en import.meta.env;
// se pasan por SSR al cliente vía window.__RD_ENV__ (ver src/lib/supabase.ts)
const rdEnvUrl = (import.meta.env.VITE_SUPABASE_URL as string | undefined) ?? "";
const rdEnvKey = (import.meta.env.VITE_SUPABASE_ANON_KEY as string | undefined) ?? "";
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- CSS crítico inline (is:inline = se emite crudo en el head, antes del
         bundle): pinta el fondo de vacío de inmediato y evita el flash
         blanco→negro en la 1ª carga y en cada navegación entre rutas. -->
    <style is:inline>
      html,
      body {
        background-color: #07111E;
        color-scheme: dark;
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#00BFFF" />

    {canonical && <link rel="canonical" href={canonical} />}
    {autoCanonical && (
      <script is:inline>
        (function () {
          var path = window.location.pathname.replace(/\/+$/, '') || '/';
          var url = window.location.origin + path;
          var canonical = document.querySelector('link[rel="canonical"]');
          if (!canonical) {
            canonical = document.createElement('link');
            canonical.rel = 'canonical';
            document.head.appendChild(canonical);
          }
          canonical.setAttribute('href', url);
          canonical.setAttribute('data-rd-auto-canonical', '');
          var ogUrl = document.querySelector('meta[property="og:url"]');
          if (!ogUrl) {
            ogUrl = document.createElement('meta');
            ogUrl.setAttribute('property', 'og:url');
            document.head.appendChild(ogUrl);
          }
          ogUrl.setAttribute('content', url);
        })();
      </script>
    )}

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!autoCanonical && canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={DEFAULT_OG_IMAGE_ALT} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={LOCALE} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={DEFAULT_OG_IMAGE_ALT} />

    <!-- Iconos -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />

    {jsonLd && <JsonLd data={jsonLd} />}

    <!-- Fondo de atmósfera precargado: queda decodificado antes del primer
         pintado (sin pop-in) y el encuadre `cover` no reajusta al aparecer. -->
    {background && <link rel="preload" as="image" href={background} fetchpriority="high" />}
    <!-- Registro de visitas (estilo guild-portal): beacon a /api/visit con la
         sección visitada. La visita jamás bloquea la navegación. -->
    <script is:inline>
      (function () {
        try {
          var host = window.location.hostname || "";
          if (!host || host === "localhost" || host === "127.0.0.1" || host === "::1" || host === "0.0.0.0") return;
          var p = window.location.pathname;
          if (!p || p.indexOf("/api") === 0 || p.indexOf("/_astro") === 0 || p.indexOf("/assets") === 0) return;

          var sid = null;
          try {
            sid = window.localStorage.getItem("rd_visitor_id");
            if (!sid) {
              sid =
                window.crypto && window.crypto.randomUUID
                  ? window.crypto.randomUUID()
                  : "v-" + Math.random().toString(36).slice(2) + Date.now().toString(36);
              window.localStorage.setItem("rd_visitor_id", sid);
            }
          } catch (e) {
            sid = null;
          }

          var section = "Otra sección";
          var paths = [
            [/^\/upload/, "Subir archivo del addon"],
            [/^\/hermandades/, "Directorio de hermandades"],
            [/^\/hermandad[\/?]?/, "Portal de hermandad"],
            [/^\/jugadores/, "Directorio de jugadores"],
            [/^\/jugador[\/?]?/, "Perfil de jugador"],
            [/^\/bandas/, "Directorio de bandas"],
            [/^\/banda[\/?]?/, "Ficha de banda"],
            [/^\/personajes/, "Directorio de personajes"],
            [/^\/personaje[\/?]?/, "Ficha de personaje"],
            [/^\/servidores/, "Directorio de servidores"],
            [/^\/servidor[\/?]?/, "Ficha de servidor"],
            [/^\/dashboard[\/?]?/, "Dashboard"],
            [/^\/login[\/?]?/, "Login"],
            [/^\/admin[\/?]?/, "Panel de admin"],
            [/^\/moderate[\/?]?/, "Moderación"],
            [/^\/?$/, "Portada"]
          ];
          for (var i = 0; i < paths.length; i++) {
            if (paths[i][0].test(p)) {
              section = paths[i][1];
              break;
            }
          }

          var data = { path: p, page: section, visitorId: sid };
          if (window.navigator && window.navigator.sendBeacon) {
            window.navigator.sendBeacon("/api/visit", new window.Blob([JSON.stringify(data)], { type: "application/json" }));
          } else {
            window.fetch("/api/visit", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data),
              keepalive: true
            });
          }
        } catch (e) {
          /* la visita jamás bloquea la navegación */
        }
      })();
    </script>
  </head>
  <body class="rd-bg relative flex flex-col min-h-[100dvh]">
    <script is:inline define:vars={{ rdEnvUrl, rdEnvKey }}>
      window.__RD_ENV__ = { url: rdEnvUrl || "", key: rdEnvKey || "" };
    </script>
    <!-- Contexto de apilado de la página (isolation): permite que la atmósfera
         (z -1) quede SOBRE el fondo del body (.rd-bg) y BAJO todo el contenido
         (contenido, footer, toasts). Sin este wrapper, el fondo del body —
         que está posicionado (relative) — taparía la capa de z negativo. -->
    <div class="relative isolate flex flex-col flex-1 w-full">
      <!-- Atmósfera de página (imagen + partículas), fija bajo el contenido -->
      {(background || particles) && (
        <PageAtmosphere
          variant={particles}
          image={background}
          veil={veil}
        />
      )}
      <!-- El contenedor del slot crece (flex-1) para que el Footer quede
           pegado abajo incluso en páginas con poco contenido. Es el ÚNICO
           contenedor de contenido: su padding horizontal replica el del nav
           superior (px-4 sm:px-6 lg:px-8) y los wrappers de cada página solo
           centran (max-w-* mx-auto) sin añadir padding propio. -->
      <div class="w-full flex-1 max-w-6xl px-4 sm:px-6 lg:px-8 mx-auto relative">
        <slot />
      </div>
      <!-- inserta el footer -->
      <Footer />
      <!-- Contenedor global de toasts (esquina inferior-izquierda, sobre el botón Guía RD) -->
      <ToastContainer />
      <!-- Guía flotante de RaidDominion (abajo-izquierda), disponible en todas las páginas -->
      <ChatWidget />
    </div>
    <script>
      // Revelado canónico del contenido async (contrato y motor en
      // src/lib/ui/reveal.ts): bloques `data-rd-reveal`, grillas
      // `data-rd-reveal-cards` y paneles `[role="tabpanel"]` entran con
      // fundido en cuanto están disponibles.
      import { observeReveals } from '@/lib/ui/reveal';

      observeReveals();
    </script>
  </body>
</html>

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  html {
    font-family: "Jost Variable", system-ui, sans-serif;
    background-color: var(--bg-void);
    overflow-x: hidden;
    /* Reserva siempre el canal del scrollbar: el ancho útil no cambia al
       aparecer la barra y el fondo `cover` de la atmósfera no reencuadra. */
    scrollbar-gutter: stable;
    /* Sin anclaje automático de scroll: cuando el layout se asienta después
       de cargar (imagen del logo, swap de la fuente Jost), Chrome compensaba
       moviendo el scroll hacia abajo al recargar con la página arriba.
       El desplazamiento debe ser SIEMPRE del usuario (frallas.md F019). */
    overflow-anchor: none;
    animation: fadeIn 1.5s ease-in-out;
  }

  /* Enlaces por defecto heredan el color ámbar de marca y el foco ceremonial */
  a {
    color: inherit;
  }

  ::selection {
    background: rgba(0, 191, 255, 0.3);
    color: #fff;
  }
</style>
