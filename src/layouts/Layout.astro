---
import Footer from "@/sections/Footer.astro";
import "@fontsource-variable/jost";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// En dev el pipeline cliente no expone VITE_* en import.meta.env;
// se pasan por SSR al cliente vía window.__RD_ENV__ (ver src/lib/supabase.ts)
const rdEnvUrl = (import.meta.env.VITE_SUPABASE_URL as string | undefined) ?? "";
const rdEnvKey = (import.meta.env.VITE_SUPABASE_ANON_KEY as string | undefined) ?? "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={description ?? "Addon para World of Warcraft 3.3.5a para liderar bandas. Compacto y fácil de usar."}
    />
    <meta
      name="keywords"
      content="comunidad, raid, dominion, tools, addon, world, warcraft, 3.3.5a, macro, ayuda, compacto, fácil"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Andrés Muñoz" />
    <meta name="language" content="es" />
    <meta name="revisit-after" content="7 days" />
    <link rel="canonical" href="https://raid-dominion.netlify.app/" />
    <!-- Open Graph Meta Tags -->
    <meta
      property="og:title"
      content="Comunidad Raid Dominion"
    />
    <meta
      property="og:description"
      content="Addon para World of Warcraft 3.3.5a para liderar bandas. Compacto y fácil de usar."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://raid-dominion.netlify.app/" />
    <meta
      property="og:image"
      content="https://raid-dominion.netlify.app/logo.png"
    />
    <meta
      property="og:site_name"
      content="Comunidad Raid Dominion"
    />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Comunidad Raid Dominion"
    />
    <meta
      name="twitter:description"
      content="Addon para World of Warcraft 3.3.5a para liderar bandas. Compacto y fácil de usar."
    />
    <meta
      name="twitter:image"
      content="https://raid-dominion.netlify.app/logo.png"
    />
    <!-- <meta name="twitter:site" content="@tu_usuario" /> -->

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title}</title>
  </head>
  <body class="relative flex flex-col min-h-[100dvh]">
    <script define:vars={{ rdEnvUrl, rdEnvKey }}>
      window.__RD_ENV__ = { url: rdEnvUrl || "", key: rdEnvKey || "" };
    </script>
    <!-- El contenedor del slot crece (flex-1) para que el Footer quede
         pegado abajo incluso en páginas con poco contenido. Es el ÚNICO
         contenedor de contenido: su padding horizontal replica el del nav
         superior (px-4 sm:px-6 lg:px-8) y los wrappers de cada página solo
         centran (max-w-* mx-auto) sin añadir padding propio. -->
    <div class="w-full flex-1 max-w-6xl px-4 sm:px-6 lg:px-8 mx-auto relative">
      <slot />
    </div>
    <div
      style="position:fixed;"
      class="bg-gradient-to-b from-.2% from-[rgba(255,255,255,.01)] from-15% to-[rgba(17,17,17,1)] w-[100vw] h-[100vh] inset-x-0 top-[0px] z-[-2]"
    >
    </div>
    <!-- inserta el footer -->
    <Footer />
  </body>
</html>

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  html {
    font-family: "Jost Variable", system-ui, sans-serif;
    background:
      url("/background.png") no-repeat,
      #111;
    overflow-x: hidden;
    background-size: 100vw 100vh;
    background-attachment: fixed;
    background-position: center top;
    animation: fadeIn 1.5s ease-in-out;
  }

  @media (max-width: 640px) {  /* xm breakpoint */
    html {
      background-size: auto 100vh;
    }
  }
</style>
