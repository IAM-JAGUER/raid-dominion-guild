---
export interface Props {
  imageName: string;
  classes?: string;
  altText?: string;
  width?: number;
  height?: number;
}

const { imageName, classes = "", altText = "", width, height } = Astro.props;

---

<img 
  src={`/gallery/${imageName}`} 
  class={classes} 
  alt={altText}
  width={width}
  height={height}
  loading="lazy"
  decoding="async"
/>