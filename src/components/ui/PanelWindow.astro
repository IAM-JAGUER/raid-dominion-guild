---
// Ventana de panel (modelo dashboard): cabecera contigua (sectionHead + cutTop)
// + cuerpo (sectionBody). ÚNICA fuente del patrón de cabecera de panel — antes
// duplicado como literal en 27 lugares (ver AGENTS.sections/pagina-map.md §2).
//
// La cabecera lleva el medallón de punto ámbar + título; los controles de la
// cabecera (disclosure de filtros, buscador, selector) van en el slot `head`.
// El contenido principal va en el slot por defecto.
interface Props {
  id?: string;
  title: string;
  // Icono temático de la cabecera (contrato src/lib/ui/icons.ts). Si no se
  // pasa, la cabecera conserva el punto ámbar clásico.
  icon?: IconName;
  // Padding del cuerpo/cabecera: md = denso (default, dashboard/listas),
  // lg = protagonista (fichas/póster, design.md §12).
  pad?: 'md' | 'lg';
  // Clases del h2. Default: patrón de dashboard/vistas (gradiente de marca).
  titleCls?: string;
  // Clases extra del contenedor del body (p. ej. `space-y-5`).
  bodyCls?: string;
  // Clases extra del contenedor de la cabecera (p. ej. ids de toggle).
  headCls?: string;
  // Oculto inicialmente (id de toggle JS).
  hidden?: boolean;
  // Añade ui.gradientTitle al título (default true; hermandad usa solid).
  gradient?: boolean;
  // Tono ceremonial de la cabecera (paleta v2). `steel` = marca.
  tone?: Tone;
  // Contenedor exterior: clases extra (p. ej. `space-y-6`, `pt-6`) y ARIA.
  wrapCls?: string;
  role?: 'tabpanel';
  ariaLabelledby?: string;
}

const {
  id,
  title,
  icon,
  pad = 'md',
  titleCls = 'text-lg font-bold flex items-center',
  bodyCls = '',
  headCls = '',
  hidden = false,
  gradient = true,
  tone = 'steel',
  wrapCls = '',
  role,
  ariaLabelledby,
} = Astro.props;

import { ui, type Tone } from '@/lib/ui/design';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/ui/icons';

const isTone = tone !== 'steel';
const toneCls = ui.tone[tone];
const h2Cls = `${gradient ? `${titleCls} ${ui.gradientTitle}` : titleCls} pb-[0.1em]${isTone ? ` ${ui.toneTitle}` : ''}`;
const wrapClsFull = `${hidden ? 'hidden ' : ''}${toneCls} ${wrapCls}`.trim();
const padCls = ui.panelPad[pad];
---
<div id={id} class={wrapClsFull} role={role} aria-labelledby={ariaLabelledby}>
  <div class={`${ui.sectionHead} ${ui.cutTop} ${padCls} bg-gradient-to-br from-brand-900/20 to-transparent ${isTone ? ui.toneHead : ''} ${headCls}`}>
    {isTone && <span class={ui.toneRail} aria-hidden="true"></span>}
    <h2 class={h2Cls}>
      {icon ? (
        isTone ? (
          <span class={`mr-2.5 inline-flex items-center justify-center rounded-md border p-1.5 ${ui.toneIcon}`}>
            <Icon name={icon} size="lg" />
          </span>
        ) : (
          <Icon name={icon} size="lg" class="mr-2.5" />
        )
      ) : (
        <span class={`w-2 h-2 rounded-full mr-3 ${isTone ? 'rd-tone-dot' : 'bg-brand-500 shadow-[0_0_8px_rgba(0,191,255,0.5)]'}`}></span>
      )}
      {title}
    </h2>
    <slot name="head" />
  </div>
  <div class={`${ui.sectionBody} ${padCls} ${isTone ? ui.toneBody : ''} ${bodyCls}`}>
    <slot />
  </div>
</div>