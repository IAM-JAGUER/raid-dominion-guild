---
// Estado vacío reutilizable (directorios, fichas y paneles del dashboard):
// medallón de icono + eyebrow + título + mensaje + CTA, con variantes
// `window`/`panel`/`plain` y cuerpo libre vía slot. ÚNICA fuente del patrón
// empty (antes 7 bloques casi idénticos — ver AGENTS.sections/pagina-map.md
// §2).
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  // Clases del título. Default: blanco en itálico (dashboard) — los
  // directorios pasan el gradiente.
  titleCls?: string;
  message?: string;
  // CTA opcional (label + href).
  cta?: { label: string; href: string } | null;
  // Clases extra del CTA (p. ej. `transform hover:scale-105`).
  ctaCls?: string;
  // Alineación del contenido del head: 'center' (directorios) | 'start'.
  align?: 'center' | 'start';
  // Alineación del body (text-center por defecto; 'start' para cuerpos libres).
  bodyAlign?: 'center' | 'start';
  // Añade ui.gradientTitle al título (default true; dashboard usa sólido).
  gradient?: boolean;
  // Icono por catálogo temático (contrato único src/lib/ui/icons.ts).
  icon?: IconName;
  // Oculto inicialmente (id de toggle JS).
  hidden?: boolean;
  // Clases extra del contenedor (p. ej. `mb-6`).
  cls?: string;
  // `window`: cabecera + cuerpo (dashboard y estados de página). `panel`:
  // tarjeta simple dentro de un panel (estados vacíos del portal de
  // hermandad). `plain`: sin superficie propia, para vivir DENTRO de una
  // ficha que ya aporta el marco (cuerpo hundido de la ficha de directorio).
  variant?: 'window' | 'panel' | 'plain';
  // Padding del variant `panel`.
  pad?: 'md' | 'lg';
  // Corte diagonal sup-izq en el variant `panel`.
  cut?: boolean;
  // Clases del mensaje en el variant `panel`.
  messageCls?: string;
}

const {
  id,
  eyebrow,
  title,
  titleCls = 'font-black italic text-white',
  message,
  cta = null,
  ctaCls = '',
  align = 'start',
  bodyAlign = 'center',
  gradient = true,
  icon = 'personaje',
  hidden = false,
  cls = '',
  variant = 'window',
  pad = 'md',
  cut = false,
  messageCls = `${ui.text.bodyMuted} italic`,
} = Astro.props;

import { ui } from '@/lib/ui/design';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/ui/icons';

const titleTextCls = gradient ? `${titleCls} ${ui.gradientTitle}` : titleCls;
const isPanel = variant === 'panel';
const isPlain = variant === 'plain';
const wrapCls = isPanel
  ? `${hidden ? 'hidden ' : ''}${ui.panel}${cut ? ` ${ui.cut}` : ''} relative overflow-hidden ${pad === 'lg' ? 'p-6 sm:p-8' : 'p-6'} text-center ${cls}`.trim()
  : isPlain
    ? `${hidden ? 'hidden ' : ''}max-w-2xl mx-auto text-center ${cls}`.trim()
    : `${hidden ? 'hidden ' : ''}max-w-2xl mx-auto ${cls}`.trim();
const headCls = align === 'center' ? 'flex items-center justify-center gap-3' : 'flex items-center gap-3';
---
<div id={id} data-rd-reveal data-rd-list-empty class={wrapCls}>
  {isPanel || isPlain ? (
    <>
      <div class={`${ui.iconTile} ${ui.iconTileLg} mx-auto mb-4`} aria-hidden="true">
        <Icon name={icon} size="xl" />
      </div>
      <p class={`${titleTextCls} mb-1`}>{title}</p>
      {message && <p class={messageCls}>{message}</p>}
      {cta && <a href={cta.href} class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest mt-6 ${ctaCls}`}>{cta.label}</a>}
      <slot name="body" />
    </>
  ) : (
    <>
      <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-brand-900/20 to-transparent`}>
        <div class={headCls}>
          <div class={`${ui.iconTile} ${ui.iconTileLg}`}>
            <Icon name={icon} size="xl" />
          </div>
          <div class="min-w-0">
            {eyebrow && <p class={`${ui.eyebrow} mb-1`}>{eyebrow}</p>}
            <h2 class={`${titleTextCls} text-base`}>{title}</h2>
          </div>
        </div>
      </div>
      <div class={`${ui.sectionBody} ${bodyAlign === 'center' ? 'text-center' : ''}`}>
        <slot name="body">
          {message && <p class="text-sm text-gray-300 max-w-md mx-auto mb-6">{message}</p>}
          {cta && <a href={cta.href} class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest ${ctaCls}`}>{cta.label}</a>}
        </slot>
      </div>
    </>
  )}
</div>