---
// Estado vacío reutilizable (patrón de directorios y paneles del dashboard):
// medallón de icono + eyebrow + título + mensaje + CTA, con variante de
// cuerpo libre vía slot. ÚNICA fuente del patrón empty (antes 7 bloques
// casi idénticos — ver AGENTS.sections/pagina-map.md §2).
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  // Clases del título. Default: blanco en itálico (dashboard) — los
  // directorios pasan el gradiente.
  titleCls?: string;
  message?: string;
  // CTA opcional (label + href).
  cta?: { label: string; href: string } | null;
  // Clases extra del CTA (p. ej. `transform hover:scale-105`).
  ctaCls?: string;
  // Alineación del contenido del head: 'center' (directorios) | 'start'.
  align?: 'center' | 'start';
  // Alineación del body (text-center por defecto; 'start' para cuerpos libres).
  bodyAlign?: 'center' | 'start';
  // Añade ui.gradientTitle al título (default true; dashboard usa sólido).
  gradient?: boolean;
  // Icono por catálogo temático (contrato único src/lib/ui/icons.ts).
  icon?: IconName;
  // Oculto inicialmente (id de toggle JS).
  hidden?: boolean;
  // Clases extra del contenedor (p. ej. `mb-6`).
  cls?: string;
}

const {
  id,
  eyebrow,
  title,
  titleCls = 'font-black italic text-white',
  message,
  cta = null,
  ctaCls = '',
  align = 'start',
  bodyAlign = 'center',
  gradient = true,
  icon = 'personaje',
  hidden = false,
  cls = '',
} = Astro.props;

import { ui } from '@/lib/ui/design';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/ui/icons';

const titleTextCls = gradient ? `${titleCls} ${ui.gradientTitle}` : titleCls;
const wrapCls = `${hidden ? 'hidden ' : ''}max-w-2xl mx-auto ${cls}`.trim();
const headCls = align === 'center' ? 'flex items-center justify-center gap-3' : 'flex items-center gap-3';
---
<div id={id} data-rd-reveal data-rd-list-empty class={wrapCls}>
  <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-brand-900/20 to-transparent`}>
    <div class={headCls}>
      <div class={`${ui.iconTile} ${ui.iconTileLg}`}>
        <Icon name={icon} size="xl" />
      </div>
      <div class="min-w-0">
        <p class={`${ui.eyebrow} mb-1`}>{eyebrow}</p>
        <p class={`${titleTextCls} text-base`}>{title}</p>
      </div>
    </div>
  </div>
  <div class={`${ui.sectionBody} ${bodyAlign === 'center' ? 'text-center' : ''}`}>
    <slot name="body">
      {message && <p class="text-sm text-gray-400 max-w-md mx-auto mb-6">{message}</p>}
      {cta && <a href={cta.href} class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest ${ctaCls}`}>{cta.label}</a>}
    </slot>
  </div>
</div>