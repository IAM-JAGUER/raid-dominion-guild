---
// Estado vacío reutilizable (patrón de directorios y paneles del dashboard):
// medallón de icono + eyebrow + título + mensaje + CTA, con variante de
// cuerpo libre vía slot. ÚNICA fuente del patrón empty (antes 7 bloques
// casi idénticos — ver AGENTS.sections/pagina-map.md §2).
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  // Clases del título. Default: blanco en itálico (dashboard) — los
  // directorios pasan el gradiente.
  titleCls?: string;
  message?: string;
  // CTA opcional (label + href).
  cta?: { label: string; href: string } | null;
  // Clases extra del CTA (p. ej. `transform hover:scale-105`).
  ctaCls?: string;
  // Alineación del contenido del head: 'center' (directorios) | 'start'.
  align?: 'center' | 'start';
  // Alineación del body (text-center por defecto; 'start' para cuerpos libres).
  bodyAlign?: 'center' | 'start';
  // Añade ui.gradientTitle al título (default true; dashboard usa sólido).
  gradient?: boolean;
  // Icono por catálogo (no se pasan paths SVG sueltos).
  icon?: 'server' | 'user' | 'group' | 'building' | 'upload' | 'code';
  // Oculto inicialmente (id de toggle JS).
  hidden?: boolean;
  // Clases extra del contenedor (p. ej. `mb-6`).
  cls?: string;
}

const {
  id,
  eyebrow,
  title,
  titleCls = 'font-black italic text-white',
  message,
  cta = null,
  ctaCls = '',
  align = 'start',
  bodyAlign = 'center',
  gradient = true,
  icon = 'user',
  hidden = false,
  cls = '',
} = Astro.props;

import { ui } from '@/lib/ui/design';

const titleTextCls = gradient ? `${titleCls} ${ui.gradientTitle}` : titleCls;

const ICONS: Record<string, string> = {
  server:
    'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
  user: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  group:
    'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  building:
    'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  upload:
    'M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12',
  code: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
};
const iconPath = ICONS[icon] ?? ICONS.user;
const wrapCls = `${hidden ? 'hidden ' : ''}max-w-2xl mx-auto ${cls}`.trim();
const headCls = align === 'center' ? 'flex items-center justify-center gap-3' : 'flex items-center gap-3';
---
<div id={id} class={wrapCls}>
  <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}>
    <div class={headCls}>
      <div class={`${ui.iconTile} w-12 h-12 shrink-0`}>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} /></svg>
      </div>
      <div class="min-w-0">
        <p class={`${ui.eyebrow} mb-1`}>{eyebrow}</p>
        <p class={`${titleTextCls} text-base`}>{title}</p>
      </div>
    </div>
  </div>
  <div class={`${ui.sectionBody} ${bodyAlign === 'center' ? 'text-center' : ''}`}>
    <slot name="body">
      {message && <p class="text-sm text-gray-400 max-w-md mx-auto mb-6">{message}</p>}
      {cta && <a href={cta.href} class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest ${ctaCls}`}>{cta.label}</a>}
    </slot>
  </div>
</div>