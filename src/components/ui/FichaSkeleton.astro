---
// Esqueleto de una ficha: separador central + separador izquierdo + barra de
// pestañas + contenido + separador de cierre. Fuente única del ritmo que
// antes se repetía en servidor, reino, banda, personaje y jugador.
import { ui } from '@/lib/ui/design';

interface Props {
  // Barra de pestañas (se omite en fichas sin tabs o con dock propio).
  showBar?: boolean;
  barId?: string;
  barLabel?: string;
  barHidden?: boolean;
  // Clases extra de la barra (p. ej. animate-fade-in-1).
  barCls?: string;
  // Envoltorio opcional alrededor de la barra (portal de hermandad).
  barWrapId?: string;
  barWrapHidden?: boolean;
  barWrapCls?: string;
  // Separador izquierdo de respaldo.
  showLeftSep?: boolean;
  leftSepId?: string;
  leftSepHidden?: boolean;
  leftSepCls?: string;
}

const {
  showBar = true,
  barId = '',
  barLabel = '',
  barHidden = false,
  barCls = '',
  barWrapId,
  barWrapHidden = false,
  barWrapCls = '',
  showLeftSep = true,
  leftSepId,
  leftSepHidden = false,
  leftSepCls = 'mt-8 mb-10',
} = Astro.props;

const leftSep = [
  leftSepHidden ? 'hidden' : '',
  ui.dividerFadeRight,
  leftSepCls,
].filter(Boolean).join(' ');
const bar = [
  barHidden ? 'hidden' : '',
  ui.zone.tabBar,
  'mt-8',
  ui.zone.tabs,
  barCls,
].filter(Boolean).join(' ');
const barWrap = [barWrapHidden ? 'hidden' : '', barWrapCls].filter(Boolean).join(' ');
---

<div class={`${ui.dividerFadeBoth} mt-6`} aria-hidden="true"></div>
{showLeftSep && <div id={leftSepId} class={leftSep} aria-hidden="true"></div>}
{showBar && (
  barWrapId ? (
    <div id={barWrapId} class={barWrap}>
      <nav id={barId} role="tablist" aria-label={barLabel} class={bar}></nav>
    </div>
  ) : (
    <nav id={barId} role="tablist" aria-label={barLabel} class={bar}></nav>
  )
)}
<slot />
<div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
