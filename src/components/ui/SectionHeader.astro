---
// Componente SectionHeader
// Muestra un título de sección con estilos consistentes (tokens de src/lib/ui/design.ts)
import { ui, type Tone } from '@/lib/ui/design';

export interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  // Tono ceremonial del título/ornamento (paleta v2). `steel` = marca.
  tone?: Tone;
}

const { 
  title, 
  subtitle = '', 
  align = 'center',
  tone = 'steel',
} = Astro.props;

const textAlign = {
  'left': 'text-left',
  'center': 'text-center',
  'right': 'text-right'
}[align];
---

<div class={`${tone === 'steel' ? '' : ui.tone[tone]} ${textAlign} mb-8`}>
  <h2 class={`${ui.sectionTitle} ${ui.gradientTitle} ${ui.ornament} mb-2${tone === 'steel' ? '' : ` ${ui.toneTitle}`}`}>
    {title}
  </h2>
  {subtitle && (
    <p class="font-editorial text-base text-gray-300 italic max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
</div>
