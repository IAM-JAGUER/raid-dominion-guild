---
// Componente SectionHeader
// Muestra un título de sección con estilos consistentes (tokens de src/lib/ui/design.ts)
import { ui } from '@/lib/ui/design';

export interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
}

const { 
  title, 
  subtitle = '', 
  align = 'center' 
} = Astro.props;

const textAlign = {
  'left': 'text-left',
  'center': 'text-center',
  'right': 'text-right'
}[align];
---

<div class={`${textAlign} mb-8`}>
  <h2 class={`${ui.sectionTitle} mb-2`}>
    {title}
  </h2>
  {subtitle && (
    <p class="text-gray-300 max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
  <div class="w-24 h-1 bg-amber-500 mt-4 mx-auto"></div>
</div>
