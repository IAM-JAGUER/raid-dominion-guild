---
const { title, icon } = Astro.props;
---

<div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 rounded-xl overflow-hidden border border-amber-600/30 p-6 h-full transition-transform hover:scale-105">
  {icon && (
    <div class="text-amber-400 text-3xl mb-3">
      {icon}
    </div>
  )}
  <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
  <p class="text-gray-300">
    <slot />
  </p>
</div>
