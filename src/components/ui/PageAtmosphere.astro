---
// Capa atmosférica de página: imagen de fondo + velo de contraste + partículas.
// Única fuente del markup de la atmósfera; Layout la monta con props opcionales
// (`background`, `particles`) y DetailShell las reenvía para las fichas.
import type { ParticleVariant } from '@/lib/ui/particles';

interface Props {
  variant?: ParticleVariant;
  image?: string;
  // Intensidad del velo oscuro (0..1); más alto = fondo más tenue.
  veil?: number;
}

const { variant = 'arcane', image, veil = 0.9 } = Astro.props;
---

<div class="rd-atmosphere" aria-hidden="true">
  {
    image && (
      <div
        class="rd-atmosphere__image"
        style={`background-image:url('${image}')`}
      />
    )
  }
  <div class="rd-atmosphere__veil" style={`--rd-veil:${veil}`}></div>
  <canvas class="rd-atmosphere__canvas" data-rd-particles data-variant={variant}></canvas>
</div>

<script>
  import { autoMountParticleFields } from '@/lib/ui/particles';

  autoMountParticleFields();
</script>
