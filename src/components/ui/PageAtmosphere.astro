---
// Capa atmosférica de página: imagen de fondo + velo de contraste + partículas.
// Única fuente del markup de la atmósfera; Layout la monta con props opcionales
// (`background`, `particles`) y DetailShell las reenvía para las fichas.
import type { ParticleVariant } from '@/lib/ui/particles';

interface Props {
  variant?: ParticleVariant;
  image?: string;
  // Intensidad del velo oscuro (0..1); más alto = fondo más tenue.
  // Única capa permitida sobre el fondo (design.md §3b): 0.3 por defecto
  // para que la imagen a opacidad plena no compita con el texto.
  veil?: number;
}

const { variant = 'arcane', image, veil = 0.3 } = Astro.props;
---

<div class="rd-atmosphere" aria-hidden="true">
  {
    image && (
      <div
        class="rd-atmosphere__image"
        style={`background-image:url('${image}')`}
      />
    )
  }
  {
    /* El velo SOLO existe como atenuación de una imagen de fondo: sin imagen
       (páginas con partículas y `.rd-bg` liso) no se monta capa extra. */
    image && (
      <div class="rd-atmosphere__veil" style={`--rd-veil:${veil}`} />
    )
  }
  <canvas class="rd-atmosphere__canvas" data-rd-particles data-variant={variant}></canvas>
</div>

<script>
  import { autoMountParticleFields } from '@/lib/ui/particles';

  autoMountParticleFields();

  // El fondo se sincroniza por JS con el tamaño de la capa y una transición
  // corta (ver `[data-fit]` en material.css): un cambio de viewport reencuadra
  // suave, sin salto. El motor de partículas conserva su campo por su cuenta.
  const image = document.querySelector<HTMLElement>('.rd-atmosphere__image');
  if (image) {
    const fit = (): void => {
      const layer = image.parentElement;
      if (!layer) return;
      image.dataset.fit = '';
      image.style.width = `${layer.clientWidth}px`;
      image.style.height = `${layer.clientHeight}px`;
    };
    fit();
    window.addEventListener('resize', fit);
  }
</script>
