---
// Grid de guías del addon con lector interno.
// La guía activa se muestra en la parte SUPERIOR (antes de la lista de guías),
// sin recargar página. Se navega internamente vía accordion.
import { guides, colorClasses } from '@/data/addonGuides';
import { ui } from '@/lib/ui/design';

// Lista blanca EXACTA de comandos del addon (verificados en addonGuides.ts),
// más largos primero para que /rd no tape a /rdloot.
const KBD_COMMANDS = ['/rdloot', '/rdc', '/rdh', '/rd'] as const;

// Escape HTML antes de cualquier set:html (los datos traen '>' literal, p. ej. "Bandas > Gestor").
function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// Patrón único con lookahead: evita coincidir un prefijo de otro comando (/rdX inexistente).
const KBD_PATTERN = new RegExp(KBD_COMMANDS.map((cmd) => `${cmd}(?!\\w)`).join('|'), 'g');

// Sintaxis [texto](destino) para enlaces internos dentro del contenido.
const LINK_PATTERN = /\[([^\]]+)\]\(([^)\s]+)\)/g;

// Solo destinos internos seguros: rutas relativas (sin esquema, sin //) y
// anclas propias #guide-<id>. Cualquier otro destino queda como texto plano.
function isSafeInternal(dest: string): boolean {
  if (dest.startsWith('#guide-')) return /^#guide-[a-z0-9-]+$/.test(dest);
  if (!dest.startsWith('/') || dest.startsWith('//')) return false;
  return /^\/[a-z0-9/_-]+$/.test(dest) && !dest.includes('@') && !dest.includes(':');
}

const linkClass =
  'text-amber-300 font-bold underline decoration-amber-600/60 underline-offset-2 hover:text-amber-200 hover:decoration-amber-400 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400';

// Escapa la línea, convierte enlaces internos [texto](destino) y envuelve los
// comandos de la lista blanca en <code> estilo kbd.
function renderLine(line: string): string {
  const withLinks = escapeHtml(line).replace(LINK_PATTERN, (match, text, dest) => {
    if (!isSafeInternal(dest)) return match;
    return `<a href="${dest}" class="${linkClass}">${text}</a>`;
  });
  return withLinks.replace(KBD_PATTERN, (match) => `<code class="${ui.kbd}">${match}</code>`);
}

// Botones prev/next del pie de cada panel (estilo consistente con ui.btnGhost).
const navBtn = `${ui.btnBase} ${ui.btnGhost} ${ui.btnSizes.sm} border border-transparent w-full truncate`;
---

<div class="mt-8" id="addon-guides">
  <p class="text-gray-400 text-sm text-center mb-8 italic">
    Aprende a usar RaidDominion: menú flotante, bandas, botín, spammers y comandos.
  </p>

  <!-- Lector interno: la guía activa se muestra ARRIBA, antes de la lista -->
  <div class="mb-10 space-y-6">
    {guides.map((guide, index) => {
      const c = colorClasses[guide.color] || colorClasses.amber;
      return (
        <section
          id={`guide-panel-${guide.id}`}
          class={`guide-panel hidden ${ui.panel} overflow-hidden`}
          data-guide-index={index}
        >
          <!-- Header del panel -->
          <div class="px-6 py-5 bg-gradient-to-r from-gray-900/80 to-gray-800/40 border-b border-amber-600/30 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class={`p-2.5 rounded-md ${c.iconBg} border ${c.iconBorder} w-fit`}>
                <span class="text-xl">{guide.icon}</span>
              </div>
              <div>
                <h4 class="text-xl font-bold text-amber-300">
                  <span class="text-amber-400/90 font-black tabular-nums mr-1">{index + 1}.</span>{guide.title}
                </h4>
                <span class={`${ui.chip} ${c.iconBg} ${c.iconBorder} ${c.iconText}`}>
                  {guide.category}
                </span>
              </div>
            </div>
            <button
              type="button"
              class="guide-close px-4 py-2 rounded-md bg-gray-800/80 border border-amber-600/30 text-amber-200 hover:bg-amber-900/40 hover:text-white transition-all text-xs font-black uppercase tracking-widest focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
              data-guide-index={index}
            >
              ✕ Cerrar
            </button>
          </div>

          <!-- Contenido (accordion de secciones) -->
          <div class="p-2 sm:p-6">
            <p class="text-gray-400 text-sm italic mb-6">{guide.description}</p>
            <div class="space-y-4">
              {guide.sections.map((section, sIdx) => (
                <details
                  class="group bg-gray-800/50 border border-amber-600/30 rounded-md overflow-hidden"
                  open
                >
                  <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between text-amber-200 font-bold text-sm hover:bg-amber-900/10 group-open:bg-amber-900/20 border-l-2 border-l-amber-500/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400 transition-all">
                    <span class="inline-flex items-baseline gap-2">
                      <span class="text-amber-400 font-black tabular-nums">{sIdx + 1}.</span>
                      <span>{section.title}</span>
                    </span>
                    <svg class="w-4 h-4 text-amber-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-5 pb-4">
                    <ul class="space-y-3">
                      {section.content.map((line) => (
                        <li class="flex items-start text-sm text-gray-300 font-medium leading-relaxed">
                          <span class="text-amber-600 mr-2 mt-0.5">›</span>
                          <span set:html={renderLine(line)} />
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              ))}
            </div>

            <!-- Micro-CTA común a todos los paneles -->
            <div class="mt-6 pt-4 border-t border-amber-600/20 flex flex-wrap items-center justify-between gap-2">
              <p class="text-xs text-gray-400">¿Ya usas el addon? Sube tu RaidDominion.lua.</p>
              <a href="/upload" class={`${ui.btnBase} ${ui.btnGhost} ${ui.btnSizes.sm} border border-transparent`}>Subir SavedVariables</a>
            </div>

            <!-- Navegación anterior/siguiente entre guías -->
            <nav class="mt-4 pt-4 border-t border-amber-600/20 grid grid-cols-2 gap-3" aria-label="Navegar entre guías">
              <div class="min-w-0">
                {index > 0 ? (
                  <button
                    type="button"
                    class={`guide-prev ${navBtn}`}
                    data-guide-index={index - 1}
                    aria-label={`Guía anterior: ${guides[index - 1].title}`}
                  >
                    <span aria-hidden="true">←</span>
                    <span class="text-amber-400/90 font-black tabular-nums">{index}.</span>
                    <span class="truncate">{guides[index - 1].title}</span>
                  </button>
                ) : null}
              </div>
              <div class="min-w-0">
                {index < guides.length - 1 ? (
                  <button
                    type="button"
                    class={`guide-next ${navBtn}`}
                    data-guide-index={index + 1}
                    aria-label={`Guía siguiente: ${guides[index + 1].title}`}
                  >
                    <span class="text-amber-400/90 font-black tabular-nums">{index + 2}.</span>
                    <span class="truncate">{guides[index + 1].title}</span>
                    <span aria-hidden="true">→</span>
                  </button>
                ) : null}
              </div>
            </nav>
          </div>
        </section>
      );
    })}
  </div>

  <!-- Grid de guías (cards → abren el lector interno arriba) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {guides.map((guide, index) => {
      const c = colorClasses[guide.color] || colorClasses.amber;
      return (
        <button
          type="button"
          class={`addon-guide-card relative group ${ui.panel} p-5 transition-all duration-300 hover:border-amber-500/50 hover:shadow-amber-500/10 hover:-translate-y-1 overflow-hidden text-left cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400`}
          data-guide-index={index}
          aria-expanded="false"
          aria-controls={`guide-panel-${guide.id}`}
        >
          <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
          <div class="relative z-10 flex flex-col h-full">
            <div class="flex items-center justify-between mb-3">
              <div class={`p-2.5 rounded-md ${c.iconBg} border ${c.iconBorder} w-fit`}>
                <span class="text-lg">{guide.icon}</span>
              </div>
              <span class={`${ui.chip} ${c.iconBg} ${c.iconBorder} ${c.iconText}`}>
                {guide.category}
              </span>
            </div>
            <h4 class="text-base font-bold text-white mb-2 group-hover:text-amber-400 transition-colors leading-tight">
              <span class="text-amber-400/90 font-black tabular-nums mr-1">{index + 1}.</span>{guide.title}
            </h4>
            <p class="text-gray-400 text-xs leading-relaxed mb-4 flex-grow italic">
              {guide.description}
            </p>
            <div class="pt-3 border-t border-amber-600/20">
              <span class={`text-[10px] font-black uppercase tracking-widest ${c.btnText}`}>
                <span class="card-cta-idle">Leer Guía →</span>
                <span class="card-cta-activa">Leyendo…</span>
              </span>
            </div>
          </div>
        </button>
      );
    })}
  </div>
</div>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.addon-guide-card'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.guide-panel'));

  function closeAll(): void {
    panels.forEach((p) => {
      p.classList.add('hidden');
    });
    cards.forEach((card) => card.setAttribute('aria-expanded', 'false'));
  }

  function openGuide(index: number): void {
    closeAll();
    const panel = panels[index];
    if (!panel) return;
    panel.classList.remove('hidden');
    const card = cards[index];
    if (card) card.setAttribute('aria-expanded', 'true');
    // El panel está arriba; hacer scroll al inicio de la sección de guías
    const container = document.getElementById('addon-guides');
    if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  cards.forEach((card, i) => {
    card.addEventListener('click', () => openGuide(i));
  });

  // Navegación anterior/siguiente del pie de panel (reutiliza openGuide,
  // que ya hace scroll al contenedor #addon-guides).
  document.querySelectorAll<HTMLElement>('.guide-prev, .guide-next').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = Number(btn.getAttribute('data-guide-index'));
      if (!Number.isNaN(target)) openGuide(target);
    });
  });

  document.querySelectorAll<HTMLElement>('.guide-close').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAll();
      const card = cards[Number(btn.getAttribute('data-guide-index'))];
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  // Soporte a #guide-<id> para abrir directo desde un enlace.
  // El deep-link público es #guide-<id> pero el panel vive como
  // #guide-panel-<id>, así que resolvemos el id real quitando el prefijo.
  const openByGuideId = (id: string): void => {
    if (!id.startsWith('guide-')) return;
    const slug = id.slice('guide-'.length);
    const panel = document.getElementById(`guide-panel-${slug}`);
    if (!panel) return;
    const idx = Number(panel.getAttribute('data-guide-index'));
    if (!Number.isNaN(idx)) openGuide(idx);
  };
  const onHash = (): void => {
    openByGuideId(window.location.hash.replace(/^#/, ''));
  };
  window.addEventListener('hashchange', onHash);
  onHash();

  // Clic en un enlace interno [texto](#guide-<id>): abre el panel sin
  // recargar (misma lógica que onHash) y refleja el hash en la URL.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#guide-"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href') ?? '';
      const id = href.replace(/^#/, '');
      if (!id.startsWith('guide-')) return;
      e.preventDefault();
      openByGuideId(id);
      if (window.location.hash !== href) history.replaceState(null, '', href);
    });
  });
</script>

<style>
  .bg-grid-pattern {
    background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
    background-size: 20px 20px;
  }

  /* Ocultar el marcador por defecto de <summary> */
  .guide-panel summary::-webkit-details-marker {
    display: none;
  }

  /* Card activa ↔ lector: el script existente alterna aria-expanded y el CSS
     refleja el estado sin JS adicional. display:none oculta el texto inactivo
     también del árbol de accesibilidad (una sola etiqueta leída por AT). */
  .addon-guide-card .card-cta-activa {
    display: none;
  }

  .addon-guide-card[aria-expanded='true'] {
    border-color: rgba(245, 158, 11, 0.7);
    box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.35);
  }

  .addon-guide-card[aria-expanded='true'] .card-cta-idle {
    display: none;
  }

  .addon-guide-card[aria-expanded='true'] .card-cta-activa {
    display: inline;
  }
</style>