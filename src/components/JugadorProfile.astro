---
import Breadcrumb from '@/components/Breadcrumb.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/lib/ui/design';
---

<main class="relative py-16">
  <div class="max-w-6xl mx-auto">
    <Breadcrumb />

    <!-- Cargando -->
    <LoadingBlock id="loading" text="Cargando perfil…" />

    <!-- No encontrado -->
    <div id="not-found" data-rd-reveal class={`hidden ${ui.card} relative overflow-hidden p-8 sm:p-10 text-center`}>
      <span class={ui.cardTop} aria-hidden="true"></span>
      <div class={`${ui.iconTile} ${ui.iconTileLg} mx-auto mb-4`}>
        <Icon name="advertencia" size="xl" />
      </div>
      <h2 id="not-found-title" class={`${ui.text.h1} text-white mb-2`}>Perfil no encontrado</h2>
      <p id="not-found-msg" class={`${ui.text.bodyMuted} max-w-md mx-auto`}>Este perfil no existe, es privado o cambió su enlace.</p>
      <a id="not-found-cta" href="/jugadores" class={`${ui.btnBase} ${ui.btnPrimary} inline-block mt-5 px-6 py-2.5 text-xs font-black uppercase tracking-widest`}>Ver jugadores</a>
    </div>

    <!-- Ficha del personaje -->
    <div id="profile" data-rd-reveal class="hidden space-y-10">
      <header class={`animate-fade-in-1 ${ui.zone.hero}`}>
        <div class={`${ui.plaque} p-5 sm:p-7`}>
          <span class={ui.cardTop} aria-hidden="true"></span>
          <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8">
            <!-- Medallón héroe: arte nativo del sprite con halo del color de
                 clase del personaje principal. La clase va en su chip con la
                 miniatura JPG a 20px (el asset es de 18px). -->
            <div id="avatar" class={`${ui.iconTile} rd-medallion-hero ${ui.iconTileHero}`}>
              <Icon name="personaje" size="hero" />
            </div>
            <div class="flex-1 min-w-0 text-left">
              <p class={`${ui.eyebrow} mb-2`}>Jugador</p>
              <h1 id="display-name" class={`${ui.titleFicha} break-words ${ui.gradientTitle}`}></h1>
              <div id="chips" class="flex flex-wrap justify-start gap-2 mt-4"></div>
              <div class="flex flex-wrap justify-start gap-2 mt-3">
                <span id="role-badge" class={`hidden ${ui.badge} ${ui.badgeMd} bg-gradient-to-b from-fuchsia-950/60 to-fuchsia-950/25 border-fuchsia-500/40 text-fuchsia-300`}><Icon name="estrella" size="sm" class="self-center" />Maestro de hermandad</span>
              </div>
              <p id="profile-ref" class="hidden text-sm text-gray-400 mt-3"></p>
              <!-- Contexto del jugador (servidor/reino): cierra la zona de
                   identidad, con contenedor real (antes tira fantasma al final). -->
              <div id="jugador-context" class="hidden flex flex-wrap gap-2 mt-3"></div>
            </div>
          </div>
        </div>
      </header>

      <!-- Navegación entre paneles (modelo dashboard): solo las secciones con
           contenido generan pestaña (initAvailableTabs). -->
      <nav id="profile-tab-bar" role="tablist" aria-label="Secciones del perfil" class={`hidden flex flex-nowrap items-center gap-1 rd-tabbar relative ${ui.zone.tabs} animate-fade-in-1 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden`}></nav>

      <!-- Paneles ventana (modelo dashboard): Personajes, Bandas, Hermandades -->
      <div id="profile-panels" class={ui.zone.body}>
        <PanelWindow id="panel-personajes" title="Personajes" icon="personaje" role="tabpanel" ariaLabelledby="tab-personajes" hidden>
          <h3 id="main-title" class={ui.subTitle}></h3>
          <div id="main-card"></div>
          <div id="characters-section" data-rd-reveal class="hidden">
            <h3 class={`${ui.subTitle} mb-2`}>Otros personajes de la cuenta</h3>
            <div id="characters-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div>
          </div>
        </PanelWindow>

        <PanelWindow id="panel-bandas" title="Bandas" icon="espadas" role="tabpanel" ariaLabelledby="tab-bandas" hidden>
          <div slot="head">
            <!-- Barra de filtros estándar (buscador + chips de día) del motor
                 src/lib/ui/filterBar.ts, vía el modelo renderBandasPanel. -->
            <div class="mt-4" id="bandas-filtro" data-rd-reveal-cards></div>
          </div>
          <div id="bandas-content" class="space-y-8"></div>
        </PanelWindow>

        <PanelWindow id="panel-hermandades" title="Hermandades" icon="hermandad" role="tabpanel" ariaLabelledby="tab-hermandades" hidden>
          <div id="hermandades-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div>
        </PanelWindow>
      </div>

      <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
    </div>

  </div>
</main>

<script>
  import { supabase } from '@/lib/supabase';
  import { getPublicProfileBySlug, getPublicGuildsForPlayer, getPublicCharactersByUser, getPublicBandsForCharacter, ensureMyCharacterSlugs, type PublicBandSummary } from '@/lib/api';
  import { slugify, RESERVED } from '@/lib/routes';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { safePlayerName } from '@/lib/ui/playerNames';
  import type { CharacterRow } from '@/lib/api';
  import type { ProfileRow } from '@/types/database';
  import { ui } from '@/lib/ui/design';
  import { card, cardTop, iconTileEl } from '@/lib/ui/card';
  import { el, chip, iconChip, statChip, setBreadcrumb } from '@/lib/ui/dom';
  import { iconEl } from '@/lib/ui/icons';
  import { classColor } from '@/lib/ui/classColors';
  import { renderCharacterCard, renderGuildCard, renderBandCard } from '@/lib/ui/cards';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';
  import { resolveBandOwners, type OwnerRef } from '@/lib/bandListing';
  import { JUGADOR_TABS, initAvailableTabs } from '@/lib/ui/tabs';

  // Perfil público de jugador (/jugador/:slug): única ruta canónica. El shell
  // (jugador.astro) se sirve por rewrite en prod (/jugador/* → /jugador) y el
  // navegador conserva la URL real; en dev el middleware pasa ?slug=.
  function isProfileRoute(): boolean {
    const seg = window.location.pathname.split('/').filter(Boolean);
    return seg[0] === 'jugador';
  }

  function currentSlug(): string {
    const override = new URLSearchParams(window.location.search).get('slug');
    if (override) return override;
    const seg = window.location.pathname.split('/').filter(Boolean);
    return seg.length === 2 && seg[0] === 'jugador' ? seg[1] : '';
  }

  function showNotFound(): void {
    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('not-found')?.classList.remove('hidden');
    (document.getElementById('not-found-title') as HTMLElement).textContent = 'Perfil no encontrado';
    (document.getElementById('not-found-msg') as HTMLElement).textContent = 'Este perfil no existe, es privado o cambió su enlace.';
    const cta = document.getElementById('not-found-cta') as HTMLAnchorElement;
    cta.href = '/jugadores';
    cta.textContent = 'Ver jugadores';
    document.title = 'Perfil no encontrado - RaidDominion';
  }

  const isProfile = isProfileRoute() || !!new URLSearchParams(window.location.search).get('slug');
  const slug = currentSlug();
  if (!slug || !isProfile || RESERVED.has(slug.toLowerCase())) {
    showNotFound();
  } else {
    void resolveProfile(slug);
  }

  // Perfil público de jugador (/jugador/:slug): muestra la información del
  // personajes públicos de la cuenta. NO redirige a la ficha de un personaje.
  async function resolveProfile(profileSlug: string): Promise<void> {
    const res = await getPublicProfileBySlug(profileSlug);
    if (!res.ok || !res.profile) {
      showNotFound();
      return;
    }
    const p = res.profile;

    // El perfil es visible aunque la cuenta aún no tenga personajes públicos
    // (la visibilidad del perfil es independiente de la de personajes).
    const charsRes = await getPublicCharactersByUser(p.id);
    if (!charsRes.ok || !charsRes.items) {
      showNotFound();
      return;
    }
    await renderProfile(p, charsRes.items);
  }

  // Vista de perfil: cabecera del jugador + personaje principal destacado y
  // el resto de personajes públicos de su cuenta.
  async function renderProfile(p: ProfileRow, chars: CharacterRow[]): Promise<void> {
    // El personaje principal SOLO es el declarado (character_name). Con el
    // principal en "Ninguno" no se toma ningún personaje público como tal:
    // la identidad cae al handle estable @hex del perfil.
    const mainName = (p.character_name ?? '').trim().toLowerCase();
    const main = mainName ? chars.find((c) => c.name.toLowerCase() === mainName) : undefined;

    // Nombre visible seguro: nunca expone un principal declarado que no sea
    // público (los `chars` ya son solo personajes públicos).
    const publicNames = new Set(chars.map((c) => c.name.toLowerCase()));
    const displayName = safePlayerName(p, { publicNames, fallbackName: main?.name });
    document.title = `${displayName} - RaidDominion`;
    setBreadcrumb(displayName);

    // Halo del medallón héroe con el color de clase del personaje principal.
    const avatar = document.getElementById('avatar') as HTMLElement;
    const tint = classColor(main?.class ?? chars[0]?.class, main?.class_file ?? chars[0]?.class_file);
    if (tint) {
      avatar.style.setProperty('--rd-hero-tint', tint);
      avatar.style.borderColor = tint;
    }
    (document.getElementById('display-name') as HTMLElement).textContent = displayName;

    const chipsEl = document.getElementById('chips') as HTMLElement;
    const ctxEl = document.getElementById('jugador-context') as HTMLElement;
    if (main) {
      // Servidor/reino viven en la tira de contexto al final del contenido,
      // no en el encabezado; los chips de clase/cifras/hermandad sí quedan
      // junto al nombre.
      ctxEl.appendChild(serverRealmLinks(main));
      chipsEl.appendChild(characterChips(main));
    }
    if (p.realm && !main?.realm) ctxEl.appendChild(chip(p.realm, '', 'md'));
    if (ctxEl.children.length > 0) ctxEl.classList.remove('hidden');

    // La insignia de maestro solo aplica si hay un personaje maestro PÚBLICO
    // (los `chars` ya son solo personajes públicos de la cuenta). La tarjeta
    // de hermandad vive en el panel "Hermandades" (renderPlayerGuilds).
    if (p.role === 'guild_master' && chars.some((c) => c.sv_is_gm)) {
      document.getElementById('role-badge')?.classList.remove('hidden');
    }

    const mainCard = document.getElementById('main-card') as HTMLElement;
    const mainTitle = document.getElementById('main-title') as HTMLElement;
    // Modelo de card compacta de UNA SOLA LÍNEA (mismo lenguaje que el core
    // de banda): ícono + nombre (-reino) y, a la derecha, Nivel/ilvl + el
    // indicador "Ver ficha →". renderCharacterCard ya enlaza a /personaje/:slug
    // (o /jugador/:slug si el personaje no es público pero el perfil sí).
    const profiles = new Map<string, { slug: string | null; display_name: string | null; character_name: string | null }>();
    profiles.set(p.id, { slug: p.slug, display_name: p.display_name, character_name: p.character_name });
    if (main) {
      // El principal entra al mismo grid 3-col responsive que el resto de
      // personajes (cards compactas de una sola línea).
      const grid = el('div', 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3');
      grid.appendChild(renderCharacterCard(main, { profiles }));
      mainCard.appendChild(grid);
      mainTitle.textContent = 'Personaje principal';
      void renderAccountCharacters(p.id, main.id, profiles);
    } else if (chars.length > 0) {
      // Sin principal fijado ("Ninguno"): todos los personajes públicos se
      // muestran en igualdad, sin destacar a ninguno como "el principal".
      const grid = el('div', 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3');
      chars.forEach((c) => grid.appendChild(renderCharacterCard(c, { profiles })));
      mainCard.appendChild(grid);
      mainTitle.textContent = 'Personajes';
    } else {
      // Perfil público sin personajes publicados: ficha vacía informativa.
      const emptyCard = card('p-6 sm:p-8 text-center');
      emptyCard.appendChild(cardTop());
      emptyCard.appendChild(el('p', 'text-sm text-gray-400 italic', 'Este jugador aún no publica personajes.'));
      mainCard.appendChild(emptyCard);
      mainTitle.textContent = 'Personajes';
    }
    const available: string[] = ['personajes'];

    await renderPlayerBands(chars, available);
    await renderPlayerGuilds(p.id, available);
    initAvailableTabs({ barId: 'profile-tab-bar', tabs: JUGADOR_TABS, available });

    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('profile')?.classList.remove('hidden');
  }

  // Panel "Bandas": agrega las bandas públicas de TODOS los personajes de la
  // cuenta (dedupe por nombre|horario) → /banda/:slug cuando existe slug. La
  // pestaña solo se genera si hay bandas (available). Usa el modelo compartido
  // /bandas (renderBandasPanel): filtro por día + día/hora agrupados 3×responsive.
  async function renderPlayerBands(chars: CharacterRow[], available: string[]): Promise<void> {
    const seen = new Set<string>();
    const unique: PublicBandSummary[] = [];
    for (const c of chars) {
      const res = await getPublicBandsForCharacter(c.name);
      (res.ok ? (res.bands ?? []) : []).forEach((b) => {
        // Dedupe por identidad nombre|horario (no solo por nombre): un jugador
        // puede pertenecer a DOS bandas con el mismo nombre en horarios
        // distintos y ambas deben listarse.
        const key = `${b.name.trim().toLowerCase()}|${(b.schedule ?? '').trim().toLowerCase()}`;
        if (seen.has(key)) return;
        seen.add(key);
        unique.push(b);
      });
    }
    if (unique.length > 0) {
      // Atribución: la card estándar del directorio /bandas identifica a quién
      // pertenece cada banda (hermandad o jugador).
      const owners = await resolveBandOwners(unique.map((b) => ({ guild_id: b.guildId ?? null, owner_id: b.ownerId ?? '' })));
      renderBandasPanel({
        filtro: document.getElementById('bandas-filtro') as HTMLElement,
        content: document.getElementById('bandas-content') as HTMLElement,
        items: unique,
        getSchedule: (b: PublicBandSummary) => b.schedule ?? null,
        // Búsqueda por nombre de banda / jugador (este perfil) / personaje /
        // hermandad dueña.
        getSearchText: (b: PublicBandSummary) => [
          b.name,
          b.role ?? '',
          owners.get((b.guildId || b.ownerId) ?? '')?.label,
          chars.map((c) => c.name).join(' '),
        ].filter(Boolean).join(' '),
        renderCard: (b: PublicBandSummary) => bandRow(b, owners.get((b.guildId || b.ownerId) ?? '')),
      });
      available.push('bandas');
    }
  }

  // Panel "Hermandades": hermandades públicas donde el jugador es maestro.
  async function renderPlayerGuilds(ownerId: string, available: string[]): Promise<void> {
    const res = await getPublicGuildsForPlayer(ownerId);
    const list = document.getElementById('hermandades-list') as HTMLElement;
    // Card estándar del directorio /hermandades (renderGuildCard).
    (res.ok ? (res.guilds ?? []) : []).forEach((g) => list.appendChild(renderGuildCard(g)));
    if (list.children.length > 0) available.push('hermandades');
  }

  function bandRow(b: PublicBandSummary, owner?: OwnerRef): HTMLElement {
    // Card de banda con el modelo estándar del directorio /bandas (renderBandCard);
    // identifica a quién se atribuye la banda y si está integrada a una hermandad.
    if (b.slug) {
      return renderBandCard({ slug: b.slug, name: b.name, schedule: b.schedule ?? null, min_gs: b.minGS ?? null, guildId: b.guildId ?? null }, { integrated: b.integrated, owner });
    }
    // Sin slug: card no enlazable con el mismo modelo visual.
    const cardEl = card('p-5');
    cardEl.appendChild(cardTop());
    const head = el('div', 'flex items-center gap-3 mb-3');
    head.appendChild(iconTileEl('espadas'));
    head.appendChild(el('h3', 'font-black italic text-base leading-[1.3] text-white', b.name));
    cardEl.appendChild(head);
    const parts: string[] = [];
    if (b.schedule) parts.push(b.schedule);
    if (typeof b.minGS === 'number' && b.minGS > 0) parts.push(`GS ${b.minGS}`);
    if (parts.length > 0) {
      const chips = el('div', 'flex flex-wrap gap-1.5');
      parts.forEach((p) => chips.appendChild(el('span', `${ui.badge} ${ui.badgeSm} bg-brand-800/60 border-brand-600/20 text-gray-300`, p)));
      cardEl.appendChild(chips);
    }
    cardEl.appendChild(el('p', 'text-xs text-gray-400 mt-4', 'Ver banda →'));
    return cardEl;
  }

  // Chips del encabezado (junto al nombre visible): clase/cifras/hermandad.
  function characterChips(c: CharacterRow): HTMLElement {
    const row = el('div', 'flex flex-wrap gap-1.5');
    if (c.class) {
      // Chip de clase con la miniatura JPG a 20px (el asset es de 18px:
      // nítido a este tamaño; el chip nombra la clase → imagen decorativa).
      const clsChip = chip(c.class, '', 'md');
      const clsImg = classIconEl(c.class, c.class_file, 'w-5 h-5 rounded-[3px] border border-brand-600/30 object-cover shrink-0');
      clsImg.alt = '';
      clsChip.insertBefore(clsImg, clsChip.firstChild);
      row.appendChild(clsChip);
    }
    if (typeof c.level === 'number') row.appendChild(statChip('Nivel', String(c.level)));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) {
      const il = statChip('ilvl', String(c.avg_ilvl));
      il.classList.add('!text-brand-300', '!border-brand-500/40');
      row.appendChild(il);
    }
    if (c.member_verified) {
      const v = iconChip('validado', 'Validado', '', 'md');
      v.classList.add('!text-emerald-300', '!border-emerald-600/40');
      row.appendChild(v);
    }
    if (c.sv_guild_name) {
      const gchip = iconChip(
        c.sv_is_gm ? 'estrella' : 'hermandad',
        c.sv_is_gm ? `${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}`,
        '',
        'md'
      );
      gchip.classList.add(
        c.sv_is_gm ? '!text-fuchsia-300' : '!text-brand-200',
        c.sv_is_gm ? '!border-fuchsia-500/40' : '!border-brand-600/30'
      );
      row.appendChild(gchip);
    }
    return row;
  }

  // Enlaces de contexto: servidor (realmlist) y reino → jerarquía del directorio.
  function serverRealmLinks(c: CharacterRow): HTMLElement {
    const row = el('div', 'flex flex-wrap gap-2');
    if (c.server) {
      const s = document.createElement('a');
      s.href = `/servidor/${encodeURIComponent(c.server)}`;
      s.className = `${ui.badge} ${ui.badgeMd} text-brand-200 bg-brand-950/70 border-brand-600/40 hover:bg-brand-900/50 hover:border-brand-500/60 transition-all`;
      s.appendChild(iconEl('servidor', { size: 'sm', cls: 'shrink-0' }));
      s.appendChild(document.createTextNode(c.server));
      row.appendChild(s);
    }
    if (c.realm) {
      const r = document.createElement(c.server ? 'a' : 'span');
      const cls = `${ui.badge} ${ui.badgeMd} text-gray-300 bg-brand-950/70 border-brand-600/25`;
      if (c.server) {
        (r as HTMLAnchorElement).href = `/servidor/${encodeURIComponent(c.server)}/reino/${encodeURIComponent(slugify(c.realm))}`;
        r.className = `${cls} hover:bg-brand-900/50 hover:border-brand-500/60 transition-all`;
      } else {
        r.className = cls;
      }
      r.appendChild(iconEl('vientos', { size: 'sm', cls: 'shrink-0' }));
      r.appendChild(document.createTextNode(c.realm));
      row.appendChild(r);
    }
    return row;
  }

  async function renderAccountCharacters(userId: string, currentCharId: string, profiles: Map<string, { slug: string | null; display_name: string | null; character_name: string | null }>): Promise<void> {
    const res = await getPublicCharactersByUser(userId);
    if (!res.ok || !res.items || res.items.length === 0) return;

    const chars = res.items;

    // Slugs para enlazar a /personaje/<slug>: los propios (con sesión) se
    // generan/recuperan vía RPC; el resto viaja ya en la fila pública.
    const slugMap = new Map<string, string>();
    chars.forEach((c) => { if (c.slug) slugMap.set(c.id, c.slug); });
    const session = await supabase.auth.getSession();
    if (session.data.session?.user) {
      const ensure = await ensureMyCharacterSlugs();
      if (ensure.ok && ensure.slugs) {
        ensure.slugs.forEach((s) => slugMap.set(s.id, s.slug));
      }
    }

    const others = chars.filter((c) => c.id !== currentCharId);
    if (others.length === 0) return;

    // Cards compactas de una sola línea (renderCharacterCard ya enlaza).
    const grid = document.getElementById('characters-grid') as HTMLElement;
    others.forEach((c) => {
      if (slugMap.has(c.id)) c.slug = slugMap.get(c.id)!;
      grid.appendChild(renderCharacterCard(c, { profiles }));
    });
    if (grid.children.length > 0) {
      document.getElementById('characters-section')?.classList.remove('hidden');
    }
  }
</script>