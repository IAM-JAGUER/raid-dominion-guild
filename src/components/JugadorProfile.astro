---
import Breadcrumb from '@/components/Breadcrumb.astro';
---

<main class="relative py-16">
  <div class="max-w-6xl mx-auto px-4">
    <Breadcrumb />

    <!-- Cargando -->
    <div id="loading" class="text-center py-20">
      <div class="inline-block w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-sm text-gray-400 italic mt-4">Cargando personaje…</p>
    </div>

    <!-- No encontrado -->
    <div id="not-found" class="hidden bg-gray-900/60 border border-red-900/40 rounded-lg p-10 text-center">
      <svg class="w-10 h-10 text-red-400/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <h1 id="not-found-title" class="text-xl font-bold text-white mb-2">Personaje no encontrado</h1>
      <p id="not-found-msg" class="text-sm text-gray-400 max-w-md mx-auto">Este personaje no existe, es privado o cambió su enlace.</p>
      <a id="not-found-cta" href="/personajes" class="inline-block mt-5 px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105">Ver personajes</a>
    </div>

    <!-- Ficha del personaje -->
    <div id="profile" class="hidden space-y-10">
      <header class="bg-gradient-to-br from-gray-900/80 to-gray-800/50 border border-amber-600/25 rounded-lg p-8 animate-fade-in-1">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
          <div id="avatar" class="w-20 h-20 rounded-lg bg-gradient-to-br from-amber-600/25 to-amber-800/25 border border-amber-600/30 flex items-center justify-center text-4xl font-black italic text-amber-300 shadow-lg shrink-0"></div>
          <div class="flex-1 min-w-0 text-center sm:text-left">
            <h1 id="display-name" class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wide break-words"></h1>
            <div id="chips" class="flex flex-wrap justify-center sm:justify-start gap-2 mt-3"></div>
            <div class="flex flex-wrap justify-center sm:justify-start gap-2 mt-3">
              <span id="role-badge" class="hidden inline-flex items-center px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest border bg-fuchsia-950/40 border-fuchsia-500/40 text-fuchsia-300">★ Maestro de hermandad</span>
              <a id="guild-card" href="#" class="hidden inline-flex items-center px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest border bg-sky-950/40 border-sky-600/30 text-sky-200 hover:bg-sky-900/40 transition-all">
                <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
                <span id="guild-card-name"></span>
              </a>
            </div>
            <p id="profile-ref" class="hidden text-xs text-gray-500 mt-2"></p>
          </div>
        </div>
      </header>

      <!-- Ficha del personaje consultado -->
      <section id="main-section" class="hidden">
        <h2 class="text-lg font-bold text-amber-200 mb-4 flex items-center">
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Ficha del personaje
        </h2>
        <div id="main-card"></div>
      </section>

      <!-- Otros personajes de la cuenta -->
      <section id="characters-section" class="hidden">
        <h2 class="text-lg font-bold text-amber-200 mb-4 flex items-center">
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Otros personajes de la cuenta
        </h2>
        <div id="characters-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
      </section>
    </div>

  </div>
</main>

<script>
  import { supabase } from '@/lib/supabase';
  import { getPublicCharacterBySlug, getPublicProfileBySlug, getPublicGuildByOwner, getPublicCharactersByUser, getPublicBandsForCharacter, ensureMyCharacterSlugs, getPublicAccountNames, type PublicBandSummary } from '@/lib/api';
  import { slugify } from '@/lib/routes';
  import { classColor } from '@/lib/ui/classColors';
  import { safePlayerName } from '@/lib/ui/playerNames';
  import { itemQualityColor, equipmentSlotLabel, roleLabel } from '@/lib/ui/itemQuality';
  import type { CharacterRow } from '@/lib/api';
  import type { ProfileRow, RaiddominionRole } from '@/types/database';

  const RESERVED = new Set([
    'upload', 'login', 'dashboard', 'admin', 'moderate', 'guilds', 'p', 'api',
    'assets', '_astro', 'portal', 'jugador', 'personajes', 'personaje',
  ]);

  // /personaje/<slug> → ficha de UN personaje concreto.
  // /p/<slug> (legacy) y /jugador/<slug> (canónico) → perfil público.
  function currentMode(): 'character' | 'profile' | '' {
    const seg = window.location.pathname.split('/').filter(Boolean);
    if (seg.length === 2 && seg[0] === 'personaje') return 'character';
    if (seg.length === 2 && (seg[0] === 'p' || seg[0] === 'jugador')) return 'profile';
    // Dev: el rewrite /p/ → /jugador?slug=... de astro.config.mjs
    if (new URLSearchParams(window.location.search).get('slug')) return 'profile';
    return '';
  }

  function currentSlug(): string {
    const override = new URLSearchParams(window.location.search).get('slug');
    if (override) return override;
    const seg = window.location.pathname.split('/').filter(Boolean);
    return seg.length === 2 ? seg[1] : '';
  }

  function showNotFound(): void {
    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('not-found')?.classList.remove('hidden');
    const isProfile = mode === 'profile';
    const title = isProfile ? 'Perfil no encontrado' : 'Personaje no encontrado';
    (document.getElementById('not-found-title') as HTMLElement).textContent = title;
    (document.getElementById('not-found-msg') as HTMLElement).textContent = isProfile
      ? 'Este perfil no existe, es privado o cambió su enlace.'
      : 'Este personaje no existe, es privado o cambió su enlace.';
    const cta = document.getElementById('not-found-cta') as HTMLAnchorElement;
    cta.href = isProfile ? '/jugadores' : '/personajes';
    cta.textContent = isProfile ? 'Ver jugadores' : 'Ver personajes';
    document.title = `${title} - RaidDominion`;
  }

  function makeEl(tag: string, cls: string, text?: string): HTMLElement {
    const node = document.createElement(tag);
    node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function chip(text: string): HTMLElement {
    const c = document.createElement('span');
    c.className = 'px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-800/60 border border-amber-600/20';
    c.textContent = text;
    return c;
  }

  const mode = currentMode();
  const slug = currentSlug();
  if (!slug || RESERVED.has(slug.toLowerCase())) {
    showNotFound();
  } else if (mode === 'character') {
    const res = await getPublicCharacterBySlug(slug);
    if (!res.ok || !res.result) {
      showNotFound();
    } else {
      void renderCharacter(res.result.character, res.result.profile);
    }
  } else if (mode === 'profile') {
    void resolveProfile(slug);
  } else {
    showNotFound();
  }

  // Ficha del personaje consultado: el card principal SIEMPRE es ESE
  // personaje (el del slug), no el último subido de la cuenta.
  async function renderCharacter(c: CharacterRow, p?: ProfileRow): Promise<void> {
    document.title = `${c.name}${c.realm ? ' - ' + c.realm : ''} - RaidDominion`;
    (window as unknown as { __rdBreadcrumb?: { setLabel: (l: string) => void } }).__rdBreadcrumb?.setLabel(c.name);

    (document.getElementById('avatar') as HTMLElement).textContent = c.name[0].toUpperCase();
    (document.getElementById('display-name') as HTMLElement).textContent = c.name;

    const chipsEl = document.getElementById('chips') as HTMLElement;
    chipsEl.appendChild(serverRealmLinks(c));
    chipsEl.appendChild(characterChips(c));

    // Nombres públicos + ¿hay un personaje maestro PÚBLICO? (la insignia de
    // maestro no se expone si el maestro real está oculto por el usuario).
    const namesRes = await getPublicAccountNames([c.user_id]);
    const info = namesRes.get(c.user_id);

    if (p && (p.role as RaiddominionRole) === 'guild_master' && info?.hasPublicGm === true) {
      document.getElementById('role-badge')?.classList.remove('hidden');

      const gRes = await getPublicGuildByOwner(c.user_id);
      if (gRes.ok && gRes.guild?.is_public) {
        const card = document.getElementById('guild-card') as HTMLAnchorElement;
        card.href = `/${gRes.guild.slug}`;
        (document.getElementById('guild-card-name') as HTMLElement).textContent = gRes.guild.name;
        card.classList.remove('hidden');
      }
    }

    if (p) {
      const ref = document.getElementById('profile-ref') as HTMLElement;
      ref.classList.remove('hidden');
      // No exponer un principal declarado que no es público.
      const label = safePlayerName(p, { publicNames: info?.publicNames, fallbackName: info?.principal });
      if (p.slug) {
        ref.appendChild(document.createTextNode('Cuenta de '));
        const a = document.createElement('a');
        a.href = `/p/${p.slug}`;
        a.className = 'text-amber-300 hover:text-amber-200 underline';
        a.textContent = label;
        ref.appendChild(a);
      } else {
        ref.textContent = `Cuenta de ${label}`;
      }
    }

    const bands = await getPublicBandsForCharacter(c.name, c.sv_guild_name);
    (document.getElementById('main-card') as HTMLElement).appendChild(
      richCharacterCard(c, bands.ok ? (bands.bands ?? []) : [], true)
    );
    document.getElementById('main-section')?.classList.remove('hidden');

    void renderAccountCharacters(c.user_id, c.id);

    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('profile')?.classList.remove('hidden');
  }

  // Perfil público de jugador (/jugador/:slug y legacy /p/:slug): muestra la
  // información del perfil (nombre, reino, rol, hermandad) junto con TODOS los
  // personajes públicos de la cuenta. NO redirige a la ficha de un personaje.
  async function resolveProfile(profileSlug: string): Promise<void> {
    const res = await getPublicProfileBySlug(profileSlug);
    if (!res.ok || !res.profile) {
      showNotFound();
      return;
    }
    const p = res.profile;

    // El perfil es visible aunque la cuenta aún no tenga personajes públicos
    // (la visibilidad del perfil es independiente de la de personajes).
    const charsRes = await getPublicCharactersByUser(p.id);
    if (!charsRes.ok || !charsRes.items) {
      showNotFound();
      return;
    }
    await renderProfile(p, charsRes.items);
  }

  // Vista de perfil: cabecera del jugador + personaje principal destacado y
  // el resto de personajes públicos de su cuenta.
  async function renderProfile(p: ProfileRow, chars: CharacterRow[]): Promise<void> {
    const mainName = (p.character_name ?? '').trim().toLowerCase();
    let main = mainName ? chars.find((c) => c.name.toLowerCase() === mainName) : undefined;
    main = main ?? chars[0];

    // Nombre visible seguro: nunca expone un principal declarado que no sea
    // público (los `chars` ya son solo personajes públicos).
    const publicNames = new Set(chars.map((c) => c.name.toLowerCase()));
    const displayName = safePlayerName(p, { publicNames, fallbackName: main?.name });
    document.title = `${displayName} - RaidDominion`;
    (window as unknown as { __rdBreadcrumb?: { setLabel: (l: string) => void } }).__rdBreadcrumb?.setLabel(displayName);

    (document.getElementById('avatar') as HTMLElement).textContent = displayName[0].toUpperCase();
    (document.getElementById('display-name') as HTMLElement).textContent = displayName;

    const chipsEl = document.getElementById('chips') as HTMLElement;
    if (main) {
      chipsEl.appendChild(serverRealmLinks(main));
      chipsEl.appendChild(characterChips(main));
    }
    if (p.realm && !main?.realm) chipsEl.appendChild(chip(p.realm));

    // La insignia de maestro solo aplica si hay un personaje maestro PÚBLICO
    // (los `chars` ya son solo personajes públicos de la cuenta).
    if (p.role === 'guild_master' && chars.some((c) => c.sv_is_gm)) {
      document.getElementById('role-badge')?.classList.remove('hidden');

      const gRes = await getPublicGuildByOwner(p.id);
      if (gRes.ok && gRes.guild?.is_public) {
        const card = document.getElementById('guild-card') as HTMLAnchorElement;
        card.href = `/${gRes.guild.slug}`;
        (document.getElementById('guild-card-name') as HTMLElement).textContent = gRes.guild.name;
        card.classList.remove('hidden');
      }
    }

    const mainCard = document.getElementById('main-card') as HTMLElement;
    const mainTitle = document.querySelector('#main-section h2');
    if (main) {
      const bands = await getPublicBandsForCharacter(main.name, main.sv_guild_name);
      mainCard.appendChild(
        richCharacterCard(main, bands.ok ? (bands.bands ?? []) : [], true)
      );
      if (mainTitle?.lastChild) mainTitle.lastChild.textContent = 'Personaje principal';
      void renderAccountCharacters(p.id, main.id);
    } else {
      // Perfil público sin personajes publicados: ficha vacía informativa.
      const emptyCard = makeEl('div', 'bg-gray-900/60 border border-amber-600/25 rounded-lg p-8 text-center');
      emptyCard.appendChild(makeEl('p', 'text-sm text-gray-400 italic', 'Este jugador aún no publica personajes.'));
      mainCard.appendChild(emptyCard);
      if (mainTitle?.lastChild) mainTitle.lastChild.textContent = 'Personajes';
    }
    document.getElementById('main-section')?.classList.remove('hidden');

    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('profile')?.classList.remove('hidden');
  }

  function equipmentGrid(c: CharacterRow): HTMLElement | null {
    const eq = c.equipment ?? [];
    if (eq.length === 0) return null;

    const wrap = makeEl('div', 'mt-4');
    wrap.appendChild(makeEl('h4', 'text-[10px] font-black uppercase tracking-widest text-amber-400/80 mb-2', `Equipamiento (${eq.length})`));

    const grid = makeEl('div', 'grid grid-cols-1 gap-1');
    [...eq].sort((a, b) => a.slot - b.slot).forEach((piece) => {
      const qc = itemQualityColor(piece.quality);
      const row = makeEl('div', 'flex items-center gap-2 rounded px-2 py-1 bg-gray-900/40 border-l-2');
      row.style.borderColor = qc;
      row.appendChild(makeEl('span', 'text-[9px] text-gray-500 uppercase shrink-0 w-12', equipmentSlotLabel(piece.slot)));
      const nm = makeEl('span', 'text-xs truncate');
      nm.style.color = qc;
      nm.textContent = piece.name;
      row.appendChild(nm);
      row.appendChild(makeEl('span', 'text-xs text-gray-400 shrink-0', `i${piece.ilvl}`));
      grid.appendChild(row);
    });
    wrap.appendChild(grid);
    return wrap;
  }

  function bandsRow(bands: PublicBandSummary[]): HTMLElement | null {
    if (!bands || bands.length === 0) return null;
    const wrap = makeEl('div', 'mt-4');
    wrap.appendChild(makeEl('h4', 'text-[10px] font-black uppercase tracking-widest text-amber-400/80 mb-2', 'Bandas de raid'));
    const list = makeEl('div', 'flex flex-wrap gap-2');
    bands.forEach((b) => {
      const parts = [b.name];
      const rol = roleLabel(b.role);
      if (rol) parts.push(rol);
      if (b.schedule) parts.push(b.schedule);
      if (typeof b.minGS === 'number' && b.minGS > 0) parts.push(`GS ${b.minGS}`);
      list.appendChild(makeEl('span', 'px-2 py-1 rounded-lg text-[10px] font-bold text-amber-200 bg-amber-900/20 border border-amber-600/30', parts.join(' · ')));
    });
    wrap.appendChild(list);
    return wrap;
  }

  // Enlaces de contexto: servidor (realmlist) y reino → jerarquía del directorio.
  function serverRealmLinks(c: CharacterRow): HTMLElement {
    const row = makeEl('div', 'flex flex-wrap gap-1.5');
    if (c.server) {
      const s = document.createElement('a');
      s.href = `/servidor/${encodeURIComponent(c.server)}`;
      s.className = 'px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest text-sky-200 bg-sky-950/40 border border-sky-600/30 hover:bg-sky-900/40 transition-all';
      s.textContent = c.server;
      row.appendChild(s);
    }
    if (c.realm) {
      const r = document.createElement(c.server ? 'a' : 'span');
      const cls = 'px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-800/60 border border-amber-600/20';
      if (c.server) {
        (r as HTMLAnchorElement).href = `/servidor/${encodeURIComponent(c.server)}/reino/${encodeURIComponent(slugify(c.realm))}`;
        r.className = `${cls} hover:bg-gray-800/80 transition-all`;
      } else {
        r.className = cls;
      }
      r.textContent = c.realm;
      row.appendChild(r);
    }
    return row;
  }

  function characterChips(c: CharacterRow): HTMLElement {
    const row = makeEl('div', 'flex flex-wrap gap-1.5');
    if (c.class) row.appendChild(chip(c.class));
    if (typeof c.level === 'number') row.appendChild(chip(`Nivel ${c.level}`));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) {
      const il = chip(`ilvl ${c.avg_ilvl}`);
      il.classList.add('!text-amber-300', '!border-amber-500/40');
      row.appendChild(il);
    }
    if (c.member_verified) {
      const v = chip('✓ Validado');
      v.classList.add('!text-emerald-300', '!border-emerald-600/40');
      row.appendChild(v);
    }
    if (c.sv_guild_name) {
      const gchip = chip(c.sv_is_gm ? `★ ${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}`);
      gchip.classList.add(
        c.sv_is_gm ? '!text-fuchsia-300' : '!text-sky-200',
        c.sv_is_gm ? '!border-fuchsia-500/40' : '!border-sky-600/30'
      );
      row.appendChild(gchip);
    }
    return row;
  }

  function richCharacterCard(c: CharacterRow, bands: PublicBandSummary[], featured: boolean): HTMLElement {
    const color = classColor(c.class, c.class_file);
    const card = makeEl('article', 'relative bg-gray-900/60 border border-amber-600/25 hover:border-amber-500/40 rounded-lg overflow-hidden transition-colors duration-200 ' + (featured ? 'p-5 pl-6' : 'p-4 pl-5'));

    const accent = makeEl('div', 'absolute top-0 left-0 w-1 h-full');
    accent.style.backgroundColor = color;
    card.appendChild(accent);

    // Cabecera: avatar + nombre en color de clase
    const head = makeEl('div', 'flex items-center gap-3 mb-3');
    const avatar = makeEl('div', (featured ? 'w-12 h-12 ' : 'w-10 h-10 ') + 'rounded-md flex items-center justify-center font-black italic text-lg shrink-0 shadow-lg border border-gray-700/50');
    avatar.style.backgroundColor = `${color}26`;
    avatar.style.color = color;
    avatar.textContent = (c.name || '?')[0].toUpperCase();
    head.appendChild(avatar);

    const nameWrap = makeEl('div', 'min-w-0');
    const name = makeEl('h3', 'font-black italic truncate leading-snug ' + (featured ? 'text-lg' : 'text-sm'));
    name.style.color = color;
    name.textContent = `${c.name}${c.realm ? '-' + c.realm : ''}`;
    nameWrap.appendChild(name);
    if (featured) nameWrap.appendChild(characterChips(c));
    head.appendChild(nameWrap);
    card.appendChild(head);

    // Stats principales
    const stats = makeEl('div', 'grid grid-cols-3 gap-2 mb-4');
    const stat = (label: string, value: string | number): HTMLElement => {
      const box = makeEl('div', 'text-center bg-gray-900/50 border border-amber-600/20 rounded-lg px-2 py-2');
      box.appendChild(makeEl('p', 'text-lg font-black text-amber-200 italic', String(value)));
      box.appendChild(makeEl('p', 'text-[9px] font-black uppercase tracking-widest text-gray-500', label));
      return box;
    };
    stats.appendChild(stat('Nivel', c.level ?? '—'));
    stats.appendChild(stat('ilvl', c.avg_ilvl ?? '—'));
    stats.appendChild(stat('Clase', c.class ?? '—'));
    card.appendChild(stats);

    if (!featured) {
      const chips = characterChips(c);
      card.appendChild(chips);
    }

    const eq = equipmentGrid(c);
    if (eq) card.appendChild(eq);

    const br = bandsRow(bands);
    if (br) card.appendChild(br);

    return card;
  }

  async function renderAccountCharacters(userId: string, currentCharId: string): Promise<void> {
    const res = await getPublicCharactersByUser(userId);
    if (!res.ok || !res.items || res.items.length === 0) return;

    const chars = res.items;

    // Slugs para enlazar a /personaje/<slug>: los propios (con sesión) se
    // generan/recuperan vía RPC; el resto viaja ya en la fila pública.
    const slugMap = new Map<string, string>();
    chars.forEach((c) => { if (c.slug) slugMap.set(c.id, c.slug); });
    const session = await supabase.auth.getSession();
    if (session.data.session?.user) {
      const ensure = await ensureMyCharacterSlugs();
      if (ensure.ok && ensure.slugs) {
        ensure.slugs.forEach((s) => slugMap.set(s.id, s.slug));
      }
    }

    const others = chars.filter((c) => c.id !== currentCharId);
    if (others.length === 0) return;

    const bandResults = await Promise.all(
      others.map((c) => getPublicBandsForCharacter(c.name, c.sv_guild_name))
    );

    const grid = document.getElementById('characters-grid') as HTMLElement;
    others.forEach((c, i) => {
      const bands = bandResults[i]?.ok ? (bandResults[i].bands ?? []) : [];
      const card = richCharacterCard(c, bands, false);
      const slug = slugMap.get(c.id);
      if (slug) {
        const a = document.createElement('a');
        a.href = `/personaje/${slug}`;
        a.className = 'block transition-all duration-200 hover:-translate-y-0.5';
        a.appendChild(card);
        grid.appendChild(a);
      } else {
        grid.appendChild(card);
      }
    });
    if (grid.children.length > 0) {
      document.getElementById('characters-section')?.classList.remove('hidden');
    }
  }
</script>