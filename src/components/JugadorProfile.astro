---
import Breadcrumb from '@/components/Breadcrumb.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import StatusCard from '@/components/ui/StatusCard.astro';
import Icon from '@/components/ui/Icon.astro';
import FichaHero from '@/components/ui/FichaHero.astro';
import FichaDock from '@/components/ui/FichaDock.astro';
import { ui } from '@/lib/ui/design';
---

<main class="relative py-16">
  <div class="max-w-6xl mx-auto">
    <Breadcrumb />

    <noscript><style>#loading { display: none; }</style></noscript>

    <!-- Cargando -->
    <LoadingBlock id="loading" text="Cargando perfil…" />

    <!-- No encontrado -->
    <StatusCard
      id="not-found"
      surface="card"
      showTop
      tone="neutral"
      medallion
      icon="advertencia"
      title="Perfil no encontrado"
      titleId="not-found-title"
      titleCls={`${ui.text.h1} text-white mb-2`}
      message="Este perfil no existe, es privado o cambió su enlace."
      messageId="not-found-msg"
      messageCls={`${ui.text.bodyMuted} max-w-md mx-auto`}
      cta={{ label: 'Ver jugadores', href: '/jugadores' }}
      ctaId="not-found-cta"
      ctaCls={`${ui.btnBase} ${ui.btnPrimary} inline-block mt-5 px-6 py-2.5 text-xs font-black uppercase tracking-widest`}
    />

    <!-- Ficha del personaje: encabezado + paneles en la MISMA superficie.
         La tira de contexto (#jugador-context) queda fuera de la ficha. -->
    <div id="profile" data-rd-reveal class="hidden">
      <FichaHero image="/images/headers/ficha-personaje.webp" icon="personaje" tone="arcane" avatarId="avatar">
        <h1 id="display-name" class={`${ui.titleFicha} break-words ${ui.gradientTitle} ${ui.toneTitle}`}></h1>
        <div id="chips" class="flex flex-wrap justify-start gap-2 mt-4"></div>
        <div class="flex flex-wrap justify-start gap-2 mt-3">
          <span id="role-badge" class={`hidden ${ui.badge} ${ui.badgeMd} bg-gradient-to-b from-fuchsia-950/60 to-fuchsia-950/25 border-fuchsia-500/40 text-fuchsia-300`}><Icon name="estrella" size="sm" class="self-center" />Maestro de hermandad</span>
        </div>
        <p id="profile-ref" class="hidden text-sm text-gray-300 mt-3"></p>
        <div id="profile-actions" class="flex flex-wrap justify-start gap-2 mt-3"></div>
        <FichaDock
          slot="dock"
          dockId="jugador-tab-dock"
          barId="profile-tab-bar"
          label="Secciones del perfil"
        />

        <!-- Paneles ventana (modelo dashboard): Personajes, Bandas, Hermandades -->
        <div slot="body" id="profile-panels" class={ui.zone.body}>
          <PanelWindow flat id="panel-personajes" title="Personajes" icon="personaje" role="tabpanel" ariaLabelledby="tab-personajes" hidden>
            <h3 id="main-title" class={ui.subTitle}></h3>
            <!-- Filtros/paginador cuando la cuenta no tiene principal declarado
                 (todos los personajes van en la tarjeta principal). -->
            <div id="personajes-main-filtro" class="mt-4"></div>
            <div id="main-card"></div>
            <div id="personajes-main-pager" class="mt-3"></div>
            <div id="characters-section" data-rd-reveal class="hidden mt-6">
              <h3 class={ui.subTitle}>Otros personajes de la cuenta</h3>
              <!-- Motor único de filtros (src/lib/ui/filterBar.ts) + paginador. -->
              <div id="personajes-filtro" class="mb-4"></div>
              <div id="characters-grid" class={ui.gridCards}></div>
              <div id="personajes-pager" class="mt-3"></div>
            </div>
          </PanelWindow>

          <PanelWindow flat id="panel-bandas" title="Bandas" icon="espadas" tone="ember" role="tabpanel" ariaLabelledby="tab-bandas" hidden>
            <div slot="head">
              <!-- Panel de filtros estándar (buscador + selector de día) del motor
                   src/lib/ui/filterBar.ts, vía el modelo renderBandasPanel. -->
              <div class="mt-4" id="bandas-filtro" data-rd-reveal-cards></div>
            </div>
            <div id="bandas-content" class="space-y-8"></div>
          </PanelWindow>

          <PanelWindow flat id="panel-hermandades" title="Hermandades" icon="hermandad" tone="valor" role="tabpanel" ariaLabelledby="tab-hermandades" hidden>
            <div slot="head">
              <!-- Motor único de filtros (src/lib/ui/filterBar.ts). -->
              <div class="mt-4" id="hermandades-filtro"></div>
            </div>
            <div id="hermandades-list" class={ui.gridCards}></div>
            <div id="hermandades-pager" class="mt-3"></div>
          </PanelWindow>
        </div>
      </FichaHero>
      <!-- Contexto del jugador (servidor/reino): va DESPUÉS de la ficha
           unificada para liberar el encabezado. -->
      <div id="jugador-context" class={ui.contextStrip}></div>

      <!-- Contexto estático del perfil: visible sin JS y para crawlers. -->
      <section class="mt-12" aria-labelledby="rd-jugador-info">
        <div class={`${ui.panel} p-5 sm:p-7`}>
          <span class={ui.cardTop} aria-hidden="true"></span>
          <h2 id="rd-jugador-info" class={`${ui.text.h2} text-brand-200 mb-3`}>Sobre este perfil de jugador</h2>
          <p class={`${ui.text.body} mb-3`}>
            El perfil reúne los personajes que la cuenta decidió hacer públicos, junto con sus
            hermandades y bandas visibles. La identidad, la visibilidad y las notas privadas las
            controla el dueño desde su dashboard.
          </p>
          <p class={`${ui.text.bodyMuted}`}>
            Explora el <a href="/jugadores" class="text-brand-300 underline hover:text-brand-200">directorio de jugadores</a>
            o las <a href="/personajes" class="text-brand-300 underline hover:text-brand-200">fichas de personaje</a> de WoW 3.3.5a.
            Si quieres aparecer aquí, <a href="/upload" class="text-brand-300 underline hover:text-brand-200">sube el archivo del addon</a>.
          </p>
          <noscript>
            <p class={`${ui.status.info} mt-4 rounded-md p-3 text-sm`}>
              Este perfil carga los personajes con JavaScript. También puedes consultar el
              <a href="/jugadores" class="underline">directorio de jugadores</a>.
            </p>
          </noscript>
        </div>
      </section>
    </div>

  </div>
</main>

<script>
  import { supabase } from '@/lib/supabase';
  import { getPublicProfileBySlug, getPublicGuildsForPlayer, getPublicCharactersByUser, getPublicBandsForCharacter, ensureMyCharacterSlugs, type PublicBandSummary } from '@/lib/api';
  import { RESERVED } from '@/lib/routes';
  import { safePlayerName } from '@/lib/ui/playerNames';
  import type { CharacterRow } from '@/lib/api';
  import type { GuildRow, ProfileRow } from '@/types/database';
  import { ui } from '@/lib/ui/design';
  import { type Facet } from '@/lib/ui/filterBar';
  import { PAGE_SIZE_GRID } from '@/lib/ui/paginator';
  import { mountPagedList } from '@/lib/ui/list';
  import { card, cardTop, serverRealmLinks } from '@/lib/ui/card';
  import { el, setBreadcrumb } from '@/lib/ui/dom';
  import { profilePageSchema, setPageMeta } from '@/lib/seo';
  import { classColor } from '@/lib/ui/classColors';
  import { renderCharacterCard, renderGuildCard, renderBandCard, renderBandFallbackCard } from '@/lib/ui/cards';
  import { characterChips } from '@/lib/ui/characterChips';
  import { shareLinkButton } from '@/lib/ui/share';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';
  import { resolveBandOwners, type OwnerRef } from '@/lib/bandListing';
  import { JUGADOR_TABS, initAvailableTabs } from '@/lib/ui/tabs';

  // Perfil público de jugador (/jugador/:slug): única ruta canónica. El shell
  // (jugador.astro) se sirve por rewrite en prod (/jugador/* → /jugador) y el
  // navegador conserva la URL real; en dev el middleware pasa ?slug=.
  function isProfileRoute(): boolean {
    const seg = window.location.pathname.split('/').filter(Boolean);
    return seg[0] === 'jugador';
  }

  function currentSlug(): string {
    const override = new URLSearchParams(window.location.search).get('slug');
    if (override) return override;
    const seg = window.location.pathname.split('/').filter(Boolean);
    return seg.length === 2 && seg[0] === 'jugador' ? seg[1] : '';
  }

  function showNotFound(): void {
    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('not-found')?.classList.remove('hidden');
    (document.getElementById('not-found-title') as HTMLElement).textContent = 'Perfil no encontrado';
    (document.getElementById('not-found-msg') as HTMLElement).textContent = 'Este perfil no existe, es privado o cambió su enlace.';
    const cta = document.getElementById('not-found-cta') as HTMLAnchorElement;
    cta.href = '/jugadores';
    cta.textContent = 'Ver jugadores';
    setPageMeta({
      title: 'Perfil no encontrado — RaidDominion',
      description: 'Este perfil no existe, es privado o cambió su enlace.',
      noindex: true,
    });
  }

  const isProfile = isProfileRoute() || !!new URLSearchParams(window.location.search).get('slug');
  const slug = currentSlug();
  if (!slug || !isProfile || RESERVED.has(slug.toLowerCase())) {
    showNotFound();
  } else {
    void resolveProfile(slug);
  }

  // Perfil público de jugador (/jugador/:slug): muestra la información del
  // personajes públicos de la cuenta. NO redirige a la ficha de un personaje.
  async function resolveProfile(profileSlug: string): Promise<void> {
    const res = await getPublicProfileBySlug(profileSlug);
    if (!res.ok || !res.profile) {
      showNotFound();
      return;
    }
    const p = res.profile;

    // El perfil es visible aunque la cuenta aún no tenga personajes públicos
    // (la visibilidad del perfil es independiente de la de personajes).
    const charsRes = await getPublicCharactersByUser(p.id);
    if (!charsRes.ok || !charsRes.items) {
      showNotFound();
      return;
    }
    await renderProfile(p, charsRes.items);
  }

  // Vista de perfil: cabecera del jugador + personaje principal destacado y
  // el resto de personajes públicos de su cuenta.
  async function renderProfile(p: ProfileRow, chars: CharacterRow[]): Promise<void> {
    // El personaje principal SOLO es el declarado (character_name). Con el
    // principal en "Ninguno" no se toma ningún personaje público como tal:
    // la identidad cae al handle estable @hex del perfil.
    const mainName = (p.character_name ?? '').trim().toLowerCase();
    const main = mainName ? chars.find((c) => c.name.toLowerCase() === mainName) : undefined;

    // Nombre visible seguro: nunca expone un principal declarado que no sea
    // público (los `chars` ya son solo personajes públicos).
    const publicNames = new Set(chars.map((c) => c.name.toLowerCase()));
    const displayName = safePlayerName(p, { publicNames, fallbackName: main?.name });
    const slug = p.slug ?? currentSlug();
    const path = `/jugador/${slug}`;
    const description = `Perfil público de ${displayName} en RaidDominion: personajes, hermandades y bandas visibles de World of Warcraft 3.3.5a.`;
    setPageMeta({
      title: `${displayName} — Perfil de jugador | RaidDominion`,
      description,
      path,
      type: 'profile',
      breadcrumbs: [
        { name: 'Inicio', path: '/' },
        { name: 'Jugadores', path: '/jugadores' },
        { name: displayName, path },
      ],
      jsonLd: profilePageSchema(`${displayName} — RaidDominion`, description, path),
    });
    setBreadcrumb(displayName);

    // Halo del medallón héroe con el color de clase del personaje principal.
    const avatar = document.getElementById('avatar') as HTMLElement;
    const tint = classColor(main?.class ?? chars[0]?.class, main?.class_file ?? chars[0]?.class_file);
    if (tint) {
      avatar.style.setProperty('--rd-hero-tint', tint);
      avatar.style.borderColor = tint;
    }
    (document.getElementById('display-name') as HTMLElement).textContent = displayName;
    (document.getElementById('profile-actions') as HTMLElement).appendChild(
      shareLinkButton({
        title: `${displayName} | RaidDominion`,
        text: `Perfil público de ${displayName} en RaidDominion.`,
        url: window.location.href,
      }),
    );

    const chipsEl = document.getElementById('chips') as HTMLElement;
    const ctxEl = document.getElementById('jugador-context') as HTMLElement;
    if (main) {
      // Servidor/reino viven en la tira de contexto tras el separador final
      // (#jugador-context), no en el encabezado; los chips de clase/cifras/
      // hermandad sí quedan junto al nombre. Sin datos no se desoculta (la
      // fila del helper siempre existe, vacía).
      if (main.server || main.realm) ctxEl.appendChild(serverRealmLinks(main));
      chipsEl.appendChild(characterChips(main, { race: true, stats: true }));
    }
    if (p.realm && !main?.realm) ctxEl.appendChild(serverRealmLinks({ server: null, realm: p.realm }));
    if (ctxEl.children.length > 0) ctxEl.classList.remove('hidden');

    // La insignia de maestro solo aplica si hay un personaje maestro PÚBLICO
    // (los `chars` ya son solo personajes públicos de la cuenta). La tarjeta
    // de hermandad vive en el panel "Hermandades" (renderPlayerGuilds).
    if (p.role === 'guild_master' && chars.some((c) => c.sv_is_gm)) {
      document.getElementById('role-badge')?.classList.remove('hidden');
    }

    const mainCard = document.getElementById('main-card') as HTMLElement;
    const mainTitle = document.getElementById('main-title') as HTMLElement;
    // Modelo de card compacta de UNA SOLA LÍNEA (mismo lenguaje que el core
    // de banda): ícono + nombre (-reino) y, a la derecha, Nivel/ilvl + el
    // indicador "Ver ficha →". renderCharacterCard ya enlaza a /personaje/:slug
    // (o /jugador/:slug si el personaje no es público pero el perfil sí).
    const profiles = new Map<string, { slug: string | null; display_name: string | null; character_name: string | null }>();
    profiles.set(p.id, { slug: p.slug, display_name: p.display_name, character_name: p.character_name });
    if (main) {
      // El principal entra al mismo grid 3-col responsive que el resto de
      // personajes (cards compactas de una sola línea).
      const grid = el('div', ui.gridCards);
      grid.appendChild(renderCharacterCard(main, { profiles }));
      mainCard.appendChild(grid);
      mainTitle.textContent = 'Personaje principal';
      void renderAccountCharacters(p.id, main.id, profiles);
    } else if (chars.length > 0) {
      // Sin principal fijado ("Ninguno"): todos los personajes públicos se
      // muestran en igualdad, sin destacar a ninguno como "el principal", con
      // el mismo buscador/facetas/paginador que "Otros personajes".
      const grid = el('div', ui.gridCards);
      mainCard.appendChild(grid);
      mainTitle.textContent = 'Resumen';
      mountCharacterList(
        chars,
        grid,
        document.getElementById('personajes-main-filtro') as HTMLElement,
        document.getElementById('personajes-main-pager') as HTMLElement | null,
        profiles,
      );
    } else {
      // Perfil público sin personajes publicados: ficha vacía informativa.
      const emptyCard = card('p-6 sm:p-8 text-center');
      emptyCard.appendChild(cardTop());
      emptyCard.appendChild(el('p', 'text-sm text-gray-300 italic', 'Este jugador aún no publica personajes.'));
      mainCard.appendChild(emptyCard);
      mainTitle.textContent = 'Resumen';
    }
    const available: string[] = ['personajes'];

    const bandsCount = await renderPlayerBands(chars, available);
    const guildsCount = await renderPlayerGuilds(p.id, available);
    initAvailableTabs({
      barId: 'profile-tab-bar',
      tabs: JUGADOR_TABS,
      available,
      counts: { personajes: chars.length, bandas: bandsCount, hermandades: guildsCount },
      variant: 'ficha',
      dockId: 'jugador-tab-dock',
    });

    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    document.getElementById('profile')?.classList.remove('hidden');
  }

  // Panel "Bandas": agrega las bandas públicas de TODOS los personajes de la
  // cuenta (dedupe por nombre|horario) → /banda/:slug cuando existe slug. La
  // pestaña solo se genera si hay bandas (available). Usa el modelo compartido
  // /bandas (renderBandasPanel): filtro por día + día/hora agrupados 3×responsive.
  async function renderPlayerBands(chars: CharacterRow[], available: string[]): Promise<number> {
    const seen = new Set<string>();
    const unique: PublicBandSummary[] = [];
    for (const c of chars) {
      const res = await getPublicBandsForCharacter(c.name, c.realm);
      (res.ok ? (res.bands ?? []) : []).forEach((b) => {
        // Dedupe por identidad nombre|horario (no solo por nombre): un jugador
        // puede pertenecer a DOS bandas con el mismo nombre en horarios
        // distintos y ambas deben listarse.
        const key = `${b.name.trim().toLowerCase()}|${(b.schedule ?? '').trim().toLowerCase()}`;
        if (seen.has(key)) return;
        seen.add(key);
        unique.push(b);
      });
    }
    if (unique.length > 0) {
      // Atribución: la card estándar del directorio /bandas identifica a quién
      // pertenece cada banda (hermandad o jugador).
      const owners = await resolveBandOwners(unique.map((b) => ({ guild_id: b.guildId ?? null, owner_id: b.ownerId ?? '' })));
      renderBandasPanel({
        filtro: document.getElementById('bandas-filtro') as HTMLElement,
        content: document.getElementById('bandas-content') as HTMLElement,
        items: unique,
        getSchedule: (b: PublicBandSummary) => b.schedule ?? null,
        // Búsqueda por nombre de banda / jugador (este perfil) / personaje /
        // hermandad dueña.
        getSearchText: (b: PublicBandSummary) => [
          b.name,
          b.role ?? '',
          owners.get((b.guildId || b.ownerId) ?? '')?.label,
          chars.map((c) => c.name).join(' '),
        ].filter(Boolean).join(' '),
        renderCard: (b: PublicBandSummary) => bandRow(b, owners.get((b.guildId || b.ownerId) ?? '')),
      });
      available.push('bandas');
    }
    return unique.length;
  }

  // Panel "Hermandades": hermandades públicas donde el jugador es maestro.
  async function renderPlayerGuilds(ownerId: string, available: string[]): Promise<number> {
    const res = await getPublicGuildsForPlayer(ownerId);
    const guilds = res.ok ? (res.guilds ?? []) : [];
    if (guilds.length === 0) return 0;

    const list = document.getElementById('hermandades-list') as HTMLElement;
    const pager = document.getElementById('hermandades-pager') as HTMLElement | null;
    const facets: Array<Facet<GuildRow>> = [
      {
        id: 'faccion',
        label: 'Filtrar por facción',
        // Solo facciones reales: el addon usa '?' como marcador de desconocido.
        getValues: (g) => (g.faction === 'Horde' || g.faction === 'Alliance' ? [g.faction] : []),
        labelOf: (v) => (v === 'Horde' ? 'Horda' : 'Alianza'),
        order: () => ['Horde', 'Alliance'],
      },
      {
        id: 'reino',
        label: 'Filtrar por reino',
        getValues: (g) => [(g.realm ?? '').trim()].filter(Boolean),
      },
      {
        kind: 'flag',
        id: 'verified',
        label: 'Filtrar hermandades verificadas',
        getFlag: (g) => g.claim_status === 'verified',
        chipLabel: 'Verificada',
        icon: 'medalla',
      },
    ];

    // Card estándar del directorio /hermandades (renderGuildCard), buscador +
    // facetas (facción/reino/verificada) + paginador (PAGE_SIZE_GRID).
    mountPagedList<GuildRow>({
      mount: document.getElementById('hermandades-filtro') as HTMLElement,
      items: guilds,
      pageSize: PAGE_SIZE_GRID,
      pager,
      container: list,
      renderItem: (g) => renderGuildCard(g),
      getSearchText: (g) => `${g.name} ${g.realm ?? ''} ${g.server ?? ''} ${g.description ?? ''}`,
      searchPlaceholder: 'Buscar por nombre, reino o descripción…',
      searchLabel: 'Buscar hermandades por nombre, reino o descripción',
      facets,
      resultNoun: (n) => `${n} hermandad${n === 1 ? '' : 'es'}`,
      emptyMessage: (state) => state.query.trim()
        ? `Ninguna hermandad coincide con "${state.query.trim()}".`
        : 'No hay hermandades que coincidan con los filtros.',
    });
    available.push('hermandades');
    return guilds.length;
  }

  function bandRow(b: PublicBandSummary, owner?: OwnerRef): HTMLElement {
    // Card de banda con el modelo estándar del directorio /bandas
    // (renderBandCard); sin slug, card no enlazable con el mismo modelo.
    if (b.slug) {
      return renderBandCard(
        { slug: b.slug, name: b.name, nameLink: b.nameLink ?? null, schedule: b.schedule ?? null, min_gs: b.minGS ?? null, guildId: b.guildId ?? null, hide_players: b.hidePlayers ?? false },
        { integrated: b.integrated, owner, playerCount: b.playerCount },
      );
    }
    return renderBandFallbackCard({
      name: b.name,
      nameLink: b.nameLink ?? null,
      schedule: b.schedule ?? null,
      minGS: b.minGS ?? null,
      hidePlayers: b.hidePlayers,
      playerCount: b.playerCount,
    });
  }

  async function renderAccountCharacters(userId: string, currentCharId: string, profiles: Map<string, { slug: string | null; display_name: string | null; character_name: string | null }>): Promise<void> {
    const res = await getPublicCharactersByUser(userId);
    if (!res.ok || !res.items || res.items.length === 0) return;

    const chars = res.items;

    // Slugs para enlazar a /personaje/<slug>: los propios (con sesión) se
    // generan/recuperan vía RPC; el resto viaja ya en la fila pública.
    const slugMap = new Map<string, string>();
    chars.forEach((c) => { if (c.slug) slugMap.set(c.id, c.slug); });
    const session = await supabase.auth.getSession();
    if (session.data.session?.user) {
      const ensure = await ensureMyCharacterSlugs();
      if (ensure.ok && ensure.slugs) {
        ensure.slugs.forEach((s) => slugMap.set(s.id, s.slug));
      }
    }

    const others = chars.filter((c) => c.id !== currentCharId);
    if (others.length === 0) return;

    // Slugs resueltos ANTES de filtrar (mutación única sobre el array fuente).
    others.forEach((c) => {
      if (slugMap.has(c.id)) c.slug = slugMap.get(c.id)!;
    });

    const grid = document.getElementById('characters-grid') as HTMLElement;
    const pager = document.getElementById('personajes-pager') as HTMLElement | null;
    mountCharacterList(others, grid, document.getElementById('personajes-filtro') as HTMLElement, pager, profiles);

    document.getElementById('characters-section')?.classList.remove('hidden');
  }

  // Buscador + clase/reino/validado/maestro + paginador compartido por las dos
  // variantes del panel Personajes (con principal → "otros"; sin principal →
  // todos). La carta principal (cuando existe) no participa del filtro.
  function mountCharacterList(
    items: CharacterRow[],
    grid: HTMLElement,
    filterEl: HTMLElement,
    pager: HTMLElement | null,
    profiles: Map<string, { slug: string | null; display_name: string | null; character_name: string | null }>,
  ): void {
    filterEl.innerHTML = '';
    if (pager) pager.textContent = '';
    const facets: Array<Facet<CharacterRow>> = [
      {
        id: 'clase',
        label: 'Filtrar personajes por clase',
        getValues: (c) => (c.class ? [c.class] : []),
        labelOf: (v) => v,
      },
      {
        id: 'reino',
        label: 'Filtrar personajes por reino',
        getValues: (c) => [(c.realm ?? '').trim()].filter(Boolean),
      },
      {
        kind: 'flag',
        id: 'validado',
        label: 'Filtrar personajes validados',
        getFlag: (c) => !!c.member_verified,
        chipLabel: 'Validado',
        icon: 'validado',
      },
      {
        kind: 'flag',
        id: 'gm',
        label: 'Filtrar personajes maestros de hermandad',
        getFlag: (c) => !!c.sv_is_gm,
        chipLabel: 'Maestro',
        icon: 'estrella',
      },
    ];

    mountPagedList<CharacterRow>({
      mount: filterEl,
      items,
      pageSize: PAGE_SIZE_GRID,
      pager,
      container: grid,
      renderItem: (c) => renderCharacterCard(c, { profiles }),
      getSearchText: (c) => `${c.name} ${c.realm ?? ''} ${c.class ?? ''} ${c.sv_guild_name ?? ''}`,
      searchPlaceholder: 'Buscar personaje…',
      searchLabel: 'Buscar personajes por nombre, clase o reino',
      facets,
      resultNoun: (n) => `${n} personaje${n === 1 ? '' : 's'}`,
      emptyMessage: (state) => state.query.trim()
        ? `Ningún personaje coincide con "${state.query.trim()}".`
        : 'No hay personajes que coincidan con los filtros.',
    });
  }
</script>