---
// Vista de REINO ANIDADO (/servidor/:server/reino/:realm), resuelta 100% en cliente.
// Auto-gate: ["servidor", server, "reino", realm] — 4 segmentos.
// Muestra guilds y personajes públicos de ese reino en ese servidor, con chip
// del servidor (realmlist) que enlaza a /servidor/:server.
  import { ui } from '@/lib/ui/design';
  import PanelWindow from '@/components/ui/PanelWindow.astro';
  import StatCell from '@/components/ui/StatCell.astro';
  import FichaHero from '@/components/ui/FichaHero.astro';
  import FichaSkeleton from '@/components/ui/FichaSkeleton.astro';
---
<section id="view-reino" class="hidden">
  <FichaHero image="/images/headers/server-realm.webp" icon="vientos" tone="valor">
    <h1 id="rv-realm" class={`${ui.titleFicha} break-all ${ui.gradientTitle} ${ui.toneTitle}`}></h1>
    <div class="flex flex-wrap items-center mt-5" aria-label="Indicadores del reino">
      <StatCell label="Hermandades" valueId="rv-stat-guilds" valueCls={ui.toneTitle} />
      <StatCell label="Personajes" valueId="rv-stat-chars" valueCls={ui.toneTitle} />
      <StatCell label="Bandas" valueId="rv-stat-bands" valueCls={ui.toneTitle} />
    </div>
  </FichaHero>

  <FichaSkeleton
    barId="rv-tab-bar"
    barLabel="Secciones del reino"
    barHidden
    barCls="animate-fade-in-1"
    leftSepId="rv-left-sep"
    leftSepHidden
  >
  <div id="rv-panels" class={ui.zone.body}>
    <PanelWindow id="panel-hermandades" title="Hermandades" icon="hermandad" tone="valor" role="tabpanel" ariaLabelledby="tab-hermandades" hidden>
      <div slot="head">
        <!-- Motor único de filtros (src/lib/ui/filterBar.ts). -->
        <div class="mt-4" id="rv-guilds-filtro"></div>
      </div>
      <p id="rv-guilds-empty" class="hidden text-sm text-gray-300 italic">Sin hermandades públicas en este reino.</p>
      <div id="rv-guilds" class={ui.gridCards}></div>
      <div id="rv-guilds-pager" class="mt-3"></div>
    </PanelWindow>

    <PanelWindow id="panel-personajes" title="Personajes" icon="personaje" role="tabpanel" ariaLabelledby="tab-personajes" hidden>
      <div slot="head">
        <!-- Motor único de filtros (src/lib/ui/filterBar.ts). -->
        <div class="mt-4" id="rv-chars-filtro"></div>
      </div>
      <p id="rv-chars-empty" class="hidden text-sm text-gray-300 italic">Sin personajes públicos en este reino.</p>
      <div id="rv-chars" class={ui.gridCards}></div>
      <div id="rv-chars-pager" class="mt-3"></div>
    </PanelWindow>

    <PanelWindow id="panel-bandas" title="Bandas" icon="espadas" tone="ember" role="tabpanel" ariaLabelledby="tab-bandas" hidden>
      <div slot="head">
        <!-- Panel de filtros estándar (buscador + selector de día) del motor
             src/lib/ui/filterBar.ts, vía el modelo renderBandasPanel. -->
        <div class="mt-4" id="rv-bandas-filtro" data-rd-reveal-cards></div>
      </div>
      <div id="rv-bandas" class="space-y-8"></div>
    </PanelWindow>
  </div>
  </FichaSkeleton>
  <!-- Contexto del reino (servidor realmlist): va DESPUÉS del separador
       final para liberar el encabezado. Mismo formato de chips que las
       fichas de jugador/personaje (contrato serverRealmLinks). -->
  <div id="rv-context" class={ui.contextStrip}></div>
</section>

<script>
  import {
    getServerRealms, getRealmOverview, getRealmBands, getPublicAccountNames,
    type CharacterRow, type PublicAccountNames,
  } from '@/lib/api';
  import { currentSegments, showNotFound, showView, slugify } from '@/lib/routes';
  import { setPageMeta } from '@/lib/seo';
  import { supabase } from '@/lib/supabase';
  import { setBreadcrumb } from '@/lib/ui/dom';
  import { resolveBandOwners, mergeDirectoryBands } from '@/lib/bandListing';
  import { REINO_TABS, initAvailableTabs } from '@/lib/ui/tabs';
  import { renderGuildCard, renderCharacterCard, renderBandCard } from '@/lib/ui/cards';
  import { serverRealmLinks } from '@/lib/ui/card';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';
  import { PAGE_SIZE_GRID } from '@/lib/ui/paginator';
  import { type Facet } from '@/lib/ui/filterBar';
  import { mountPagedList } from '@/lib/ui/list';

  interface ProfileLight { id: string; slug: string | null; display_name: string | null; character_name: string | null }

  const seg = currentSegments();
  if (
    seg[0]?.toLowerCase() === 'servidor' &&
    seg.length === 4 &&
    seg[2]?.toLowerCase() === 'reino'
  ) {
    const server = seg[1];
    const realmSlug = seg[3];
    if (!server || !realmSlug) {
      showNotFound('Reino no encontrado.');
    } else {
      await render(server, realmSlug);
    }
  }

  async function render(server: string, realmSlug: string): Promise<void> {
    // Resolver el reino REAL dentro del servidor por slug (la URL lleva el slug).
    const realmsRes = await getServerRealms(server);
    if (!realmsRes.ok || !realmsRes.realms) {
      showNotFound('No se pudo cargar este reino.');
      return;
    }
    const realm = realmsRes.realms.find(
      (r) => slugify(r).toLowerCase() === realmSlug.toLowerCase() || r.toLowerCase() === realmSlug.toLowerCase()
    );
    if (!realm) {
      showNotFound('Este reino no existe en este servidor.');
      return;
    }

    const res = await getRealmOverview(server, realm);
    if (!res.ok) {
      showNotFound('No se pudo cargar este reino.');
      return;
    }
    const realmGuilds = res.guilds ?? [];
    const realmChars = res.characters ?? [];

    if (realmGuilds.length === 0 && realmChars.length === 0) {
      showNotFound('Este reino no tiene datos públicos todavía.');
      return;
    }

    const realmPath = `/servidor/${encodeURIComponent(server)}/reino/${slugify(realm)}`;
    setPageMeta({
      title: `${realm} — Reino de ${server} | RaidDominion`,
      description: `Hermandades, personajes y bandas públicas del reino ${realm} en ${server}, World of Warcraft 3.3.5a.`,
      path: realmPath,
      breadcrumbs: [
        { name: 'Inicio', path: '/' },
        { name: 'Servidores', path: '/servidores' },
        { name: server, path: `/servidor/${encodeURIComponent(server)}` },
        { name: realm, path: realmPath },
      ],
    });
    (document.getElementById('rv-realm') as HTMLElement).textContent = realm;
    setBreadcrumb(realm);

    const ctx = document.getElementById('rv-context') as HTMLElement;
    ctx.appendChild(serverRealmLinks({ server, realm: null }));
    ctx.classList.remove('hidden');

    // Indicadores del reino (cifras públicas).
    (document.getElementById('rv-stat-guilds') as HTMLElement).textContent = String(realmGuilds.length);
    (document.getElementById('rv-stat-chars') as HTMLElement).textContent = String(realmChars.length);

    // Hermandades (modelo del directorio).
    const guildsEl = document.getElementById('rv-guilds') as HTMLElement;
    const guildsPager = document.getElementById('rv-guilds-pager') as HTMLElement | null;
    if (realmGuilds.length === 0) {
      document.getElementById('rv-guilds-empty')?.classList.remove('hidden');
      if (guildsPager) guildsPager.textContent = '';
    } else {
      const facets: Array<Facet<(typeof realmGuilds)[number]>> = [
        {
          id: 'faccion',
          label: 'Filtrar hermandades por facción',
          getValues: (g) => (g.faction === 'Horde' || g.faction === 'Alliance' ? [g.faction] : []),
          labelOf: (v) => (v === 'Horde' ? 'Horda' : 'Alianza'),
          order: () => ['Horde', 'Alliance'],
        },
        {
          kind: 'flag',
          id: 'verificada',
          label: 'Filtrar hermandades verificadas',
          getFlag: (g) => g.claim_status === 'verified',
          chipLabel: 'Verificada',
          icon: 'medalla',
        },
      ];
      mountPagedList({
        mount: document.getElementById('rv-guilds-filtro') as HTMLElement,
        items: realmGuilds,
        pageSize: PAGE_SIZE_GRID,
        pager: guildsPager,
        container: guildsEl,
        renderItem: (g) => renderGuildCard(g),
        getSearchText: (g) => `${g.name} ${g.description ?? ''} ${g.faction ?? ''}`,
        searchPlaceholder: 'Buscar hermandad…',
        searchLabel: 'Buscar hermandades por nombre o descripción',
        facets,
        resultNoun: (n) => `${n} hermandad${n === 1 ? '' : 'es'}`,
        emptyMessage: (state) => state.query.trim()
          ? `Ninguna hermandad coincide con "${state.query.trim()}".`
          : 'No hay hermandades que coincidan con los filtros.',
      });
    }

    // Personajes (modelo del directorio; resolución de dueños en batch).
    const charsEl = document.getElementById('rv-chars') as HTMLElement;
    const charsPager = document.getElementById('rv-chars-pager') as HTMLElement | null;
    if (realmChars.length === 0) {
      document.getElementById('rv-chars-empty')?.classList.remove('hidden');
      if (charsPager) charsPager.textContent = '';
    } else {
      const charIds = realmChars.map((c) => c.user_id);
      const [profRes, namesRes] = await Promise.all([
        supabase.from('raiddominion_profiles').select('id, slug, display_name, character_name').in('id', charIds),
        getPublicAccountNames(charIds),
      ]);
      const profiles = new Map<string, ProfileLight>();
      if (!profRes.error) {
        (profRes.data as ProfileLight[]).forEach((p) => profiles.set(p.id, p));
      }
      const accountNames = new Map<string, PublicAccountNames>();
      namesRes.forEach((v, k) => accountNames.set(k, v));

      const facets: Array<Facet<CharacterRow>> = [
        {
          id: 'clase',
          label: 'Filtrar personajes por clase',
          getValues: (c) => (c.class ? [c.class] : []),
        },
        {
          kind: 'flag',
          id: 'validado',
          label: 'Filtrar personajes validados',
          getFlag: (c) => !!c.member_verified,
          chipLabel: 'Validado',
          icon: 'validado',
        },
        {
          kind: 'flag',
          id: 'gm',
          label: 'Filtrar personajes maestros de hermandad',
          getFlag: (c) => !!c.sv_is_gm,
          chipLabel: 'Maestro',
          icon: 'estrella',
        },
      ];
      // Vista acotada a este reino: sin chip de reino (hideRealm), conserva servidor.
      mountPagedList<CharacterRow>({
        mount: document.getElementById('rv-chars-filtro') as HTMLElement,
        items: realmChars,
        pageSize: PAGE_SIZE_GRID,
        pager: charsPager,
        container: charsEl,
        renderItem: (c) => renderCharacterCard(c, { profiles, names: accountNames, hideRealm: true }),
        getSearchText: (c) => `${c.name} ${c.class ?? ''} ${c.sv_guild_name ?? ''}`,
        searchPlaceholder: 'Buscar personaje…',
        searchLabel: 'Buscar personajes por nombre, clase o hermandad',
        facets,
        resultNoun: (n) => `${n} personaje${n === 1 ? '' : 's'}`,
        emptyMessage: (state) => state.query.trim()
          ? `Ningún personaje coincide con "${state.query.trim()}".`
          : 'No hay personajes que coincidan con los filtros.',
      });
    }

    // Bandas públicas del reino (capa solo por reino, como las guilds) con
    // fusión de bandas integradas (mismo criterio que el directorio /bandas).
    const available: string[] = ['hermandades', 'personajes'];
    const bandsRes = await getRealmBands(realm);
    const realmBands = bandsRes.ok ? (bandsRes.bands ?? []) : [];
    (document.getElementById('rv-stat-bands') as HTMLElement).textContent = String(realmBands.length);
    if (realmBands.length > 0) {
      const owners = await resolveBandOwners(realmBands);
      const merged = mergeDirectoryBands(realmBands, owners);
      // Modelo compartido /bandas (renderBandasPanel): filtro por día +
      // grupos de días lunes→domingo por hora en grilla responsive.
      renderBandasPanel({
        filtro: document.getElementById('rv-bandas-filtro') as HTMLElement,
        content: document.getElementById('rv-bandas') as HTMLElement,
        items: merged,
        getSchedule: (item) => item.b.schedule,
        // Búsqueda por nombre de banda / jugadores / personaje / hermandad.
        getSearchText: (item) => [
          item.b.name,
          Array.isArray(item.b.players) ? (item.b.players as Array<{ name?: string }>).map((p) => p.name).join(' ') : '',
          item.b.character_name,
          owners.get(item.b.guild_id || item.b.owner_id)?.label,
        ].filter(Boolean).join(' '),
        renderCard: (item) => renderBandCard(item.b, { source: item.source, playerCount: item.playerCount, owner: owners.get(item.b.guild_id || item.b.owner_id), guildId: item.b.guild_id }),
      });
      if (merged.length > 0) available.push('bandas');
    }

    initAvailableTabs({ barId: 'rv-tab-bar', tabs: REINO_TABS, available, leftSepId: 'rv-left-sep' });

    showView('view-reino');
  }
</script>