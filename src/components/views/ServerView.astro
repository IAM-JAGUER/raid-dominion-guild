---
// Vista de DETALLE DE SERVIDOR (/servidor/:server), resuelta 100% en cliente.
// Auto-gate: primer segmento "servidor" y exactamente 2 segmentos.
// Muestra la dirección realmlist del servidor y los reinos que aloja, cada
// uno enlazando a su vista anidada /servidor/:server/reino/:realm.
import { ui } from '@/lib/ui/design';
import Icon from '@/components/ui/Icon.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
---
<section id="view-servidor" class="hidden">
  <header class={`animate-fade-in-1 ${ui.zone.hero}`}>
    <div class={`${ui.plaque} p-5 sm:p-7`}>
      <span class={ui.cardTop} aria-hidden="true"></span>
      <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8">
        <!-- Medallón héroe (póster): arte nativo del sprite a tamaño protagonista. -->
        <div class={`${ui.iconTile} rd-medallion-hero ${ui.iconTileHero}`}>
          <Icon name="servidor" size="hero" />
        </div>
        <div class="flex-1 min-w-0">
          <p class={`${ui.eyebrow} mb-2`}>Servidor (realmlist)</p>
          <h1 id="sv-server" class={`${ui.titleFicha} break-all ${ui.gradientTitle}`}></h1>
          <p id="sv-summary" class={`${ui.text.body} italic mt-3 max-w-3xl`}></p>
        </div>
      </div>
    </div>
  </header>

  <!-- Esqueleto de página (modelo dashboard): separador central + separador
       izquierdo (esta vista no tiene barra de tabs). -->
  <div class={`${ui.dividerFadeBoth} mt-6`} aria-hidden="true"></div>
  <div class={`${ui.dividerFadeRight} mt-8 mb-10`} aria-hidden="true"></div>

  <PanelWindow title="Reinos" icon="vientos">
    <div slot="head" class="mt-4" id="sv-realms-filtro"></div>
    <div id="sv-realms" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    <div id="sv-realms-pager" class="mt-3"></div>
  </PanelWindow>
  <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
</section>

<script>
  import { getServerRealms } from '@/lib/api';
  import { currentSegments, showNotFound, showView, slugify } from '@/lib/routes';
  import { cardLink, cardTitle, iconTileEl } from '@/lib/ui/card';
  import { ui } from '@/lib/ui/design';
  import { el, setBreadcrumb } from '@/lib/ui/dom';
  import { createFilterBar } from '@/lib/ui/filterBar';
  import { createPaginator, PAGE_SIZE_GRID } from '@/lib/ui/paginator';

  const seg = currentSegments();
  if (seg[0]?.toLowerCase() === 'servidor' && seg.length === 2) {
    const server = seg[1];
    if (!server) {
      showNotFound('Servidor no encontrado.');
    } else {
      const res = await getServerRealms(server);
      if (!res.ok) {
        showNotFound('No se pudo cargar este servidor.');
      } else if (!res.realms || res.realms.length === 0) {
        showNotFound('Este servidor no tiene datos públicos todavía.');
      } else {
        render(server, res.realms);
      }
    }
  }

  async function render(server: string, realms: string[]): Promise<void> {
    document.title = `${server} - RaidDominion`;
    (document.getElementById('sv-server') as HTMLElement).textContent = server;
    setBreadcrumb(server);

    (document.getElementById('sv-summary') as HTMLElement).textContent =
      'Servidor con hermandades y personajes públicos de la comunidad RaidDominion.';

    realms.sort((a, b) => a.localeCompare(b));

    const realmsEl = document.getElementById('sv-realms') as HTMLElement;
    const pagerEl = document.getElementById('sv-realms-pager') as HTMLElement | null;

    createFilterBar({
      mount: document.getElementById('sv-realms-filtro') as HTMLElement,
      items: realms,
      getSearchText: (realm) => realm,
      searchPlaceholder: 'Buscar reino…',
      searchLabel: 'Buscar reinos por nombre',
      resultNoun: (n) => `${n} reino${n === 1 ? '' : 's'}`,
      onChange: (filtered, state) => {
        if (pagerEl) pagerEl.textContent = '';
        realmsEl.innerHTML = '';
        if (filtered.length === 0) {
          const msg = state.query.trim()
            ? `Ningún reino coincide con "${state.query.trim()}".`
            : 'No hay reinos que coincidan con los filtros.';
          realmsEl.appendChild(el('p', `${ui.text.bodyMuted} italic col-span-full`, msg));
          return;
        }
        const paginator = createPaginator({
          pageSize: PAGE_SIZE_GRID,
          totalItems: filtered.length,
          summary: `${filtered.length} reino${filtered.length === 1 ? '' : 's'}`,
          renderPage: (page) => {
            realmsEl.innerHTML = '';
            const start = (page - 1) * PAGE_SIZE_GRID;
            filtered.slice(start, start + PAGE_SIZE_GRID).forEach((realm) => {
              realmsEl.appendChild(realmCard(server, realm));
            });
          },
        });
        if (pagerEl && paginator.bar) pagerEl.appendChild(paginator.bar);
        paginator.update();
      },
    });

    showView('view-servidor');
  }

  function realmCard(server: string, realm: string): HTMLElement {
    const cardEl = cardLink(`/servidor/${encodeURIComponent(server)}/reino/${encodeURIComponent(slugify(realm))}`, 'p-5');
    const head = el('div', 'flex items-center gap-3 mb-2');
    head.appendChild(iconTileEl('vientos'));
    head.appendChild(cardTitle(realm, 'text-xl', 'truncate min-w-0'));
    cardEl.appendChild(head);
    cardEl.appendChild(el('p', `${ui.text.bodyMuted} mt-2`, 'Hermandades y personajes públicos →'));
    return cardEl;
  }
</script>