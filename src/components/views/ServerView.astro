---
// Vista de DETALLE DE SERVIDOR (/servidor/:server), resuelta 100% en cliente.
// Auto-gate: primer segmento "servidor" y exactamente 2 segmentos.
// Muestra la dirección realmlist del servidor y los reinos que aloja, cada
// uno enlazando a su vista anidada /servidor/:server/reino/:realm.
---
<section id="view-servidor" class="hidden">
  <header class="bg-gradient-to-br from-gray-900/80 to-gray-800/50 border border-amber-600/25 rounded-lg p-8 animate-fade-in-1 mb-6">
    <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1">Servidor (realmlist)</p>
    <h1 id="sv-server" class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wide break-all"></h1>
    <p id="sv-summary" class="text-sm text-gray-400 italic mt-3"></p>
  </header>
  <div id="sv-body" class="space-y-6"></div>
</section>

<script>
  import { getServerRealms } from '@/lib/api';
  import { currentSegments, isReserved, showNotFound, showView, slugify } from '@/lib/routes';

  const seg = currentSegments();
  if (seg[0]?.toLowerCase() === 'servidor' && seg.length === 2 && !isReserved('servidor')) {
    const server = seg[1];
    if (!server) {
      showNotFound('Servidor no encontrado.');
    } else {
      const res = await getServerRealms(server);
      if (!res.ok) {
        showNotFound('No se pudo cargar este servidor.');
      } else if (!res.realms || res.realms.length === 0) {
        showNotFound('Este servidor no tiene datos públicos todavía.');
      } else {
        render(server, res.realms);
      }
    }
  }

  function el(tag: string, cls: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  async function render(server: string, realms: string[]): Promise<void> {
    document.title = `${server} - RaidDominion`;
    (document.getElementById('sv-server') as HTMLElement).textContent = server;
    (document.getElementById('sv-summary') as HTMLElement).textContent =
      `${realms.length} reino${realms.length === 1 ? '' : 's'} alojado${realms.length === 1 ? '' : 's'} en este servidor`;

    const body = document.getElementById('sv-body') as HTMLElement;
    const grid = el('div', 'grid grid-cols-1 md:grid-cols-2 gap-4');

    realms.sort((a, b) => a.localeCompare(b)).forEach((realm) => {
      const card = el('a', 'group block bg-gray-900/60 border border-amber-600/25 hover:border-amber-500/50 rounded-lg p-5 transition-all duration-300 transform hover:-translate-y-0.5') as HTMLAnchorElement;
      card.href = `/servidor/${encodeURIComponent(server)}/reino/${encodeURIComponent(slugify(realm))}`;
      card.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1', 'Reino'));
      card.appendChild(el('h2', 'text-xl font-bold text-white group-hover:text-amber-200 transition-colors', realm));
      card.appendChild(el('p', 'text-sm text-gray-400 mt-2', 'Hermandades y personajes públicos →'));
      grid.appendChild(card);
    });

    body.appendChild(grid);
    showView('view-servidor');
  }
</script>