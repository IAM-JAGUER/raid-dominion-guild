---
// Vista pública POR PERSONAJE (/personaje/:slug), resuelta 100% en cliente.
// Auto-gate: solo actúa cuando el primer segmento de la ruta es "personaje".
import { ui } from '@/lib/ui/design';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import Icon from '@/components/ui/Icon.astro';
---
<section id="view-personaje" class="hidden">
  <header class={`animate-fade-in-1 ${ui.zone.hero}`}>
    <div class={`${ui.plaque} p-5 sm:p-7`}>
      <span class={ui.cardTop} aria-hidden="true"></span>
      <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8">
        <!-- Medallón héroe: arte NATIVO del sprite (nítido hasta 80px) con halo
             del color de clase. La clase como tal vive en su chip, con la
             miniatura JPG a 20px (el asset es de 18px: a 96px se veía borroso). -->
        <div id="pv-avatar" class={`${ui.iconTile} rd-medallion-hero ${ui.iconTileHero}`}>
          <Icon name="personaje" size="hero" />
        </div>
        <div class="flex-1 min-w-0 text-left">
          <p class={`${ui.eyebrow} mb-2`}>Personaje</p>
          <h1 id="pv-name" class={`${ui.titleFicha} break-words ${ui.gradientTitle}`}></h1>
          <div id="pv-stats" class="flex flex-wrap items-center mt-5"></div>
          <div id="pv-chips" class="flex flex-wrap justify-start gap-2 mt-4"></div>
          <div id="pv-links" class="flex flex-wrap justify-start gap-2 mt-3"></div>
        </div>
      </div>
    </div>
  </header>

  <!-- Navegación entre paneles (modelo dashboard): solo las secciones con
       contenido generan pestaña (initAvailableTabs). -->
  <nav id="pv-tab-bar" role="tablist" aria-label="Secciones del personaje" class={`hidden flex flex-nowrap items-center gap-1 rd-tabbar relative ${ui.zone.tabs} animate-fade-in-1 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden`}></nav>

  <div id="pv-panels" class={ui.zone.body}>
    <PanelWindow id="panel-equipamiento" title="Equipamiento" icon="arma" pad="lg" role="tabpanel" ariaLabelledby="tab-equipamiento" hidden>
      <div slot="head" id="pv-equip-summary" class="hidden mt-4"></div>
      <div id="pv-equip-list"></div>
    </PanelWindow>

    <PanelWindow id="panel-metas" title="Metas" icon="estrella" pad="lg" role="tabpanel" ariaLabelledby="tab-metas" hidden>
      <div id="pv-metas"></div>
    </PanelWindow>

    <PanelWindow id="panel-notas" title="Notas" icon="nota" pad="lg" role="tabpanel" ariaLabelledby="tab-notas" hidden>
      <div id="pv-notas"></div>
    </PanelWindow>

    <PanelWindow id="panel-instancias" title="Instancias" icon="ciudadela" pad="lg" role="tabpanel" ariaLabelledby="tab-instancias" hidden>
      <div id="pv-instancias"></div>
    </PanelWindow>

    <PanelWindow id="panel-bandas" title="Bandas" icon="espadas" pad="lg" role="tabpanel" ariaLabelledby="tab-bandas" hidden>
      <div slot="head">
        <!-- Barra de filtros estándar (buscador + chips de día) del motor
             src/lib/ui/filterBar.ts, vía el modelo renderBandasPanel. -->
        <div class="mt-4" id="pv-bandas-filtro" data-rd-reveal-cards></div>
      </div>
      <div id="pv-bandas" class="space-y-8"></div>
    </PanelWindow>

    <PanelWindow id="panel-hermandad" title="Hermandad" icon="hermandad" pad="lg" role="tabpanel" ariaLabelledby="tab-hermandad" hidden>
      <div id="pv-guilds" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div>
    </PanelWindow>
  </div>

  <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
  <!-- Contexto del personaje (servidor/reino): va DESPUÉS del separador
       final para liberar el encabezado. -->
  <div id="pv-context" class={ui.contextStrip}></div>
</section>

<script>
  import { getPublicCharacterBySlug, getPublicBandsForCharacter, getPublicGuildByOwner, getPublicAccountNames, type CharacterRow } from '@/lib/api';
  import type { ProfileRow } from '@/types/database';
  import { currentSection, currentSlug, showNotFound, showView } from '@/lib/routes';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { classColor } from '@/lib/ui/classColors';
  import { safePlayerName, isNamelessSafe, handleFromSlug, declaredPrincipalPublic } from '@/lib/ui/playerNames';
  import { itemQualityColor, itemQualityCountLabel, equipmentSlotLabel, wowItemUrl } from '@/lib/ui/itemQuality';
  import { applyWowhead } from '@/lib/ui/wowhead';
  import { card, cardTop, iconTileEl, itemRow, serverRealmLinks, statCell } from '@/lib/ui/card';
  import { chip, el, iconChip, setBreadcrumb } from '@/lib/ui/dom';
  import { iconEl } from '@/lib/ui/icons';
  import { renderBandCard, renderGuildCard } from '@/lib/ui/cards';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';
  import { resolveBandOwners, type OwnerRef } from '@/lib/bandListing';
  import { PERSONAJE_TABS, initAvailableTabs } from '@/lib/ui/tabs';
  import { ui } from '@/lib/ui/design';

  if (currentSection() === 'personaje') {
    const slug = currentSlug();
    if (!slug) {
      showNotFound('Este personaje no existe, es privado o cambió su enlace.');
    } else {
      const res = await getPublicCharacterBySlug(slug);
      if (!res.ok || !res.result) {
        showNotFound('Este personaje no existe, es privado o cambió su enlace.');
      } else {
        render(res.result.character, res.result.profile);
      }
    }
  }

  async function render(c: CharacterRow, p?: ProfileRow): Promise<void> {
    document.title = `${c.name}${c.realm ? ' - ' + c.realm : ''} - RaidDominion`;
    (document.getElementById('pv-name') as HTMLElement).textContent = c.name;
    setBreadcrumb(c.name);

    // Halo del medallón héroe con el color de clase (el arte no se recolorea).
    const avatar = document.getElementById('pv-avatar') as HTMLElement;
    const tint = classColor(c.class, c.class_file);
    if (tint) {
      avatar.style.setProperty('--rd-hero-tint', tint);
      avatar.style.borderColor = tint;
    }

    // Tira de cifras del póster: las magnitudes del personaje en grande.
    const stats = document.getElementById('pv-stats') as HTMLElement;
    if (typeof c.level === 'number') stats.appendChild(statCell('Nivel', c.level));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) stats.appendChild(statCell('ilvl medio', c.avg_ilvl));
    const pieces = (c.equipment ?? []).length;
    if (pieces > 0) stats.appendChild(statCell('Piezas', pieces));

    const chips = document.getElementById('pv-chips') as HTMLElement;
    if (c.class) {
      // La clase lleva su miniatura JPG a 20px (el asset es de 18px: nítido
      // a este tamaño; a 96px se veía borroso). El chip nombra la clase, la
      // imagen es decorativa.
      const clsChip = chip(c.class, '', 'md');
      const clsImg = classIconEl(c.class, c.class_file, 'w-5 h-5 rounded-[3px] border border-brand-600/30 object-cover shrink-0');
      clsImg.alt = '';
      clsChip.insertBefore(clsImg, clsChip.firstChild);
      chips.appendChild(clsChip);
    }
    if (c.member_verified) chips.appendChild(iconChip('validado', 'Validado', '!text-emerald-300 !border-emerald-600/40', 'md'));
    if (c.sv_guild_name) {
      chips.appendChild(iconChip(
        c.sv_is_gm ? 'estrella' : 'hermandad',
        c.sv_is_gm ? `${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}`,
        c.sv_is_gm ? '!text-fuchsia-300 !border-fuchsia-500/40' : '!text-brand-200 !border-brand-600/30',
        'md'
      ));
    }

    // Servidor/reino viven en la tira de contexto tras el separador final
    // (#pv-context), no en el encabezado. Sin datos no se desoculta (la fila
    // del helper siempre existe, vacía).
    const ctx = document.getElementById('pv-context') as HTMLElement;
    if (c.server || c.realm) {
      ctx.appendChild(serverRealmLinks(c));
      ctx.classList.remove('hidden');
    }

    const links = document.getElementById('pv-links') as HTMLElement;
    // Nombres públicos + ¿hay un personaje maestro PÚBLICO?
    const namesRes = await getPublicAccountNames([c.user_id]);
    const info = namesRes.get(c.user_id);
    if (p?.slug) {
      const a = document.createElement('a');
      a.href = `/jugador/${p.slug}`;
      a.className = `${ui.badge} ${ui.badgeMd} bg-brand-800/60 border-brand-600/20 text-brand-200 hover:bg-brand-800/80 transition-all`;
      // Un personaje solo se atribuye a un jugador, nunca a otro personaje: si
      // el perfil dueño no declara nombre visible, la cuenta cae al handle
      // estable @hex del perfil, no al personaje público más relevante.
      // Solo un personaje declarado como principal Y público se usa como nombre.
      const principal = declaredPrincipalPublic(p, info?.publicNames);
      const label = isNamelessSafe(p, { publicNames: info?.publicNames, fallbackName: principal })
        ? handleFromSlug(p.slug)
        : safePlayerName(p, { publicNames: info?.publicNames, fallbackName: principal });
      a.textContent = `Cuenta de ${label} →`;
      links.appendChild(a);
    }
    // Paneles ventana (modelo dashboard): Equipamiento / Metas / Bandas /
    // Hermandad. Cada panel con contenido agrega su pestaña (initAvailableTabs).
    const available: string[] = [];

    const equip = equipmentList(c);
    if (equip) {
      (document.getElementById('pv-equip-list') as HTMLElement).appendChild(equip);
      // Resumen de calidades en la cabecera del panel (dimensión que el héroe
      // no muestra: cuántas épicas/legendarias lleva puestas).
      const summary = qualitySummary(c);
      if (summary) {
        const box = document.getElementById('pv-equip-summary') as HTMLElement;
        box.appendChild(summary);
        box.classList.remove('hidden');
      }
      available.push('equipamiento');
    }

    const metas = objectivesPanel(c);
    if (metas) {
      (document.getElementById('pv-metas') as HTMLElement).appendChild(metas);
      available.push('metas');
    }

    const notas = notePanel(c);
    if (notas) {
      (document.getElementById('pv-notas') as HTMLElement).appendChild(notas);
      available.push('notas');
    }

    const instancias = instancesPanel(c);
    if (instancias) {
      (document.getElementById('pv-instancias') as HTMLElement).appendChild(instancias);
      available.push('instancias');
    }

    const bands = await getPublicBandsForCharacter(c.name);
    const bandList = bands.ok ? (bands.bands ?? []) : [];
    if (bandList.length > 0) {
      // Cards de banda ESTÁNDAR (modelo del directorio /bandas) con ATRIBUCIÓN;
      // también el layout (filtro por día + grupos de días responsive) viene
      // del modelo compartido renderBandasPanel.
      const owners = await resolveBandOwners(bandList.map((b) => ({ guild_id: b.guildId ?? null, owner_id: b.ownerId ?? '' })));
      renderBandasPanel({
        filtro: document.getElementById('pv-bandas-filtro') as HTMLElement,
        content: document.getElementById('pv-bandas') as HTMLElement,
        items: bandList,
        getSchedule: (b) => b.schedule ?? null,
        // Búsqueda por nombre de banda / personaje (este) / hermandad dueña.
        getSearchText: (b) => [
          b.name,
          c.name,
          b.role ?? '',
          owners.get((b.guildId || b.ownerId) ?? '')?.label,
        ].filter(Boolean).join(' '),
        renderCard: (b) => bandCard(b, owners.get((b.guildId || b.ownerId) ?? '')),
      });
      available.push('bandas');
    }

    // Panel "Hermandad": solo si ESTE personaje es rango 0 de la hermandad a
    // la que pertenece (sv_is_gm + sv_guild_name) y esa hermandad es pública;
    // nunca se le atribuye una hermandad ajena aunque la cuenta sea maestro
    // de otra. Card estándar del directorio /hermandades (renderGuildCard).
    const myGuildName = c.sv_guild_name?.trim().toLowerCase();
    if (c.sv_is_gm && myGuildName) {
      const gRes = await getPublicGuildByOwner(c.user_id);
      if (gRes.ok && gRes.guild?.is_public && gRes.guild.name.trim().toLowerCase() === myGuildName) {
        (document.getElementById('pv-guilds') as HTMLElement).appendChild(renderGuildCard(gRes.guild));
        available.push('hermandad');
      }
    }

    initAvailableTabs({ barId: 'pv-tab-bar', tabs: PERSONAJE_TABS, available });

    wireParticleTheme(c);

    showView('view-personaje');
  }

  // Tinte de las partículas de la página: color de clase por defecto y, con la
  // pestaña "Equipamiento" activa, la paleta de calidades del equipo real del
  // personaje (épico/legendario dominan). El motor (src/lib/ui/particles.ts)
  // escucha `rd:particles`; el observer vive solo mientras la vista esté viva.
  function wireParticleTheme(c: CharacterRow): void {
    const classPalette = [classColor(c.class, c.class_file)];
    const qualityColors = new Map<number, string>();
    (c.equipment ?? []).forEach((piece) => {
      if (typeof piece.quality === 'number' && piece.quality > 0) {
        qualityColors.set(piece.quality, itemQualityColor(piece.quality));
      }
    });
    const qualityPalette = Array.from(qualityColors.keys())
      .sort((a, b) => b - a)
      .slice(0, 4)
      .map((q) => qualityColors.get(q) ?? '#ffffff');

    const activePanel = (): string => {
      const wrap = document.getElementById('pv-panels');
      if (!wrap) return '';
      const shown = Array.from(wrap.querySelectorAll<HTMLElement>('[role="tabpanel"]')).find(
        (panel) => !panel.classList.contains('hidden'),
      );
      return (shown?.id ?? '').replace(/^panel-/, '');
    };

    const emit = (): void => {
      const palette = activePanel() === 'equipamiento' && qualityPalette.length > 0
        ? qualityPalette
        : classPalette;
      window.dispatchEvent(new CustomEvent('rd:particles', { detail: { palette } }));
    };

    const wrap = document.getElementById('pv-panels');
    if (wrap) {
      // createTabBar alterna `hidden` en los paneles (click, teclado y hash):
      // observar esa clase es la señal única de "cambió la pestaña activa".
      const observer = new MutationObserver(emit);
      observer.observe(wrap, { subtree: true, attributes: true, attributeFilter: ['class'] });
    }
    emit();
  }

  // Panel "Equipamiento": grilla de tarjetas de ítem (póster, design.md §12).
  // Cada pieza: el slot como etiqueta, el NOMBRE del objeto como protagonista
  // (color de calidad del juego) y el ilvl como cifra; el enlace abre la
  // búsqueda del objeto en UltimoWoW (el SV no guarda itemID del equipo).
  function equipmentList(c: CharacterRow): HTMLElement | null {
    const eq = c.equipment ?? [];
    if (eq.length === 0) return null;
    const list = el('div', 'grid grid-cols-1 md:grid-cols-2 gap-2');
    [...eq].sort((a, b) => a.slot - b.slot).forEach((piece) => {
      list.appendChild(itemRow({
        slot: equipmentSlotLabel(piece.slot),
        name: piece.name,
        quality: piece.quality,
        value: `i${piece.ilvl}`,
        href: wowItemUrl(piece.name),
        hrefTitle: `Ver "${piece.name}" en UltimoWoW`,
      }));
    });
    return list;
  }

  // Resumen de calidades del equipo (cabecera del panel): "4 épicas · 12 raras".
  function qualitySummary(c: CharacterRow): HTMLElement | null {
    const counts = new Map<number, number>();
    (c.equipment ?? []).forEach((piece) => {
      if (typeof piece.quality === 'number') {
        counts.set(piece.quality, (counts.get(piece.quality) ?? 0) + 1);
      }
    });
    if (counts.size === 0) return null;
    const row = el('div', 'flex flex-wrap items-center gap-2');
    Array.from(counts.entries())
      .sort((a, b) => b[0] - a[0])
      .forEach(([quality, n]) => {
        const badge = el('span', `${ui.badge} ${ui.badgeSm} bg-brand-950/60 border-brand-700/40 text-gray-300`);
        const dot = el('span', 'w-2 h-2 rounded-full shrink-0');
        dot.style.backgroundColor = itemQualityColor(quality);
        badge.appendChild(dot);
        badge.appendChild(document.createTextNode(itemQualityCountLabel(quality, n)));
        row.appendChild(badge);
      });
    return row;
  }

  // Panel "Metas": lo que el personaje publica para la comunidad (equipo que
  // busca y monedas que persigue). Devuelve null si no hay metas (los SV
  // anteriores a 3.0.1 no las traen) y entonces la pestaña no se genera.
  // Usa el MISMO lenguaje de ítem que Equipamiento (design.md §12).
  function objectivesPanel(c: CharacterRow): HTMLElement | null {
    const equipment = [...(c.objectives?.equipment ?? [])].sort((a, b) => a.slot - b.slot);
    const currencies = [...(c.objectives?.currencies ?? [])];
    if (equipment.length === 0 && currencies.length === 0) return null;

    const pendingOf = <T extends { done: boolean } | { reached: boolean }>(list: T[]): number => {
      let n = 0;
      list.forEach((g) => {
        const flag = 'done' in g ? g.done : (g as { reached: boolean }).reached;
        if (flag) n += 1;
      });
      return list.length - n;
    };

    // Sub-cabecera de bloque: eyebrow + contador enmarcado (la etiqueta ya no
    // flota sola sobre la atmósfera).
    const sectionHead = (label: string, pending: number, total: number): HTMLElement => {
      const head = el('div', 'flex items-center justify-between gap-3 mb-3');
      head.appendChild(el('p', ui.eyebrow, label));
      head.appendChild(el('span', `${ui.badge} ${ui.badgeSm} bg-brand-950/60 border-brand-700/40 text-gray-300`, `faltan ${pending} de ${total}`));
      return head;
    };

    const wrap = el('div', 'space-y-8');

    if (equipment.length > 0) {
      const list = el('div', 'grid grid-cols-1 md:grid-cols-2 gap-2');
      equipment.forEach((goal) => {
        const row = itemRow({
          slot: equipmentSlotLabel(goal.slot),
          name: goal.name,
          quality: goal.quality,
          value: typeof goal.ilvl === 'number' ? `i${goal.ilvl}` : undefined,
          done: goal.done,
          leading: iconEl(goal.done ? 'correcto' : 'reloj', { size: 'md', cls: 'shrink-0' }),
          href: wowItemUrl(goal.name),
          hrefTitle: `Ver "${goal.name}" en UltimoWoW`,
        }) as HTMLAnchorElement;
        // Con itemID del SV, tooltip rico del widget de Wowhead; sin él (SVs
        // que no exportan metas con id), búsqueda por nombre en UltimoWoW.
        if (typeof goal.itemID === 'number') {
          row.removeAttribute('title');
          applyWowhead(row, { type: 'item', id: goal.itemID, label: goal.name, raw: goal.name });
        }
        list.appendChild(row);
      });
      const section = el('div', '');
      section.appendChild(sectionHead('Equipo buscado', pendingOf(equipment), equipment.length));
      section.appendChild(list);
      wrap.appendChild(section);
    }

    if (currencies.length > 0) {
      const list = el('div', 'grid grid-cols-1 md:grid-cols-2 gap-2');
      currencies.forEach((goal) => {
        list.appendChild(itemRow({
          name: goal.name,
          done: goal.reached,
          rail: '#0C74A8',
          leading: iconEl(goal.reached ? 'correcto' : 'medalla', { size: 'md', cls: 'shrink-0' }),
          value: goal.reached ? undefined : `${goal.target}`,
        }));
      });
      const section = el('div', '');
      section.appendChild(sectionHead('Monedas', pendingOf(currencies), currencies.length));
      section.appendChild(list);
      wrap.appendChild(section);
    }

    return wrap;
  }

  // Panel "Notas": la nota del personaje SOLO llega por la vista pública cuando
  // su dueño activó "Nota pública" (raiddominion_character_notes es privada).
  // Devuelve null sin nota → la pestaña no se genera.
  function notePanel(c: CharacterRow): HTMLElement | null {
    const note = (c.note ?? '').trim();
    if (!note) return null;
    const wrap = el('div', '');
    wrap.appendChild(el('p', `${ui.eyebrow} mb-3`, 'Nota del jugador'));
    // Superficie real (pergamino) en vez de línea translúcida: la nota es
    // contenido, no metadata.
    wrap.appendChild(el('p', `${ui.surf.row} rd-parchment p-4 sm:p-5 text-sm sm:text-base text-gray-200 leading-relaxed whitespace-pre-line`, note));
    return wrap;
  }

  // Cuenta atrás "2d 4h" / "5h 20m" / "30m" / "ahora" — mismo formato que el
  // addon (RD_Utils_Instances.FormatRemaining).
  function formatRemaining(seconds: number): string {
    const secs = Math.max(0, Math.floor(seconds));
    if (secs <= 0) return 'ahora';
    const days = Math.floor(secs / 86400);
    const hours = Math.floor((secs % 86400) / 3600);
    const mins = Math.floor((secs % 3600) / 60);
    if (days > 0) return hours > 0 ? `${days}d ${hours}h` : `${days}d`;
    if (hours > 0) return mins > 0 ? `${hours}h ${mins}m` : `${hours}h`;
    return `${Math.max(1, mins)}m`;
  }

  // Panel "Instancias": snapshot de los lockouts guardados (addon 3.1.0).
  // `resetAt` es una época absoluta capturada al pulsar "Registrar": la cuenta
  // atrás es una ESTIMACIÓN según ese registro (se indica en el title).
  function instancesPanel(c: CharacterRow): HTMLElement | null {
    const instances = [...(c.instances ?? [])];
    if (instances.length === 0) return null;
    const now = Date.now() / 1000;
    // Con reloj primero, por reinicio más próximo (mismo orden que el addon).
    instances.sort((a, b) => {
      const ra = typeof a.resetAt === 'number' && a.resetAt > 0 ? a.resetAt : Number.POSITIVE_INFINITY;
      const rb = typeof b.resetAt === 'number' && b.resetAt > 0 ? b.resetAt : Number.POSITIVE_INFINITY;
      if (ra !== rb) return ra - rb;
      return a.name.localeCompare(b.name);
    });

    const wrap = el('div', '');
    wrap.appendChild(el('p', `${ui.eyebrow} mb-3`, `Instancias guardadas · ${instances.length}`));
    const list = el('div', 'grid grid-cols-1 md:grid-cols-2 gap-2');
    instances.forEach((instance) => {
      const slot = [instance.difficulty, instance.extended ? 'extendido' : ''].filter(Boolean).join(' · ');
      let valueEl: HTMLElement | undefined;
      if (!instance.extended && typeof instance.resetAt === 'number' && instance.resetAt > 0) {
        const remaining = instance.resetAt - now;
        if (remaining <= 0) {
          // Ya venció: el reinicio ocurrió desde el último registro.
          valueEl = el('span', 'shrink-0 text-[10px] font-black uppercase tracking-widest text-emerald-300', 'Reiniciado');
        } else {
          valueEl = el('span', `${ui.statValue} ${ui.item.value}`, formatRemaining(remaining));
          valueEl.title = 'Cuenta atrás estimada según el último registro del addon';
        }
      }
      list.appendChild(itemRow({
        slot: slot || undefined,
        name: instance.name,
        leading: iconEl('ciudadela', { size: 'md', cls: 'shrink-0' }),
        rail: '#0C74A8',
        valueEl,
      }));
    });
    wrap.appendChild(list);
    return wrap;
  }

  // Card de banda con el modelo estándar del directorio /bandas (renderBandCard);
  // distingue si está integrada a una hermandad. Sin slug (banda pública sin
  // ficha) se muestra una card no enlazable con el mismo modelo visual.
  function bandCard(b: { name: string; slug?: string; schedule?: string; minGS?: number; role?: string; integrated?: boolean; guildId?: string | null; ownerId?: string }, owner?: OwnerRef): HTMLElement {
    if (b.slug) {
      return renderBandCard({ slug: b.slug, name: b.name, schedule: b.schedule ?? null, min_gs: b.minGS ?? null, guildId: b.guildId ?? null }, { integrated: b.integrated, owner });
    }
    const cardEl = card('p-5');
    cardEl.appendChild(cardTop());
    const head = el('div', 'flex items-center gap-3 mb-3');
    head.appendChild(iconTileEl('espadas'));
    head.appendChild(el('h3', 'font-black italic text-base leading-[1.3] text-white', b.name));
    cardEl.appendChild(head);
    const parts: string[] = [];
    if (b.schedule) parts.push(b.schedule);
    if (typeof b.minGS === 'number' && b.minGS > 0) parts.push(`GS ${b.minGS}`);
    if (parts.length > 0) {
      const chips = el('div', 'flex flex-wrap gap-1.5');
      parts.forEach((p) => chips.appendChild(el('span', `${ui.badge} ${ui.badgeSm} bg-brand-800/60 border-brand-600/20 text-gray-300`, p)));
      cardEl.appendChild(chips);
    }
    cardEl.appendChild(el('p', 'text-xs text-gray-400 mt-4', 'Sin ficha pública'));
    return cardEl;
  }
</script>
