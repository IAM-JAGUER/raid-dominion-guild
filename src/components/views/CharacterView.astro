---
// Vista pública POR PERSONAJE (/personaje/:slug), resuelta 100% en cliente.
// Auto-gate: solo actúa cuando el primer segmento de la ruta es "personaje".
---
<section id="view-personaje" class="hidden">
  <header class="bg-gradient-to-br from-gray-900/80 to-gray-800/50 border border-amber-600/25 rounded-md p-6 sm:p-8 animate-fade-in-1 mb-6">
    <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-2 flex items-center">
      <svg class="w-3.5 h-3.5 mr-1.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
      <span>Personaje</span>
    </p>
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <div id="pv-avatar" class="w-20 h-20 rounded-md bg-gradient-to-br from-amber-600/25 to-amber-800/25 border border-amber-600/30 flex items-center justify-center text-4xl font-black italic text-amber-300 shadow-lg shrink-0"></div>
      <div class="flex-1 min-w-0 text-center sm:text-left">
        <h1 id="pv-name" class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wide break-words"></h1>
        <div id="pv-chips" class="flex flex-wrap justify-center sm:justify-start gap-2 mt-3"></div>
        <div id="pv-links" class="flex flex-wrap justify-center sm:justify-start gap-2 mt-3"></div>
      </div>
    </div>
  </header>

  <div id="pv-body" class="space-y-6"></div>
</section>

<script>
  import { getPublicCharacterBySlug, getPublicBandsForCharacter, getPublicGuildByOwner, getPublicAccountNames, type CharacterRow } from '@/lib/api';
  import type { ProfileRow } from '@/types/database';
  import { currentSection, currentSlug, showNotFound, showView, slugify } from '@/lib/routes';
  import { classColor } from '@/lib/ui/classColors';
  import { safePlayerName, isNamelessSafe, handleFromSlug } from '@/lib/ui/playerNames';
  import { itemQualityColor, equipmentSlotLabel, roleLabel } from '@/lib/ui/itemQuality';

  if (currentSection() === 'personaje') {
    const slug = currentSlug();
    if (!slug) {
      showNotFound('Este personaje no existe, es privado o cambió su enlace.');
    } else {
      const res = await getPublicCharacterBySlug(slug);
      if (!res.ok || !res.result) {
        showNotFound('Este personaje no existe, es privado o cambió su enlace.');
      } else {
        render(res.result.character, res.result.profile);
      }
    }
  }

  function el(tag: string, cls: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function chip(text: string, extra = ''): HTMLElement {
    return el('span', 'px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-800/60 border border-amber-600/20' + (extra ? ` ${extra}` : ''), text);
  }

  function linkChip(text: string, href: string, extra = ''): HTMLElement {
    const a = el('a', 'px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest text-sky-200 bg-sky-950/40 border border-sky-600/30 hover:bg-sky-900/40 transition-all' + (extra ? ` ${extra}` : ''), text);
    (a as HTMLAnchorElement).href = href;
    return a;
  }

  async function render(c: CharacterRow, p?: ProfileRow): Promise<void> {
    document.title = `${c.name}${c.realm ? ' - ' + c.realm : ''} - RaidDominion`;
    (document.getElementById('pv-avatar') as HTMLElement).textContent = (c.name || '?')[0].toUpperCase();
    (document.getElementById('pv-name') as HTMLElement).textContent = c.name;
    (window as unknown as { __rdBreadcrumb?: { setLabel: (l: string) => void } }).__rdBreadcrumb?.setLabel(c.name);

    const chips = document.getElementById('pv-chips') as HTMLElement;
    if (c.server) chips.appendChild(linkChip(c.server, `/servidor/${encodeURIComponent(c.server)}`));
    if (c.realm && c.server) {
      chips.appendChild(linkChip(c.realm, `/servidor/${encodeURIComponent(c.server)}/reino/${encodeURIComponent(slugify(c.realm))}`));
    } else if (c.realm) {
      chips.appendChild(chip(c.realm));
    }
    if (c.class) chips.appendChild(chip(c.class));
    if (typeof c.level === 'number') chips.appendChild(chip(`Nivel ${c.level}`));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) chips.appendChild(chip(`ilvl ${c.avg_ilvl}`, '!text-amber-300 !border-amber-500/40'));
    if (c.member_verified) chips.appendChild(chip('✓ Validado', '!text-emerald-300 !border-emerald-600/40'));
    if (c.sv_guild_name) {
      chips.appendChild(chip(
        c.sv_is_gm ? `★ ${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}`,
        c.sv_is_gm ? '!text-fuchsia-300 !border-fuchsia-500/40' : '!text-sky-200 !border-sky-600/30'
      ));
    }

    const links = document.getElementById('pv-links') as HTMLElement;
    // Nombres públicos + ¿hay un personaje maestro PÚBLICO?
    const namesRes = await getPublicAccountNames([c.user_id]);
    const info = namesRes.get(c.user_id);
    if (p?.slug) {
      const a = document.createElement('a');
      a.href = `/jugador/${p.slug}`;
      a.className = 'inline-flex items-center px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border bg-gray-800/60 border-amber-600/20 text-amber-200 hover:bg-gray-800/80 transition-all';
      // Un personaje solo se atribuye a un jugador, nunca a otro personaje: si
      // el perfil dueño no declara nombre visible, la cuenta cae al handle
      // estable @hex del perfil, no al personaje público más relevante.
      const label = isNamelessSafe(p, { publicNames: info?.publicNames })
        ? handleFromSlug(p.slug)
        : safePlayerName(p, { publicNames: info?.publicNames, fallbackName: info?.principal });
      a.textContent = `Cuenta de ${label} →`;
      links.appendChild(a);
    }
    // El enlace "★ Hermandad" solo aplica si ESTE personaje es rango 0 de la
    // hermandad a la que pertenece (sv_is_gm + sv_guild_name); nunca se le
    // atribuye una hermandad ajena aunque la cuenta sea maestro de otra.
    const myGuildName = c.sv_guild_name?.trim().toLowerCase();
    if (c.sv_is_gm && myGuildName) {
      const gRes = await getPublicGuildByOwner(c.user_id);
      if (gRes.ok && gRes.guild?.is_public && gRes.guild.name.trim().toLowerCase() === myGuildName) {
        const a = document.createElement('a');
        a.href = `/${gRes.guild.slug}`;
        a.className = 'inline-flex items-center px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border bg-fuchsia-950/40 border-fuchsia-500/40 text-fuchsia-300 hover:bg-fuchsia-900/40 transition-all';
        a.textContent = `★ ${gRes.guild.name}`;
        links.appendChild(a);
      }
    }

    const body = document.getElementById('pv-body') as HTMLElement;
    body.appendChild(statsCard(c));
    const eq = equipmentCard(c);
    if (eq) body.appendChild(eq);
    const bands = await getPublicBandsForCharacter(c.name, c.sv_guild_name);
    if (bands.ok && bands.bands && bands.bands.length > 0) body.appendChild(bandsCard(bands.bands));

    showView('view-personaje');
  }

  function statsCard(c: CharacterRow): HTMLElement {
    const card = el('div', 'bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6');
    const color = classColor(c.class, c.class_file);
    const head = el('div', 'flex items-center gap-3 mb-4');
    const avatar = el('div', 'w-11 h-11 rounded-md flex items-center justify-center font-black italic text-lg shrink-0 shadow-lg border border-gray-700/50');
    avatar.style.backgroundColor = `${color}26`;
    avatar.style.color = color;
    avatar.textContent = (c.name || '?')[0].toUpperCase();
    head.appendChild(avatar);
    const name = el('h2', 'font-black italic text-lg');
    name.style.color = color;
    name.textContent = `${c.name}${c.realm ? '-' + c.realm : ''}`;
    head.appendChild(name);
    card.appendChild(head);

    const stats = el('div', 'grid grid-cols-3 gap-3');
    const stat = (label: string, value: string | number): HTMLElement => {
      const box = el('div', 'text-center bg-gray-900/50 border border-amber-600/20 rounded-md px-2 py-3');
      box.appendChild(el('p', 'text-2xl font-black text-amber-200 italic', String(value)));
      box.appendChild(el('p', 'text-[9px] font-black uppercase tracking-widest text-gray-500', label));
      return box;
    };
    stats.appendChild(stat('Nivel', c.level ?? '—'));
    stats.appendChild(stat('ilvl', c.avg_ilvl ?? '—'));
    stats.appendChild(stat('Clase', c.class ?? '—'));
    card.appendChild(stats);
    return card;
  }

  function equipmentCard(c: CharacterRow): HTMLElement | null {
    const eq = c.equipment ?? [];
    if (eq.length === 0) return null;
    const card = el('div', 'bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6');
    card.appendChild(el('h2', 'text-lg font-bold text-amber-200 mb-4 flex items-center', 'Equipamiento'));
    card.querySelector('h2')?.prepend(el('span', 'w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]'));
    const list = el('div', 'grid grid-cols-1 gap-1');
    [...eq].sort((a, b) => a.slot - b.slot).forEach((piece) => {
      const qc = itemQualityColor(piece.quality);
      const row = el('div', 'flex items-center gap-2 rounded px-2 py-1 bg-gray-900/40 border-l-2');
      row.style.borderColor = qc;
      row.appendChild(el('span', 'text-[9px] text-gray-500 uppercase shrink-0 w-12', equipmentSlotLabel(piece.slot)));
      const nm = el('span', 'text-xs truncate');
      nm.style.color = qc;
      nm.textContent = piece.name;
      row.appendChild(nm);
      row.appendChild(el('span', 'text-xs text-gray-400 shrink-0', `i${piece.ilvl}`));
      list.appendChild(row);
    });
    card.appendChild(list);
    return card;
  }

  function bandsCard(bands: Array<{ name: string; schedule?: string; minGS?: number; role?: string }>): HTMLElement {
    const card = el('div', 'bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6');
    card.appendChild(el('h2', 'text-lg font-bold text-amber-200 mb-4 flex items-center', 'Bandas de raid'));
    card.querySelector('h2')?.prepend(el('span', 'w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]'));
    const list = el('div', 'flex flex-wrap gap-2');
    bands.forEach((b) => {
      const parts = [b.name];
      const rol = roleLabel(b.role);
      if (rol) parts.push(rol);
      if (b.schedule) parts.push(b.schedule);
      if (typeof b.minGS === 'number' && b.minGS > 0) parts.push(`GS ${b.minGS}`);
      list.appendChild(el('span', 'px-3 py-1.5 rounded-md text-[11px] font-bold text-amber-200 bg-amber-900/20 border border-amber-600/30', parts.join(' · ')));
    });
    card.appendChild(list);
    return card;
  }
</script>
