---
// Vista pública POR PERSONAJE (/personaje/:slug), resuelta 100% en cliente.
// Auto-gate: solo actúa cuando el primer segmento de la ruta es "personaje".
import { ui } from '@/lib/ui/design';
---
<section id="view-personaje" class="hidden">
  <header class="animate-fade-in-1 mb-6">
    <p class={`${ui.eyebrow} mb-2 flex items-center`}>
      <svg class="w-3.5 h-3.5 mr-1.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
      <span>Personaje</span>
    </p>
    <div class="flex flex-col sm:flex-row items-start gap-5">
      <div id="pv-avatar" class={`${ui.iconTile} w-24 h-24 overflow-hidden shadow-lg`}></div>
      <div class="flex-1 min-w-0 text-left">
        <h1 id="pv-name" class="text-3xl md:text-5xl font-black italic text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 leading-[1.3] break-words"></h1>
        <div id="pv-chips" class="flex flex-wrap justify-start gap-2 mt-3"></div>
        <div id="pv-links" class="flex flex-wrap justify-start gap-2 mt-3"></div>
      </div>
    </div>
    <div class={`${ui.dividerFadeRight} mt-6`} aria-hidden="true"></div>
  </header>

  <!-- Navegación entre paneles (modelo dashboard): solo las secciones con
       contenido generan pestaña (initAvailableTabs). -->
  <nav id="pv-tab-bar" role="tablist" aria-label="Secciones del personaje" class="hidden flex flex-nowrap items-center gap-1 rd-tabbar relative mb-6 animate-fade-in-1 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"></nav>

  <div id="pv-panels" class="space-y-6">
    <div id="panel-equipamiento" role="tabpanel" aria-labelledby="tab-equipamiento" class="hidden">
      <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}>
        <h2 class={`text-lg font-bold flex items-center ${ui.gradientTitle}`}>
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Equipamiento
        </h2>
      </div>
      <div class={`${ui.sectionBody}`}>
        <div id="pv-equip-list" class="grid grid-cols-1 gap-1"></div>
      </div>
    </div>

    <div id="panel-bandas" role="tabpanel" aria-labelledby="tab-bandas" class="hidden">
      <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}>
        <h2 class={`text-lg font-bold flex items-center ${ui.gradientTitle}`}>
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Bandas
        </h2>
      </div>
      <div class={`${ui.sectionBody}`}>
        <div id="pv-bandas" class="flex flex-wrap gap-2"></div>
      </div>
    </div>

    <div id="panel-hermandad" role="tabpanel" aria-labelledby="tab-hermandad" class="hidden">
      <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}>
        <h2 class={`text-lg font-bold flex items-center ${ui.gradientTitle}`}>
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Hermandad
        </h2>
      </div>
      <div class={`${ui.sectionBody}`}>
        <div id="pv-guilds" class="space-y-3"></div>
      </div>
    </div>
  </div>

  <!-- Servidor/reino viven en la tira de contexto al final del contenido, no
       en el encabezado (mismo criterio que /jugador). -->
  <div id="pv-context" class="hidden flex flex-wrap gap-2"></div>
  <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
</section>

<script>
  import { getPublicCharacterBySlug, getPublicBandsForCharacter, getPublicGuildByOwner, getPublicAccountNames, type CharacterRow } from '@/lib/api';
  import type { ProfileRow } from '@/types/database';
  import { currentSection, currentSlug, showNotFound, showView, slugify } from '@/lib/routes';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { safePlayerName, isNamelessSafe, handleFromSlug } from '@/lib/ui/playerNames';
  import { itemQualityColor, equipmentSlotLabel, roleLabel, wowItemUrl } from '@/lib/ui/itemQuality';
  import { cardLink, stat } from '@/lib/ui/card';
  import { PERSONAJE_TABS, initAvailableTabs } from '@/lib/ui/tabs';
  import { ui } from '@/lib/ui/design';

  if (currentSection() === 'personaje') {
    const slug = currentSlug();
    if (!slug) {
      showNotFound('Este personaje no existe, es privado o cambió su enlace.');
    } else {
      const res = await getPublicCharacterBySlug(slug);
      if (!res.ok || !res.result) {
        showNotFound('Este personaje no existe, es privado o cambió su enlace.');
      } else {
        render(res.result.character, res.result.profile);
      }
    }
  }

  function el(tag: string, cls: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function chip(text: string, extra = ''): HTMLElement {
    return el('span', `${ui.badge} ${ui.badgeMd} bg-gray-800/60 border-amber-600/20` + (extra ? ` ${extra}` : ''), text);
  }

  // Chip de cifra: etiqueta muted + valor con degradado vertical (ui.statValue).
  function statChip(label: string, value: string, extra = ''): HTMLElement {
    const c = el('span', `${ui.badge} ${ui.badgeMd} bg-gray-800/60 border-amber-600/20` + (extra ? ` ${extra}` : ''));
    c.appendChild(el('span', 'text-gray-400', label));
    c.appendChild(stat(value, 'text-sm'));
    return c;
  }

  // Enlaces de contexto: servidor (realmlist) y reino → jerarquía del directorio.
  function serverRealmLinks(c: CharacterRow): HTMLElement {
    const row = el('div', 'flex flex-wrap gap-1.5');
    if (c.server) {
      const s = document.createElement('a');
      s.href = `/servidor/${encodeURIComponent(c.server)}`;
      s.className = `${ui.badge} ${ui.badgeMd} text-sky-200 bg-sky-950/40 border-sky-600/30 hover:bg-sky-900/40 transition-all`;
      s.textContent = c.server;
      row.appendChild(s);
    }
    if (c.realm) {
      const r = document.createElement(c.server ? 'a' : 'span');
      const cls = `${ui.badge} ${ui.badgeMd} text-gray-300 bg-gray-800/60 border-amber-600/20`;
      if (c.server) {
        (r as HTMLAnchorElement).href = `/servidor/${encodeURIComponent(c.server)}/reino/${encodeURIComponent(slugify(c.realm))}`;
        r.className = `${cls} hover:bg-gray-800/80 transition-all`;
      } else {
        r.className = cls;
      }
      r.textContent = c.realm;
      row.appendChild(r);
    }
    return row;
  }

  async function render(c: CharacterRow, p?: ProfileRow): Promise<void> {
    document.title = `${c.name}${c.realm ? ' - ' + c.realm : ''} - RaidDominion`;
    (document.getElementById('pv-avatar') as HTMLElement).replaceChildren(classIconEl(c.class, c.class_file, 'w-full h-full object-cover'));
    (document.getElementById('pv-name') as HTMLElement).textContent = c.name;
    (window as unknown as { __rdBreadcrumb?: { setLabel: (l: string) => void } }).__rdBreadcrumb?.setLabel(c.name);

    const chips = document.getElementById('pv-chips') as HTMLElement;
    if (c.class) chips.appendChild(chip(c.class));
    if (typeof c.level === 'number') chips.appendChild(statChip('Nivel', String(c.level)));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) chips.appendChild(statChip('ilvl', String(c.avg_ilvl), '!text-amber-300 !border-amber-500/40'));
    if (c.member_verified) chips.appendChild(chip('✓ Validado', '!text-emerald-300 !border-emerald-600/40'));
    if (c.sv_guild_name) {
      chips.appendChild(chip(
        c.sv_is_gm ? `★ ${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}`,
        c.sv_is_gm ? '!text-fuchsia-300 !border-fuchsia-500/40' : '!text-sky-200 !border-sky-600/30'
      ));
    }

    // Servidor/reino al final del contenido (tira de contexto), liberando el
    // encabezado para clase/cifras/hermandad.
    const ctx = document.getElementById('pv-context') as HTMLElement;
    ctx.appendChild(serverRealmLinks(c));
    if (ctx.children.length > 0) ctx.classList.remove('hidden');

    const links = document.getElementById('pv-links') as HTMLElement;
    // Nombres públicos + ¿hay un personaje maestro PÚBLICO?
    const namesRes = await getPublicAccountNames([c.user_id]);
    const info = namesRes.get(c.user_id);
    if (p?.slug) {
      const a = document.createElement('a');
      a.href = `/jugador/${p.slug}`;
      a.className = `${ui.badge} ${ui.badgeMd} bg-gray-800/60 border-amber-600/20 text-amber-200 hover:bg-gray-800/80 transition-all`;
      // Un personaje solo se atribuye a un jugador, nunca a otro personaje: si
      // el perfil dueño no declara nombre visible, la cuenta cae al handle
      // estable @hex del perfil, no al personaje público más relevante.
      const label = isNamelessSafe(p, { publicNames: info?.publicNames })
        ? handleFromSlug(p.slug)
        : safePlayerName(p, { publicNames: info?.publicNames, fallbackName: info?.principal });
      a.textContent = `Cuenta de ${label} →`;
      links.appendChild(a);
    }
    // Paneles ventana (modelo dashboard): Equipamiento / Bandas / Hermandad.
    // Cada panel con contenido agrega su pestaña (initAvailableTabs).
    const available: string[] = [];

    const equip = equipmentList(c);
    if (equip) {
      (document.getElementById('pv-equip-list') as HTMLElement).appendChild(equip);
      available.push('equipamiento');
    }

    const bands = await getPublicBandsForCharacter(c.name);
    const bandList = bands.ok ? (bands.bands ?? []) : [];
    if (bandList.length > 0) {
      (document.getElementById('pv-bandas') as HTMLElement).appendChild(bandChips(bandList));
      available.push('bandas');
    }

    // Panel "Hermandad": solo si ESTE personaje es rango 0 de la hermandad a
    // la que pertenece (sv_is_gm + sv_guild_name) y esa hermandad es pública;
    // nunca se le atribuye una hermandad ajena aunque la cuenta sea maestro
    // de otra.
    const myGuildName = c.sv_guild_name?.trim().toLowerCase();
    if (c.sv_is_gm && myGuildName) {
      const gRes = await getPublicGuildByOwner(c.user_id);
      if (gRes.ok && gRes.guild?.is_public && gRes.guild.name.trim().toLowerCase() === myGuildName) {
        const a = cardLink(`/hermandad/${gRes.guild.slug}`, 'p-4');
        a.appendChild(el('h3', `${ui.gradientTitle} font-bold text-sm`, gRes.guild.name));
        const meta = [gRes.guild.realm, gRes.guild.server].filter(Boolean).join(' · ');
        a.appendChild(el('p', 'text-xs text-gray-500 mt-1', meta ? meta : 'Ver portal →'));
        (document.getElementById('pv-guilds') as HTMLElement).appendChild(a);
        available.push('hermandad');
      }
    }

    initAvailableTabs({ barId: 'pv-tab-bar', tabs: PERSONAJE_TABS, available });

    showView('view-personaje');
  }

  // Lista de equipamiento del panel (filas slot · ítem · ilvl).
  function equipmentList(c: CharacterRow): HTMLElement | null {
    const eq = c.equipment ?? [];
    if (eq.length === 0) return null;
    const list = el('div', 'grid grid-cols-1 gap-1');
    [...eq].sort((a, b) => a.slot - b.slot).forEach((piece) => {
      const qc = itemQualityColor(piece.quality);
      const row = el('div', 'flex items-center gap-2 rounded-md px-2 py-1 bg-gray-900/40 border-l-2 hover:bg-gray-800/50 transition-colors');
      row.style.borderColor = qc;
      row.appendChild(el('span', 'text-[9px] text-gray-500 uppercase shrink-0 w-12', equipmentSlotLabel(piece.slot)));
      const nm = el('a', 'text-xs truncate hover:underline');
      nm.style.color = qc;
      nm.textContent = piece.name;
      nm.setAttribute('href', wowItemUrl(piece.name));
      nm.setAttribute('target', '_blank');
      nm.setAttribute('rel', 'noopener noreferrer');
      nm.setAttribute('title', `Ver "${piece.name}" en UltimoWoW`);
      row.appendChild(nm);
      row.appendChild(el('span', `text-xs shrink-0 ${ui.statValue}`, `i${piece.ilvl}`));
      list.appendChild(row);
    });
    return list;
  }

  // Chips del panel "Bandas": enlazan a /banda/:slug cuando existe slug.
  function bandChips(bands: Array<{ name: string; slug?: string; schedule?: string; minGS?: number; role?: string }>): HTMLElement {
    const list = el('div', 'flex flex-wrap gap-2');
    bands.forEach((b) => {
      const parts = [b.name];
      const rol = roleLabel(b.role);
      if (rol) parts.push(rol);
      if (b.schedule) parts.push(b.schedule);
      if (typeof b.minGS === 'number' && b.minGS > 0) parts.push(`GS ${b.minGS}`);
      const chipCls = 'px-3 py-1.5 rounded-md text-[11px] font-bold text-amber-200 bg-amber-900/20 border border-amber-600/30';
      if (b.slug) {
        const a = el('a', `${chipCls} hover:bg-amber-800/30 hover:border-amber-400/60 transition-all`, parts.join(' · '));
        (a as HTMLAnchorElement).href = `/banda/${b.slug}`;
        list.appendChild(a);
      } else {
        list.appendChild(el('span', chipCls, parts.join(' · ')));
      }
    });
    return list;
  }
</script>
