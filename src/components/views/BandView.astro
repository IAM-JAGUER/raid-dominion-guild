---
// Vista pública DE BANDA (/banda/:slug), resuelta 100% en cliente.
// Auto-gate: primer segmento "banda". Resuelve desde la tabla raiddominion_bands
// (guild_id NULLABLE: una banda puede ser personal o de hermandad). Muestra
// horario, GS mínimo, roster (players[] con role/dual/leader/banned/sanction/
// points) y reglas, con enlace a la hermandad (/:guildSlug) o al perfil del
// dueño (/jugador/:slug) según corresponda.
import { ui } from '@/lib/ui/design';
---
<section id="view-banda" class="hidden">
  <header class="animate-fade-in-1 mb-6">
    <p class={`${ui.eyebrow} mb-1 flex items-center`}>
      <svg class="w-3.5 h-3.5 mr-1.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2c-.17-1.24-1.03-2.29-2.2-2.72M7 20H2v-2a3 3 0 015.2-2.11M9 9a3 3 0 100-6 3 3 0 000 6z"/></svg>
      <span>Banda de raid</span>
    </p>
    <div class="flex flex-wrap items-end gap-3">
      <h1 id="bv-name" class="text-3xl md:text-5xl font-black italic text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 leading-[1.3] break-all"></h1>
      <a id="bv-owner-link" href="#" class={`hidden ${ui.badge} ${ui.badgeMd} bg-sky-950/40 border-sky-600/30 text-sky-200 hover:bg-sky-900/40 transition-all`}></a>
    </div>
    <div id="bv-meta" class="flex flex-wrap gap-2 mt-4"></div>
    <div class={`${ui.divider} mt-6`} aria-hidden="true"></div>
  </header>

  <nav id="band-tab-bar" role="tablist" aria-label="Secciones de la banda" class="flex flex-nowrap items-center gap-1 mb-6 border-b border-amber-600/30 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"></nav>

  <div id="panel-core" role="tabpanel" aria-labelledby="tab-core" class="space-y-6">
    <!-- Mismo modelo de ventana que el roster de hermandad/dashboard:
         cabecera contigua (título + controles de filtro) + cuerpo con el
         roster del core. -->
    <div>
      <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}>
        <h2 class={`text-lg font-bold flex items-center ${ui.gradientTitle}`}>
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Core
        </h2>
        <details id="bv-filtro-clases" class={`${ui.disclosure} mt-4 hidden`}>
          <summary class={ui.disclosureSummary}>
            <span class="inline-flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10v-1a3 3 0 00-3-3h-4a3 3 0 00-3 3v1zm0 0v-3a3 3 0 01-3-3V7a3 3 0 013-3h10a3 3 0 013 3v8a3 3 0 01-3 3v3m-9-7h.01M9 6h.01m.01-1h.01"/></svg>
              Clases
            </span>
            <svg class="w-4 h-4 text-amber-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class={ui.disclosureBody}>
            <div id="bv-stats-classes" class="grid grid-cols-2 gap-2 content-start min-w-0"></div>
          </div>
        </details>
        <div id="bv-search-wrap" class="hidden mt-4">
          <div class="relative">
            <svg class="w-4 h-4 text-amber-400/70 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
            <input
              id="bv-search"
              type="search"
              autocomplete="off"
              class={`${ui.form.input} ${ui.focusRing} pl-9 pr-3`}
              placeholder="Buscar jugador por nombre…"
              aria-label="Buscar jugador por nombre"
            />
          </div>
        </div>
      </div>
      <div class={`${ui.sectionBody} space-y-5`}>
        <p id="bv-empty-filter" class={`hidden ${ui.text.bodyMuted} italic text-center bg-gray-900/40 border border-amber-600/20 rounded-md p-4`}>
          Ningún jugador coincide con estos filtros.
        </p>
        <div id="bv-core"></div>
      </div>
    </div>
  </div>

  <div id="panel-reglas" role="tabpanel" aria-labelledby="tab-reglas" class="hidden space-y-6">
    <div>
      <div class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}>
        <h2 class={`text-lg font-bold flex items-center ${ui.gradientTitle}`}>
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Reglas
        </h2>
      </div>
      <div class={`${ui.sectionBody} space-y-5`}>
        <div id="bv-rules"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { getPublicBandBySlug, listGuildPortalBands, getPublicAccountNames, getPublicCharacterSlugsByNames, getGuildBandIntegrationRules, type BandRow } from '@/lib/api';
  import { supabase } from '@/lib/supabase';
  import { currentSlug, showNotFound, showView } from '@/lib/routes';
  import { renderBandCore } from '@/lib/ui/preview';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { createTabBar, BAND_TABS, tabFromHash } from '@/lib/ui/tabs';
  import { ui } from '@/lib/ui/design';
  import { safePlayerName, isNamelessSafe, handleFromSlug } from '@/lib/ui/playerNames';
  import { bandMergeKey, mergeBandPlayers, type MergePlayer } from '@/lib/bandMerge';

  if (isBandRoute()) {
    const slug = currentSlug();
    if (!slug) {
      showNotFound('Banda no encontrada.');
    } else {
      const res = await getPublicBandBySlug(slug);
      if (!res.ok || !res.band) {
        showNotFound('Esta banda no existe o no es pública.');
      } else {
        await render(res.band);
      }
    }
  }

  function isBandRoute(): boolean {
    return window.location.pathname.split('/').filter(Boolean)[0]?.toLowerCase() === 'banda';
  }

  function el(tag: string, cls: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function metaChip(text: string, extra = ''): HTMLElement {
    return el('span', `${ui.badge} ${ui.badgeMd} bg-gray-800/60 border-amber-600/20` + (extra ? ` ${extra}` : ''), text);
  }

  function emptyState(text: string): HTMLElement {
    const box = el('div', 'rounded-md border border-amber-600/20 bg-gray-900/40 p-6 text-center');
    box.appendChild(el('p', `${ui.text.bodyMuted} italic`, text));
    return box;
  }

  interface BandRule {
    title?: string;
    content?: string;
    icon?: string;
  }

  async function render(band: BandRow): Promise<void> {
    document.title = `${band.name || 'Banda'} - RaidDominion`;
    (document.getElementById('bv-name') as HTMLElement).textContent = band.name || 'Sin nombre';
    (window as unknown as { __rdBreadcrumb?: { setLabel: (l: string) => void } }).__rdBreadcrumb?.setLabel(band.name || 'Banda');

    const ownerLink = document.getElementById('bv-owner-link') as HTMLAnchorElement;
    const owner = await resolveOwner(band);
    if (owner) {
      ownerLink.href = owner.href;
      ownerLink.textContent = owner.label;
      ownerLink.classList.remove('hidden');
    }

    const meta = document.getElementById('bv-meta') as HTMLElement;
    if (band.schedule) meta.appendChild(metaChip(`Horario: ${band.schedule}`));
    if (typeof band.min_gs === 'number' && band.min_gs > 0) meta.appendChild(metaChip(`GS mínimo: ${band.min_gs}`, '!text-amber-300 !border-amber-500/40'));
    if (band.guild_id && band.is_rank_integrated) {
      meta.appendChild(metaChip('Integrada', '!text-emerald-300 !border-emerald-500/40'));
    }
    // Jugadores combinados: si la banda está integrada a una hermandad, se
    // unen los rosters de todas las bandas del mismo grupo (clave name|horario|
    // GS), deduplicando por nombre y destacando la fuente de la integración.
    const merged = await resolveMergeGroup(band);
    const players = merged.players;
    if (band.hide_players) {
      meta.appendChild(metaChip('jugadores ocultos', '!text-gray-500'));
    }

    const coreBox = document.getElementById('bv-core') as HTMLElement;

    // Core (antes "Roster"): lista de asistencia estilo raids de guild-portal,
    // agrupada por rol con cabeceras colapsables.
    if (band.hide_players) {
      coreBox.appendChild(emptyState('Esta banda mantiene oculta su lista de jugadores al público.'));
    } else if (players.length === 0) {
      coreBox.appendChild(emptyState('Esta banda aún no tiene jugadores asignados.'));
    } else {
      // Slugs públicos de los jugadores del core → enlaces a /personaje/:slug.
      let slugMap: Record<string, string> = {};
      try {
        const slugRes = await getPublicCharacterSlugsByNames(players.map((p) => p.name).filter((n): n is string => !!n));
        if (slugRes.ok && slugRes.slugs) slugMap = slugRes.slugs;
      } catch {
        // Silencioso: el core se renderiza sin enlaces si la consulta falla.
      }
      const mergedOpts = { sourceNames: merged.sourceNames, slugMap };

      // Filtros del core (mismo patrón que el roster de hermandad): chips de
      // clase + buscador por nombre. Ambos filtran players y re-renderizan el
      // core con renderBandCore, conservando los badges de integración de cada
      // jugador (puede haber varios) y los enlaces a ficha pública.
      const state: { cls?: string; query: string } = { query: '' };
      const classesBox = document.getElementById('bv-stats-classes') as HTMLElement;
      const classesFilter = document.getElementById('bv-filtro-clases') as HTMLElement;
      const searchWrap = document.getElementById('bv-search-wrap') as HTMLElement;
      const searchInput = document.getElementById('bv-search') as HTMLInputElement;
      const emptyFilter = document.getElementById('bv-empty-filter') as HTMLElement;

      const classChip = (o: { label: string; count: number; cls?: string; active: boolean }): HTMLButtonElement => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const key = o.cls ? o.cls.toLowerCase() : '__none__';
        btn.className = 'w-full min-w-0 rounded-md px-3 py-2 border text-left transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ' +
          (o.active
            ? 'text-amber-200 border-amber-500/60 bg-gradient-to-b from-amber-900/40 to-amber-950/40 ring-2 ring-amber-400/60'
            : 'text-gray-200 bg-gradient-to-b from-gray-800/80 to-gray-900/80 border-amber-600/25 hover:border-amber-500/40 hover:from-gray-700/70');
        btn.setAttribute('aria-pressed', String(o.active));
        btn.setAttribute('data-class-key', key);
        const nameRow = el('div', 'flex items-center gap-1.5 mb-1 min-w-0');
        nameRow.appendChild(classIconEl(o.cls, undefined, 'w-4 h-4 rounded-sm border border-gray-700/50 shrink-0 object-cover'));
        nameRow.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest truncate flex-1 min-w-0', o.label));
        btn.appendChild(nameRow);
        btn.appendChild(el('span', `${ui.statValue} text-[11px]`, String(o.count)));
        return btn;
      };

      const renderChips = (): void => {
        classesBox.innerHTML = '';
        const byClass = new Map<string, { label: string; cls?: string; count: number }>();
        players.forEach((p) => {
          const cls = (p.class || '').trim();
          const key = cls ? cls.toLowerCase() : '__none__';
          const cur = byClass.get(key) ?? { label: cls || 'Sin dato', cls: cls || undefined, count: 0 };
          cur.count += 1;
          byClass.set(key, cur);
        });
        const chips = Array.from(byClass.values())
          .sort((a, b) => b.count - a.count)
          .map((c) => classChip({
            label: c.label, count: c.count, cls: c.cls,
            active: state.cls === (c.cls ? c.cls.toLowerCase() : '__none__'),
          }));
        chips.forEach((c) => classesBox.appendChild(c));
        classesFilter.classList.toggle('hidden', chips.length === 0);
      };

      const applyFilters = (): void => {
        const q = state.query.trim().toLowerCase();
        const filtered = players.filter((p) => {
          if (state.cls !== undefined) {
            const cls = (p.class || '').trim();
            if (cls.toLowerCase() !== state.cls) return false;
          }
          if (q && !(p.name || '').toLowerCase().includes(q)) return false;
          return true;
        });
        coreBox.innerHTML = '';
        if (filtered.length === 0) {
          emptyFilter.classList.remove('hidden');
        } else {
          emptyFilter.classList.add('hidden');
          coreBox.appendChild(renderBandCore(filtered, mergedOpts));
        }
      };

      classesBox.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-class-key]');
        if (!btn) return;
        const k = btn.dataset.classKey ?? '';
        state.cls = state.cls === k ? undefined : k;
        renderChips();
        applyFilters();
      });
      searchInput.addEventListener('input', () => {
        state.query = searchInput.value;
        applyFilters();
      });

      searchWrap.classList.remove('hidden');
      renderChips();
      applyFilters();
    }

    // Reglas. SIEMPRE que la banda está INTEGRADA (guild_id + is_rank_integrated)
    // — sea del GM o de un miembro — la autoridad es el visor "Bandas
    // propuestas" del GM (band_integration_rules): SOLO se publican las reglas
    // que el GM activó EXPLÍCITAMENTE. Sin selección guardada no se publica
    // ninguna. El contenido siempre se lee en vivo de bands.rules del
    // proponente. La identidad de cada regla es su TÍTULO (así los cambios de
    // CONTENIDO del proponente en reglas activadas quedan sincronizados; las
    // que añada y el GM no active, NO aparecen). Se acepta la clave legacy
    // title|content. Cuando N bandas del mismo grupo (nombre|horario|GS) se
    // combinan en el portal, se muestra la UNIÓN de las reglas activadas de
    // cada una (todas las que el GM marcó, en orden de banda). Bandas
    // personales (guild_id NULL) muestran sus reglas.
    let rules = Array.isArray(band.rules) ? (band.rules as BandRule[]) : [];
    if (band.guild_id && band.is_rank_integrated) {
      const rulesRes = await getGuildBandIntegrationRules(band.guild_id);
      const selection = rulesRes.ok && rulesRes.selection ? rulesRes.selection : {};
      // La autoridad es el visor "Bandas propuestas" del GM, banda por banda.
      // Como varias bandas del mismo grupo (nombre|horario|GS) se integran
      // como UNA en el portal, las reglas publicadas son la UNIÓN de las
      // reglas ACTIVADAS de TODAS las bandas del grupo: el GM controla cada
      // una por separado y ninguna regla activada queda fuera. Cada banda sin
      // selección guardada aporta 0 reglas (nada se publica sin activación).
      const portal = await listGuildPortalBands(band.guild_id);
      const group = portal.ok && portal.bands
        ? portal.bands.filter((x) => bandMergeKey(x) === bandMergeKey(band))
        : [];
      if (group.length === 0) group.push(band);
      const seen = new Set<string>();
      const union: BandRule[] = [];
      group.forEach((member) => {
        const list = Array.isArray(member.rules) ? (member.rules as BandRule[]) : [];
        const keys = new Set(Array.isArray(selection[member.id]) ? selection[member.id] : []);
        list.forEach((r) => {
          const t = (r.title ?? '').trim();
          const identity = (t || (r.content ?? '').trim()).toLowerCase();
          if (seen.has(identity)) return;
          if ((t && keys.has(t)) || keys.has(`${t}|${(r.content ?? '').trim()}`)) {
            seen.add(identity);
            union.push(r);
          }
        });
      });
      rules = union;
    }
    const rulesBox = document.getElementById('bv-rules') as HTMLElement;
    if (rules.length === 0) {
      rulesBox.appendChild(emptyState('Esta banda aún no publica reglas.'));
    } else {
      const list = el('ul', 'space-y-3');
      rules.forEach((rule) => {
        const li = el('li', 'text-sm text-gray-300 leading-relaxed border-l-2 border-amber-600/20 pl-3');
        if (rule.title) {
          li.appendChild(el('span', 'font-bold text-amber-200', `${rule.title}: `));
        }
        li.appendChild(document.createTextNode(rule.content || ''));
        list.appendChild(li);
      });
      rulesBox.appendChild(list);
    }

    // Conteos del encabezado (chips de Core/Reglas): grupo segmentado unificado
    // que enlaza a cada tab por hash (#core/#reglas), igual que la vista de
    // hermandad (#guild-meta). Los jugadores ocultos no exponen su cifra.
    const tabMetaChips: Record<string, HTMLAnchorElement> = {};
    const tabMetaGroup = document.createElement('div');
    tabMetaGroup.className = 'inline-flex flex-wrap gap-px rounded-md border border-amber-500/40 bg-amber-600/20 overflow-hidden';
    BAND_TABS.forEach((t) => {
      const n = t.id === 'core' ? (band.hide_players ? null : players.length) : rules.length;
      if (n === null) return;
      const chip = document.createElement('a');
      chip.href = t.href;
      chip.className = 'px-3 py-1.5 text-[10px] font-black uppercase tracking-widest transition-all duration-150 bg-gradient-to-b from-gray-900/90 to-gray-950/90 hover:from-amber-900/50 hover:to-amber-950/50 hover:text-amber-200 text-gray-400';
      chip.textContent = `${t.label} · ${n}`;
      tabMetaGroup.appendChild(chip);
      tabMetaChips[t.id] = chip;
    });
    meta.appendChild(tabMetaGroup);

    // Barra de pestañas Core/Reglas (deep-link #core/#reglas). Los conteos
    // viven en los chips del encabezado, no en los tabs.
    createTabBar({
      tabs: BAND_TABS,
      barId: 'band-tab-bar',
      defaultId: 'core',
    });

    // Ilumina el chip del tab activo (hash); se re-sincroniza al navegar por
    // hash o al pulsar un botón de la barra (activate usa replaceState).
    const syncTabMetaChips = (): void => {
      let active = tabFromHash(window.location.hash);
      if (!tabMetaChips[active]) active = 'core';
      Object.entries(tabMetaChips).forEach(([id, chip]) => {
        const on = id === active;
        chip.classList.toggle('bg-amber-500/20', on);
        chip.classList.toggle('text-amber-200', on);
        chip.classList.toggle('text-gray-400', !on);
        if (on) chip.setAttribute('aria-current', 'page');
        else chip.removeAttribute('aria-current');
      });
    };
    syncTabMetaChips();
    window.addEventListener('hashchange', syncTabMetaChips);
    document.getElementById('band-tab-bar')?.addEventListener('click', syncTabMetaChips);

    showView('view-banda');
  }

  // Jugadores combinados de una banda: si la banda está integrada a una
  // hermandad (guild_id + is_rank_integrated), se unen los rosters de todas
  // las bandas públicas del mismo grupo (clave name|horario|GS) deduplicando
  // por nombre; las fuentes de integración son los character_name de las
  // bandas de miembros (owner distinto al GM).
  async function resolveMergeGroup(band: BandRow): Promise<{ players: MergePlayer[]; sourceNames: string[] }> {
    const ownPlayers = Array.isArray(band.players) ? (band.players as MergePlayer[]) : [];
    if (!band.guild_id || !band.is_rank_integrated) {
      return { players: ownPlayers, sourceNames: [] };
    }
    const portal = await listGuildPortalBands(band.guild_id);
    if (!portal.ok || !portal.bands) return { players: ownPlayers, sourceNames: [] };
    const key = bandMergeKey(band);
    const group = portal.bands.filter((x) => bandMergeKey(x) === key);
    if (group.length === 0) return { players: ownPlayers, sourceNames: [] };
    let guildOwnerId: string | null = null;
    const gRes = await supabase
      .from('raiddominion_guilds')
      .select('owner_id')
      .eq('id', band.guild_id)
      .maybeSingle();
    if (!gRes.error && gRes.data) guildOwnerId = (gRes.data as { owner_id: string | null }).owner_id ?? null;
    const sourceNames = guildOwnerId
      ? Array.from(new Set(group.filter((g) => g.owner_id !== guildOwnerId).map((g) => g.character_name).filter((n): n is string => !!n)))
      : [];
    const players = band.hide_players ? [] : mergeBandPlayers(group);
    return { players, sourceNames };
  }

  // Enlace contextual: hermandad (si la banda tiene guild pública) o el perfil
  // del dueño (si es una banda personal y su perfil es público).
  async function resolveOwner(band: BandRow): Promise<{ href: string; label: string } | null> {
    if (band.guild_id) {
      const res = await supabase
        .from('raiddominion_guilds')
        .select('slug, name, is_public')
        .eq('id', band.guild_id)
        .maybeSingle();
      if (res.error) return null;
      const g = res.data as { slug: string; name: string; is_public: boolean } | null;
      if (!g || !g.is_public) return null;
      return { href: `/hermandad/${g.slug}`, label: `Hermandad: ${g.name}` };
    }
    const res = await supabase
      .from('raiddominion_profiles')
      .select('slug, display_name, character_name, is_public')
      .eq('id', band.owner_id)
      .maybeSingle();
    if (res.error) return null;
    const p = res.data as { slug: string | null; display_name: string | null; character_name: string | null; is_public: boolean } | null;
    if (!p || !p.is_public || !p.slug) return null;
    // No exponer un character_name que no sea público.
    const namesRes = await getPublicAccountNames([band.owner_id]);
    const info = namesRes.get(band.owner_id);
    // La banda se atribuye al JUGADOR (cuenta): si el perfil no declara nombre
    // visible, cae al handle estable @hex, nunca a otro personaje de la cuenta.
    const label = isNamelessSafe(p, { publicNames: info?.publicNames })
      ? handleFromSlug(p.slug)
      : safePlayerName(p, { publicNames: info?.publicNames, fallbackName: info?.principal });
    return { href: `/jugador/${p.slug}`, label: `Por ${label}` };
  }
</script>