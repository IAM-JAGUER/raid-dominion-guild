---
// Componente de navegación principal
import { NAV_ITEMS, SITE_CONFIG } from '../utils/constants';
import { DASHBOARD_TABS, DASHBOARD_CONFIG } from '../lib/ui/tabs';
import Icon from './ui/Icon.astro';

// Props
export interface Props {
  currentPath?: string;
  className?: string;
}

const { currentPath = '/', className = '' } = Astro.props;

// Enlaces públicos de la comunidad (directorios), visibles para todos.
// (La Guía RD es un widget flotante global vía Layout → ChatWidget; no va aquí.
// El directorio de Jugadores vive SOLO en el Footer: la barra principal se
// reserva a las dos vitrinas de contenido — bandas y hermandades.)
const PUBLIC_LINKS = [
  { name: 'Bandas', href: '/bandas', icon: 'espadas' },
  { name: 'Hermandades', href: '/hermandades', icon: 'hermandad' },
] as const;

// Icono del menú de cuenta por pestaña/acción: las pestañas ya traen su
// icono en el contrato (tabs.ts). Solo el logout conserva su trazo
// direccional (el set no tiene salida de sesión).
const LOGOUT_ICON =
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />';
---

<!-- Barra de navegación fija en la parte superior -->
<nav 
  id="main-nav" 
  class={`fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-brand-900/95 to-brand-900/95 backdrop-blur border-b border-brand-600/30 shadow-lg transition-all duration-300 ${className}`}
  aria-label="Navegación principal"
>
  <!-- Excepción del contenedor único: la barra de navegación es fixed full-width y no es
       un contenedor de contenido, por eso mantiene su propio max-w-7xl en vez de ui.container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a 
          href="/" 
          class="site-logo flex items-center"
          aria-label="Ir al inicio"
        >
          <img
            src="/logo.png"
            alt="Logo RaidDominion"
            class="h-9 w-auto mr-2 rounded"
            loading="eager"
            decoding="async"
          />
          <span class="text-xl font-bold bg-clip-text text-brand-200 bg-gradient-to-r from-brand-400 to-brand-500">
            {SITE_CONFIG.TITLE}
          </span>
        </a>
      </div>

      <!-- Navegación escritorio -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-1">
          {NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class="nav-link px-4 py-2.5 rounded-md text-sm font-medium text-brand-200 hover:bg-brand-800/40 hover:text-white transition-all duration-200 hover:scale-105 relative group"
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              <span class="relative z-10">{item.name}</span>
              <span class="absolute inset-0 bg-brand-600/20 rounded-md scale-95 opacity-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300"></span>
            </a>
          ))}
          <!-- Enlaces públicos de la comunidad -->
          <span class="w-px h-6 bg-brand-600/30 mx-1" aria-hidden="true"></span>
          {PUBLIC_LINKS.map((item) => (
            <a
              href={item.href}
              data-directory={item.href}
              class="nav-link px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-brand-800/40 hover:text-brand-200 transition-all duration-200"
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              <span class="relative z-10">{item.name}</span>
            </a>
          ))}
          <!-- Entrada de cuenta: botón para invitado, dropdown ordenado para usuario -->
          <a
            href="/login"
            data-auth-link="guest"
            class="ml-3 px-4 py-2 rounded-md text-sm font-bold text-gray-900 bg-gradient-to-r from-brand-400 to-brand-500 hover:from-brand-300 hover:to-brand-400 transition-all duration-200 hover:scale-105 shadow-lg shadow-brand-500/20"
          >Iniciar Sesión</a>
          <div class="relative hidden ml-3" data-auth-dropdown="user">
            <button
              type="button"
              data-dropdown-trigger
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="account-dropdown"
              class="flex items-center justify-center w-9 h-9 rounded-md text-brand-100 border border-brand-500/50 bg-brand-900/40 hover:bg-brand-800/60 transition-all duration-200"
              aria-label="Cuenta"
            >
              <Icon name="perfil-alt" size="sm" />
            </button>
            <div
              id="account-dropdown"
              data-dropdown-menu
              class="hidden absolute right-0 mt-2 w-56 rounded-md border border-brand-600/30 bg-brand-900/95 backdrop-blur-lg shadow-xl shadow-black/40 py-2 z-50"
              role="menu"
              aria-hidden="true"
            >
              {DASHBOARD_TABS.map((t) => (
                <a href={t.href} data-dropdown-item class="account-link block px-4 py-2.5 text-sm text-brand-200 hover:bg-brand-800/40 hover:text-white transition-all duration-150" role="menuitem">
                  <span class="inline-flex items-center gap-2">
                    <Icon name={t.icon ?? 'perfil-alt'} size="xs" class="shrink-0" />
                    {t.label}
                  </span>
                </a>
              ))}
              <a href={`/dashboard${DASHBOARD_CONFIG.hash}`} data-dropdown-item class="account-link block px-4 py-2.5 text-sm text-brand-200 hover:bg-brand-800/40 hover:text-white transition-all duration-150" role="menuitem">
                <span class="inline-flex items-center gap-2">
                  <Icon name="engranajes" size="xs" class="shrink-0" />{DASHBOARD_CONFIG.label}
                </span>
              </a>
              <div class="my-1 border-t border-brand-600/30 hidden" data-staff-sep></div>
              <a href="/moderate" data-staff-link="moderate" class="hidden account-link block px-4 py-2.5 text-sm text-brand-200 hover:bg-brand-900/30 hover:text-white transition-all duration-150" role="menuitem">
                <span class="inline-flex items-center gap-2">
                  <Icon name="balanza" size="xs" class="shrink-0" />Moderación
                </span>
              </a>
              <a href="/admin" data-staff-link="admin" class="hidden account-link block px-4 py-2.5 text-sm text-red-300 hover:bg-red-900/30 hover:text-white transition-all duration-150" role="menuitem">
                <span class="inline-flex items-center gap-2">
                  <Icon name="corona" size="xs" class="shrink-0" />Administración
                </span>
              </a>
              <div class="my-1 border-t border-brand-600/30"></div>
              <button
                type="button"
                data-auth-action="logout"
                class="w-full text-left px-4 py-2.5 text-sm font-bold uppercase tracking-widest text-red-300 hover:bg-red-900/40 hover:text-red-200 transition-all duration-150"
                role="menuitem"
              >
                <span class="inline-flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 shrink-0 text-red-400/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={LOGOUT_ICON}></svg>Cerrar Sesión
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Botón menú móvil -->
      <div class="md:hidden">
        <button 
          id="mobile-menu-button" 
          class="inline-flex items-center justify-center w-10 h-10 rounded-md text-brand-300 border border-brand-600/30 bg-brand-950/20 hover:text-brand-200 hover:border-brand-500/50 hover:bg-brand-900/30 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
          aria-label="Menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="navegacion" size="md" />
        </button>
      </div>
    </div>
  </div>

  <!-- Menú móvil: panel limpio del tema (sin material pesado por fila), filas
           con medallón de ícono + acento lateral ámbar en la ruta activa -->
  <div 
    id="mobile-menu" 
    class="md:hidden hidden bg-brand-950/90 backdrop-blur-xl border-t border-brand-600/25 shadow-2xl shadow-black/50"
    aria-hidden="true"
  >
    <div class="px-3 py-3">
      {NAV_ITEMS.map((item) => {
        let icon;
        
// Asignar icono temático según la ruta (contrato src/lib/ui/icons.ts)
        switch(item.href) {
          case '/#inicio':
            icon = <Icon name="portal" size="sm" />;
            break;
          case '/#addon':
            icon = <Icon name="libro" size="sm" />;
            break;
          case '/#donaciones':
            icon = <Icon name="trofeo" size="sm" />;
            break;
          default:
            icon = null;
        }

        return (
          <a 
            href={item.href}
            class="mobile-nav-link group relative flex items-center gap-3 w-full px-3 py-3 rounded-md text-[15px] font-medium text-gray-200 hover:text-white hover:bg-brand-900/25 hover:translate-x-1 transition-all duration-200 border-l-2 border-transparent aria-[current=page]:border-brand-500 aria-[current=page]:bg-brand-950/40 aria-[current=page]:text-brand-200"
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            <span class="w-8 h-8 shrink-0 rounded-md flex items-center justify-center bg-brand-500/10 border border-brand-600/25 text-brand-300 group-hover:bg-brand-500/20 group-hover:border-brand-500/40 transition-colors">
              {icon}
            </span>
            <span class="flex-1">{item.name}</span>
            <svg class="w-4 h-4 shrink-0 text-gray-600 group-hover:text-brand-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        );
      })}
      <!-- Comunidad (directorios públicos) -->
      <div class="mt-3 pt-3 border-t border-brand-600/15 space-y-0.5">
        <p class="rd-eyebrow px-3 pb-1 pt-0.5 text-[10px] font-black uppercase tracking-widest text-gray-500">Comunidad</p>
        {PUBLIC_LINKS.map((item) => (
          <a
            href={item.href}
            data-directory={item.href}
            class="mobile-nav-link group flex items-center gap-3 w-full px-3 py-2.5 rounded-md text-sm font-medium text-gray-300 hover:text-white hover:bg-brand-900/25 hover:translate-x-1 transition-all duration-200 border-l-2 border-transparent aria-[current=page]:border-brand-500 aria-[current=page]:text-brand-200"
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            <Icon name={item.icon} size="sm" class="shrink-0" />
            <span>{item.name}</span>
          </a>
        ))}
      </div>
      <!-- Entrada de cuenta móvil (visible según sesión): CTA limpio, dropdown
           con filas a la izquierda y punto de color, mismas reglas que el desktop -->
      <div class="mt-3 pt-3 border-t border-brand-600/15 space-y-2">
        <a
          href="/login"
          data-auth-link="guest"
          class="block w-full px-4 py-3 rounded-md text-[15px] font-bold text-center text-gray-900 bg-gradient-to-r from-brand-400 to-brand-500 hover:from-brand-300 hover:to-brand-400 hover:brightness-105 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
        >Iniciar Sesión</a>
        <div class="hidden" data-auth-dropdown="user">
          <div class="rounded-md border border-brand-600/20 bg-brand-950/70 backdrop-blur-sm overflow-hidden">
            {DASHBOARD_TABS.map((t) => (
              <a
                href={t.href}
                class="flex items-center gap-2.5 px-4 py-3 text-sm text-brand-200 hover:bg-brand-800/40 hover:text-white hover:translate-x-1 transition-all duration-150"
              >
                <Icon name={t.icon ?? 'perfil-alt'} size="sm" class="shrink-0" />
                {t.label}
              </a>
            ))}
            <a
              href={`/dashboard${DASHBOARD_CONFIG.hash}`}
              class="flex items-center gap-2.5 px-4 py-3 text-sm text-brand-200 hover:bg-brand-800/40 hover:text-white hover:translate-x-1 transition-all duration-150"
            >
              <Icon name="engranajes" size="sm" class="shrink-0" />
              {DASHBOARD_CONFIG.label}
            </a>
            <div class="my-1 border-t border-brand-600/15 hidden" data-staff-sep></div>
            <a
              href="/moderate"
              data-staff-link="moderate"
              class="hidden flex items-center gap-2.5 px-4 py-3 text-sm text-brand-200 hover:bg-brand-900/30 hover:text-white transition-all duration-150"
            >
              <Icon name="balanza" size="sm" class="shrink-0" />Moderación
            </a>
            <a
              href="/admin"
              data-staff-link="admin"
              class="hidden flex items-center gap-2.5 px-4 py-3 text-sm text-red-300 hover:bg-red-900/30 hover:text-white transition-all duration-150"
            >
              <Icon name="corona" size="sm" class="shrink-0" />Administración
            </a>
          </div>
        </div>
        <button
          type="button"
          data-auth-action="logout"
          class="hidden w-full px-4 py-3 rounded-md text-sm font-black uppercase tracking-widest text-center text-red-300 border border-red-500/30 bg-red-950/20 hover:bg-red-900/40 hover:text-red-200 transition-all duration-200"
        >
          <span class="inline-flex items-center justify-center gap-2">
            <svg class="w-4 h-4 shrink-0 text-red-400/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={LOGOUT_ICON}></svg>Cerrar Sesión
          </span>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Botones de navegación flotantes -->
<div class="fixed right-2 bottom-2 z-40 flex flex-col space-y-3">
  <button id="scroll-up" aria-label="Ir arriba" class="bg-brand-600 hover:bg-brand-500 text-brand-950 p-2 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 opacity-0 translate-y-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-2 w-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </button>
  <button id="scroll-down" aria-label="Ir abajo" class="bg-brand-600 hover:bg-brand-500 text-brand-950 p-2 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 opacity-0 translate-y-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-2 w-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
</div>

<!-- Script para la funcionalidad de navegación -->
<script>
  // Esperar a que el DOM esté completamente cargado
  document.addEventListener('DOMContentLoaded', () => {
    // Obtener referencias a los elementos del DOM
    const mobileMenuButton = document.getElementById('mobile-menu-button') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    const scrollUpBtn = document.getElementById('scroll-up') as HTMLButtonElement | null;
    const scrollDownBtn = document.getElementById('scroll-down') as HTMLButtonElement | null;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]:not(.guide-panel)'));

    // Solo las secciones REALMENTE visibles cuentan: las vistas auto-gate
    // (fichas/portal/dashboard/upload) arrancan ocultas y muestran una tras
    // resolver datos en cliente; las ocultas tienen offsetHeight 0 y NO deben
    // interferir con la detección ni con la navegación ↑/↓.
    function visibleSections(): HTMLElement[] {
      return sections.filter((s) => s.offsetHeight > 0);
    }

    // Posición absoluta de la sección en el documento (offsetTop es relativo
    // al offsetParent y se rompe dentro de contenedores .relative).
    function sectionTopY(section: HTMLElement): number {
      return section.getBoundingClientRect().top + window.scrollY;
    }
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

    // Domino activo de los directorios públicos: los enlaces con
    // data-directory se iluminan según la ruta actual (páginas índice Y
    // dinámicas como /servidor/:server, /banda/:slug, /hermandad/:slug,
    // /jugador/:slug…), que no pasan currentPath a la Navigation. Mapea el
    // primer segmento al directorio correspondiente.
    function directoryKeyFromPath(pathname: string): string | null {
      const segs = pathname.split('/').filter(Boolean).map((s) => s.toLowerCase());
      const first = segs[0] ?? '';
      if (!first) return null;
      if (first === 'servidores' || first === 'servidor' || first === 'reino') return '/servidores';
      if (first === 'bandas' || first === 'banda') return '/bandas';
      if (first === 'jugadores' || first === 'jugador') return '/jugadores';
      if (first === 'personajes' || first === 'personaje') return '/personajes';
      if (first === 'hermandades' || first === 'hermandad' || first === 'guilds') return '/hermandades';
      return null;
    }

    // Aplica/reparte el resaltado activo a los enlaces de directorio
    // (escritorio y móvil): el que coincide con el dominio recibe
    // bg-brand-800/50 text-white nav-link-active + aria-current="page"; al
    // resto se le quita y se reponen sus colores base (text-gray-300
    // escritorio / text-gray-200 móvil).
    function setDirectoryActive(): void {
      const key = directoryKeyFromPath(window.location.pathname);
      document.querySelectorAll<HTMLAnchorElement>('[data-directory]').forEach((link) => {
        const active = link.getAttribute('data-directory') === key;
        const isMobile = link.closest('#mobile-menu') !== null;
        link.classList.toggle('bg-brand-800/50', active);
        link.classList.toggle('text-white', active);
        link.classList.toggle('nav-link-active', active);
        if (active) {
          link.setAttribute('aria-current', 'page');
          link.classList.remove('text-gray-300', 'text-gray-200');
        } else {
          link.removeAttribute('aria-current');
          link.classList.add(isMobile ? 'text-gray-200' : 'text-gray-300');
          link.classList.remove(isMobile ? 'text-gray-300' : 'text-gray-200');
        }
      });
    }
    setDirectoryActive();
    
    // Variable para rastrear la sección actual
    let currentSectionIndex = 0;
    // Última sección resaltada en el menú (evita mutar clases en cada scroll,
    // lo que alimentaría al MutationObserver de los botones flotantes).
    let lastActiveSectionId = '';
    
    // Verificar que los elementos existen antes de usarlos
    if (!mobileMenuButton || !mobileMenu || !scrollUpBtn || !scrollDownBtn) {
      console.error('No se pudieron encontrar todos los elementos necesarios para la navegación');
      return;
    }
    
    // Asegurarse de que los botones sean del tipo correcto
    const upButton = scrollUpBtn;
    const downButton = scrollDownBtn;

    // Mostrar/ocultar menú móvil
    mobileMenuButton.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', !isHidden);
      mobileMenu.classList.toggle('block', isHidden);
    });

    // Cerrar menú móvil al hacer clic en un enlace
    const mobileMenuLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('block');
      });
    });

    // Función para desplazamiento suave
    function scrollToSection(sectionId: string): void {
      const element = document.querySelector<HTMLElement>(sectionId);
      if (!element) return;
      
      const headerOffset = 80; // Ajusta según la altura de tu barra de navegación
      const offsetPosition = sectionTopY(element) - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth' as ScrollBehavior
      });
    }

    // Manejar clic en los enlaces de navegación con scroll suave
    function handleNavClick(e: Event) {
      const target = e.target as HTMLElement;
      const link = target.closest('a');
      
      if (!link) return;
      
      const targetId = link.getAttribute('href');
      if (!targetId || targetId === '#') return;

      // Anclas del home: "/#seccion" o "#seccion" → scroll suave
      const anchorMatch = targetId.match(/^(?:\/#)?#([\w-]+)$/);
      if (anchorMatch) {
        const targetElement = document.getElementById(anchorMatch[1]);
        if (!targetElement) return;
        e.preventDefault();
        // Cerrar menú móvil si está abierto
        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('block');
        }
        const headerOffset = 80;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.scrollY - headerOffset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
        history.pushState(null, '', `#${anchorMatch[1]}`);
        return;
      }

      // Las rutas de página navegan normal (no son anclas del home)
      if (targetId.startsWith('/')) {
        return;
      }
    }

    // Añadir manejadores de eventos a los enlaces de navegación
    navLinks.forEach(link => {
      link.addEventListener('click', handleNavClick);
    });
    
    // Añadir manejadores de eventos a los enlaces del menú móvil
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', handleNavClick);
    });

    // Navegación con botones flotantes. Funciona siempre (aunque la página no
    // exponga secciones detectadas, ej. portal de hermandad): con esa página
    // ↑/↓ saltan al inicio/final; con secciones, navegan entre ellas.
    if (upButton && downButton) {
      // Mostrar/ocultar botones con animación
      function updateButtonVisibility(): void {
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const scrollThreshold = 100;
        const vis = visibleSections();
        const cur = Math.max(0, vis.indexOf(sections[currentSectionIndex]));

        // Botón subir: visible si hay sección anterior o ya se hizo scroll
        if (scrollY > scrollThreshold || cur > 0) {
          upButton.classList.remove('opacity-0', 'translate-y-4');
          upButton.classList.add('opacity-100', 'translate-y-0');
        } else {
          upButton.classList.add('opacity-0', 'translate-y-4');
          upButton.classList.remove('opacity-100', 'translate-y-0');
        }

        // Botón bajar: oculto en la última sección visible o al pie de página.
        // Sin secciones (portal/banda…), basta con que quede fondo por recorrer.
        const faltante = scrollY < documentHeight - windowHeight - scrollThreshold;
        const haySiguiente = vis.length > 1 ? cur < vis.length - 1 && faltante : faltante;
        if (haySiguiente) {
          downButton.classList.remove('opacity-0', 'translate-y-4');
          downButton.classList.add('opacity-100', 'translate-y-0');
        } else {
          downButton.classList.add('opacity-0', 'translate-y-4');
          downButton.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      // Actualizar detección de sección y visibilidad en un solo handler,
      // para que la visibilidad use el índice recién calculado
      function onScrollOrUpdate(): void {
        updateCurrentSection();
        updateButtonVisibility();
      }

      // Actualizar al cargar, hacer scroll y redimensionar
      window.addEventListener('scroll', onScrollOrUpdate);
      window.addEventListener('resize', onScrollOrUpdate);

      // Las vistas auto-gate se muestran tras resolver datos en cliente
      // (async): un MutationObserver re-sincroniza la detección cada vez que
      // una sección aparece u oculta (tabs, vistas, resultados de upload).
      // Coalesce por frame (rAF) para no forzar layout en cada mutación.
      let observerFrame = 0;
      new MutationObserver(() => {
        if (observerFrame) return;
        observerFrame = requestAnimationFrame(() => {
          observerFrame = 0;
          onScrollOrUpdate();
        });
      }).observe(
        document.body,
        { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] },
      );

      onScrollOrUpdate();

      // Navegar a la siguiente sección
      downButton.addEventListener('click', () => {
        const vis = visibleSections();
        const cur = Math.max(0, vis.indexOf(sections[currentSectionIndex]));
        if (vis.length > 1 && cur < vis.length - 1) {
          const next = vis[cur + 1];
          if (next) scrollToSection(`#${next.id}`);
        } else {
          // Sin secciones útiles: bajar directo al final de la página.
          window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' as ScrollBehavior });
        }
      });

      // Navegar a la sección anterior
      upButton.addEventListener('click', () => {
        const vis = visibleSections();
        const cur = Math.max(0, vis.indexOf(sections[currentSectionIndex]));
        if (vis.length > 1 && cur > 0) {
          const prev = vis[cur - 1];
          if (prev) scrollToSection(`#${prev.id}`);
        } else {
          // Si está en la primera sección (o sin secciones), ir al inicio
          window.scrollTo({ top: 0, behavior: 'smooth' as ScrollBehavior });
        }
      });
    }

    // Actualizar sección actual al hacer scroll
    function updateCurrentSection(): void {
      const vis = visibleSections();
      const prevActive = lastActiveSectionId;
      if (vis.length === 0) {
        currentSectionIndex = -1;
        if (prevActive) {
          lastActiveSectionId = '';
          document.querySelectorAll<HTMLAnchorElement>('.nav-link:not([data-directory]), #mobile-menu a:not([data-directory]):not(.site-logo)').forEach(link => {
            link.classList.remove('bg-brand-800/50', 'text-white', 'nav-link-active');
            link.classList.add('text-brand-200');
          });
        }
        return;
      }
      const scrollPosition = window.scrollY + 100; // Ajuste para la detección
      let currentSection = vis[0]; // Por defecto, la primera sección visible
      
      // Encontrar la sección actual basada en la posición de desplazamiento
      for (const section of vis) {
        const sectionTop = sectionTopY(section) - 150; // Añadir un pequeño margen superior
        const sectionHeight = section.offsetHeight;
        const sectionBottom = sectionTop + sectionHeight;
        
        // Si la posición de desplazamiento está dentro de los límites de la sección
        if (scrollPosition >= sectionTop && scrollPosition <= sectionBottom) {
          currentSection = section;
          break;
        }
        
        // Si hemos pasado la sección actual, actualizamos la sección actual
        if (sectionTop <= scrollPosition) {
          currentSection = section;
        }
      }
      
      // Actualizar el índice de la sección actual
      currentSectionIndex = sections.indexOf(currentSection);
      
      // Actualizar todos los enlaces del menú (excluyendo el logo) SOLO cuando
      // la sección activa cambia; así la clase no muta en cada scroll y el
      // MutationObserver de los botones flotantes no entra en bucle.
      if (currentSection && currentSection.id !== prevActive) {
        lastActiveSectionId = currentSection.id;
        // Primero, quitar la clase activa de todos los enlaces de navegación
        document.querySelectorAll<HTMLAnchorElement>('.nav-link:not([data-directory]), #mobile-menu a:not([data-directory]):not(.site-logo)').forEach(link => {
          link.classList.remove('bg-brand-800/50', 'text-white', 'nav-link-active');
          link.classList.add('text-brand-200');
        });
        
        // Luego, agregar la clase activa a los enlaces de navegación correspondientes
        const desktopLinks = document.querySelectorAll<HTMLAnchorElement>(`.nav-link[href="#${currentSection.id}"], .nav-link[href="/#${currentSection.id}"]`);
        const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(`#mobile-menu a[href="#${currentSection.id}"]:not(.site-logo), #mobile-menu a[href="/#${currentSection.id}"]:not(.site-logo)`);
        
        [...desktopLinks, ...mobileLinks].forEach(activeLink => {
          activeLink.classList.add('bg-brand-800/50', 'text-white', 'nav-link-active');
          activeLink.classList.remove('text-brand-200');
        });
      }
    }

    // La detección de sección y visibilidad de botones se registran juntas
    // en onScrollOrUpdate (definido arriba, tras declarar las funciones)

    // Entrada de cuenta y cierre de sesión según sesión (import diferido)
    const guestLinks = document.querySelectorAll<HTMLAnchorElement>('[data-auth-link="guest"]');
    const userDropdowns = document.querySelectorAll<HTMLElement>('[data-auth-dropdown="user"]');
    const logoutButtons = document.querySelectorAll<HTMLButtonElement>('[data-auth-action="logout"]');
    if (guestLinks.length > 0 || userDropdowns.length > 0 || logoutButtons.length > 0) {
      import('@/lib/supabase').then(({ supabase }) => {
        void supabase.auth.getSession().then(async ({ data }) => {
          const logged = Boolean(data.session);
          guestLinks.forEach((a) => a.classList.toggle('hidden', logged));
          userDropdowns.forEach((d) => d.classList.toggle('hidden', !logged));
          logoutButtons.forEach((b) => b.classList.toggle('hidden', !logged));

          // Enlaces de staff (Moderación/Administración) según el rol del perfil.
          // Los paneles de admin/moderación también se auto-protegen en su página.
          const staffSep = Array.from(document.querySelectorAll<HTMLElement>('[data-staff-sep]'));
          const staffLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-staff-link]'));
          const showStaff = (isMod: boolean, isAdmin: boolean): void => {
            staffLinks.forEach((a) => {
              const kind = a.getAttribute('data-staff-link');
              const visible = kind === 'admin' ? isAdmin : isMod;
              a.classList.toggle('hidden', !visible);
            });
            const anyVisible = isMod || isAdmin;
            staffSep.forEach((s) => s.classList.toggle('hidden', !anyVisible));
          };
          showStaff(false, false);
          if (data.session?.user) {
            const roleRes = await supabase
              .from('raiddominion_profiles')
              .select('role')
              .eq('id', data.session.user.id)
              .maybeSingle();
            const role = roleRes.data as { role?: string } | null;
            const isMod = role?.role === 'moderator' || role?.role === 'admin';
            const isAdmin = role?.role === 'admin';
            showStaff(isMod, isAdmin);
          }
        });
        logoutButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            btn.disabled = true;
            void supabase.auth.signOut().then(() => window.location.assign('/'));
          });
        });
      }).catch(() => {
        // Sin Supabase configurado: dejar solo el acceso a login
      });
    }

    // Abrir/cerrar el dropdown de cuenta (escritorio)
    document.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]').forEach((trigger) => {
      const menuRaw = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (!menuRaw) return;
      const menu = menuRaw as HTMLElement;
      function closeDropdown(): void {
        menu.classList.add('hidden');
        menu.classList.remove('block');
        menu.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.querySelector('[data-chevron]')?.classList.add('rotate-180');
      }
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden', isOpen);
        menu.classList.toggle('block', !isOpen);
        menu.setAttribute('aria-hidden', String(isOpen));
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
      menu.addEventListener('click', (e) => {
        e.stopPropagation();
        closeDropdown();
      });
      document.addEventListener('click', closeDropdown);
      document.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') closeDropdown();
      });
    });
  });
</script>

<style>
  /* Estilos para la navegación */

  /* Estilos para la transición de los botones flotantes */
  #scroll-up, #scroll-down {
    transition: all 0.3s ease-in-out;
  }
  
  /* Asegurar que el menú esté por encima del contenido */
  #main-nav {
    z-index: 1000;
  }
  
  /* Ajustar el padding superior del contenido principal para la barra de navegación */
  main {
    padding-top: 4rem;
  }
  
  /* Estilos para el menú móvil */
  #mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
  }

  /* Desplegado: ocupa el alto disponible bajo la barra (64px = 4rem) y
     scrollea verticalmente si el contenido excede la pantalla. */
  #mobile-menu.block {
    max-height: calc(100vh - 4rem);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    transition: max-height 0.5s ease-in-out;
  }
  
  /* Efecto hover para los enlaces del menú */
  .nav-link {
    position: relative;
    overflow: hidden;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #00BFFF, #5CA9E8);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }
  
  .nav-link:hover::after,
  .nav-link.nav-link-active::after {
    width: 70%;
  }
  
  /* Asegurar que los botones flotantes sean accesibles en móviles */
  @media (max-width: 768px) {
    #scroll-up, #scroll-down {
      right: 1rem;
      bottom: 5rem;
    }
    #scroll-down {
      bottom: 1rem;
    }
  }
</style>
