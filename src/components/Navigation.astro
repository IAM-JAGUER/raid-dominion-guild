---
// Componente de navegación principal
import { NAV_ITEMS, SITE_CONFIG } from '../utils/constants';

// Props
export interface Props {
  currentPath?: string;
  className?: string;
}

const { currentPath = '/', className = '' } = Astro.props;
---

<!-- Barra de navegación fija en la parte superior -->
<nav 
  id="main-nav" 
  class={`fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-gray-900/95 to-amber-900/95 backdrop-blur border-b border-amber-600/30 shadow-lg transition-all duration-300 ${className}`}
  aria-label="Navegación principal"
>
  <!-- Excepción del contenedor único: la barra de navegación es fixed full-width y no es
       un contenedor de contenido, por eso mantiene su propio max-w-7xl en vez de ui.container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a 
          href="/" 
          class="site-logo flex items-center"
          aria-label="Ir al inicio"
        >
          <img
            src="/logo.png"
            alt="Logo RaidDominion"
            class="h-9 w-auto mr-2 rounded"
            loading="eager"
            decoding="async"
          />
          <span class="text-xl font-bold bg-clip-text text-amber-200 bg-gradient-to-r from-amber-400 to-yellow-500">
            {SITE_CONFIG.TITLE}
          </span>
        </a>
      </div>

      <!-- Navegación escritorio -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-1">
          {NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class="nav-link px-4 py-2.5 rounded-lg text-sm font-medium text-amber-200 hover:bg-amber-800/40 hover:text-white transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-amber-500/10 relative group"
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              <span class="relative z-10">{item.name}</span>
              <span class="absolute inset-0 bg-amber-600/20 rounded-lg scale-95 opacity-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300"></span>
            </a>
          ))}
          <!-- Entrada de cuenta: botón para invitado, dropdown ordenado para usuario -->
          <a
            href="/login"
            data-auth-link="guest"
            class="ml-3 px-4 py-2 rounded-lg text-sm font-bold text-gray-900 bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 transition-all duration-200 hover:scale-105 shadow-lg shadow-amber-500/20"
          >Iniciar Sesión</a>
          <div class="relative hidden ml-3" data-auth-dropdown="user">
            <button
              type="button"
              data-dropdown-trigger
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="account-dropdown"
              class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-bold text-amber-100 border border-amber-500/50 bg-amber-900/40 hover:bg-amber-800/60 transition-all duration-200"
            >
              <span>Mi Espacio</span>
              <svg class="h-4 w-4 transition-transform duration-200" data-chevron fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              id="account-dropdown"
              data-dropdown-menu
              class="hidden absolute right-0 mt-2 w-56 rounded-lg border border-amber-600/30 bg-gray-900/95 backdrop-blur-lg shadow-xl shadow-black/40 py-2 z-50"
              role="menu"
              aria-hidden="true"
            >
              <a href="/dashboard" data-dropdown-item class="account-link block px-4 py-2.5 text-sm text-amber-200 hover:bg-amber-800/40 hover:text-white transition-all duration-150" role="menuitem">Mi Espacio</a>
              <a href="/dashboard/guild" data-dropdown-item data-role-item="guild_master,admin" class="account-link hidden px-4 py-2.5 text-sm text-amber-200 hover:bg-amber-800/40 hover:text-white transition-all duration-150" role="menuitem">Mi Hermandad</a>
              <a href="#" data-dropdown-item data-profile-link class="account-link hidden px-4 py-2.5 text-sm text-amber-200 hover:bg-amber-800/40 hover:text-white transition-all duration-150" role="menuitem">Mi página pública</a>
              <a href="/moderate" data-dropdown-item data-role-item="moderator,admin" class="account-link hidden px-4 py-2.5 text-sm text-amber-200 hover:bg-amber-800/40 hover:text-white transition-all duration-150" role="menuitem">Moderación</a>
              <a href="/admin" data-dropdown-item data-role-item="admin" class="account-link hidden px-4 py-2.5 text-sm text-amber-200 hover:bg-amber-800/40 hover:text-white transition-all duration-150" role="menuitem">Administración</a>
              <div class="my-1 border-t border-amber-600/30"></div>
              <button
                type="button"
                data-auth-action="logout"
                class="w-full text-left px-4 py-2.5 text-sm font-bold uppercase tracking-widest text-red-300 hover:bg-red-900/40 hover:text-red-200 transition-all duration-150"
                role="menuitem"
              >Cerrar Sesión</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Botón menú móvil -->
      <div class="md:hidden">
        <button 
          id="mobile-menu-button" 
          class="text-amber-200 hover:text-white focus:outline-none"
          aria-label="Menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú móvil -->
  <div 
    id="mobile-menu" 
    class="md:hidden hidden bg-gray-900/95 backdrop-blur-lg"
    aria-hidden="true"
  >
    <div class="px-4 py-3 space-y-1">
      {NAV_ITEMS.map((item) => {
        let icon;
        
// Asignar icono según la ruta
        switch(item.href) {
          case '/#inicio':
            icon = (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            );
            break;
          case '/#addon':
            icon = (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            );
            break;
          case '/#donaciones':
            icon = (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            );
            break;
          default:
            icon = null;
        }

        return (
          <a 
            href={item.href}
            class="mobile-nav-link block w-full px-4 py-3 rounded-lg text-base font-medium text-amber-100 hover:bg-amber-800/40 hover:text-white transition-all duration-200 hover:translate-x-1"
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            <div class="flex items-center space-x-3">
              {icon}
              <span>{item.name}</span>
            </div>
          </a>
        );
      })}
      <!-- Entrada de cuenta móvil (visible según sesión) -->
      <div class="pt-2 mt-2 border-t border-amber-600/30 space-y-1">
        <a
          href="/login"
          data-auth-link="guest"
          class="block w-full px-4 py-3 rounded-lg text-base font-bold text-center text-gray-900 bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 transition-all duration-200"
        >Iniciar Sesión</a>
        <a
          href="/dashboard"
          data-auth-link="user"
          class="hidden block w-full px-4 py-3 rounded-lg text-base font-bold text-center text-amber-100 border border-amber-500/50 bg-amber-900/40 hover:bg-amber-800/60 transition-all duration-200"
        >Mi Espacio</a>
        <button
          type="button"
          data-auth-action="logout"
          class="hidden block w-full px-4 py-3 rounded-lg text-sm font-bold text-center uppercase tracking-widest text-red-300 border border-red-500/30 bg-red-950/20 hover:bg-red-900/40 hover:text-red-200 transition-all duration-200"
        >Cerrar Sesión</button>
      </div>
    </div>
  </div>
</nav>

<!-- Botones de navegación flotantes -->
<div class="fixed right-1 bottom-1 z-40 flex flex-col space-y-3">
  <button id="scroll-up" class="bg-amber-600 hover:bg-amber-500 text-white p-2 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 opacity-0 translate-y-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-2 w-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </button>
  <button id="scroll-down" class="bg-amber-600 hover:bg-amber-500 text-white p-2 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 opacity-0 translate-y-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-2 w-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
</div>

<!-- Script para la funcionalidad de navegación -->
<script>
  // Esperar a que el DOM esté completamente cargado
  document.addEventListener('DOMContentLoaded', () => {
    // Obtener referencias a los elementos del DOM
    const mobileMenuButton = document.getElementById('mobile-menu-button') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    const scrollUpBtn = document.getElementById('scroll-up') as HTMLButtonElement | null;
    const scrollDownBtn = document.getElementById('scroll-down') as HTMLButtonElement | null;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]:not(.guide-panel)'));
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    
    // Variable para rastrear la sección actual
    let currentSectionIndex = 0;
    
    // Verificar que los elementos existen antes de usarlos
    if (!mobileMenuButton || !mobileMenu || !scrollUpBtn || !scrollDownBtn) {
      console.error('No se pudieron encontrar todos los elementos necesarios para la navegación');
      return;
    }
    
    // Asegurarse de que los botones sean del tipo correcto
    const upButton = scrollUpBtn;
    const downButton = scrollDownBtn;

    // Mostrar/ocultar menú móvil
    mobileMenuButton.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', !isHidden);
      mobileMenu.classList.toggle('block', isHidden);
    });

    // Cerrar menú móvil al hacer clic en un enlace
    const mobileMenuLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('block');
      });
    });

    // Función para desplazamiento suave
    function scrollToSection(sectionId: string): void {
      const element = document.querySelector<HTMLElement>(sectionId);
      if (!element) return;
      
      const headerOffset = 80; // Ajusta según la altura de tu barra de navegación
      const elementPosition = element.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.scrollY - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth' as ScrollBehavior
      });
    }

    // Manejar clic en los enlaces de navegación con scroll suave
    function handleNavClick(e: Event) {
      const target = e.target as HTMLElement;
      const link = target.closest('a');
      
      if (!link) return;
      
      const targetId = link.getAttribute('href');
      if (!targetId || targetId === '#') return;

      // Anclas del home: "/#seccion" o "#seccion" → scroll suave
      const anchorMatch = targetId.match(/^(?:\/#)?#([\w-]+)$/);
      if (anchorMatch) {
        const targetElement = document.getElementById(anchorMatch[1]);
        if (!targetElement) return;
        e.preventDefault();
        // Cerrar menú móvil si está abierto
        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('block');
        }
        const headerOffset = 80;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
        history.pushState(null, '', `#${anchorMatch[1]}`);
        return;
      }

      // Las rutas de página navegan normal (no son anclas del home)
      if (targetId.startsWith('/')) {
        return;
      }
    }

    // Añadir manejadores de eventos a los enlaces de navegación
    navLinks.forEach(link => {
      link.addEventListener('click', handleNavClick);
    });
    
    // Añadir manejadores de eventos a los enlaces del menú móvil
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', handleNavClick);
    });

    // Navegación con botones flotantes
    if (sections.length > 0) {
      // Mostrar/ocultar botones con animación
      function updateButtonVisibility(): void {
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const scrollThreshold = 100;

        // Botón subir: visible si hay sección anterior o ya se hizo scroll
        if (scrollY > scrollThreshold || currentSectionIndex > 0) {
          upButton.classList.remove('opacity-0', 'translate-y-4');
          upButton.classList.add('opacity-100', 'translate-y-0');
        } else {
          upButton.classList.add('opacity-0', 'translate-y-4');
          upButton.classList.remove('opacity-100', 'translate-y-0');
        }

        // Botón bajar: oculto en la última sección (donaciones) — no hay destino
        const haySiguiente = currentSectionIndex < sections.length - 1 &&
          scrollY < documentHeight - windowHeight - scrollThreshold;
        if (haySiguiente) {
          downButton.classList.remove('opacity-0', 'translate-y-4');
          downButton.classList.add('opacity-100', 'translate-y-0');
        } else {
          downButton.classList.add('opacity-0', 'translate-y-4');
          downButton.classList.remove('opacity-100', 'translate-y-0');
        }
      }

      // Actualizar detección de sección y visibilidad en un solo handler,
      // para que la visibilidad use el índice recién calculado
      function onScrollOrUpdate(): void {
        updateCurrentSection();
        updateButtonVisibility();
      }

      // Actualizar al cargar, hacer scroll y redimensionar
      window.addEventListener('scroll', onScrollOrUpdate);
      window.addEventListener('resize', onScrollOrUpdate);
      onScrollOrUpdate();

      // Navegar a la siguiente sección
      downButton.addEventListener('click', () => {
        if (currentSectionIndex < sections.length - 1) {
          currentSectionIndex++;
          const nextSection = sections[currentSectionIndex];
          if (nextSection) {
            scrollToSection(`#${nextSection.id}`);
          }
        }
      });

      // Navegar a la sección anterior
      upButton.addEventListener('click', () => {
        if (currentSectionIndex > 0) {
          currentSectionIndex--;
          const prevSection = sections[currentSectionIndex];
          if (prevSection) {
            scrollToSection(`#${prevSection.id}`);
          }
        } else {
          // Si está en la primera sección, ir al inicio
          window.scrollTo({ top: 0, behavior: 'smooth' as ScrollBehavior });
        }
      });
    }

    // Actualizar sección actual al hacer scroll
    function updateCurrentSection(): void {
      const scrollPosition = window.scrollY + 100; // Ajuste para la detección
      let currentSection = sections[0]; // Por defecto, la primera sección
      
      // Encontrar la sección actual basada en la posición de desplazamiento
      for (const section of sections) {
        const sectionTop = section.offsetTop - 150; // Añadir un pequeño margen superior
        const sectionHeight = section.offsetHeight;
        const sectionBottom = sectionTop + sectionHeight;
        
        // Si la posición de desplazamiento está dentro de los límites de la sección
        if (scrollPosition >= sectionTop && scrollPosition <= sectionBottom) {
          currentSection = section;
          break;
        }
        
        // Si hemos pasado la sección actual, actualizamos la sección actual
        if (sectionTop <= scrollPosition) {
          currentSection = section;
        }
      }
      
      // Actualizar el índice de la sección actual
      currentSectionIndex = Array.from(sections).indexOf(currentSection);
      
      // Actualizar todos los enlaces del menú (excluyendo el logo)
      if (currentSection) {
        // Primero, quitar la clase activa de todos los enlaces de navegación
        document.querySelectorAll<HTMLAnchorElement>('.nav-link, #mobile-menu a:not(.site-logo)').forEach(link => {
          link.classList.remove('bg-amber-800/50', 'text-white', 'nav-link-active');
          link.classList.add('text-amber-200');
        });
        
        // Luego, agregar la clase activa a los enlaces de navegación correspondientes
        const desktopLinks = document.querySelectorAll<HTMLAnchorElement>(`.nav-link[href="#${currentSection.id}"], .nav-link[href="/#${currentSection.id}"]`);
        const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(`#mobile-menu a[href="#${currentSection.id}"]:not(.site-logo), #mobile-menu a[href="/#${currentSection.id}"]:not(.site-logo)`);
        
        [...desktopLinks, ...mobileLinks].forEach(activeLink => {
          activeLink.classList.add('bg-amber-800/50', 'text-white', 'nav-link-active');
          activeLink.classList.remove('text-amber-200');
        });
      }
    }

    // La detección de sección y visibilidad de botones se registran juntas
    // en onScrollOrUpdate (definido arriba, tras declarar las funciones)

    // Entrada de cuenta: botón para invitado, dropdown ordenado para usuario
    const guestLinks = document.querySelectorAll<HTMLAnchorElement>('[data-auth-link="guest"]');
    const userLinks = document.querySelectorAll<HTMLAnchorElement>('[data-auth-link="user"]');
    const userDropdowns = document.querySelectorAll<HTMLElement>('[data-auth-dropdown="user"]');
    const logoutButtons = document.querySelectorAll<HTMLButtonElement>('[data-auth-action="logout"]');
    if (guestLinks.length > 0 || userLinks.length > 0 || userDropdowns.length > 0 || logoutButtons.length > 0) {
      import('@/lib/supabase').then(({ supabase }) => {
        void supabase.auth.getSession().then(async ({ data }) => {
          const logged = Boolean(data.session);
          guestLinks.forEach((a) => a.classList.toggle('hidden', logged));
          userLinks.forEach((a) => a.classList.toggle('hidden', !logged));
          userDropdowns.forEach((d) => d.classList.toggle('hidden', !logged));

          if (!logged) return;

          // Ordena los enlaces del dropdown según rol y perfil del usuario
          const { getMyProfile } = await import('@/lib/api');
          const res = await getMyProfile();
          if (res.ok && res.profile) {
            const role = res.profile.role;
            userDropdowns.forEach((d) => {
              d.querySelectorAll<HTMLElement>('[data-role-item]').forEach((el) => {
                const roles = (el.getAttribute('data-role-item') ?? '').split(',');
                el.classList.toggle('hidden', !roles.includes(role));
              });
            });
            const profileLink = document.querySelector<HTMLAnchorElement>('[data-profile-link]');
            if (profileLink) {
              if (res.profile.slug) {
                profileLink.href = `/p/${res.profile.slug}`;
                profileLink.classList.remove('hidden');
              } else {
                profileLink.classList.add('hidden');
              }
            }
          }
        });
        logoutButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            btn.disabled = true;
            void supabase.auth.signOut().then(() => window.location.assign('/'));
          });
        });
      }).catch(() => {
        // Sin Supabase configurado: dejar solo el acceso a login
      });
    }

    // Abrir/cerrar el dropdown de cuenta (escritorio)
    const dropdownTriggers = document.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]');
    dropdownTriggers.forEach((trigger) => {
      const menu = document.getElementById(trigger.getAttribute('aria-controls') ?? '') as HTMLElement | null;
      if (!menu) return;

      function closeDropdown(): void {
        menu.classList.add('hidden');
        menu.classList.remove('block');
        menu.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
        const chevron = trigger.querySelector<SVGElement>('[data-chevron]');
        chevron?.classList.remove('rotate-180');
      }

      function openDropdown(): void {
        menu.classList.remove('hidden');
        menu.classList.add('block');
        menu.setAttribute('aria-hidden', 'false');
        trigger.setAttribute('aria-expanded', 'true');
        const chevron = trigger.querySelector<SVGElement>('[data-chevron]');
        chevron?.classList.add('rotate-180');
      }

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (menu.classList.contains('block')) closeDropdown();
        else openDropdown();
      });

      // Cerrar al hacer clic fuera
      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!trigger.contains(target) && !menu.contains(target)) closeDropdown();
      });

      // Cerrar tras navegar o cerrar sesión
      menu.querySelectorAll<HTMLElement>('[data-dropdown-item]').forEach((item) => {
        item.addEventListener('click', closeDropdown);
      });
    });
  });
</script>

<style>
  /* Estilos para la navegación */

  /* Estilos para la transición de los botones flotantes */
  #scroll-up, #scroll-down {
    transition: all 0.3s ease-in-out;
  }
  
  /* Asegurar que el menú esté por encima del contenido */
  #main-nav {
    z-index: 1000;
  }
  
  /* Ajustar el padding superior del contenido principal para la barra de navegación */
  main {
    padding-top: 4rem;
  }
  
  /* Estilos para el menú móvil */
  #mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
  }
  
  #mobile-menu.block {
    max-height: 500px; /* Ajusta según sea necesario */
    transition: max-height 0.5s ease-in-out;
  }
  
  /* Efecto hover para los enlaces del menú */
  .nav-link {
    position: relative;
    overflow: hidden;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #f59e0b, #fbbf24);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }
  
  .nav-link:hover::after,
  .nav-link.nav-link-active::after {
    width: 70%;
  }
  
  /* Asegurar que los botones flotantes sean accesibles en móviles */
  @media (max-width: 768px) {
    #scroll-up, #scroll-down {
      right: 1rem;
