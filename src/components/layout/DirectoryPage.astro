---
// Plantilla de página DIRECTORIO (servidores, jugadores, personajes, bandas,
// hermandades). Encapsula el esqueleto común: FICHA DE DIRECTORIO
// (DirectorySheet: identidad + filtros + cuerpo hundido) con la lista
// asíncrona dentro, el paginador y el estado vacío. No usa PanelWindow: esa
// ventana es el lenguaje de las fichas de entidad y aquí repetiría el
// título/icono. Cada página conserva solo su <script> (card() + fetch +
// facetas) y monta la barra sobre #filters con src/lib/ui/filterBar.ts. La
// lista usa el contrato de src/lib/ui/list.ts
// (`data-rd-list-status/content/empty/frame`) y los ids #grid/#empty siguen
// siendo el anclaje del script (ver AGENTS.sections/pagina-map.md §2).
import Breadcrumb from '@/components/Breadcrumb.astro';
import DirectorySheet from '@/components/ui/DirectorySheet.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import { ui, type Tone } from '@/lib/ui/design';
import type { IconName } from '@/lib/ui/icons';

interface EmptyConfig {
  icon?: IconName;
  eyebrow?: string;
  title: string;
  titleCls?: string;
  gradient?: boolean;
  message: string;
  cta?: { label: string; href: string } | null;
  ctaCls?: string;
}

interface Props {
  hero: string;
  intro?: string;
  // Icono temático de la placa del directorio (contrato src/lib/ui/icons.ts).
  panelIcon?: IconName;
  // Texto del estado de carga (aria-live).
  loadingText: string;
  gridLabel: string;
  // Config del estado vacío (toggle #empty).
  empty: EmptyConfig;
  // Bloque editorial de cierre: explica cómo aparecer en el directorio y
  // añade contenido estático indexable (además del listado cliente).
  context?: {
    title: string;
    text: string;
    cta?: { label: string; href: string } | null;
  };
  // Clases extra del h1 (p. ej. `rd-title rd-ornament`).
  heroTitleCls?: string;
  // Imagen de portada del encabezado (decorativa; se monta dentro de la placa).
  heroImage?: string;
  heroImagePosition?: string;
  heroImageMode?: 'background' | 'cover';
  // Tono ceremonial del directorio (paleta v2). `steel` = marca.
  tone?: Tone;
}

const {
  hero,
  intro,
  panelIcon,
  loadingText,
  gridLabel,
  empty,
  context,
  heroTitleCls = '',
  heroImage,
  heroImagePosition,
  heroImageMode,
  tone = 'steel',
} = Astro.props;
const isTone = tone !== 'steel';
const toneCls = isTone ? ui.tone[tone] : '';
---
<Breadcrumb />

<DirectorySheet
  title={hero}
  intro={intro}
  titleCls={heroTitleCls}
  icon={panelIcon}
  image={heroImage}
  imagePosition={heroImagePosition}
  imageMode={heroImageMode}
  tone={tone}
>
  <div slot="filters" id="filters" data-rd-filter-bar class={ui.filter.headerMount}></div>

  <!-- Cuerpo hundido de la ficha: la lista, el paginador y el estado vacío
       viven DENTRO de la misma superficie. El bloque de carga sigue siendo el
       único hijo de #grid mientras carga y se retira al asentarse. El contador
       vive en el filtro; el paginador solo aporta la posición de página. -->
  <div data-rd-list-frame class={ui.directory.board}>
    <h2 id="directory-list-title" class="sr-only">{gridLabel}</h2>
    <section id="grid" data-rd-list-content data-rd-reveal-cards class={ui.directory.grid} aria-labelledby="directory-list-title">
      <LoadingBlock text={loadingText} listStatus pad="md" class="md:col-span-2 lg:col-span-3" />
    </section>
    <div id="pager" data-rd-list-pager></div>
  </div>

  <EmptyState
    id="empty"
    variant="plain"
    cls={ui.directory.empty}
    hidden
    icon={empty.icon}
    eyebrow={empty.eyebrow}
    title={empty.title}
    titleCls={empty.titleCls}
    gradient={empty.gradient}
    message={empty.message}
    cta={empty.cta}
    ctaCls={empty.ctaCls}
    align="center"
  />
</DirectorySheet>

{context && (
  <section class={`${ui.panel} ${toneCls} ${isTone ? ui.tonePanel : ''} relative overflow-hidden mt-10 p-6 sm:p-7`}>
    <span class={`${ui.cardTop} ${isTone ? ui.toneTop : ''}`} aria-hidden="true"></span>
    <h2 class={`${ui.text.h1} ${ui.gradientTitle} ${isTone ? ui.toneTitle : ''} mb-2`}>{context.title}</h2>
    <p class={`${ui.text.body} leading-relaxed max-w-md`}>{context.text}</p>
    {context.cta && (
      <a href={context.cta.href} class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.sm} mt-5`}>
        {context.cta.label}
      </a>
    )}
  </section>
)}
