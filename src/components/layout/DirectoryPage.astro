---
// Plantilla de página DIRECTORIO (servidores, jugadores, personajes, bandas,
// hermandades). Encapsula el esqueleto común: PageHeader + dividerFadeBoth +
// PanelWindow (cabecera con la barra de filtros estándar) + lista asíncrona
// + dividerFadeLeft. Cada página conserva solo su <script> (card() + fetch +
// facetas) y monta la barra sobre #filters con src/lib/ui/filterBar.ts.
// La lista usa el contrato de src/lib/ui/list.ts
// (`data-rd-list-status/content/empty/frame`) y los ids #grid/#empty siguen
// siendo el anclaje del script (ver AGENTS.sections/pagina-map.md §2).
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import { ui } from '@/lib/ui/design';

interface EmptyConfig {
  icon?: 'server' | 'user' | 'group' | 'building' | 'upload' | 'code';
  eyebrow: string;
  title: string;
  titleCls?: string;
  gradient?: boolean;
  message: string;
  cta?: { label: string; href: string } | null;
  ctaCls?: string;
}

interface Props {
  eyebrow?: string;
  hero: string;
  intro?: string;
  // Título de la ventana del panel (default: el hero).
  panelTitle?: string;
  // Texto del estado de carga (aria-live).
  loadingText: string;
  gridLabel: string;
  // Config del estado vacío (toggle #empty).
  empty: EmptyConfig;
  // Clases del divisor tras el header (por defecto `mt-6 mb-10`).
  dividerCls?: string;
  // Clases extra del h1 (p. ej. `rd-title rd-ornament`).
  heroTitleCls?: string;
}

const {
  eyebrow = 'Directorio público',
  hero,
  intro,
  panelTitle = hero,
  loadingText,
  gridLabel,
  empty,
  dividerCls = 'mt-6 mb-10',
  heroTitleCls = '',
} = Astro.props;
---
<Breadcrumb />

<PageHeader eyebrow={eyebrow} title={hero} intro={intro} titleCls={heroTitleCls} />
<div class={`${ui.dividerFadeBoth} ${dividerCls}`} aria-hidden="true"></div>

<!-- Lista asíncrona estándar (src/lib/ui/list.ts): los ítems viven en la
     grilla del cuerpo del panel; el bloque de carga es su único hijo mientras
     carga y se retira al asentarse (reemplazo in-place, sin salto). El motor
     de reveal escalona los ítems. La cabecera monta la barra de filtros
     (buscador + chips) vía src/lib/ui/filterBar.ts sobre #filters. -->
<div data-rd-list-frame>
  <PanelWindow title={panelTitle}>
    <div slot="head" class="mt-4" id="filters" data-rd-filter-bar></div>
    <section id="grid" data-rd-list-content data-rd-reveal-cards class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" aria-label={gridLabel}>
      <LoadingBlock text={loadingText} listStatus pad="md" class="md:col-span-2 lg:col-span-3" />
    </section>
  </PanelWindow>
</div>

<EmptyState
  id="empty"
  hidden
  icon={empty.icon}
  eyebrow={empty.eyebrow}
  title={empty.title}
  titleCls={empty.titleCls}
  gradient={empty.gradient}
  message={empty.message}
  cta={empty.cta}
  ctaCls={empty.ctaCls}
  align="center"
/>
<div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
