---
// Plantilla de página DIRECTORIO (servidores, jugadores, personajes, bandas,
// hermandades). Encapsula el esqueleto común: PageHeader + dividerFadeBoth +
// dividerFadeRight (separador izquierdo, la página no tiene tabs) +
// PanelWindow (cabecera con la barra de filtros estándar) + lista asíncrona
// + dividerFadeLeft. Cada página conserva solo su <script> (card() + fetch +
// facetas) y monta la barra sobre #filters con src/lib/ui/filterBar.ts.
// La lista usa el contrato de src/lib/ui/list.ts
// (`data-rd-list-status/content/empty/frame`) y los ids #grid/#empty siguen
// siendo el anclaje del script (ver AGENTS.sections/pagina-map.md §2).
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import { ui, type Tone } from '@/lib/ui/design';
import type { IconName } from '@/lib/ui/icons';

interface EmptyConfig {
  icon?: IconName;
  eyebrow?: string;
  title: string;
  titleCls?: string;
  gradient?: boolean;
  message: string;
  cta?: { label: string; href: string } | null;
  ctaCls?: string;
}

interface Props {
  hero: string;
  intro?: string;
  // Título de la ventana del panel (default: el hero).
  panelTitle?: string;
  // Icono temático de la ventana del panel (contrato src/lib/ui/icons.ts).
  panelIcon?: IconName;
  // Texto del estado de carga (aria-live).
  loadingText: string;
  gridLabel: string;
  // Config del estado vacío (toggle #empty).
  empty: EmptyConfig;
  // Bloque editorial de cierre: explica cómo aparecer en el directorio y
  // añade contenido estático indexable (además del listado cliente).
  context?: {
    title: string;
    text: string;
    cta?: { label: string; href: string } | null;
  };
  // Clases del separador CENTRAL tras el header (por defecto `mt-6`).
  dividerCls?: string;
  // Clases extra del h1 (p. ej. `rd-title rd-ornament`).
  heroTitleCls?: string;
  // Imagen de portada del encabezado (decorativa; se monta dentro de la placa).
  heroImage?: string;
  heroImagePosition?: string;
  heroImageMode?: 'background' | 'cover';
  // Tono ceremonial del directorio (paleta v2). `steel` = marca.
  tone?: Tone;
}

const {
  hero,
  intro,
  panelTitle = hero,
  panelIcon,
  loadingText,
  gridLabel,
  empty,
  context,
  dividerCls = 'mt-6',
  heroTitleCls = '',
  heroImage,
  heroImagePosition,
  heroImageMode,
  tone = 'steel',
} = Astro.props;
const isTone = tone !== 'steel';
const toneCls = isTone ? ui.tone[tone] : '';
---
<Breadcrumb />

<PageHeader
  title={hero}
  intro={intro}
  titleCls={heroTitleCls}
  icon={panelIcon}
  image={heroImage}
  imagePosition={heroImagePosition}
  imageMode={heroImageMode}
  tone={tone}
/>
<div class={`${ui.dividerFadeBoth} ${dividerCls}`} aria-hidden="true"></div>
<div class={`${ui.dividerFadeRight} mt-8 mb-10`} aria-hidden="true"></div>

<!-- Lista asíncrona estándar (src/lib/ui/list.ts): los ítems viven en la
     grilla del cuerpo del panel; el bloque de carga es su único hijo mientras
     carga y se retira al asentarse (reemplazo in-place, sin salto). El motor
     de reveal escalona los ítems. La cabecera monta la barra de filtros
     (buscador + selector dinámico + chips activos) vía
     src/lib/ui/filterBar.ts sobre #filters. -->
<div data-rd-list-frame>
  <PanelWindow title={panelTitle} icon={panelIcon} tone={tone}>
    <div slot="head" class="mt-4" id="filters" data-rd-filter-bar></div>
    <section id="grid" data-rd-list-content data-rd-reveal-cards class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" aria-label={gridLabel}>
      <LoadingBlock text={loadingText} listStatus pad="md" class="md:col-span-2 lg:col-span-3" />
    </section>
    <div id="pager" data-rd-list-pager></div>
  </PanelWindow>
</div>

<EmptyState
  id="empty"
  hidden
  icon={empty.icon}
  eyebrow={empty.eyebrow}
  title={empty.title}
  titleCls={empty.titleCls}
  gradient={empty.gradient}
  message={empty.message}
  cta={empty.cta}
  ctaCls={empty.ctaCls}
  align="center"
/>

{context && (
  <section class={`${ui.panel} ${toneCls} ${isTone ? ui.tonePanel : ''} relative overflow-hidden mt-10 p-6 sm:p-7`}>
    <span class={`${ui.cardTop} ${isTone ? ui.toneTop : ''}`} aria-hidden="true"></span>
    <h2 class={`${ui.text.h1} ${ui.gradientTitle} ${isTone ? ui.toneTitle : ''} mb-2`}>{context.title}</h2>
    <p class={`${ui.text.body} leading-relaxed max-w-md`}>{context.text}</p>
    {context.cta && (
      <a href={context.cta.href} class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.sm} mt-5`}>
        {context.cta.label}
      </a>
    )}
  </section>
)}
<div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
