---
// Plantilla de página DIRECTORIO (servidores, jugadores, personajes, bandas,
// hermandades). Encapsula el esqueleto común: PageHeader (identidad + barra
// de filtros en el slot `filters`) + dividerFadeBoth + TABLERO ABIERTO con la
// lista asíncrona + dividerFadeLeft. No usa PanelWindow: esa ventana es el
// lenguaje de las fichas y aquí repetiría título/icono del header. Cada página
// conserva solo su <script> (card() + fetch + facetas) y monta la barra sobre
// #filters con src/lib/ui/filterBar.ts. La lista usa el contrato de
// src/lib/ui/list.ts (`data-rd-list-status/content/empty/frame`) y los ids
// #grid/#empty siguen siendo el anclaje del script
// (ver AGENTS.sections/pagina-map.md §2).
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import { ui, type Tone } from '@/lib/ui/design';
import type { IconName } from '@/lib/ui/icons';

interface EmptyConfig {
  icon?: IconName;
  eyebrow?: string;
  title: string;
  titleCls?: string;
  gradient?: boolean;
  message: string;
  cta?: { label: string; href: string } | null;
  ctaCls?: string;
}

interface Props {
  hero: string;
  intro?: string;
  // Icono temático de la placa del directorio (contrato src/lib/ui/icons.ts).
  panelIcon?: IconName;
  // Texto del estado de carga (aria-live).
  loadingText: string;
  gridLabel: string;
  // Config del estado vacío (toggle #empty).
  empty: EmptyConfig;
  // Bloque editorial de cierre: explica cómo aparecer en el directorio y
  // añade contenido estático indexable (además del listado cliente).
  context?: {
    title: string;
    text: string;
    cta?: { label: string; href: string } | null;
  };
  // Clases del separador CENTRAL tras el header (por defecto `mt-6`).
  dividerCls?: string;
  // Clases extra del h1 (p. ej. `rd-title rd-ornament`).
  heroTitleCls?: string;
  // Imagen de portada del encabezado (decorativa; se monta dentro de la placa).
  heroImage?: string;
  heroImagePosition?: string;
  heroImageMode?: 'background' | 'cover';
  // Tono ceremonial del directorio (paleta v2). `steel` = marca.
  tone?: Tone;
}

const {
  hero,
  intro,
  panelIcon,
  loadingText,
  gridLabel,
  empty,
  context,
  dividerCls = 'mt-6',
  heroTitleCls = '',
  heroImage,
  heroImagePosition,
  heroImageMode,
  tone = 'steel',
} = Astro.props;
const isTone = tone !== 'steel';
const toneCls = isTone ? ui.tone[tone] : '';
---
<Breadcrumb />

<PageHeader
  title={hero}
  intro={intro}
  titleCls={heroTitleCls}
  icon={panelIcon}
  image={heroImage}
  imagePosition={heroImagePosition}
  imageMode={heroImageMode}
  tone={tone}
>
  <div slot="filters" id="filters" data-rd-filter-bar class={ui.filter.headerMount}></div>
</PageHeader>
<div class={`${ui.dividerFadeBoth} ${dividerCls}`} aria-hidden="true"></div>

<!-- Tablero abierto del directorio: la lista vive directamente bajo el header
     y el divisor central, sin la ventana de contenido de las fichas. El
     bloque de carga sigue siendo el único hijo de #grid mientras carga y se
     retira al asentarse. El contador vive en el filtro (header); el paginador
     solo aporta la posición de página. -->
<div data-rd-list-frame class={ui.directory.board}>
  <section id="grid" data-rd-list-content data-rd-reveal-cards class={ui.directory.grid} aria-label={gridLabel}>
    <LoadingBlock text={loadingText} listStatus pad="md" class="md:col-span-2 lg:col-span-3" />
  </section>
  <div id="pager" data-rd-list-pager></div>
</div>

<EmptyState
  id="empty"
  cls={ui.directory.empty}
  hidden
  icon={empty.icon}
  eyebrow={empty.eyebrow}
  title={empty.title}
  titleCls={empty.titleCls}
  gradient={empty.gradient}
  message={empty.message}
  cta={empty.cta}
  ctaCls={empty.ctaCls}
  align="center"
/>

{context && (
  <section class={`${ui.panel} ${toneCls} ${isTone ? ui.tonePanel : ''} relative overflow-hidden mt-10 p-6 sm:p-7`}>
    <span class={`${ui.cardTop} ${isTone ? ui.toneTop : ''}`} aria-hidden="true"></span>
    <h2 class={`${ui.text.h1} ${ui.gradientTitle} ${isTone ? ui.toneTitle : ''} mb-2`}>{context.title}</h2>
    <p class={`${ui.text.body} leading-relaxed max-w-md`}>{context.text}</p>
    {context.cta && (
      <a href={context.cta.href} class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.sm} mt-5`}>
        {context.cta.label}
      </a>
    )}
  </section>
)}
<div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
