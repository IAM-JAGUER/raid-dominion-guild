---
// Ficha pública DE BANDA (/banda/:slug). Shell estático servido por el
// rewrite netlify /banda/* → /banda (dev: middleware de astro.config.mjs).
// El navegador conserva la URL real y BandView se auto-activa y resuelve el
// slug 100% en cliente.
import DetailShell from '@/components/DetailShell.astro';
import BandView from '@/components/views/BandView.astro';
import { PAGE_META } from '@/lib/seo';

const meta = PAGE_META['/banda'];
---
<DetailShell
  title={meta.title}
  description={meta.description}
  autoCanonical
  particles="ember"
>
  <BandView />
</DetailShell>