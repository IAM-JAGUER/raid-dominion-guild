---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
---

<Layout title="Sube tu SavedVariables - RaidDominion" description="Sube tu RaidDominion.lua y visualiza el roster y las bandas de tu hermandad.">
  <Navigation currentPath="/upload" />
  <main class="relative py-16">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Header -->
      <header class="text-center mb-12 animate-fade-in-1">
        <div class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-amber-600 to-amber-800 rounded-lg flex items-center justify-center shadow-lg shadow-amber-900/20">
          <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase">
          Sube tu SavedVariables
        </h1>
        <p class="text-gray-400 mt-3 text-sm max-w-lg mx-auto italic">
          Carga tu <code class="text-amber-300">RaidDominion.lua</code> para ver el roster, las bandas y los roles de tu hermandad.
        </p>
        <div class="w-48 h-0.5 bg-gradient-to-r from-amber-900/0 via-amber-500/80 to-amber-900/0 mx-auto my-6"></div>
      </header>

      <!-- Dropzone -->
      <section class="bg-gray-900/50 backdrop-blur-sm border border-amber-600/30 rounded-lg p-6 sm:p-8 mb-8">
        <label
          for="sv-file"
          id="dropzone"
          class="flex flex-col items-center justify-center border-2 border-dashed border-amber-600/40 rounded-lg p-10 cursor-pointer hover:border-amber-500/70 hover:bg-amber-900/10 transition-all"
        >
          <svg class="w-10 h-10 text-amber-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
          <span class="text-sm text-amber-200 font-medium">Arrastra tu archivo aquí o haz clic para seleccionarlo</span>
          <span class="text-xs text-gray-500 mt-1">RaidDominion.lua · máx. 2 MB</span>
          <input id="sv-file" type="file" accept=".lua,.txt,text/plain" class="hidden" />
        </label>

        <div id="status" class="mt-4 text-sm text-gray-400 text-center" aria-live="polite"></div>

        <!-- Advertencias -->
        <div id="warnings" class="mt-4 space-y-2"></div>
      </section>

      <!-- Resultado -->
      <section id="result" class="hidden space-y-6">
        <!-- Claim de maestro -->
        <div id="claim-banner" class="hidden bg-gradient-to-r from-amber-900/40 to-amber-800/20 border border-amber-600/40 rounded-lg p-6">
          <h2 class="text-xl font-bold text-amber-300 mb-2">¡Eres candidato a maestro de hermandad!</h2>
          <p class="text-sm text-gray-300 mb-4">
            Tu SavedVariables fue generado por <strong id="claim-char" class="text-amber-200"></strong> con rango de liderazgo.
            Registra tu hermandad para recibir un portal web gratuito.
          </p>

          <!-- Reclamo con sesión activa -->
          <form id="claim-form" class="hidden space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="claim-name" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">Nombre de la hermandad *</label>
                <input type="text" id="claim-name" required maxlength="60" placeholder="Colmillo de Acero"
                  class="w-full px-3 py-2 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600" />
              </div>
              <div>
                <label for="claim-discord" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">Discord (opcional)</label>
                <input type="url" id="claim-discord" placeholder="https://discord.gg/…"
                  class="w-full px-3 py-2 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600" />
              </div>
            </div>
            <button type="submit" id="claim-btn"
              class="px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:pointer-events-none">
              Reclamar hermandad
            </button>
          </form>

          <!-- Sin sesión: primero cuenta -->
          <p id="claim-anon" class="hidden text-sm">
            <a href="/login?next=%2Fupload" class="inline-block px-5 py-2 rounded-lg border border-amber-500/50 bg-gray-900/60 text-amber-200 hover:bg-amber-900/30 hover:text-white transition-all duration-300 text-xs font-black uppercase tracking-widest">
              Inicia sesión para reclamarla
            </a>
          </p>

          <div id="claim-pending" class="hidden mt-3">
            <p class="text-xs text-amber-200/70">Tu rango no es de liderazgo; un moderador revisará tu solicitud.</p>
          </div>
          <p id="claim-msg" class="hidden mt-3 text-sm rounded-lg px-4 py-2.5" role="status"></p>
        </div>

        <!-- Resumen -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-lg p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-guild-size">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Miembros</p>
          </div>
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-lg p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-bands">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Bandas</p>
          </div>
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-lg p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-roles">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Roles</p>
          </div>
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-lg p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-mechanics">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Mecánicas</p>
          </div>
        </div>

        <!-- Personaje propio (registry.player) -->
        <div id="player-banner" class="hidden"></div>

        <!-- Hermandad del personaje activo (registry.guild) -->
        <div id="guild-sv-banner" class="hidden"></div>

        <!-- Bandas -->
        <div id="bands-section" class="bg-gray-900/50 backdrop-blur-sm border border-amber-600/30 rounded-lg p-6">
          <h2 class="text-xl font-bold text-amber-300 mb-4 flex items-center">
            <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
            Bandas
          </h2>
          <div id="bands-list" class="space-y-4"></div>
        </div>

        <!-- Reglas -->
        <div id="rules-section" class="bg-gray-900/50 backdrop-blur-sm border border-amber-600/30 rounded-lg p-6">
          <h2 class="text-xl font-bold text-amber-300 mb-4 flex items-center">
            <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
            Reglas de banda
          </h2>
          <ul id="rules-list" class="space-y-3"></ul>
        </div>

        <!-- Roster preview -->
        <div id="roster-section" class="bg-gray-900/50 backdrop-blur-sm border border-amber-600/30 rounded-lg p-6">
          <h2 class="text-xl font-bold text-amber-300 mb-4 flex items-center">
            <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
            Roster de la hermandad
          </h2>
          <div id="roster-table-wrap" class="overflow-x-auto"></div>
        </div>
      </section>

      <!-- Error -->
      <section id="error" class="hidden bg-red-950/40 border border-red-600/40 rounded-lg p-6">
        <h2 class="text-lg font-bold text-red-300 mb-2">No se pudo procesar el archivo</h2>
        <p id="error-msg" class="text-sm text-red-200/80"></p>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { parseSavedVariables } from '@/lib/parser/savedVariables';
  import type { ParsedSavedVariables, GuildMember } from '@/types/parser';
  import { el, renderParsedSections } from '@/lib/ui/preview';
  import { supabase } from '@/lib/supabase';
  import {
    saveUpload,
    claimGuild,
    getMyProfile,
    saveMyGuildSnapshot,
    buildPortalSnapshot,
    upsertMyCharacter,
    saveRosterEvidence,
    tryPromoteMember,
    claimGuildFromSV,
  } from '@/lib/api';

  const fileInput = document.getElementById('sv-file') as HTMLInputElement;
  const dropzone = document.getElementById('dropzone') as HTMLElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const warningsEl = document.getElementById('warnings') as HTMLElement;
  const resultEl = document.getElementById('result') as HTMLElement;
  const errorEl = document.getElementById('error') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;

  function setStatus(msg: string): void {
    statusEl.textContent = msg;
  }

  function showError(msg: string): void {
    errorEl.classList.remove('hidden');
    errorMsg.textContent = msg;
    resultEl.classList.add('hidden');
  }

  function clearWarnings(): void {
    warningsEl.innerHTML = '';
  }

  function addWarning(msg: string): void {
    warningsEl.appendChild(el('div', 'text-xs text-amber-200/80 bg-amber-900/20 border-l-2 border-amber-500/50 px-4 py-2 rounded-lg', '⚠ ' + msg));
  }

  // Persiste el parseo si hay sesión activa; si no, invita a iniciar sesión
  async function persistIfLoggedIn(data: ParsedSavedVariables): Promise<void> {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session?.user) {
      const info = el('div', 'text-xs text-gray-400 bg-gray-900/60 border-l-2 border-amber-500/50 px-4 py-2 rounded-lg mt-2');
      info.appendChild(document.createTextNode('Inicia sesión para guardar este análisis en tu historial. '));
      const link = el('a', 'text-amber-300 underline hover:text-amber-200', 'Iniciar Sesión');
      link.href = '/login?next=%2Fupload';
      info.appendChild(link);
      warningsEl.appendChild(info);
      return;
    }

    setStatus('Guardando en tu historial…');
    const saved = await saveUpload(data);
    if (!saved.ok) {
      setStatus('Archivo procesado, pero no se pudo guardar en el historial: ' + (saved.error || 'error desconocido'));
      return;
    }

    // Registro por personaje usando SU snapshot del registry (equipo incluido);
    // fallback: roster de cuenta para quienes no tienen entrada propia.
    let charStatus: string | null = null;
    const conflicts: string[] = [];
    const handledKeys = new Set<string>();
    const normKey = (name: string, realm?: string): string =>
      `${name.toLowerCase()}|${(realm ?? '').toLowerCase()}`;

    for (const reg of data.registries) {
      if (!reg.player) continue;
      handledKeys.add(normKey(reg.player.name, reg.player.realm));
      const up = await upsertMyCharacter(saved.id, reg.player, reg.savedAt, reg.guild);
      const isActiveReg = Boolean(data.player &&
        reg.player.name.toLowerCase() === data.player.name.toLowerCase() &&
        (reg.player.realm ?? '').toLowerCase() === (data.player.realm ?? '').toLowerCase());
      if (!up.ok || up.result === 'conflict') {
        conflicts.push(reg.player.name);
        if (!charStatus && (up.result === 'conflict' || isActiveReg)) charStatus = up.result === 'conflict' ? 'conflict' : null;
      } else if (isActiveReg || !charStatus) {
        charStatus = up.result ?? 'updated';
      }
    }

    if (data.characters.length > 0) {
      for (const ch of data.characters) {
        const key = normKey(ch.name, ch.realm);
        if (handledKeys.has(key)) continue;
        const up = await upsertMyCharacter(saved.id, {
          name: ch.name,
          realm: ch.realm ?? '',
          class: ch.class,
          classFile: ch.classFile,
          race: ch.race,
          level: ch.level,
          equipment: [],
        });
        if (!up.ok || up.result === 'conflict') conflicts.push(ch.name);
      }
    }
    if (conflicts.length > 0) {
      addWarning(`Sin registrar por estar vinculados a otra cuenta: ${Array.from(new Set(conflicts)).join(', ')}. Contacta a un moderador si son tuyos.`);
      if (data.player && conflicts.some((c) => c.toLowerCase() === data.player!.name.toLowerCase())) charStatus = charStatus === 'conflict' ? 'conflict' : 'conflict';
    }
    if (data.player && !charStatus) charStatus = 'updated';

    // Evidencia de membresía en orden de fiabilidad (AGENTS.md §4):
    //   a) PRIMARIO: roster GM v3 (registry.*.guild.memberList) de todos los
    //      personajes del archivo — el addon no viaja con notas (privacidad).
    //   b) FALLBACK legacy: Guild.memberList (archivos antiguos v2).
    //   c) BANDAS: jugadores curados in-game por el líder.
    const evidenceRoster: GuildMember[] = [];
    const seenNames = new Set<string>();
    const pushEvidence = (m: GuildMember): void => {
      const key = m.name.trim().toLowerCase();
      if (!key || seenNames.has(key)) return;
      seenNames.add(key);
      evidenceRoster.push(m);
    };

    for (const reg of data.registries) {
      reg.guild?.memberList?.forEach((gm) => {
        pushEvidence({
          name: gm.name,
          class: gm.class ?? gm.classFile ?? '',
          rank: gm.rank || (typeof gm.rankIndex === 'number' ? String(gm.rankIndex) : ''),
          publicNote: '',
          officerNote: '',
        });
      });
    }
    data.guild.members.forEach(pushEvidence);
    data.bands.forEach((b) =>
      b.players.forEach((p) => {
        if (!p.name.trim()) return;
        pushEvidence({
          name: p.name.trim(),
          class: p.class ?? '',
          rank: 'banda',
          publicNote: '',
          officerNote: '',
        });
      })
    );
    if (evidenceRoster.length > 0) {
      await saveRosterEvidence(saved.id, evidenceRoster);
    }

    // guild_master: el re-upload actualiza el roster/bandas del portal público
    let role: string | null = null;
    const profRes = await getMyProfile();
    role = profRes.ok ? profRes.profile?.role ?? null : null;

    if (role === 'guild_master') {
      const snap = await saveMyGuildSnapshot(buildPortalSnapshot(data));
      setStatus(snap.ok
        ? 'Archivo procesado y guardado. Portal de tu hermandad actualizado.'
        : 'Archivo procesado y guardado, pero no se pudo actualizar el portal: ' + (snap.error || ''));
      return;
    }

    // Onboarding visitante → member.
    // Regla (20260824): un SV con personaje maestro (registry.guild.isGM) y
    // más de dos personajes registrados promueve automáticamente a 'member',
    // sin evidencia cruzada. Jamás degrada a quien ya es member/guild_master.
    if (charStatus !== 'conflict') {
      setStatus('Validando tu cuenta…');
      const promo = await tryPromoteMember(saved.id);
      if (promo.ok && promo.data?.promoted) {
        const wasVisitante = role === 'visitante';
        renderOnboardingBanner('success', '¡Bienvenido, Miembro! Tu SavedVariables acredita maestría con más de dos personajes: tu cuenta quedó validada y lista para reclamar tu hermandad.');
        if (wasVisitante) role = 'member';
      } else if (promo.ok) {
        // Sin auto-validación: se queda Visitante, sin pedir validación externa
        if (role === 'visitante') {
          renderOnboardingBanner('visitor',
            'Registrado como Visitante. Para ser Miembro, tu SV debe acreditar maestría de hermandad con más de dos personajes registrados.');
        }
      } else {
        addWarning('No se pudo validar tu personaje: ' + (promo.error || 'error desconocido') + '. Contacta a soporte si persiste.');
      }
    }

    // Reclamo estricto desde el SV: registry.guild.isGM + Miembro validado
    if (role === 'member' && saved.id && data.registryGuild?.isGM) {
      setStatus('El addon te reporta como Maestro: reclamando hermandad desde el SV…');
      const claimRes = await claimGuildFromSV(saved.id);
      if (claimRes.ok) {
        renderOnboardingBanner('success', '¡Hermandad reclamada desde tu SavedVariables! Ya eres Maestro de Hermandad; revisa la pestaña Mi Hermandad para publicar tu portal.');
        setStatus('Archivo procesado. Hermandad creada automáticamente con los datos del addon.');
        return;
      }
      if (claimRes.error?.includes('Miembro')) {
        addWarning('Tu SV indica maestría de hermandad, pero la promoción a Miembro requiere un SV con más de dos personajes registrados. El reclamo se completará en tu próximo upload.');
      } else if (claimRes.error?.includes('Ya tienes')) {
        // inofensivo: ya es GM
      } else {
        addWarning('No se pudo reclamar la hermandad desde el SV: ' + (claimRes.error || ''));
      }
    }

    setStatus('Archivo procesado y guardado en tu historial.');
  }

  function renderOnboardingBanner(kind: 'success' | 'visitor', msg: string): void {
    const cls = kind === 'success'
      ? 'text-emerald-200 bg-emerald-950/40 border-l-2 border-emerald-500/60'
      : 'text-amber-100 bg-amber-950/30 border-l-2 border-amber-500/60';
    const box = el('div', 'text-xs px-4 py-3 rounded-lg mb-2 ' + cls);
    box.textContent = kind === 'success' ? '✓ ' + msg : '⬆ ' + msg;
    warningsEl.prepend(box);
  }

  function renderResult(data: ParsedSavedVariables): void {
    // Roster efectivo: memberList v3 (registries) ∪ legacy, dedupe por nombre.
    const rosterNames = new Set<string>();
    data.registries.forEach((reg) =>
      reg.guild?.memberList?.forEach((gm) => rosterNames.add(gm.name.trim().toLowerCase())));
    if (rosterNames.size === 0) {
      data.guild.members.forEach((m) => rosterNames.add(m.name.trim().toLowerCase()));
    }
    (document.getElementById('stat-guild-size') as HTMLElement).textContent = String(rosterNames.size);
    (document.getElementById('stat-bands') as HTMLElement).textContent = String(data.bands.length);
    (document.getElementById('stat-roles') as HTMLElement).textContent = String(data.roles.length);
    (document.getElementById('stat-mechanics') as HTMLElement).textContent = String(data.mechanics.length);

    // Tarjetas por CADA personaje del registry (activo marcado)
    const shown = data.registries.length > 0
      ? data.registries
      : (data.player ? [{ key: '', player: data.player, guild: data.registryGuild, savedAt: data.savedAt }] : []);
    const playerBanner = document.getElementById('player-banner') as HTMLElement;
    playerBanner.innerHTML = '';
    for (const reg of shown) {
      const p = reg.player;
      if (!p) continue;
      const isActive = Boolean(data.player && p.name.toLowerCase() === data.player.name.toLowerCase()
        && (p.realm ?? '').toLowerCase() === (data.player.realm ?? '').toLowerCase());
      const card = el('div', 'bg-gray-800/50 border rounded-lg p-4 mb-3 ' + (isActive ? 'border-amber-500/60' : 'border-gray-700/50'));
      const title = el('div', 'flex flex-wrap items-center gap-2 mb-2');
      title.appendChild(el('h3', 'text-base font-bold ' + (isActive ? 'text-amber-200' : 'text-gray-200'),
        `${p.name}${p.realm ? '-' + p.realm : ''}`));
      if (isActive) title.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-emerald-300 bg-emerald-950/30 border border-emerald-600/40 rounded-lg px-3 py-1', 'Activo'));
      if (p.class) title.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-900/60 border border-amber-600/20 rounded-lg px-3 py-1', p.class));
      if (p.race) title.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-400 bg-gray-900/60 border border-gray-600/30 rounded-lg px-3 py-1', p.race));
      if (typeof p.level === 'number') title.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-900/60 border border-amber-600/20 rounded-lg px-3 py-1', `Nivel ${p.level}`));
      if (typeof p.avgIlvl === 'number') title.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-amber-300 bg-gray-900/60 border border-amber-500/30 rounded-lg px-3 py-1', `ilvl ${p.avgIlvl}`));
      card.appendChild(title);
      if (reg.guild) {
        card.appendChild(el('p', 'text-xs text-gray-400 mb-1',
          `Hermandad: ${reg.guild.name}${reg.guild.rank ? ' · ' + reg.guild.rank : ''}`));
      }
      if (p.equipment.length > 0) {
        const list = el('div', 'grid grid-cols-1 sm:grid-cols-2 gap-1');
        p.equipment.forEach((piece) => {
          const row = el('div', 'text-xs text-gray-300 flex justify-between gap-3 bg-gray-900/40 rounded px-2 py-1');
          row.appendChild(el('span', '', piece.name));
          row.appendChild(el('span', 'text-gray-500 whitespace-nowrap', `i${piece.ilvl} · slot ${piece.slot}`));
          list.appendChild(row);
        });
        card.appendChild(list);
      }
      playerBanner.appendChild(card);
    }
    playerBanner.classList.toggle('hidden', shown.length === 0);

    // Banner de hermandad detectada por el addon
    const guildBanner = document.getElementById('guild-sv-banner') as HTMLElement;
    guildBanner.innerHTML = '';
    const rg = data.registryGuild;
    if (rg) {
      const box = el('div', 'bg-gray-900/50 border border-amber-700/40 rounded-lg p-4');
      const head = el('div', 'flex flex-wrap items-center justify-between gap-3');
      head.appendChild(el('h3', 'text-sm font-bold text-amber-200',
        `${rg.name}${rg.rank ? ' — ' + rg.rank : ''}${rg.isGM ? ' · MAESTRO' : ''}`));
      head.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500',
        rg.isGM
          ? 'Reclamo automático al subir siendo Miembro validado'
          : 'El maestro de tu hermandad puede reclamarla subiendo su SV'));
      box.appendChild(head);
      guildBanner.appendChild(box);
    }
    guildBanner.classList.toggle('hidden', !rg);

    // Bandas, reglas y roster vía módulo compartido
    renderParsedSections(data, {
      bands: document.getElementById('bands-list') as HTMLElement,
      rules: document.getElementById('rules-list') as HTMLElement,
      rosterWrap: document.getElementById('roster-table-wrap') as HTMLElement,
    });
    const allBandsCount = data.bands.length;
    (document.getElementById('bands-section') as HTMLElement).classList.toggle('hidden', allBandsCount === 0);
    (document.getElementById('rules-section') as HTMLElement).classList.toggle('hidden', data.rules.length === 0);

    // Claim de maestro
    const claimBanner = document.getElementById('claim-banner') as HTMLElement;
    const claimPending = document.getElementById('claim-pending') as HTMLElement;
    if (data.generatedBy) {
      claimBanner.classList.remove('hidden');
      (document.getElementById('claim-char') as HTMLElement).textContent = data.generatedBy;
      void setupClaim(data);
      if (!data.guild.isLeaderRank) {
        claimPending.classList.remove('hidden');
      }
    } else {
      claimBanner.classList.add('hidden');
    }

    errorEl.classList.add('hidden');
    resultEl.classList.remove('hidden');
  }

  // Muestra formulario de reclamo (con sesión) o CTA de login; valida el SV
  async function setupClaim(data: ParsedSavedVariables): Promise<void> {
    const claimForm = document.getElementById('claim-form') as HTMLFormElement;
    const claimAnon = document.getElementById('claim-anon') as HTMLElement;
    const claimMsg = document.getElementById('claim-msg') as HTMLElement;
    const claimBtn = document.getElementById('claim-btn') as HTMLButtonElement;

    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session?.user) {
      claimAnon.classList.remove('hidden');
      return;
    }
    if (!data.guild.isLeaderRank) return;

    claimForm.classList.remove('hidden');
    let claimed = false;

    claimForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (claimed) return;
      claimMsg.classList.add('hidden');

      const name = (document.getElementById('claim-name') as HTMLInputElement).value.trim();
      const discord = (document.getElementById('claim-discord') as HTMLInputElement).value.trim();
      if (!name) {
        claimMsg.textContent = 'Escribe el nombre de tu hermandad.';
        claimMsg.className = 'mt-3 text-sm rounded-lg px-4 py-2.5 bg-red-950/40 border border-red-600/40 text-red-300';
        claimMsg.classList.remove('hidden');
        return;
      }

      // Slug kebab-case a partir del nombre
      const slug = name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'hermandad';

      claimBtn.disabled = true;
      claimBtn.textContent = 'Reclamando…';
      const res = await claimGuild({ slug, name, discordLink: discord || null, generatedBy: data.generatedBy });
      claimBtn.disabled = false;
      claimBtn.textContent = 'Reclamar hermandad';

      claimMsg.classList.remove('hidden');
      if (res.ok) {
        claimed = true;
        claimForm.classList.add('hidden');
        claimMsg.textContent = '¡Hermandad reclamada! Ya eres maestro de hermandad: administra tu portal desde el dashboard.';
        claimMsg.className = 'mt-3 text-sm rounded-lg px-4 py-2.5 bg-emerald-950/30 border border-emerald-600/40 text-emerald-300';
        const dash = document.createElement('a');
        dash.href = '/dashboard';
        dash.textContent = 'Ir al dashboard →';
        dash.className = 'ml-2 underline font-bold hover:text-emerald-200';
        claimMsg.appendChild(dash);
      } else {
        claimMsg.textContent = res.error || 'No se pudo reclamar la hermandad.';
        claimMsg.className = 'mt-3 text-sm rounded-lg px-4 py-2.5 bg-red-950/40 border border-red-600/40 text-red-300';
      }
    });
  }

  function handleFile(file: File): void {
    clearWarnings();
    if (file.size > 2 * 1024 * 1024) {
      showError('El archivo supera el límite de 2 MB.');
      return;
    }
    setStatus('Leyendo archivo…');
    const reader = new FileReader();
    reader.onload = () => {
      const text = String(reader.result || '');
      setStatus('Parseando RaidDominion.lua…');
      try {
        const result = parseSavedVariables(text);
        if (!result.ok) {
          showError(result.errors.join(' '));
          return;
        }
        result.warnings.forEach(addWarning);
        renderResult(result.data as ParsedSavedVariables);
        void persistIfLoggedIn(result.data as ParsedSavedVariables);
      } catch (e) {
        showError('Error inesperado al parsear: ' + String(e));
      }
    };
    reader.onerror = () => showError('No se pudo leer el archivo.');
    reader.readAsText(file);
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  ['dragover', 'drop'].forEach((evt) => {
    dropzone.addEventListener(evt, (e) => e.preventDefault());
  });
  dropzone.addEventListener('drop', (e) => {
    const file = (e as DragEvent).dataTransfer?.files?.[0];
    if (file) handleFile(file);
  });
</script>