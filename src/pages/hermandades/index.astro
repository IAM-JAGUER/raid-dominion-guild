---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { ui } from '@/lib/ui/design';
---

<Layout title="Hermandades - RaidDominion" description="Directorio público de hermandades de la comunidad RaidDominion: roster, bandas y reglas de cada portal.">
  <Navigation currentPath="/hermandades" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />

      <header class="text-center mb-10 animate-fade-in-1">
        <p class={`${ui.eyebrow} mb-2`}>Directorio público</p>
        <h1 class={`${ui.text.hero} text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase`}>Hermandades</h1>
        <p class={`${ui.text.bodyMuted} italic mt-3 max-w-2xl mx-auto`}>
          Portales públicos de las hermandades que usan RaidDominion: roster, bandas,
          horarios y reglas, actualizados por sus propios maestros.
        </p>
        <div class={ui.sectionRule} aria-hidden="true"></div>
      </header>

      <!-- Filtros -->
      <div class="flex flex-col sm:flex-row gap-3 mb-8 animate-fade-in-1" style="animation-delay: 0.1s">
        <div class="relative flex-1">
          <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="search" id="search" placeholder="Buscar por nombre o reino…"
            class={`${ui.form.input} ${ui.focusRing} pl-9 pr-4`} />
        </div>
        <select id="faction-filter"
          class={`${ui.form.input} ${ui.focusRing} sm:w-48`}>
          <option value="">Toda facción</option>
          <option value="Horde">Horde</option>
          <option value="Alliance">Alliance</option>
        </select>
      </div>

      <!-- Resultados -->
      <p id="status" class={`${ui.loading.liveText} italic mb-4`} aria-live="polite">Cargando hermandades…</p>
      <section id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" aria-label="Listado de hermandades"></section>

      <!-- Vacío -->
      <div id="empty" class={`hidden ${ui.card} ${ui.cut} relative overflow-hidden p-8 sm:p-10 text-center`}>
        <span class={ui.cardTop} aria-hidden="true"></span>
        <div class={`${ui.iconTile} w-12 h-12 mx-auto mb-4`} aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <p class={`${ui.gradientTitle} font-black italic text-base mb-1`}>Aún no hay hermandades públicas</p>
        <p class={`${ui.text.bodyMuted} max-w-md mx-auto`}>Los maestros de hermandad publican su portal desde el dashboard al reclamar su guild.</p>
        <a href="/upload" class={`${ui.btnBase} ${ui.btnPrimary} inline-block mt-5 px-6 py-2.5 text-xs font-black uppercase tracking-widest`}>Sube tu SavedVariables</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { listPublicGuilds } from '@/lib/api';
  import type { GuildRow } from '@/types/database';
  import { ui } from '@/lib/ui/design';
  import { cardLink, iconTile, cardTitle } from '@/lib/ui/card';

  const statusEl = document.getElementById('status') as HTMLElement;
  const gridEl = document.getElementById('grid') as HTMLElement;
  const emptyEl = document.getElementById('empty') as HTMLElement;
  const searchEl = document.getElementById('search') as HTMLInputElement;
  const factionEl = document.getElementById('faction-filter') as HTMLSelectElement;

  let guilds: GuildRow[] = [];

  function card(g: GuildRow): HTMLElement {
    const link = cardLink(`/hermandad/${g.slug}`, 'p-5');

    const head = document.createElement('div');
    head.className = 'flex items-center gap-3 mb-3';
    head.appendChild(iconTile((g.name[0] || '?').toUpperCase(), 'w-10 h-10', 'text-lg'));
    head.appendChild(cardTitle(g.name, 'text-base', 'truncate min-w-0'));
    link.appendChild(head);

    if (g.description) {
      const desc = document.createElement('p');
      desc.className = `${ui.text.bodyMuted} italic line-clamp-2 mb-3`;
      desc.textContent = g.description;
      link.appendChild(desc);
    }

    // Chips: facción, servidor (enlaza al directorio de servidores), verificación y Discord
    const chips = document.createElement('div');
    chips.className = 'flex flex-wrap gap-1.5 mb-3';
    if (g.faction) {
      const faction = document.createElement('span');
      faction.className = `shrink-0 ${ui.badge} ${ui.badgeSm} ${g.faction === 'Horde' ? 'bg-red-950/40 border-red-700/50 text-red-300' : 'bg-sky-950/40 border-sky-700/50 text-sky-300'}`;
      faction.textContent = g.faction === 'Horde' ? 'Horda' : 'Alianza';
      chips.appendChild(faction);
    }
    if (g.server) {
      const serverChip = document.createElement('a');
      serverChip.href = `/servidor/${encodeURIComponent(g.server)}`;
      serverChip.className = `${ui.badge} ${ui.badgeSm} bg-gray-800/60 border-amber-600/20 text-sky-200 hover:bg-sky-900/30 transition-colors`;
      serverChip.textContent = g.server;
      chips.appendChild(serverChip);
    }
    if (g.claim_status === 'verified') {
      const verified = document.createElement('span');
      verified.className = `${ui.badge} ${ui.badgeSm} bg-emerald-950/30 border-emerald-600/40 text-emerald-300`;
      verified.textContent = '✓ Verificada';
      chips.appendChild(verified);
    }
    if (g.discord_link) {
      const discord = document.createElement('a');
      discord.href = g.discord_link;
      discord.target = '_blank';
      discord.rel = 'noopener noreferrer';
      discord.title = 'Discord de la hermandad';
      discord.className = `${ui.badge} ${ui.badgeSm} bg-indigo-950/30 border-indigo-600/40 text-indigo-300 hover:bg-indigo-900/30 transition-colors`;
      discord.textContent = 'Discord';
      chips.appendChild(discord);
    }
    if (chips.children.length > 0) link.appendChild(chips);

    const meta = document.createElement('div');
    meta.className = 'flex items-center justify-between mt-auto pt-3 border-t border-amber-600/15';
    const realm = document.createElement('span');
    realm.className = 'text-[10px] font-black uppercase tracking-widest text-gray-500';
    realm.textContent = g.realm || 'Reino no especificado';
    const cta = document.createElement('span');
    cta.className = 'text-[10px] font-black uppercase tracking-widest text-amber-400 group-hover:text-amber-300 transition-colors';
    cta.textContent = 'Ver portal →';
    meta.append(realm, cta);
    link.appendChild(meta);

    return link;
  }

  function render(): void {
    const q = searchEl.value.trim().toLowerCase();
    const f = factionEl.value;
    gridEl.innerHTML = '';

    const filtered = guilds.filter((g) => {
      const matchQ = !q || g.name.toLowerCase().includes(q) || (g.realm ?? '').toLowerCase().includes(q);
      const matchF = !f || g.faction === f;
      return matchQ && matchF;
    });

    if (filtered.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    filtered.forEach((g) => gridEl.appendChild(card(g)));
  }

  searchEl.addEventListener('input', render);
  factionEl.addEventListener('change', render);

  const res = await listPublicGuilds();
  if (!res.ok) {
    // #status se usa SOLO para el error de red; en éxito se oculta siempre.
    statusEl.textContent = 'No se pudo cargar el directorio. Intenta de nuevo más tarde.';
  } else {
    guilds = res.guilds ?? [];
    document.title = guilds.length > 0
      ? `${guilds.length} hermandad${guilds.length === 1 ? '' : 'es'} — RaidDominion`
      : 'Hermandades - RaidDominion';
    statusEl.classList.add('hidden');
    render();
  }
</script>