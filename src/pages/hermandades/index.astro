---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import DirectoryPage from '@/components/layout/DirectoryPage.astro';
import { PAGE_META, breadcrumbSchema, collectionPageSchema } from '@/lib/seo';

const meta = PAGE_META['/hermandades'];
const jsonLd = [
  collectionPageSchema('Directorio de hermandades de WoW 3.3.5a', meta.description, '/hermandades'),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Hermandades', path: '/hermandades' },
  ]),
];
---

<Layout
  title={meta.title}
  description={meta.description}
  jsonLd={jsonLd}
  particles="banner"
>
  <Navigation currentPath="/hermandades" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <DirectoryPage
        hero="Hermandades"
        tone="parchment"
        panelIcon="hermandad"
        heroImage="/images/headers/hermandades.webp"
        heroImagePosition="center"
        heroImageMode="cover"
        intro="Explora hermandades de World of Warcraft 3.3.5a por reino y facción. Cada portal reúne roster, bandas, horarios, reglas y Discord, sincronizados desde el addon RaidDominion."
        loadingText="Cargando hermandades…"
        context={{
          title: '¿Cómo aparecer en este directorio?',
          text: 'Sube el archivo del personaje que dirige tu hermandad y valida tu cuenta. El portal reconocerá tu rango de maestro y creará la hermandad sin formularios; después publícala desde tu dashboard para que aparezca aquí.',
          cta: { label: 'Subir archivo del addon', href: '/upload' },
        }}
        gridLabel="Listado de hermandades"
        empty={{
          icon: 'hermandad',
          title: 'Aún no hay hermandades públicas',
          titleCls: 'font-black italic',
          message: 'Los maestros de hermandad publican su portal desde el dashboard al reclamar su guild.',
          cta: { label: 'Sube el archivo del addon', href: '/upload' },
        }}
      />
    </div>
  </main>
</Layout>

<script>
  import { listPublicGuilds } from '@/lib/api';
  import { renderGuildCard } from '@/lib/ui/cards';
  import { PAGE_SIZE_GRID } from '@/lib/ui/paginator';
  import { resolveAsyncList, settleAsyncList, clearListItems, mountPagedList } from '@/lib/ui/list';

  // Ítems por página del directorio (grilla 3 columnas × 4 filas).

  const list = resolveAsyncList();
  const gridEl = document.getElementById('grid') as HTMLElement;
  const filtersEl = document.getElementById('filters') as HTMLElement;
  const pagerEl = document.getElementById('pager') as HTMLElement;

  const res = await listPublicGuilds();
  if (!res.ok) {
    settleAsyncList(list, 'notice', 'No se pudo cargar el directorio. Intenta de nuevo más tarde.');
  } else {
    const guilds = res.guilds ?? [];
    document.title = guilds.length > 0
      ? `${guilds.length} hermandad${guilds.length === 1 ? '' : 'es'} — RaidDominion`
      : 'Hermandades - RaidDominion';
    if (guilds.length === 0) {
      settleAsyncList(list, 'empty');
    } else {
      // Panel estándar (src/lib/ui/filterBar.ts): buscador (nombre, reino,
      // servidor, descripción) + selector dinámico de facción, reino,
      // Verificada y Discord. Cards vía renderGuildCard (src/lib/ui/cards.ts).
      mountPagedList({
        mount: filtersEl,
        items: guilds,
        pageSize: PAGE_SIZE_GRID,
        pager: pagerEl,
        container: gridEl,
        renderItem: (g) => renderGuildCard(g),
        getSearchText: (g) => `${g.name} ${g.realm ?? ''} ${g.server ?? ''} ${g.description ?? ''}`,
        searchPlaceholder: 'Buscar por nombre, reino o descripción…',
        searchLabel: 'Buscar hermandades por nombre, reino o descripción',
        facets: [
          {
            id: 'faccion',
            label: 'Filtrar por facción',
            // Solo facciones reales: el addon usa '?' como marcador de
            // desconocido y no debe agruparse como Alianza.
            getValues: (g) => (g.faction === 'Horde' || g.faction === 'Alliance' ? [g.faction] : []),
            labelOf: (v) => (v === 'Horde' ? 'Horda' : 'Alianza'),
            order: () => ['Horde', 'Alliance'],
          },
          {
            id: 'reino',
            label: 'Filtrar por reino',
            getValues: (g) => [(g.realm ?? '').trim()].filter(Boolean),
          },
          {
            kind: 'flag',
            id: 'verified',
            label: 'Filtrar hermandades verificadas',
            getFlag: (g) => g.claim_status === 'verified',
            chipLabel: 'Verificada',
            icon: 'medalla',
          },
          {
            kind: 'flag',
            id: 'discord',
            label: 'Filtrar hermandades con Discord',
            getFlag: (g) => !!g.discord_link,
            chipLabel: 'Discord',
            icon: 'discord',
          },
        ],
        resultNoun: (n) => `${n} hermandad${n === 1 ? '' : 'es'}`,
        clear: () => clearListItems(list),
        emptyMessage: (state) => state.query.trim()
          ? `Ninguna hermandad coincide con "${state.query.trim()}".`
          : 'Sin resultados con los filtros aplicados.',
        renderEmpty: (message) => settleAsyncList(list, 'notice', message),
        onReady: () => settleAsyncList(list, 'ready'),
      });
    }
  }
</script>
