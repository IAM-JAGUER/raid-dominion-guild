---
// Portal público DE HERMANDAD (/hermandad/:slug). Ruta canónica del portal de
// guild: shell estático servido por el rewrite netlify /hermandad/* → /hermandad
// (en dev lo replica el middleware de astro.config.mjs). El navegador conserva
// la URL real /hermandad/:slug y el script resuelve el slug 100% en cliente
// contra src/lib/api.ts.
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import { ui } from '@/lib/ui/design';
---

<Layout title="Hermandad - RaidDominion" description="Portal público de hermandad de la comunidad RaidDominion.">
  <Navigation />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />

      <!-- Cargando -->
      <div id="loading" class="text-center py-20">
        <div class={`${ui.loading.spinner} w-8 h-8`}></div>
        <p class={`${ui.loading.liveText} italic mt-4`}>Invocando el portal…</p>
      </div>

      <!-- No encontrado -->
      <div id="not-found" class={`hidden ${ui.panel} ${ui.cut} !border-red-900/40 rounded-md p-8 sm:p-10 text-center`}>
        <svg class="w-10 h-10 text-red-400/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <h2 class={`${ui.text.h2} text-white mb-2`}>Portal no encontrado</h2>
        <p id="not-found-msg" class={`${ui.text.bodyMuted} max-w-md mx-auto mb-6`}>Esta hermandad no existe o su portal es privado.</p>
        <a href="/hermandades" class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest transform hover:scale-105`}>Ver directorio</a>
      </div>

      <!-- Portal -->
      <div id="portal" class="hidden space-y-8">

        <!-- Vista previa privada (owner) -->
        <div id="preview-banner" class={`hidden ${ui.panel} ${ui.cut} relative overflow-hidden p-4 flex items-start gap-3`}>
          <div class={`${ui.iconTile} w-10 h-10 shrink-0`} aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <p class="text-sm text-gray-300 mt-1.5"><span class="font-bold text-amber-200">Vista previa privada.</span> Solo tú puedes ver este portal. Publícalo desde tu dashboard para que aparezca en el directorio.</p>
        </div>

        <!-- Hero (sin caja: sin padding, borde ni fondo, tipografía limpia) -->
        <header class="animate-fade-in-1">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1 flex items-center">
                <svg class="w-3.5 h-3.5 mr-1.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l7 3v5c0 4.97-3.13 8.32-7 9.73-3.87-1.41-7-4.76-7-9.73V6l7-3z"/></svg>
                <span>Portal de hermandad</span>
              </p>
              <h1 id="guild-name" class={`${ui.titleFicha} ${ui.gradientTitle}`}></h1>
            </div>
            <div class="flex items-center gap-2">
              <span id="verified-badge" class={`hidden ${ui.badge} ${ui.badgeMd} ${ui.status.success}`}>✓ Verificada</span>
              <a id="discord-link" href="#" target="_blank" rel="noopener" class="hidden px-4 py-2 rounded-md border border-indigo-500/50 bg-indigo-950/30 text-indigo-300 hover:bg-indigo-900/40 transition-all text-xs font-black uppercase tracking-widest">Discord</a>
            </div>
          </div>
          <p id="guild-description" class={`${ui.text.body} max-w-3xl leading-relaxed`}></p>
          <div id="guild-meta" class="flex flex-wrap gap-2 mt-4"></div>
          <p id="snapshot-updated" class={`hidden mt-3 italic ${ui.text.caption}`}></p>
          <div class={`${ui.dividerFadeRight} mt-6`} aria-hidden="true"></div>
        </header>

        <!-- Pestañas: Miembros · Bandas · Reglas -->
        <div id="portal-tabs" class="hidden">
          <nav id="portal-tab-bar" role="tablist" aria-label="Secciones del portal" class="flex flex-nowrap items-center gap-1 rd-tabbar relative animate-fade-in-1 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" style="animation-delay: 0.15s"></nav>

          <div id="panel-miembros" role="tabpanel" aria-labelledby="tab-miembros" class="space-y-6 pt-6">
            <!-- Roster con filtros: rangos + clases (mismo chip de barra; las
                 clases conservan su ícono) + buscador por nombre. Todos filtran
                 la lista de jugadores de abajo (renderRoster). Mismo modelo de
                 ventana que los paneles del dashboard — cabecera contigua
                 (título + controles de filtro) + cuerpo con el roster. -->
            <PanelWindow title="Roster" gradient={false} titleCls="text-lg font-bold flex items-center text-amber-200">
              <div slot="head">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-4 items-start mt-4">
                  <details id="filtro-jerarquia" class={ui.disclosure}>
                    <summary class={ui.disclosureSummary}>
                      <span class="inline-flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        Jerarquía
                      </span>
                      <svg class="w-4 h-4 text-amber-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </summary>
                    <div class={ui.disclosureBody}>
                      <div id="stats-ranks" class="grid grid-cols-2 gap-2 content-start min-w-0"></div>
                    </div>
                  </details>
                  <details id="filtro-clases" class={ui.disclosure}>
                    <summary class={ui.disclosureSummary}>
                      <span class="inline-flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10v-1a3 3 0 00-3-3h-4a3 3 0 00-3 3v1zm0 0v-3a3 3 0 01-3-3V7a3 3 0 013-3h10a3 3 0 013 3v8a3 3 0 01-3 3v3m-9-7h.01M9 6h.01m.01-1h.01"/></svg>
                        Clases
                      </span>
                      <svg class="w-4 h-4 text-amber-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </summary>
                    <div class={ui.disclosureBody}>
                      <div id="stats-classes" class="grid grid-cols-2 gap-2 content-start min-w-0"></div>
                    </div>
                  </details>
                </div>
                <!-- Control de texto: filtra por nombre -->
                <div id="roster-search-wrap" class="hidden mt-4">
                  <div class="relative">
                    <svg class="w-4 h-4 text-amber-400/70 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
                    <input
                      id="roster-search"
                      type="search"
                      autocomplete="off"
                      class={`${ui.form.input} ${ui.focusRing} pl-9 pr-3`}
                      placeholder="Buscar jugador por nombre…"
                      aria-label="Buscar jugador por nombre"
                    />
                  </div>
                </div>
              </div>
              <p id="roster-empty-filter" class={`hidden ${ui.text.bodyMuted} italic text-center bg-gray-900/40 border border-amber-600/20 rounded-md p-4`}>
                Ningún jugador coincide con estos filtros.
              </p>
              <div id="viewer-roster-wrap"></div>
            </PanelWindow>
          </div>

          <div id="panel-bandas" role="tabpanel" aria-labelledby="tab-bandas" class="hidden space-y-6 pt-6">
            <!-- Ventana de panel: cabecera contigua (secciónHead) + cuerpo
                 (sectionBody), mismo modelo que Roster y los paneles del portal. -->
            <PanelWindow title="Bandas" gradient={false} titleCls="text-lg font-bold flex items-center text-amber-200">
              <div id="viewer-bands" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div>
              <div id="bandas-empty" class={`hidden ${ui.panel} ${ui.cut} relative overflow-hidden p-6 sm:p-8 text-center`}>
                <div class={`${ui.iconTile} w-12 h-12 mx-auto mb-4`} aria-hidden="true">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                </div>
                <p class="font-bold text-white mb-1">Sin bandas publicadas</p>
                <p class={`${ui.text.bodyMuted} italic`}>Esta hermandad aún no publica bandas.</p>
              </div>
            </PanelWindow>
          </div>

          <div id="panel-reglas" role="tabpanel" aria-labelledby="tab-reglas" class="hidden space-y-6 pt-6">
            <!-- Ventana de panel: cabecera contigua (secciónHead) + cuerpo
                 (sectionBody), mismo modelo que Roster y Bandas. -->
            <PanelWindow title="Reglas" gradient={false} titleCls="text-lg font-bold flex items-center text-amber-200">
              <div id="viewer-rules" class="space-y-2 [&>li]:flex [&>li]:items-start [&>li]:text-sm [&>li]:text-gray-300 [&>li]:bg-gray-800/30 [&>li]:border [&>li]:border-amber-600/15 [&>li]:rounded-md [&>li]:px-3 [&>li]:py-2.5 [&>li]:transition-colors [&>li:hover]:border-amber-500/30"></div>
              <div id="reglas-empty" class={`hidden ${ui.panel} ${ui.cut} relative overflow-hidden p-6 text-center`}>
                <div class={`${ui.iconTile} w-12 h-12 mx-auto mb-4`} aria-hidden="true">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <p class="font-bold text-white mb-1">Sin reglas publicadas</p>
                <p class={`${ui.text.bodyMuted} italic`}>Esta hermandad aún no publica reglas.</p>
              </div>
            </PanelWindow>
          </div>
        </div>

        <!-- Sin snapshot -->
        <div id="no-snapshot" class={`hidden ${ui.panel} ${ui.cut} relative overflow-hidden p-6 sm:p-8 text-center`}>
          <div class={`${ui.iconTile} w-12 h-12 mx-auto mb-4`} aria-hidden="true">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <p class="font-bold text-white mb-1">Sin análisis público todavía</p>
          <p class="text-sm text-gray-400">El maestro de esta hermandad aún no publica roster ni bandas.</p>
        </div>

        <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
        <!-- Contexto del portal (servidor/reino): van DESPUÉS del separador
             final para liberar el encabezado; se rellenan solo con los chips
             de servidor y reino (la atribución ★ y la facción quedan arriba). -->
        <div id="guild-context" class="hidden flex flex-wrap gap-2"></div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { getPublicGuildBySlug, getGuildSnapshot, getGuildRules, listGuildPortalBands, getPublicCharactersByUser, getPublicCharacterSlugsByNames, type GuildPortalSnapshot } from '@/lib/api';
  import type { BandRow } from '@/types/database';
  import type { ContentItem } from '@/types/parser';
  import { slugify, RESERVED, currentSlug } from '@/lib/routes';
  import { renderParsedSections, renderRoster, el } from '@/lib/ui/preview';
  import { renderBandCard } from '@/lib/ui/cards';
  import { resolveBandOwners } from '@/lib/bandListing';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { sortRanks } from '@/lib/ui/ranks';
  import { ui } from '@/lib/ui/design';
  import { setBreadcrumb } from '@/lib/ui/dom';
  import { createTabBar, PORTAL_TABS, tabFromHash } from '@/lib/ui/tabs';
  import { mergeBandPlayers } from '@/lib/bandMerge';

  function showNotFound(msg?: string): void {
    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    const nf = document.getElementById('not-found') as HTMLElement;
    if (msg) (document.getElementById('not-found-msg') as HTMLElement).textContent = msg;
    nf.classList.remove('hidden');
    document.title = 'Portal no encontrado - RaidDominion';
  }

  function metaChip(text: string): HTMLElement {
    const chip = document.createElement('span');
    chip.className = `${ui.badge} ${ui.badgeMd} text-gray-200 bg-gradient-to-b from-gray-800/80 to-gray-900/80 border-amber-600/30`;
    chip.textContent = text;
    return chip;
  }

  const slug = currentSlug();
  if (!slug || RESERVED.has(slug.toLowerCase())) {
    showNotFound();
  } else {
    const res = await getPublicGuildBySlug(slug);
    if (!res.ok) {
      showNotFound('No se pudo cargar el portal. Intenta de nuevo más tarde.');
    } else if (!res.guild) {
      showNotFound();
    } else {
      const g = res.guild;
      document.title = `${g.name} - RaidDominion`;
      setBreadcrumb(g.name);

      (document.getElementById('guild-name') as HTMLElement).textContent = g.name;
      const descEl = document.getElementById('guild-description') as HTMLElement;
      descEl.textContent = g.description || '';
      descEl.classList.toggle('hidden', !g.description);

      const metaEl = document.getElementById('guild-meta') as HTMLElement;
      // Servidor/reino del portal: viven en la tira de contexto al final del
      // contenido (#guild-context), no en el encabezado.
      const ctxEl = document.getElementById('guild-context') as HTMLElement;
      if (g.server) {
        const serverChip = document.createElement('a');
        serverChip.href = `/servidor/${encodeURIComponent(g.server)}`;
        serverChip.className = `${ui.badge} ${ui.badgeMd} bg-gradient-to-b from-sky-950/60 to-sky-950/30 border-sky-600/40 text-sky-200 hover:from-sky-900/70 hover:to-sky-900/40 hover:border-sky-400/60 hover:text-sky-100 transition-all`;
        serverChip.textContent = g.server;
        ctxEl.appendChild(serverChip);
      }
      if (g.realm) {
        const realmChip = document.createElement(g.server ? 'a' : 'span');
        const cls = `${ui.badge} ${ui.badgeMd} text-gray-200 bg-gradient-to-b from-gray-800/80 to-gray-900/80 border-amber-600/30`;
        if (g.server) {
          (realmChip as HTMLAnchorElement).href = `/servidor/${encodeURIComponent(g.server)}/reino/${encodeURIComponent(slugify(g.realm))}`;
          realmChip.className = `${cls} hover:from-gray-700/80 hover:to-gray-800/60 hover:border-amber-400/50 hover:text-gray-100 transition-all`;
        } else {
          realmChip.className = cls;
        }
        realmChip.textContent = g.realm;
        ctxEl.appendChild(realmChip);
      }
      if (ctxEl.children.length > 0) ctxEl.classList.remove('hidden');
      if (g.faction) metaEl.appendChild(metaChip(g.faction === 'Horde' ? 'Horda' : 'Alianza'));

      // Atribución de la hermandad: el chip ★ se muestra SOLO cuando el
      // personaje rango 0 (sv_is_gm) de ESTA hermandad es público y tiene
      // slug. La guild NUNCA se atribuye al perfil del jugador (cuenta): si
      // no hay personaje GM público, no se muestra ninguna atribución.
      const charsRes = await getPublicCharactersByUser(g.owner_id);
      const chars = charsRes.ok ? (charsRes.items ?? []) : [];
      const guildName = g.name.trim().toLowerCase();
      const gmChar = chars.find(
        (c) => c.sv_is_gm && c.sv_guild_name?.trim().toLowerCase() === guildName
      );
      if (gmChar && gmChar.slug) {
        const ownerChip = document.createElement('a');
        ownerChip.className = `${ui.badge} ${ui.badgeMd} bg-gradient-to-b from-fuchsia-950/60 to-fuchsia-950/25 border-fuchsia-500/40 text-fuchsia-300 hover:from-fuchsia-900/70 hover:to-fuchsia-900/40 hover:border-fuchsia-400/60 transition-all`;
        ownerChip.href = `/personaje/${gmChar.slug}`;
        ownerChip.textContent = `★ ${gmChar.name}`;
        metaEl.appendChild(ownerChip);
      }

      if (g.claim_status === 'verified') {
        document.getElementById('verified-badge')?.classList.remove('hidden');
      }
      if (g.discord_link) {
        const link = document.getElementById('discord-link') as HTMLAnchorElement;
        link.href = g.discord_link;
        link.classList.remove('hidden');
      }
      if (!g.is_public) {
        document.getElementById('preview-banner')?.classList.remove('hidden');
      }

      // Snapshot público (roster/reglas) + bandas integradas en tiempo real.
      // Las bandas del portal ya NO vienen del snapshot: se leen de
      // raiddominion_bands con guild_id = hermandad y dueño de rango
      // autorizado (listGuildPortalBands). Si una banda oculta jugadores,
      // players[] ya viene vacío y el contador se omite.
      let snapshot: GuildPortalSnapshot | undefined;
      let manualRules: ContentItem[] | undefined;
      const [snapRes, bandsRes, rulesRes] = await Promise.all([
        getGuildSnapshot(g.id),
        listGuildPortalBands(g.id),
        getGuildRules(g.id),
      ]);
      if (snapRes.ok) snapshot = snapRes.snapshot;
      if (rulesRes.ok && Array.isArray(rulesRes.items)) manualRules = rulesRes.items;
      const portalBands = bandsRes.ok ? bandsRes.bands ?? [] : [];

      const loading = document.getElementById('loading') as HTMLElement;
      loading.classList.add('hidden');
      document.getElementById('portal')?.classList.remove('hidden');

      // Las reglas publicadas son SOLO las que eligió el maestro en su
      // dashboard (#hermandad). Subir un SV no llena reglas del portal:
      // si el maestro no eligió ninguna, no hay sección de reglas.
      const hasSnapshotContent = (!!snapshot && snapshot.members.length > 0) || (manualRules?.length ?? 0) > 0;
      if (!hasSnapshotContent && portalBands.length === 0) {
        document.getElementById('no-snapshot')?.classList.remove('hidden');
      } else {
        // Pestañas Miembros / Bandas / Reglas: los conteos viven como badges
        // de la barra (reemplazan al antiguo strip de métricas). Los paneles
        // vacíos se mantienen visibles con placeholder.
        const members = snapshot?.members ?? [];
        const rules = manualRules ?? [];
        const ranks = snapshot?.ranks;

        // Enlaza al roster con las fichas públicas: resuelve los slugs de
        // /personaje/:slug por nombre y los adjunta a cada miembro. Los que
        // no tienen ficha pública (o RLS no los expone) se quedan sin slug y
        // se muestran como texto plano.
        try {
          const slugRes = await getPublicCharacterSlugsByNames(members.map((m) => m.name));
          if (slugRes.ok && slugRes.slugs) {
            const slugs = slugRes.slugs;
            members.forEach((m) => {
              const s = slugs[(m.name || '').trim().toLowerCase()];
              if (s) m.slug = s;
            });
          }
        } catch {
          // Silencioso: sin slugs el roster no enlaza, no rompe el panel.
        }

        document.getElementById('portal-tabs')?.classList.remove('hidden');

        if (snapshot?.lastUpdate) {
          const upd = document.getElementById('snapshot-updated') as HTMLElement;
          upd.textContent = `Análisis actualizado el ${new Date(snapshot.lastUpdate * 1000).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })}`;
          upd.classList.remove('hidden');
        }

        // Filtros del roster: rangos y clases comparten el mismo chip de
        // barra de progreso (las clases conservan su ícono) y, debajo, un
        // buscador de texto. Los tres filtran la lista de jugadores vía
        // renderRoster; un clic aplica el filtro y otro lo quita.
        if (members.length > 0) {
          const total = members.length;
          const ranksBox = document.getElementById('stats-ranks') as HTMLElement;
          const classesBox = document.getElementById('stats-classes') as HTMLElement;
          // Colapsables que agrupan los chips de filtro: se ocultan completos
          // cuando su grupo queda vacío (sin rangos o sin clases).
          const ranksFilter = document.getElementById('filtro-jerarquia') as HTMLElement;
          const classesFilter = document.getElementById('filtro-clases') as HTMLElement;
          const rosterWrap = document.getElementById('viewer-roster-wrap') as HTMLElement;
          const emptyFilter = document.getElementById('roster-empty-filter') as HTMLElement;
          const searchInput = document.getElementById('roster-search') as HTMLInputElement;

          // Clave de agrupación de rango: su índice si está declarado en la
          // jerarquía; huérfanos y sin rankIndex comparten el grupo "Otros".
          const declared = sortRanks([...(ranks ?? [])]);
          const declaredIndexes = new Set(declared.map((r) => r.index));
          const rankKey = (m: (typeof members)[number]): number | 'others' =>
            typeof m.rankIndex === 'number' && declaredIndexes.has(m.rankIndex) ? m.rankIndex : 'others';

          const state = { rank: undefined as number | 'others' | undefined, cls: undefined as string | undefined, query: '' };

          const statChip = (o: {
            label: string; count: number; pct: number; icon?: HTMLImageElement | null;
            leader?: boolean; active: boolean; dataset: Record<string, string>;
          }): HTMLButtonElement => {
            const btn = document.createElement('button');
            btn.type = 'button';
            // Fila 1: solo el nombre (con elipsis). Fila 2: barra + cifra/porcentaje al final.
            btn.className = 'w-full min-w-0 rounded-md px-3 py-2 border text-left transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ' +
              (o.leader
                ? 'text-amber-200 border-amber-500/50 bg-gradient-to-b from-amber-900/40 to-amber-950/40 hover:from-amber-900/55'
                : 'text-gray-200 bg-gradient-to-b from-gray-800/80 to-gray-900/80 border-amber-600/25 hover:border-amber-500/40 hover:from-gray-700/70') +
              (o.active ? ' ring-2 ring-amber-400/60 border-amber-500/80 shadow-lg shadow-amber-500/10' : '');
            Object.entries(o.dataset).forEach(([k, v]) => btn.setAttribute(`data-${k}`, v));
            btn.setAttribute('aria-pressed', String(o.active));
            const nameRow = el('div', 'flex items-center gap-1.5 mb-1 min-w-0');
            if (o.icon) {
              o.icon.className = 'w-4 h-4 rounded-sm border border-gray-700/50 shrink-0 object-cover';
              nameRow.appendChild(o.icon);
            }
            nameRow.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest truncate flex-1 min-w-0', o.label));
            btn.appendChild(nameRow);
            const barRow = el('div', 'flex items-center gap-2 min-w-0');
            const barWrap = el('div', 'flex-1 min-w-0 h-1.5 rounded-full bg-gray-900/60 overflow-hidden');
            const bar = el('div', 'h-full rounded-full ' + (o.leader ? 'bg-gradient-to-r from-amber-400 to-amber-300' : 'bg-gradient-to-r from-amber-600 to-amber-400'));
            bar.style.width = `${Math.max(2, o.pct)}%`;
            barWrap.appendChild(bar);
            barRow.appendChild(barWrap);
            barRow.appendChild(el('span', `${ui.statValue} text-[11px] shrink-0`, `${o.count} (${o.pct}%)`));
            btn.appendChild(barRow);
            return btn;
          };

          const renderStats = (): void => {
            ranksBox.innerHTML = '';
            classesBox.innerHTML = '';

            // Rangos en orden de jerarquía + "Otros" al final.
            const byRank = new Map<number | 'others', number>();
            members.forEach((m) => {
              const k = rankKey(m);
              byRank.set(k, (byRank.get(k) ?? 0) + 1);
            });
            const rankChips: HTMLButtonElement[] = [];
            declared.forEach((r, i) => {
              const count = byRank.get(r.index) ?? 0;
              if (count === 0) return;
              rankChips.push(statChip({
                label: `${i + 1}. ${(r.name || '').trim() || (r.index === 0 ? 'Líder' : `Rango ${r.index}`)}`,
                count, pct: Math.round((count / total) * 100), leader: r.index === 0,
                active: state.rank === r.index, dataset: { 'rank-key': String(r.index) },
              }));
            });
            const others = byRank.get('others') ?? 0;
            if (others > 0) {
              rankChips.push(statChip({
                label: 'Otros', count: others, pct: Math.round((others / total) * 100),
                active: state.rank === 'others', dataset: { 'rank-key': 'others' },
              }));
            }
            rankChips.forEach((c) => ranksBox.appendChild(c));
            ranksFilter.classList.toggle('hidden', rankChips.length === 0);

            // Clases con su ícono y la misma barra; sin clase → "Sin dato" con ícono por defecto.
            const byClass = new Map<string, { label: string; cls?: string; count: number }>();
            members.forEach((m) => {
              const cls = (m.class || '').trim();
              const key = cls ? cls.toLowerCase() : '__none__';
              const cur = byClass.get(key) ?? { label: cls || 'Sin dato', cls: cls || undefined, count: 0 };
              cur.count += 1;
              byClass.set(key, cur);
            });
            const classChips = Array.from(byClass.values())
              .sort((a, b) => b.count - a.count)
              .map((c) => statChip({
                label: c.label, count: c.count, pct: Math.round((c.count / total) * 100),
                icon: classIconEl(c.cls, undefined, 'w-4 h-4 rounded-sm border border-gray-700/50 shrink-0 object-cover'),
                active: state.cls === (c.cls ? c.cls.toLowerCase() : '__none__'),
                dataset: { 'class-key': c.cls ? c.cls.toLowerCase() : '__none__' },
              }));
            classChips.forEach((c) => classesBox.appendChild(c));
            classesFilter.classList.toggle('hidden', classChips.length === 0);
          };

          const applyFilters = (): void => {
            const q = state.query.trim().toLowerCase();
            const filtered = members.filter((m) => {
              if (state.rank !== undefined && rankKey(m) !== state.rank) return false;
              const cls = (m.class || '').trim();
              if (state.cls !== undefined && cls.toLowerCase() !== state.cls) return false;
              if (q && !(m.name || '').toLowerCase().includes(q)) return false;
              return true;
            });
            renderRoster(rosterWrap, filtered, ranks);
            const any = state.rank !== undefined || state.cls !== undefined || q !== '';
            emptyFilter.classList.toggle('hidden', !(any && filtered.length === 0));
          };

          ranksBox.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rank-key]');
            if (!btn) return;
            const k: number | 'others' = btn.dataset.rankKey === 'others' ? 'others' : Number(btn.dataset.rankKey);
            state.rank = state.rank === k ? undefined : k;
            renderStats();
            applyFilters();
          });
          classesBox.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-class-key]');
            if (!btn) return;
            const k = btn.dataset.classKey ?? '';
            state.cls = state.cls === k ? undefined : k;
            renderStats();
            applyFilters();
          });
          searchInput.addEventListener('input', () => {
            state.query = searchInput.value;
            applyFilters();
          });

          document.getElementById('roster-search-wrap')?.classList.remove('hidden');
          renderStats();
          applyFilters();
        }
        renderParsedSections(
          { guild: { members }, bands: [], rules, ranks } as never,
          {
            bands: document.getElementById('viewer-bands') as HTMLElement,
            rules: document.getElementById('viewer-rules') as HTMLElement,
            rosterWrap: document.getElementById('viewer-roster-wrap') as HTMLElement,
          },
        );

        // Panel Reglas: placeholder si no hay reglas publicadas.
        if (rules.length === 0) {
          document.getElementById('reglas-empty')?.classList.remove('hidden');
        }

        // Panel Bandas: cards compactas enlazando a la vista de cada banda, con
        // ATRIBUCIÓN al modelo del directorio /bandas: cada banda identifica a
        // quién pertenece (aquí, ESTA hermandad). Una banda del GM y una banda
        // integrada por un miembro que coinciden en nombre/horario/GS se
        // muestran como UNA, con conteo fusionado y badge "Integrada" cuando
        // la fuente es un personaje de un miembro.
        const merged = mergePortalBands(portalBands, g.owner_id);
        const bandsBox = document.getElementById('viewer-bands') as HTMLElement;
        bandsBox.innerHTML = '';
        const bandOwners = await resolveBandOwners(portalBands);
        merged.forEach(({ band, source, playerCount }) => {
          bandsBox.appendChild(renderBandCard(band, { source, playerCount, owner: bandOwners.get(band.guild_id || band.owner_id) }));
        });
        if (merged.length === 0) {
          document.getElementById('bandas-empty')?.classList.remove('hidden');
        }

        // Barra de pestañas (deep-link por hash #miembros/#bandas/#reglas).
        // Las cifras viven en el encabezado (chips en #guild-meta), no en los tabs.
        // Cifras del encabezado (chips de Miembros/Bandas/Reglas): grupo
        // segmentado unificado (1px de separador vía gap-px con el fondo del
        // contenedor) que enlaza a cada tab por hash (#miembros/#bandas/#reglas).
        // Orden y textos salen SOLO de PORTAL_TABS (contrato único de tabs).
        const metaEl = document.getElementById('guild-meta') as HTMLElement;
        const metaChips: Record<string, HTMLAnchorElement> = {};
        const metaGroup = document.createElement('div');
        metaGroup.className = 'inline-flex flex-wrap gap-px rounded-md border border-amber-500/40 bg-amber-600/20 overflow-hidden';
        PORTAL_TABS.forEach((t) => {
          const n = t.id === 'miembros' ? members.length : t.id === 'bandas' ? merged.length : rules.length;
          const chip = document.createElement('a');
          chip.href = t.href;
          chip.className = 'px-3 py-1.5 text-[10px] font-black uppercase tracking-widest transition-all duration-150 bg-gradient-to-b from-gray-900/90 to-gray-950/90 hover:from-amber-900/50 hover:to-amber-950/50 hover:text-amber-200 text-gray-400';
          chip.textContent = `${t.label} · ${n}`;
          metaGroup.appendChild(chip);
          metaChips[t.id] = chip;
        });
        metaEl.appendChild(metaGroup);

        // Ilumina el chip correspondiente a la tab activa (hash); falla a la
        // tab por defecto igual que createTabBar. Se re-sincroniza al navegar
        // por hash o al pulsar un botón de la barra (activate usa replaceState,
        // que no dispara hashchange).
        const syncMetaChips = (): void => {
          let active = tabFromHash(window.location.hash);
          if (!metaChips[active]) active = 'miembros';
          Object.entries(metaChips).forEach(([id, chip]) => {
            const on = id === active;
            chip.classList.toggle('bg-amber-500/20', on);
            chip.classList.toggle('text-amber-200', on);
            chip.classList.toggle('text-gray-400', !on);
            if (on) chip.setAttribute('aria-current', 'page');
            else chip.removeAttribute('aria-current');
          });
        };
        createTabBar({
          tabs: PORTAL_TABS,
          barId: 'portal-tab-bar',
          defaultId: 'miembros',
        });
        syncMetaChips();
        window.addEventListener('hashchange', syncMetaChips);
        document.getElementById('portal-tab-bar')?.addEventListener('click', syncMetaChips);
      }
    }
  }

  // Clave de coincidencia de una banda: nombre + horario (día y hora van en el
  // string schedule del addon) + gearscore, normalizados (trim + lowercase).
  function portalBandKey(b: BandRow): string {
    return [
      (b.name || '').trim().toLowerCase(),
      (b.schedule || '').trim().toLowerCase(),
      typeof b.min_gs === 'number' && b.min_gs > 0 ? String(b.min_gs) : '',
    ].join('|');
  }

  // Fusiona bandas del portal: agrupa por clave; la base es la banda del GM
  // (owner de la hermandad) si existe en el grupo; la fuente destacada es el
  // character_name del personaje que integró la banda de un miembro. El conteo
  // de jugadores es la unión del grupo (mergeBandPlayers), 0 si hide_players.
  function mergePortalBands(bands: BandRow[], guildOwnerId: string): Array<{ band: BandRow; source: string | null; playerCount: number }> {
    const groups = new Map<string, BandRow[]>();
    bands.forEach((b) => {
      const key = portalBandKey(b);
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(b);
    });
    const out: Array<{ band: BandRow; source: string | null; playerCount: number }> = [];
    groups.forEach((group) => {
      if (group.length === 1) {
        const only = group[0];
        out.push({
          band: only,
          source: only.character_name && only.owner_id !== guildOwnerId ? only.character_name : null,
          playerCount: only.hide_players ? 0 : mergeBandPlayers(group).length,
        });
        return;
      }
      const gmBand = group.find((b) => b.owner_id === guildOwnerId);
      const memberBand = group.find((b) => b.owner_id !== guildOwnerId);
      const base = gmBand ?? memberBand ?? group[0];
      const source = memberBand?.character_name ?? null;
      const playerCount = base.hide_players ? 0 : mergeBandPlayers(group).length;
      out.push({ band: base, source, playerCount });
    });
    return out;
  }
</script>