---
// Portal público DE HERMANDAD (/hermandad/:slug). Ruta canónica del portal de
// guild: shell estático servido por el rewrite netlify /hermandad/* → /hermandad
// (en dev lo replica el middleware de astro.config.mjs). El navegador conserva
// la URL real /hermandad/:slug y el script resuelve el slug 100% en cliente
// contra src/lib/api.ts.
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Icon from '@/components/ui/Icon.astro';
import StatusCard from '@/components/ui/StatusCard.astro';
import FichaHero from '@/components/ui/FichaHero.astro';
import FichaDock from '@/components/ui/FichaDock.astro';
import { ui } from '@/lib/ui/design';
import { PAGE_META } from '@/lib/seo';

const meta = PAGE_META['/hermandad'];
---

<Layout
  title={meta.title}
  description={meta.description}
  autoCanonical
  particles="banner"
>
  <Navigation />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />

      <noscript><style>#loading { display: none; }</style></noscript>

      <!-- Cargando -->
      <LoadingBlock id="loading" text="Invocando el portal…" />

      <!-- No encontrado -->
      <StatusCard
        id="not-found"
        cut
        icon="advertencia"
        title="Portal no encontrado"
        titleTag="h1"
        message="Esta hermandad no existe o su portal es privado."
        messageId="not-found-msg"
        cta={{ label: 'Ver directorio', href: '/hermandades' }}
      />

      <!-- Portal: encabezado + pestañas en la MISMA ficha. La tira de
           contexto (#guild-context) queda fuera de la ficha. -->
      <div id="portal" data-rd-reveal class="hidden">

        <!-- Vista previa privada (owner) -->
        <div id="preview-banner" class={`hidden ${ui.panel} ${ui.cut} relative overflow-hidden p-4 flex items-start gap-3 mb-8`}>
          <div class={`${ui.iconTile} ${ui.iconTileMd}`} aria-hidden="true">
            <Icon name="visibilidad" size="md" />
          </div>
          <p class="text-sm text-gray-300 mt-1.5"><span class="font-bold text-brand-200">Vista previa privada.</span> Solo tú puedes ver este portal. Publícalo desde tu dashboard para que aparezca en el directorio.</p>
        </div>

        <!-- Hero: placa de identidad (póster) con medallón héroe -->
        <FichaHero image="/images/headers/portal-hermandad.webp" icon="estandarte" tone="valor">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
              <h1 id="guild-name" class={`${ui.titleFicha} ${ui.gradientTitle} ${ui.toneTitle}`}></h1>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span id="verified-badge" class={`hidden ${ui.badge} ${ui.badgeMd} ${ui.status.success}`}><Icon name="medalla" size="xs" class="self-center" />Verificada</span>
              <a id="discord-link" href="#" target="_blank" rel="noopener" class="hidden inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-indigo-500/50 bg-indigo-950/30 text-indigo-300 hover:bg-indigo-900/40 transition-all text-xs font-black uppercase tracking-widest"><Icon name="discord" size="sm" />Discord</a>
              <span id="guild-share"></span>
            </div>
          </div>
          <p id="guild-description" class={`${ui.text.body} max-w-md leading-relaxed mt-3`}></p>
          <div id="guild-meta" class="flex flex-wrap gap-2 mt-4"></div>
          <p id="snapshot-updated" class={`hidden mt-3 italic ${ui.text.caption}`}></p>
          <FichaDock
            slot="dock"
            dockId="portal-tab-dock"
            barId="portal-tab-bar"
            label="Secciones del portal"
          />

          <div slot="body">
            <!-- Pestañas: Miembros · Bandas · Reglas -->
            <div id="portal-tabs" data-rd-reveal class="hidden">

          <div id="panel-miembros" role="tabpanel" aria-labelledby="tab-miembros" class="space-y-6">
            <!-- Roster con filtros: rangos + clases (mismo chip de barra; las
                 clases conservan su ícono) + buscador por nombre. Todos filtran
                 la lista de jugadores de abajo (renderRoster). Mismo modelo de
                 ventana que los paneles del dashboard — cabecera contigua
                 (título + controles de filtro) + cuerpo con el roster. -->
            <PanelWindow flat title="Roster" icon="jugadores">
              <div slot="head">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-4 items-start mt-4">
                  <details id="filtro-jerarquia" class={ui.filter.disclosure}>
                    <summary class={ui.filter.disclosureSummary}>
                      <span class="inline-flex items-center gap-2">
                        <Icon name="corona" size="xs" />
                        Jerarquía
                      </span>
                      <svg class="w-4 h-4 text-brand-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </summary>
                    <div class={ui.filter.panelBody}>
                      <div id="stats-ranks" class="grid grid-cols-2 gap-2 content-start min-w-0"></div>
                    </div>
                  </details>
                  <details id="filtro-clases" class={ui.filter.disclosure}>
                    <summary class={ui.filter.disclosureSummary}>
                      <span class="inline-flex items-center gap-2">
                        <Icon name="personaje" size="xs" />
                        Clases
                      </span>
                      <svg class="w-4 h-4 text-brand-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </summary>
                    <div class={ui.filter.panelBody}>
                      <div id="stats-classes" class="grid grid-cols-2 gap-2 content-start min-w-0"></div>
                    </div>
                  </details>
                </div>
                <!-- Control de texto: filtra por nombre -->
                <div id="roster-search-wrap" class="hidden mt-4">
                  <div class="relative">
                    <Icon name="buscar" size="sm" class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
                    <input
                      id="roster-search"
                      type="search"
                      autocomplete="off"
                      class={`${ui.form.input} ${ui.focusRing} pl-9 pr-3`}
                      placeholder="Buscar jugador por nombre…"
                      aria-label="Buscar jugador por nombre"
                    />
                  </div>
                </div>
              </div>
              <p id="roster-empty-filter" class={`hidden ${ui.text.bodyMuted} italic text-center bg-brand-900/40 border border-brand-600/20 rounded-md p-4`}>
                Ningún jugador coincide con estos filtros.
              </p>
              <p id="roster-private" class={`hidden ${ui.text.bodyMuted} italic text-center ${ui.surf.row} p-4`}>
                El roster de jugadores es privado. Esta hermandad publica solo su jerarquía.
              </p>
              <div id="viewer-roster-wrap"></div>
            </PanelWindow>
          </div>

          <div id="panel-bandas" role="tabpanel" aria-labelledby="tab-bandas" class="hidden space-y-6">
            <!-- Ventana de panel: cabecera contigua (secciónHead) + cuerpo
                 (sectionBody), mismo modelo que Roster y los paneles del portal. -->
            <PanelWindow flat title="Bandas" icon="espadas" tone="ember" gradient={false} titleCls="text-lg font-bold flex items-center text-brand-200">
              <div slot="head">
                <!-- Panel de filtros estándar (buscador + selector de día) del
                     motor src/lib/ui/filterBar.ts, vía renderBandasPanel. -->
                <div class="mt-4" id="viewer-bands-filtro" data-rd-reveal-cards></div>
              </div>
              <div id="viewer-bands" class="space-y-8"></div>
              <EmptyState
                id="bandas-empty"
                hidden
                variant="panel"
                pad="lg"
                cut
                icon="espadas"
                title="Sin bandas publicadas"
                message="Esta hermandad aún no publica bandas."
                gradient={false}
                titleCls="font-bold text-white"
              />
            </PanelWindow>
          </div>

          <div id="panel-reglas" role="tabpanel" aria-labelledby="tab-reglas" class="hidden space-y-6">
            <!-- Ventana de panel: cabecera contigua (secciónHead) + cuerpo
                 (sectionBody), mismo modelo que Roster y Bandas. -->
            <PanelWindow flat title="Reglas" icon="pergamino" tone="parchment" gradient={false} titleCls="text-lg font-bold flex items-center text-brand-200">
              <div slot="head">
                <!-- Motor único de filtros (src/lib/ui/filterBar.ts). -->
                <div class="mt-4" id="viewer-rules-filtro"></div>
              </div>
              <div id="viewer-rules" class="space-y-2 [&>li]:flex [&>li]:items-start [&>li]:text-sm [&>li]:text-gray-300 [&>li]:bg-brand-800/30 [&>li]:border [&>li]:border-brand-600/15 [&>li]:rounded-md [&>li]:px-3 [&>li]:py-2.5 [&>li]:transition-colors [&>li:hover]:border-brand-500/30"></div>
              <div id="viewer-rules-pager" class="mt-3"></div>
              <EmptyState
                id="reglas-empty"
                hidden
                variant="panel"
                cut
                icon="pergamino"
                title="Sin reglas publicadas"
                message="Esta hermandad aún no publica reglas."
                gradient={false}
                titleCls="font-bold text-white"
              />
            </PanelWindow>
          </div>
        </div>

            <!-- Sin snapshot -->
            <EmptyState
              id="no-snapshot"
              hidden
              variant="panel"
              pad="lg"
              cut
              icon="cristal"
              title="Sin análisis público todavía"
              message="El maestro de esta hermandad aún no publica roster ni bandas."
              messageCls="text-sm text-gray-300"
              gradient={false}
              titleCls="font-bold text-white"
            />
          </div>
        </FichaHero>

        <!-- Contexto del portal (servidor/reino): va DESPUÉS de la ficha
             unificada; se rellena solo con los chips de servidor y reino
             (la atribución ★ y la facción quedan arriba). -->
        <div id="guild-context" class={ui.contextStrip}></div>
      </div>

      <!-- Contexto estático del portal: visible sin JS y para crawlers que no
           ejecutan el cliente. -->
      <section class="mt-12" aria-labelledby="rd-hermandad-info">
        <div class={`${ui.panel} p-5 sm:p-7`}>
          <span class={ui.cardTop} aria-hidden="true"></span>
          <h2 id="rd-hermandad-info" class={`${ui.text.h2} text-brand-200 mb-3`}>Sobre este portal de hermandad</h2>
          <p class={`${ui.text.body} max-w-md mb-3`}>
            Cada portal reúne el roster, las bandas, los horarios y las reglas que el maestro de la
            hermandad comparte desde el addon RaidDominion. Los datos se actualizan al volver a subir
            el archivo del addon, sin formularios ni edición manual.
          </p>
          <p class={`${ui.text.bodyMuted} max-w-md`}>
            Explora el <a href="/hermandades" class="text-brand-300 underline hover:text-brand-200">directorio de hermandades</a>
            o descubre las <a href="/bandas" class="text-brand-300 underline hover:text-brand-200">bandas de raid</a> de WoW 3.3.5a.
            Si diriges una guild, <a href="/upload" class="text-brand-300 underline hover:text-brand-200">sube el archivo del addon</a>.
          </p>
          <noscript>
            <p class={`${ui.status.info} mt-4 rounded-md p-3 text-sm`}>
              Este portal carga el roster con JavaScript. También puedes consultar el
              <a href="/hermandades" class="underline">directorio de hermandades</a>.
            </p>
          </noscript>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { getPublicGuildBySlug, getGuildSnapshot, getGuildRules, getGuildMemberCountPublic, listGuildPortalBands, getPublicCharactersByUser, getPublicCharacterSlugsByNames, type GuildPortalSnapshot } from '@/lib/api';
  import type { BandRow } from '@/types/database';
  import type { ContentItem } from '@/types/parser';
  import { RESERVED, currentSlug } from '@/lib/routes';
  import { renderParsedSections, renderRoster, el } from '@/lib/ui/preview';
  import { renderBandCard } from '@/lib/ui/cards';
  import { serverRealmLinks } from '@/lib/ui/card';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';
  import { resolveBandOwners } from '@/lib/bandListing';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { sortRanks } from '@/lib/ui/ranks';
  import { ui } from '@/lib/ui/design';
  import { setBreadcrumb } from '@/lib/ui/dom';
  import { setPageMeta } from '@/lib/seo';
  import { iconEl, type IconName } from '@/lib/ui/icons';
  import { createTabBar, PORTAL_TABS } from '@/lib/ui/tabs';
  import { mergeBandPlayers } from '@/lib/bandMerge';
  import { shareLinkButton } from '@/lib/ui/share';
  import { type Facet } from '@/lib/ui/filterBar';
  import { PAGE_SIZE_LIST } from '@/lib/ui/paginator';
  import { mountPagedList } from '@/lib/ui/list';

  function showNotFound(msg?: string): void {
    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    const nf = document.getElementById('not-found') as HTMLElement;
    if (msg) (document.getElementById('not-found-msg') as HTMLElement).textContent = msg;
    nf.classList.remove('hidden');
    setPageMeta({
      title: 'Portal no encontrado — RaidDominion',
      description: 'Esta hermandad no existe o su portal es privado.',
      noindex: true,
    });
  }

  function metaChip(text: string, icon?: IconName): HTMLElement {
    const chip = document.createElement('span');
    chip.className = `${ui.badge} ${ui.badgeMd} text-gray-200 bg-gradient-to-b from-brand-800/80 to-brand-900/80 border-brand-600/30`;
    if (icon) chip.appendChild(iconEl(icon, { size: 'sm', cls: 'shrink-0' }));
    chip.appendChild(document.createTextNode(text));
    return chip;
  }

  // Panel Reglas: motor único de filtros (buscador título/contenido + chip
  // "Con contenido") + paginador sobre TODAS las reglas publicadas.
  function renderPortalRules(rules: ContentItem[]): void {
    const box = document.getElementById('viewer-rules') as HTMLElement;
    const pager = document.getElementById('viewer-rules-pager') as HTMLElement | null;
    const facets: Array<Facet<ContentItem>> = [
      {
        kind: 'flag',
        id: 'contenido',
        label: 'Filtrar reglas con contenido',
        getFlag: (rule) => !!rule.content?.trim(),
        chipLabel: 'Con contenido',
        icon: 'nota',
      },
    ];

    mountPagedList<ContentItem>({
      mount: document.getElementById('viewer-rules-filtro') as HTMLElement,
      items: rules,
      pageSize: PAGE_SIZE_LIST,
      pager,
      clear: () => { box.innerHTML = ''; },
      renderEmpty: (message) => { box.innerHTML = ''; box.appendChild(el('li', `${ui.text.bodyMuted} italic`, message)); },
      renderPage: (_pageItems, page, filtered) => {
        box.innerHTML = '';
        const start = (page - 1) * PAGE_SIZE_LIST;
        filtered.slice(start, start + PAGE_SIZE_LIST).forEach((rule) => {
          const li = el('li', 'flex items-start text-sm text-gray-300');
          li.appendChild(el('span', 'text-brand-600 mr-2 mt-0.5', '›'));
          const inner = el('div', '');
          inner.appendChild(el('span', 'font-bold text-brand-200', rule.title || 'Regla'));
          if (rule.content) inner.appendChild(el('p', 'text-gray-300 text-xs mt-1', rule.content));
          li.appendChild(inner);
          box.appendChild(li);
        });
      },
      getSearchText: (rule) => `${rule.title ?? ''} ${rule.content ?? ''}`,
      searchPlaceholder: 'Buscar regla…',
      searchLabel: 'Buscar reglas por título o contenido',
      facets,
      resultNoun: (n) => `${n} regla${n === 1 ? '' : 's'}`,
      emptyMessage: (state) => state.query.trim()
        ? `Ninguna regla coincide con "${state.query.trim()}".`
        : 'No hay reglas que coincidan con los filtros.',
    });
  }

  const slug = currentSlug();
  if (!slug || RESERVED.has(slug.toLowerCase())) {
    showNotFound();
  } else {
    const res = await getPublicGuildBySlug(slug);
    if (!res.ok) {
      showNotFound('No se pudo cargar el portal. Intenta de nuevo más tarde.');
    } else if (!res.guild) {
      showNotFound();
    } else {
      const g = res.guild;
      const path = `/hermandad/${g.slug}`;
      const description = `Portal de la hermandad ${g.name}${g.realm ? ` de ${g.realm}` : ''}: roster, bandas, horarios, reglas y Discord en RaidDominion.`;
      setPageMeta({
        title: `${g.name} — Hermandad | RaidDominion`,
        description,
        path,
        breadcrumbs: [
          { name: 'Inicio', path: '/' },
          { name: 'Hermandades', path: '/hermandades' },
          { name: g.name, path },
        ],
        jsonLd: {
          '@type': 'Organization',
          name: g.name,
          url: `${window.location.origin}${path}`,
          ...(g.description ? { description: g.description } : {}),
          ...(g.discord_link ? { sameAs: [g.discord_link] } : {}),
        },
      });
      setBreadcrumb(g.name);

      (document.getElementById('guild-name') as HTMLElement).textContent = g.name;
      document.getElementById('guild-share')?.appendChild(
        shareLinkButton({
          title: `${g.name} | RaidDominion`,
          text: `Portal de la hermandad ${g.name} en RaidDominion: roster, bandas y reglas.`,
          url: window.location.href,
        }),
      );
      const descEl = document.getElementById('guild-description') as HTMLElement;
      descEl.textContent = g.description || '';
      descEl.classList.toggle('hidden', !g.description);

      const metaEl = document.getElementById('guild-meta') as HTMLElement;
      // Servidor/reino del portal: viven en la tira de contexto al final del
      // contenido (#guild-context), no en el encabezado. Mismo formato de
      // chips que las fichas de jugador/personaje (contrato serverRealmLinks).
      const ctxEl = document.getElementById('guild-context') as HTMLElement;
      if (g.server || g.realm) {
        ctxEl.appendChild(serverRealmLinks({ server: g.server, realm: g.realm }));
        ctxEl.classList.remove('hidden');
      }
      if (g.faction) metaEl.appendChild(metaChip(g.faction === 'Horde' ? 'Horda' : 'Alianza', 'facciones'));

      // Atribución de la hermandad: el chip ★ se muestra SOLO cuando el
      // personaje rango 0 (sv_is_gm) de ESTA hermandad es público y tiene
      // slug. La guild NUNCA se atribuye al perfil del jugador (cuenta): si
      // no hay personaje GM público, no se muestra ninguna atribución.
      const charsRes = await getPublicCharactersByUser(g.owner_id);
      const chars = charsRes.ok ? (charsRes.items ?? []) : [];
      const guildName = g.name.trim().toLowerCase();
      const gmChar = chars.find(
        (c) => c.sv_is_gm && c.sv_guild_name?.trim().toLowerCase() === guildName
      );
      if (gmChar && gmChar.slug) {
        const ownerChip = document.createElement('a');
        ownerChip.className = `${ui.badge} ${ui.badgeMd} bg-gradient-to-b from-fuchsia-950/60 to-fuchsia-950/25 border-fuchsia-500/40 text-fuchsia-300 hover:from-fuchsia-900/70 hover:to-fuchsia-900/40 hover:border-fuchsia-400/60 transition-all`;
        ownerChip.href = `/personaje/${gmChar.slug}`;
        ownerChip.appendChild(iconEl('estrella', { size: 'xs', cls: 'shrink-0', label: 'Maestro de hermandad' }));
        ownerChip.appendChild(document.createTextNode(gmChar.name));
        metaEl.appendChild(ownerChip);
      }

      if (g.claim_status === 'verified') {
        document.getElementById('verified-badge')?.classList.remove('hidden');
      }
      if (g.discord_link) {
        const link = document.getElementById('discord-link') as HTMLAnchorElement;
        link.href = g.discord_link;
        link.classList.remove('hidden');
      }
      if (!g.is_public) {
        document.getElementById('preview-banner')?.classList.remove('hidden');
      }

      // Snapshot público (roster/reglas) + bandas integradas en tiempo real.
      // Las bandas del portal ya NO vienen del snapshot: se leen de
      // raiddominion_bands con guild_id = hermandad y dueño de rango
      // autorizado (listGuildPortalBands). Si una banda oculta jugadores,
      // players[] ya viene vacío y el contador se omite.
      let snapshot: GuildPortalSnapshot | undefined;
      let manualRules: ContentItem[] | undefined;
      const [snapRes, bandsRes, rulesRes, countRes] = await Promise.all([
        getGuildSnapshot(g.id),
        listGuildPortalBands(g.id),
        getGuildRules(g.id),
        getGuildMemberCountPublic(g.id),
      ]);
      if (snapRes.ok) snapshot = snapRes.snapshot;
      if (rulesRes.ok && Array.isArray(rulesRes.items)) manualRules = rulesRes.items;
      const memberCountPublic = countRes.ok ? countRes.public !== false : true;
      const portalBands = bandsRes.ok ? bandsRes.bands ?? [] : [];

      const loading = document.getElementById('loading') as HTMLElement;
      loading.classList.add('hidden');
      document.getElementById('portal')?.classList.remove('hidden');

      // Las reglas publicadas son SOLO las que eligió el maestro en su
      // dashboard (#hermandad). Subir un SV no llena reglas del portal:
      // si el maestro no eligió ninguna, no hay sección de reglas.
      const hasSnapshotContent = (!!snapshot && (snapshot.members.length > 0 || (snapshot.ranks?.length ?? 0) > 0)) || (manualRules?.length ?? 0) > 0;
      if (!hasSnapshotContent && portalBands.length === 0) {
        document.getElementById('no-snapshot')?.classList.remove('hidden');
      } else {
        // Pestañas Miembros / Bandas / Reglas: los conteos viven como badges
        // de la barra (reemplazan al antiguo strip de métricas). Los paneles
        // vacíos se mantienen visibles con placeholder.
        const members = snapshot?.members ?? [];
        const rules = manualRules ?? [];
        const ranks = snapshot?.ranks;

        // Enlaza al roster con las fichas públicas: resuelve los slugs de
        // /personaje/:slug por nombre y los adjunta a cada miembro. Los que
        // no tienen ficha pública (o RLS no los expone) se quedan sin slug y
        // se muestran como texto plano.
        try {
          const slugRes = await getPublicCharacterSlugsByNames(members.map((m) => m.name));
          if (slugRes.ok && slugRes.slugs) {
            const slugs = slugRes.slugs;
            members.forEach((m) => {
              const s = slugs[(m.name || '').trim().toLowerCase()];
              if (s) m.slug = s;
            });
          }
        } catch {
          // Silencioso: sin slugs el roster no enlaza, no rompe el panel.
        }

        document.getElementById('portal-tabs')?.classList.remove('hidden');

        if (snapshot?.lastUpdate) {
          const upd = document.getElementById('snapshot-updated') as HTMLElement;
          upd.replaceChildren(
            iconEl('sincronizacion', { size: 'xs', cls: 'shrink-0 align-middle' }),
            document.createTextNode(` Análisis actualizado el ${new Date(snapshot.lastUpdate * 1000).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })}`),
          );
          upd.classList.add('inline-flex', 'items-center', 'gap-1');
          upd.classList.remove('hidden');
        }

        // Modo privado: el portal oculta roster y conteos, pero conserva la
        // jerarquía declarada. El resto del panel (reglas/bandas) no cambia.
        const ranksBox = document.getElementById('stats-ranks') as HTMLElement;
        const classesBox = document.getElementById('stats-classes') as HTMLElement;
        const ranksFilter = document.getElementById('filtro-jerarquia') as HTMLElement;
        const classesFilter = document.getElementById('filtro-clases') as HTMLElement;
        const rosterWrap = document.getElementById('viewer-roster-wrap') as HTMLElement;
        const emptyFilter = document.getElementById('roster-empty-filter') as HTMLElement;
        const searchInput = document.getElementById('roster-search') as HTMLInputElement;
        const rosterPrivate = document.getElementById('roster-private') as HTMLElement;

        if (!memberCountPublic) {
          searchInput.value = '';
          document.getElementById('roster-search-wrap')?.classList.add('hidden');
          classesFilter.classList.add('hidden');
          classesBox.innerHTML = '';
          emptyFilter.classList.add('hidden');
          rosterWrap.classList.add('hidden');
          rosterWrap.innerHTML = '';
          rosterPrivate.classList.remove('hidden');
          ranksFilter.classList.remove('hidden');
          ranksFilter.classList.add('md:col-span-2');
          ranksFilter.querySelector('summary')?.classList.add('hidden');
          (ranksFilter as HTMLDetailsElement).open = true;

          // Jerarquía sin cifras: nombres de rango ordenados; si el snapshot
          // no declara ranks, se derivan los nombres únicos del roster (sin
          // contar miembros). Nunca se muestran cantidades.
          const hierarchy: Array<{ label: string; leader: boolean }> = [];
          const declaredHidden = sortRanks([...(ranks ?? [])]);
          if (declaredHidden.length > 0) {
            declaredHidden.forEach((r, i) => {
              hierarchy.push({
                label: `${i + 1}. ${(r.name || '').trim() || (r.index === 0 ? 'Líder' : `Rango ${r.index}`)}`,
                leader: r.index === 0,
              });
            });
          } else {
            const seen = new Set<string>();
            members.forEach((m) => {
              const name = (m.rank || '').trim() || 'Sin rango';
              if (seen.has(name.toLowerCase())) return;
              seen.add(name.toLowerCase());
              hierarchy.push({ label: name, leader: false });
            });
          }

          ranksBox.className = 'space-y-1.5 min-w-0';
          ranksBox.innerHTML = '';
          if (hierarchy.length === 0) {
            ranksBox.appendChild(el('p', 'text-xs text-gray-300 italic', 'La hermandad no publica su jerarquía.'));
          } else {
            hierarchy.forEach((row) => {
              const item = el('div', 'flex items-center gap-2 rounded-md border border-brand-600/20 bg-brand-950/30 px-3 py-2');
              if (row.leader) item.appendChild(iconEl('corona', { size: 'xs', cls: 'shrink-0 text-brand-300', label: 'Líder' }));
              item.appendChild(el('span', 'text-xs font-bold text-brand-200', row.label));
              ranksBox.appendChild(item);
            });
          }
        } else if (members.length > 0) {
          const total = members.length;
          rosterPrivate.classList.add('hidden');

          // Clave de agrupación de rango: su índice si está declarado en la
          // jerarquía; huérfanos y sin rankIndex comparten el grupo "Otros".
          const declared = sortRanks([...(ranks ?? [])]);
          const declaredIndexes = new Set(declared.map((r) => r.index));
          const rankKey = (m: (typeof members)[number]): number | 'others' =>
            typeof m.rankIndex === 'number' && declaredIndexes.has(m.rankIndex) ? m.rankIndex : 'others';

          const state = { rank: undefined as number | 'others' | undefined, cls: undefined as string | undefined, query: '' };

          const statChip = (o: {
            label: string; count: number; pct: number; icon?: HTMLImageElement | null;
            leader?: boolean; active: boolean; dataset: Record<string, string>;
          }): HTMLButtonElement => {
            const btn = document.createElement('button');
            btn.type = 'button';
            // Fila 1: solo el nombre (con elipsis). Fila 2: barra + cifra/porcentaje al final.
            btn.className = 'w-full min-w-0 rounded-md px-3 py-2 border text-left transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 ' +
              (o.leader
                ? 'text-brand-200 border-brand-500/50 bg-gradient-to-b from-brand-900/40 to-brand-950/40 hover:from-brand-900/55'
                : 'text-gray-200 bg-gradient-to-b from-brand-800/80 to-brand-900/80 border-brand-600/25 hover:border-brand-500/40 hover:from-gray-700/70') +
              (o.active ? ' ring-2 ring-brand-400/60 border-brand-500/80 shadow-lg shadow-brand-500/10' : '');
            Object.entries(o.dataset).forEach(([k, v]) => btn.setAttribute(`data-${k}`, v));
            btn.setAttribute('aria-pressed', String(o.active));
            const nameRow = el('div', 'flex items-center gap-1.5 mb-1 min-w-0');
            if (o.icon) {
              o.icon.className = 'w-4 h-4 rounded-sm border border-gray-700/50 shrink-0 object-cover';
              nameRow.appendChild(o.icon);
            }
            nameRow.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest truncate flex-1 min-w-0', o.label));
            btn.appendChild(nameRow);
            // Con el número de integrantes oculto, la jerarquía y las clases
            // siguen visibles como etiquetas, pero sin barras ni conteos que
            // permitan reconstruir el total.
            if (memberCountPublic) {
              const barRow = el('div', 'flex items-center gap-2 min-w-0');
              const barWrap = el('div', 'flex-1 min-w-0 h-1.5 rounded-full bg-brand-900/60 overflow-hidden');
              const bar = el('div', 'h-full rounded-full ' + (o.leader ? 'bg-gradient-to-r from-brand-400 to-brand-300' : 'bg-gradient-to-r from-brand-600 to-brand-400'));
              bar.style.width = `${Math.max(2, o.pct)}%`;
              barWrap.appendChild(bar);
              barRow.appendChild(barWrap);
              barRow.appendChild(el('span', `${ui.statValue} text-[11px] shrink-0`, `${o.count} (${o.pct}%)`));
              btn.appendChild(barRow);
            }
            return btn;
          };

          const renderStats = (): void => {
            ranksBox.innerHTML = '';
            classesBox.innerHTML = '';

            // Rangos en orden de jerarquía + "Otros" al final.
            const byRank = new Map<number | 'others', number>();
            members.forEach((m) => {
              const k = rankKey(m);
              byRank.set(k, (byRank.get(k) ?? 0) + 1);
            });
            const rankChips: HTMLButtonElement[] = [];
            declared.forEach((r, i) => {
              const count = byRank.get(r.index) ?? 0;
              if (count === 0) return;
              rankChips.push(statChip({
                label: `${i + 1}. ${(r.name || '').trim() || (r.index === 0 ? 'Líder' : `Rango ${r.index}`)}`,
                count, pct: Math.round((count / total) * 100), leader: r.index === 0,
                active: state.rank === r.index, dataset: { 'rank-key': String(r.index) },
              }));
            });
            const others = byRank.get('others') ?? 0;
            if (others > 0) {
              rankChips.push(statChip({
                label: 'Otros', count: others, pct: Math.round((others / total) * 100),
                active: state.rank === 'others', dataset: { 'rank-key': 'others' },
              }));
            }
            rankChips.forEach((c) => ranksBox.appendChild(c));
            ranksFilter.classList.toggle('hidden', rankChips.length === 0);

            // Clases con su ícono y la misma barra; sin clase → "Sin dato" con ícono por defecto.
            const byClass = new Map<string, { label: string; cls?: string; count: number }>();
            members.forEach((m) => {
              const cls = (m.class || '').trim();
              const key = cls ? cls.toLowerCase() : '__none__';
              const cur = byClass.get(key) ?? { label: cls || 'Sin dato', cls: cls || undefined, count: 0 };
              cur.count += 1;
              byClass.set(key, cur);
            });
            const classChips = Array.from(byClass.values())
              .sort((a, b) => b.count - a.count)
              .map((c) => statChip({
                label: c.label, count: c.count, pct: Math.round((c.count / total) * 100),
                icon: classIconEl(c.cls, undefined, 'w-4 h-4 rounded-full shrink-0 object-contain'),
                active: state.cls === (c.cls ? c.cls.toLowerCase() : '__none__'),
                dataset: { 'class-key': c.cls ? c.cls.toLowerCase() : '__none__' },
              }));
            classChips.forEach((c) => classesBox.appendChild(c));
            classesFilter.classList.toggle('hidden', classChips.length === 0);
          };

          const applyFilters = (): void => {
            const q = state.query.trim().toLowerCase();
            const filtered = members.filter((m) => {
              if (state.rank !== undefined && rankKey(m) !== state.rank) return false;
              const cls = (m.class || '').trim();
              if (state.cls !== undefined && cls.toLowerCase() !== state.cls) return false;
              if (q && !(m.name || '').toLowerCase().includes(q)) return false;
              return true;
            });
            renderRoster(rosterWrap, filtered, ranks, { showMemberCount: memberCountPublic });
            const any = state.rank !== undefined || state.cls !== undefined || q !== '';
            emptyFilter.classList.toggle('hidden', !(any && filtered.length === 0));
          };

          ranksBox.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rank-key]');
            if (!btn) return;
            const k: number | 'others' = btn.dataset.rankKey === 'others' ? 'others' : Number(btn.dataset.rankKey);
            state.rank = state.rank === k ? undefined : k;
            renderStats();
            applyFilters();
          });
          classesBox.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-class-key]');
            if (!btn) return;
            const k = btn.dataset.classKey ?? '';
            state.cls = state.cls === k ? undefined : k;
            renderStats();
            applyFilters();
          });
          searchInput.addEventListener('input', () => {
            state.query = searchInput.value;
            applyFilters();
          });

          document.getElementById('roster-search-wrap')?.classList.remove('hidden');
          renderStats();
          applyFilters();
        }
        // En modo privado no se renderiza el roster: el bloque de jerarquía
        // anterior es el único contenido de la pestaña.
        if (memberCountPublic) {
          renderParsedSections(
            { guild: { members }, bands: [], rules: [], ranks } as never,
            {
              bands: document.getElementById('viewer-bands') as HTMLElement,
              rules: document.getElementById('viewer-rules') as HTMLElement,
              rosterWrap: document.getElementById('viewer-roster-wrap') as HTMLElement,
            },
          );
        }

        // Panel Reglas: buscador + chip "con contenido" + paginador (sin el
        // tope silencioso de 20 que aplicaba renderParsedSections).
        if (rules.length === 0) {
          document.getElementById('reglas-empty')?.classList.remove('hidden');
        } else {
          renderPortalRules(rules);
        }

        // Panel Bandas: cards compactas enlazando a la vista de cada banda, con
        // ATRIBUCIÓN al modelo del directorio /bandas: cada banda identifica a
        // quién pertenece (aquí, ESTA hermandad). Una banda del GM y una banda
        // integrada por un miembro que coinciden en nombre/horario/GS se
        // muestran como UNA, con conteo fusionado y badge "Integrada" cuando
        // la fuente es un personaje de un miembro.
        const merged = mergePortalBands(portalBands, g.owner_id);
        // Modelo compartido /bandas (renderBandasPanel): filtro por día +
        // grupos de días lunes→domingo por hora en grilla responsive, con la
        // ATRIBUCIÓN a esta hermandad y las bandas fusionadas del portal.
        if (merged.length > 0) {
          const bandOwners = await resolveBandOwners(portalBands);
          renderBandasPanel({
            filtro: document.getElementById('viewer-bands-filtro') as HTMLElement,
            content: document.getElementById('viewer-bands') as HTMLElement,
            items: merged,
            getSchedule: (item) => item.band.schedule,
            // Búsqueda por nombre de banda / jugadores / personaje que integró
            // la banda. La hermandad dueña es esta; su nombre se suma implícito.
            getSearchText: (item) => [
              g.name,
              item.band.name,
              Array.isArray(item.band.players) ? (item.band.players as Array<{ name?: string }>).map((p) => p.name).join(' ') : '',
              item.band.character_name,
              item.source,
            ].filter(Boolean).join(' '),
            renderCard: (item) => renderBandCard(item.band, { source: item.source, playerCount: item.playerCount, owner: bandOwners.get(item.band.guild_id || item.band.owner_id), guildId: item.band.guild_id }),
          });
        } else {
          // Sin bandas: se oculta también el filtro vacío del encabezado.
          document.getElementById('viewer-bands-filtro')?.classList.add('hidden');
        }
        if (merged.length === 0) {
          document.getElementById('bandas-empty')?.classList.remove('hidden');
        }

        // Dock de secciones dentro de la placa (deep-link #miembros/#bandas/
        // #reglas). Los contadores y el renombrado Miembros→Jerarquía viven
        // en el propio dock, como en la ficha de personaje.
        document.getElementById('portal-tab-dock')?.classList.remove('hidden');
        document.getElementById('portal-tab-bar')?.classList.remove('hidden');
        createTabBar({
          tabs: PORTAL_TABS,
          barId: 'portal-tab-bar',
          defaultId: 'miembros',
          variant: 'ficha',
          counts: {
            miembros: memberCountPublic ? members.length : undefined,
            bandas: merged.length,
            reglas: rules.length,
          },
          labels: memberCountPublic ? undefined : { miembros: 'Jerarquía' },
        });
      }
    }
  }

  // Clave de coincidencia de una banda: nombre + horario (día y hora van en el
  // string schedule del addon) + gearscore, normalizados (trim + lowercase).
  function portalBandKey(b: BandRow): string {
    return [
      (b.name || '').trim().toLowerCase(),
      (b.schedule || '').trim().toLowerCase(),
      typeof b.min_gs === 'number' && b.min_gs > 0 ? String(b.min_gs) : '',
    ].join('|');
  }

  // Fusiona bandas del portal: agrupa por clave; la base es la banda del GM
  // (owner de la hermandad) si existe en el grupo; la fuente destacada es el
  // character_name del personaje que integró la banda de un miembro. El conteo
  // de jugadores es la unión del grupo (mergeBandPlayers), 0 si hide_players.
  function mergePortalBands(bands: BandRow[], guildOwnerId: string): Array<{ band: BandRow; source: string | null; playerCount: number }> {
    const groups = new Map<string, BandRow[]>();
    bands.forEach((b) => {
      const key = portalBandKey(b);
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(b);
    });
    const out: Array<{ band: BandRow; source: string | null; playerCount: number }> = [];
    groups.forEach((group) => {
      if (group.length === 1) {
        const only = group[0];
        out.push({
          band: only,
          source: only.character_name && only.owner_id !== guildOwnerId ? only.character_name : null,
          playerCount: only.hide_players ? 0 : mergeBandPlayers(group).length,
        });
        return;
      }
      const gmBand = group.find((b) => b.owner_id === guildOwnerId);
      const memberBand = group.find((b) => b.owner_id !== guildOwnerId);
      const base = gmBand ?? memberBand ?? group[0];
      const source = memberBand?.character_name ?? null;
      const playerCount = base.hide_players ? 0 : mergeBandPlayers(group).length;
      out.push({ band: base, source, playerCount });
    });
    return out;
  }
</script>