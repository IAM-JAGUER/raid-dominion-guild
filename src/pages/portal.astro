---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
---

<Layout title="Hermandad - RaidDominion" description="Portal público de hermandad de la comunidad RaidDominion.">
  <Navigation />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto px-4">
      <Breadcrumb />

      <!-- Cargando -->
      <div id="loading" class="text-center py-20">
        <div class="inline-block w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-sm text-gray-400 italic mt-4">Invocando el portal…</p>
      </div>

      <!-- No encontrado -->
      <div id="not-found" class="hidden bg-gray-900/60 border border-red-900/40 rounded-md p-8 sm:p-10 text-center">
        <svg class="w-10 h-10 text-red-400/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <h1 class="text-xl font-bold text-white mb-2">Portal no encontrado</h1>
        <p id="not-found-msg" class="text-sm text-gray-400 max-w-md mx-auto mb-6">Esta hermandad no existe o su portal es privado.</p>
        <a href="/guilds" class="inline-block px-6 py-2.5 rounded-md bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105">Ver directorio</a>
      </div>

      <!-- Portal -->
      <div id="portal" class="hidden space-y-8">

        <!-- Vista previa privada (owner) -->
        <div id="preview-banner" class="hidden bg-sky-950/40 border border-sky-700/40 rounded-md p-4 flex items-start gap-3">
          <svg class="w-5 h-5 text-sky-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          <p class="text-sm text-sky-200"><span class="font-bold">Vista previa privada.</span> Solo tú puedes ver este portal. Publícalo desde tu dashboard para que aparezca en el directorio.</p>
        </div>

        <!-- Hero -->
        <header class="bg-gradient-to-br from-gray-900/80 to-gray-800/50 border border-amber-600/25 rounded-md p-6 sm:p-8 animate-fade-in-1">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1 flex items-center">
                <svg class="w-3.5 h-3.5 mr-1.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l7 3v5c0 4.97-3.13 8.32-7 9.73-3.87-1.41-7-4.76-7-9.73V6l7-3z"/></svg>
                <span>Portal de hermandad</span>
              </p>
              <h1 id="guild-name" class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wide"></h1>
            </div>
            <div class="flex items-center gap-2">
              <span id="verified-badge" class="hidden px-3 py-1.5 rounded-md text-[10px] font-black uppercase tracking-widest border bg-emerald-950/30 border-emerald-600/40 text-emerald-300">✓ Verificada</span>
              <a id="discord-link" href="#" target="_blank" rel="noopener" class="hidden px-4 py-2 rounded-md border border-indigo-500/50 bg-indigo-950/30 text-indigo-300 hover:bg-indigo-900/40 transition-all text-xs font-black uppercase tracking-widest">Discord</a>
            </div>
          </div>
          <p id="guild-description" class="text-sm text-gray-300 max-w-3xl leading-relaxed"></p>
          <div id="guild-meta" class="flex flex-wrap gap-2 mt-4"></div>
          <p id="snapshot-updated" class="hidden text-xs text-gray-500 mt-4 italic"></p>
        </header>

        <!-- Pestañas: Miembros · Bandas · Reglas -->
        <div id="portal-tabs" class="hidden">
          <nav id="portal-tab-bar" role="tablist" aria-label="Secciones del portal" class="flex flex-wrap gap-1 border-b border-amber-600/30 animate-fade-in-1" style="animation-delay: 0.15s"></nav>

          <div id="panel-miembros" role="tabpanel" aria-labelledby="tab-miembros" class="space-y-6 pt-6">
            <!-- Jerarquía de rangos (registry.guild.ranks; 0 = líder) -->
            <section id="ranks-section" class="hidden bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
              <h2 class="text-lg font-bold text-amber-200 mb-4 flex items-center">
                <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Jerarquía de rangos
              </h2>
              <div id="viewer-ranks" class="flex flex-wrap gap-2"></div>
            </section>
            <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
              <h2 class="text-lg font-bold text-amber-200 mb-4 flex items-center">
                <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Roster
              </h2>
              <div id="roster-stats" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 mb-4"></div>
              <div id="viewer-roster-wrap"></div>
            </section>
          </div>

          <div id="panel-bandas" role="tabpanel" aria-labelledby="tab-bandas" class="hidden space-y-6 pt-6">
            <div id="viewer-bands" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
            <div id="bandas-empty" class="hidden bg-gray-900/60 border border-amber-600/25 rounded-md p-6 text-center">
              <p class="text-sm text-gray-400 italic">Esta hermandad aún no publica bandas.</p>
            </div>
          </div>

          <div id="panel-reglas" role="tabpanel" aria-labelledby="tab-reglas" class="hidden space-y-6 pt-6">
            <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
              <h2 class="text-lg font-bold text-amber-200 mb-4 flex items-center">
                <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Reglas
              </h2>
              <div id="viewer-rules" class="space-y-3"></div>
              <p id="reglas-empty" class="hidden text-sm text-gray-400 italic">Esta hermandad aún no publica reglas.</p>
            </section>
          </div>
        </div>

        <!-- Sin snapshot -->
        <div id="no-snapshot" class="hidden bg-gray-900/60 border border-amber-600/25 rounded-md p-6 sm:p-8 text-center">
          <svg class="w-9 h-9 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <p class="font-bold text-white mb-1">Sin análisis público todavía</p>
          <p class="text-sm text-gray-400">El maestro de esta hermandad aún no publica roster ni bandas.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { getPublicGuildBySlug, getGuildSnapshot, listGuildPortalBands, getPublicCharactersByUser, type GuildPortalSnapshot } from '@/lib/api';
  import type { BandRow } from '@/types/database';
  import { slugify } from '@/lib/routes';
  import { renderBandCard, renderParsedSections, renderRosterStats, el } from '@/lib/ui/preview';
  import { createTabBar, PORTAL_TABS } from '@/lib/ui/tabs';
  import { mergeBandPlayers } from '@/lib/bandMerge';

  const RESERVED = new Set([
    'upload', 'login', 'dashboard', 'admin', 'moderate', 'guilds', 'p', 'api',
    'assets', '_astro', 'portal', 'jugador', 'personajes', 'personaje',
  ]);

  function currentSlug(): string {
    const override = new URLSearchParams(window.location.search).get('slug');
    if (override) return override;
    const seg = window.location.pathname.split('/').filter(Boolean);
    return seg.length === 1 ? seg[0] : '';
  }

  function showNotFound(msg?: string): void {
    (document.getElementById('loading') as HTMLElement).classList.add('hidden');
    const nf = document.getElementById('not-found') as HTMLElement;
    if (msg) (document.getElementById('not-found-msg') as HTMLElement).textContent = msg;
    nf.classList.remove('hidden');
    document.title = 'Portal no encontrado - RaidDominion';
  }

  function metaChip(text: string): HTMLElement {
    const chip = document.createElement('span');
    chip.className = 'px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-800/60 border border-amber-600/20';
    chip.textContent = text;
    return chip;
  }

  const slug = currentSlug();
  if (!slug || RESERVED.has(slug.toLowerCase())) {
    showNotFound();
  } else {
    const res = await getPublicGuildBySlug(slug);
    if (!res.ok) {
      showNotFound('No se pudo cargar el portal. Intenta de nuevo más tarde.');
    } else if (!res.guild) {
      showNotFound();
    } else {
      const g = res.guild;
      document.title = `${g.name} - RaidDominion`;
      (window as unknown as { __rdBreadcrumb?: { setLabel: (l: string) => void } }).__rdBreadcrumb?.setLabel(g.name);

      (document.getElementById('guild-name') as HTMLElement).textContent = g.name;
      const descEl = document.getElementById('guild-description') as HTMLElement;
      descEl.textContent = g.description || '';
      descEl.classList.toggle('hidden', !g.description);

      const metaEl = document.getElementById('guild-meta') as HTMLElement;
      if (g.server) {
        const serverChip = document.createElement('a');
        serverChip.href = `/servidor/${encodeURIComponent(g.server)}`;
        serverChip.className = 'px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest bg-sky-950/40 border border-sky-600/30 text-sky-200 hover:bg-sky-900/40 transition-all';
        serverChip.textContent = g.server;
        metaEl.appendChild(serverChip);
      }
      if (g.realm) {
        const realmChip = document.createElement(g.server ? 'a' : 'span');
        const cls = 'px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest text-gray-300 bg-gray-800/60 border border-amber-600/20';
        if (g.server) {
          (realmChip as HTMLAnchorElement).href = `/servidor/${encodeURIComponent(g.server)}/reino/${encodeURIComponent(slugify(g.realm))}`;
          realmChip.className = `${cls} hover:bg-gray-800/80 transition-all`;
        } else {
          realmChip.className = cls;
        }
        realmChip.textContent = g.realm;
        metaEl.appendChild(realmChip);
      }
      if (g.faction) metaEl.appendChild(metaChip(g.faction === 'Horde' ? 'Horda' : 'Alianza'));

      // Atribución de la hermandad: el chip ★ se muestra SOLO cuando el
      // personaje rango 0 (sv_is_gm) de ESTA hermandad es público y tiene
      // slug. La guild NUNCA se atribuye al perfil del jugador (cuenta): si
      // no hay personaje GM público, no se muestra ninguna atribución.
      const charsRes = await getPublicCharactersByUser(g.owner_id);
      const chars = charsRes.ok ? (charsRes.items ?? []) : [];
      const guildName = g.name.trim().toLowerCase();
      const gmChar = chars.find(
        (c) => c.sv_is_gm && c.sv_guild_name?.trim().toLowerCase() === guildName
      );
      if (gmChar && gmChar.slug) {
        const ownerChip = document.createElement('a');
        ownerChip.className = 'inline-flex items-center px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border bg-fuchsia-950/40 border-fuchsia-500/40 text-fuchsia-300 hover:bg-fuchsia-900/40 transition-all';
        ownerChip.href = `/personaje/${gmChar.slug}`;
        ownerChip.textContent = `★ ${gmChar.name}`;
        metaEl.appendChild(ownerChip);
      }

      if (g.claim_status === 'verified') {
        document.getElementById('verified-badge')?.classList.remove('hidden');
      }
      if (g.discord_link) {
        const link = document.getElementById('discord-link') as HTMLAnchorElement;
        link.href = g.discord_link;
        link.classList.remove('hidden');
      }
      if (!g.is_public) {
        document.getElementById('preview-banner')?.classList.remove('hidden');
      }

      // Snapshot público (roster/reglas) + bandas integradas en tiempo real.
      // Las bandas del portal ya NO vienen del snapshot: se leen de
      // raiddominion_bands con guild_id = hermandad y dueño de rango
      // autorizado (listGuildPortalBands). Si una banda oculta jugadores,
      // players[] ya viene vacío y el contador se omite.
      let snapshot: GuildPortalSnapshot | undefined;
      const [snapRes, bandsRes] = await Promise.all([
        getGuildSnapshot(g.id),
        listGuildPortalBands(g.id),
      ]);
      if (snapRes.ok) snapshot = snapRes.snapshot;
      const portalBands = bandsRes.ok ? bandsRes.bands ?? [] : [];

      const loading = document.getElementById('loading') as HTMLElement;
      loading.classList.add('hidden');
      document.getElementById('portal')?.classList.remove('hidden');

      const hasSnapshotContent = !!snapshot && (snapshot.members.length > 0 || snapshot.rules.length > 0);
      if (!hasSnapshotContent && portalBands.length === 0) {
        document.getElementById('no-snapshot')?.classList.remove('hidden');
      } else {
        // Pestañas Miembros / Bandas / Reglas: los conteos viven como badges
        // de la barra (reemplazan al antiguo strip de métricas). Los paneles
        // vacíos se mantienen visibles con placeholder.
        const members = snapshot?.members ?? [];
        const rules = snapshot?.rules ?? [];
        const ranks = snapshot?.ranks;

        document.getElementById('portal-tabs')?.classList.remove('hidden');

        if (snapshot?.lastUpdate) {
          const upd = document.getElementById('snapshot-updated') as HTMLElement;
          upd.textContent = `Análisis actualizado el ${new Date(snapshot.lastUpdate * 1000).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })}`;
          upd.classList.remove('hidden');
        }

        // Jerarquía de rangos: se muestra cuando el snapshot la trae.
        if (ranks && ranks.length > 0) {
          const ranksBox = document.getElementById('viewer-ranks') as HTMLElement;
          const sorted = [...ranks].sort((a, b) => a.index - b.index);
          sorted.forEach((r) => {
            const label = (r.name || '').trim() || (r.index === 0 ? 'Líder' : `Rango ${r.index}`);
            ranksBox.appendChild(el('span', 'px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border ' +
              (r.index === 0 ? 'text-amber-300 border-amber-500/40 bg-amber-900/20' : 'text-gray-300 bg-gray-800/60 border-amber-600/20'),
              `${r.index}: ${label}`));
          });
          document.getElementById('ranks-section')?.classList.remove('hidden');
        }

        // Panel Miembros: stats de distribución + roster paginado.
        if (members.length > 0) {
          document.getElementById('roster-stats')?.classList.remove('hidden');
          renderRosterStats(document.getElementById('roster-stats') as HTMLElement, members);
        }
        renderParsedSections(
          { guild: { members }, bands: [], rules, ranks } as never,
          {
            bands: document.getElementById('viewer-bands') as HTMLElement,
            rules: document.getElementById('viewer-rules') as HTMLElement,
            rosterWrap: document.getElementById('viewer-roster-wrap') as HTMLElement,
          },
        );

        // Panel Reglas: placeholder si no hay reglas publicadas.
        if (rules.length === 0) {
          document.getElementById('reglas-empty')?.classList.remove('hidden');
        }

        // Panel Bandas: cards compactas enlazando a la vista de cada banda.
        // Una banda del GM y una banda integrada por un miembro que coinciden
        // en nombre/horario/GS se muestran como UNA, con conteo fusionado y
        // badge "Integrada" cuando la fuente es un personaje de un miembro.
        const merged = mergePortalBands(portalBands, g.owner_id);
        const bandsBox = document.getElementById('viewer-bands') as HTMLElement;
        bandsBox.innerHTML = '';
        merged.forEach(({ band, source, playerCount }) => {
          bandsBox.appendChild(renderBandCard(band, { source, playerCount }));
        });
        if (merged.length === 0) {
          document.getElementById('bandas-empty')?.classList.remove('hidden');
        }

        // Barra de pestañas (deep-link por hash #miembros/#bandas/#reglas).
        createTabBar({
          tabs: PORTAL_TABS,
          barId: 'portal-tab-bar',
          defaultId: 'miembros',
          badgeCounts: { miembros: members.length, bandas: merged.length, reglas: rules.length },
        });
      }
    }
  }

  // Clave de coincidencia de una banda: nombre + horario (día y hora van en el
  // string schedule del addon) + gearscore, normalizados (trim + lowercase).
  function portalBandKey(b: BandRow): string {
    return [
      (b.name || '').trim().toLowerCase(),
      (b.schedule || '').trim().toLowerCase(),
      typeof b.min_gs === 'number' && b.min_gs > 0 ? String(b.min_gs) : '',
    ].join('|');
  }

  // Fusiona bandas del portal: agrupa por clave; la base es la banda del GM
  // (owner de la hermandad) si existe en el grupo; la fuente destacada es el
  // character_name del personaje que integró la banda de un miembro. El conteo
  // de jugadores es la unión del grupo (mergeBandPlayers), 0 si hide_players.
  function mergePortalBands(bands: BandRow[], guildOwnerId: string): Array<{ band: BandRow; source: string | null; playerCount: number }> {
    const groups = new Map<string, BandRow[]>();
    bands.forEach((b) => {
      const key = portalBandKey(b);
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(b);
    });
    const out: Array<{ band: BandRow; source: string | null; playerCount: number }> = [];
    groups.forEach((group) => {
      if (group.length === 1) {
        const only = group[0];
        out.push({
          band: only,
          source: only.character_name && only.owner_id !== guildOwnerId ? only.character_name : null,
          playerCount: only.hide_players ? 0 : mergeBandPlayers(group).length,
        });
        return;
      }
      const gmBand = group.find((b) => b.owner_id === guildOwnerId);
      const memberBand = group.find((b) => b.owner_id !== guildOwnerId);
      const base = gmBand ?? memberBand ?? group[0];
      const source = memberBand?.character_name ?? null;
      const playerCount = base.hide_players ? 0 : mergeBandPlayers(group).length;
      out.push({ band: base, source, playerCount });
    });
    return out;
  }
</script>