---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import DirectoryPage from '@/components/layout/DirectoryPage.astro';
import { PAGE_META, breadcrumbSchema, collectionPageSchema } from '@/lib/seo';

const meta = PAGE_META['/servidores'];
const jsonLd = [
  collectionPageSchema('Servidores y reinos de WoW 3.3.5a', meta.description, '/servidores'),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Servidores', path: '/servidores' },
  ]),
];
---

<Layout
  title={meta.title}
  description={meta.description}
  jsonLd={jsonLd}
  particles="frost"
>
  <Navigation currentPath="/servidores" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <DirectoryPage
        hero="Servidores"
        panelIcon="servidor"
        heroImage="/images/headers/servidores.webp"
        heroTitleCls="rd-title rd-ornament"
        intro="Explora servidores y reinos de WoW 3.3.5a con hermandades, personajes y bandas públicas. Los datos provienen de los archivos que la comunidad decide compartir."
        loadingText="Cargando servidores…"
        context={{
          title: '¿Qué es un servidor en RaidDominion?',
          text: 'El servidor es la dirección realmlist del cliente de WoW 3.3.5a (por ejemplo, logon.ejemplo.com). Cada servidor agrupa reinos, y cada reino reúne las hermandades, personajes y bandas públicas registradas.',
          cta: { label: 'Subir archivo del addon', href: '/upload' },
        }}
        gridLabel="Listado de servidores"
        empty={{
          icon: 'servidor',
          title: 'Aún no hay servidores con datos públicos',
          titleCls: 'font-black italic',
          message: 'Sube el archivo del addon para que tu reino y hermandad aparezcan en el directorio.',
          cta: { label: 'Sube el archivo del addon', href: '/upload' },
        }}
      />
    </div>
  </main>
</Layout>

<script>
  import { listPublicServers } from '@/lib/api';
  import { cardLink, iconTileEl, cardTitle } from '@/lib/ui/card';
  import { chip } from '@/lib/ui/dom';
  import { PAGE_SIZE_GRID } from '@/lib/ui/paginator';
  import { resolveAsyncList, settleAsyncList, clearListItems, mountPagedList } from '@/lib/ui/list';

  // Ítems por página del directorio (grilla 3 columnas × 4 filas).

  const list = resolveAsyncList();
  const gridEl = document.getElementById('grid') as HTMLElement;
  const filtersEl = document.getElementById('filters') as HTMLElement;
  const pagerEl = document.getElementById('pager') as HTMLElement;

  // El servidor es la dirección realmlist (p. ej. logon.ultimowow.com); cada
  // servidor aloja uno o varios reinos (la capa siguiente en la jerarquía).
  const res = await listPublicServers();
  if (!res.ok || !res.servers) {
    settleAsyncList(list, 'notice', 'No se pudo cargar el directorio de servidores.');
  } else if (res.servers.length === 0) {
    settleAsyncList(list, 'empty');
  } else {
    const servers = res.servers;
    document.title = `${servers.length} servidor${servers.length === 1 ? '' : 'es'} — RaidDominion`;
    // Barra estándar (src/lib/ui/filterBar.ts): con una sola dimensión de
    // datos (el nombre) solo lleva buscador + contador de resultados.
    mountPagedList({
      mount: filtersEl,
      items: servers,
      pageSize: PAGE_SIZE_GRID,
      pager: pagerEl,
      container: gridEl,
      renderItem: (server) => card(server),
      getSearchText: (server) => server,
      searchPlaceholder: 'Buscar servidor…',
      searchLabel: 'Buscar servidores por nombre',
      resultNoun: (n) => `${n} servidor${n === 1 ? '' : 'es'}`,
      // El contador total vive en el filtro; el paginador solo da la página.
      summary: () => '',
      clear: () => clearListItems(list),
      emptyMessage: (state) => `Ningún servidor coincide con "${state.query.trim()}".`,
      renderEmpty: (message) => settleAsyncList(list, 'notice', message),
      onReady: () => settleAsyncList(list, 'ready'),
    });
  }

  function card(server: string): HTMLElement {
    const link = cardLink(`/servidor/${encodeURIComponent(server)}`, 'p-5');

    const head = document.createElement('div');
    head.className = 'flex items-center gap-3 mb-3';
    head.appendChild(iconTileEl('servidor'));
    const name = cardTitle(server, 'text-base', 'break-all');
    head.appendChild(name);
    link.appendChild(head);

    const meta = document.createElement('div');
    meta.className = 'flex flex-wrap gap-1.5';
    meta.appendChild(chip('Servidor realmlist'));
    link.appendChild(meta);

    const foot = document.createElement('p');
    foot.className = 'text-xs text-valor-300 mt-4 flex items-center justify-between';
    foot.appendChild(document.createTextNode('Ver servidor →'));
    link.appendChild(foot);
    return link;
  }
</script>
