---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
---

<Layout title="Servidores - RaidDominion" description="Servidores y reinos con hermandades y personajes públicos de la comunidad RaidDominion.">
  <Navigation currentPath="/servidores" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto px-4">
      <Breadcrumb />

      <header class="text-center mb-10 animate-fade-in-1">
        <h1 class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase">Servidores</h1>
        <p class="text-gray-400 italic mt-3 max-w-2xl mx-auto">
          Reinos con hermandades y personajes públicos, derivados de los
          SavedVariables subidos por la comunidad.
        </p>
      </header>

      <p id="status" class="text-sm text-gray-400 italic mb-4" aria-live="polite">Cargando servidores…</p>
      <section id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" aria-label="Listado de servidores"></section>

      <div id="empty" class="hidden bg-gray-900/60 border border-amber-600/25 rounded-lg p-10 text-center">
        <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
        <p class="font-bold text-white mb-1">Aún no hay servidores con datos públicos</p>
        <p class="text-sm text-gray-400 max-w-md mx-auto">Sube tu SavedVariables para que tu reino y hermandad aparezcan en el directorio.</p>
        <a href="/upload" class="inline-block mt-5 px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105">Sube tu SavedVariables</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { listPublicServers, getServerStats } from '@/lib/api';

  const statusEl = document.getElementById('status') as HTMLElement;
  const gridEl = document.getElementById('grid') as HTMLElement;
  const emptyEl = document.getElementById('empty') as HTMLElement;

  // El servidor es la dirección realmlist (p. ej. logon.ultimowow.com); cada
  // servidor aloja uno o varios reinos (la capa siguiente en la jerarquía).
  const res = await listPublicServers();
  if (!res.ok || !res.servers) {
    statusEl.textContent = 'No se pudo cargar el directorio de servidores.';
  } else if (res.servers.length === 0) {
    statusEl.classList.add('hidden');
    emptyEl.classList.remove('hidden');
  } else {
    document.title = `${res.servers.length} servidor${res.servers.length === 1 ? '' : 'es'} — RaidDominion`;
    const statsRes = await Promise.all(res.servers.map((s) => getServerStats(s)));
    res.servers.forEach((s, i) => {
      gridEl.appendChild(card(s, statsRes[i]));
    });
    statusEl.classList.add('hidden');
  }

  function card(server: string, stats: Awaited<ReturnType<typeof getServerStats>>): HTMLElement {
    const link = document.createElement('a');
    link.href = `/servidor/${encodeURIComponent(server)}`;
    link.className = 'group block bg-gray-900/60 border border-amber-600/25 hover:border-amber-500/50 rounded-lg p-5 transition-all duration-300 transform hover:-translate-y-0.5';

    const head = document.createElement('div');
    head.className = 'flex items-center gap-3 mb-3';
    const icon = document.createElement('div');
    icon.className = 'w-10 h-10 rounded-lg bg-amber-600/15 border border-amber-600/30 flex items-center justify-center text-amber-300 font-black text-lg shrink-0';
    icon.textContent = (server[0] || '?').toUpperCase();
    head.appendChild(icon);
    const name = document.createElement('h2');
    name.className = 'font-bold text-white group-hover:text-amber-200 transition-colors text-base leading-snug break-all';
    name.textContent = server;
    head.appendChild(name);
    link.appendChild(head);

    const meta = document.createElement('div');
    meta.className = 'flex flex-wrap gap-1.5';
    meta.appendChild(chip('Servidor realmlist'));
    link.appendChild(meta);

    // Stats reales: reinos, personajes y jugadores públicos
    const statsRow = document.createElement('div');
    statsRow.className = 'grid grid-cols-3 gap-2 mt-3';
    const stat = (label: string, value: number | undefined): HTMLElement => {
      const box = document.createElement('div');
      box.className = 'text-center bg-gray-900/50 border border-amber-600/20 rounded-lg px-2 py-2';
      const val = document.createElement('p');
      val.className = 'text-lg font-black text-amber-200 italic';
      val.textContent = String(value ?? 0);
      const lab = document.createElement('p');
      lab.className = 'text-[9px] font-black uppercase tracking-widest text-gray-500';
      lab.textContent = label;
      box.append(val, lab);
      return box;
    };
    statsRow.appendChild(stat('Reinos', stats.ok ? stats.realms : 0));
    statsRow.appendChild(stat('Personajes', stats.ok ? stats.characters : 0));
    statsRow.appendChild(stat('Jugadores', stats.ok ? stats.players : 0));
    link.appendChild(statsRow);

    const foot = document.createElement('p');
    foot.className = 'text-xs text-gray-500 mt-3';
    foot.textContent = 'Ver servidor →';
    link.appendChild(foot);
    return link;
  }

  function chip(text: string): HTMLElement {
    const c = document.createElement('span');
    c.className = 'px-2 py-0.5 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-300 bg-gray-800/60 border border-amber-600/20';
    c.textContent = text;
    return c;
  }
</script>
