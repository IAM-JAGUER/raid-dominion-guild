---
// Listado público de JUGADORES (cuentas con perfil público), distinto de
// /personajes (personajes validados). Resuelto 100% en cliente contra
// raiddominion_profiles (is_public = true). Cada tarjeta enlaza a /jugador/:slug.
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import DirectoryPage from '@/components/layout/DirectoryPage.astro';
---

<Layout
  title="Jugadores - RaidDominion"
  description="Jugadores de la comunidad RaidDominion con perfil público: cuenta, personaje principal y hermandad."
  particles="arcane"
>
  <Navigation currentPath="/jugadores" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <DirectoryPage
        hero="Jugadores"
        panelIcon="jugadores"
        heroTitleCls="rd-title rd-ornament"
        intro="Cuentas de la comunidad con perfil público. Cada jugador enlaza a su página de perfil con sus personajes y bandas visibles."
        loadingText="Cargando jugadores…"
        gridLabel="Listado de jugadores"
        empty={{
          icon: 'perfil',
          eyebrow: 'Directorio público',
          title: 'Aún no hay jugadores con perfil público',
          titleCls: 'font-black italic',
          message: 'Activa la visibilidad de tu perfil desde el dashboard para aparecer en el directorio.',
          cta: { label: 'Inicia sesión', href: '/login' },
        }}
      />
    </div>
  </main>
</Layout>

<script>
  import { listPublicPlayers, getPublicAccountNames, type PublicAccountNames } from '@/lib/api';
  import type { ProfileRow } from '@/types/database';
  import { isNamelessSafe, safePlayerName, handleFromSlug } from '@/lib/ui/playerNames';
  import { cardLink, iconTileEl, cardTitle } from '@/lib/ui/card';
  import { chip, el } from '@/lib/ui/dom';
  import { iconEl } from '@/lib/ui/icons';
  import { createFilterBar } from '@/lib/ui/filterBar';
  import { createPaginator, PAGE_SIZE_GRID } from '@/lib/ui/paginator';
  import { resolveAsyncList, settleAsyncList, clearListItems } from '@/lib/ui/list';

  // Ítems por página del directorio (grilla 3 columnas × 4 filas).

  const list = resolveAsyncList();
  const gridEl = document.getElementById('grid') as HTMLElement;
  const filtersEl = document.getElementById('filters') as HTMLElement;
  const pagerEl = document.getElementById('pager') as HTMLElement;

  // Presentación resuelta UNA vez por jugador (card + facetas comparten la
  // misma derivación de nombre visible, maestro público y perfil sin nombre).
  interface PlayerItem {
    p: ProfileRow;
    gmVisible: boolean;
    nameless: boolean;
    name: string;
    principalPublic: boolean;
    fromHandle: boolean;
  }

  function derive(p: ProfileRow, info?: PublicAccountNames): PlayerItem {
    const publicNames = info?.publicNames ?? new Set<string>();
    const fallback = info?.principal;
    // La insignia de maestro solo aplica si hay un personaje maestro PÚBLICO
    // (el rol del perfil no se expone si el maestro real está oculto).
    const gmVisible = p.is_guild_master && info?.hasPublicGm === true;
    const nameless = isNamelessSafe(p, { publicNames });
    const principalPublic = !!(p.character_name ?? '').trim() && publicNames.has(p.character_name!.toLowerCase());
    // El nombre visible: display_name → character_name público → handle @hex.
    // El fallback (personaje público de la cuenta) solo se usa si el usuario
    // declaró un principal; con el principal en "Ninguno" y sin nombre visible,
    // la card cae al handle estable del perfil, nunca a otro personaje.
    const name = safePlayerName(p, { publicNames, fallbackName: principalPublic ? fallback : undefined });
    return { p, gmVisible, nameless, name, principalPublic, fromHandle: nameless && !principalPublic };
  }

  function card(item: PlayerItem): HTMLElement {
    const { p, gmVisible, nameless, name, principalPublic, fromHandle } = item;
    const link = cardLink(`/jugador/${p.slug}`, 'p-5');

    const head = el('div', 'flex items-center gap-3 mb-3');
    head.appendChild(iconTileEl('perfil'));
    const nameWrap = el('div', 'min-w-0');
    const nm = cardTitle(name, 'text-base', 'truncate');
    nameWrap.appendChild(nm);
    // Subtítulo: el personaje principal declarado, SOLO si es público y difiere.
    if (principalPublic && p.character_name !== name) {
      nameWrap.appendChild(el('p', 'text-[11px] text-gray-400 truncate', `Principal: ${p.character_name}`));
    }
    head.appendChild(nameWrap);
    if (gmVisible) {
      const star = iconEl('estrella', { size: 'xs', cls: 'shrink-0', label: 'Maestro de hermandad' });
      star.title = 'Maestro de hermandad';
      head.appendChild(star);
    }
    link.appendChild(head);

    const chips = el('div', 'flex flex-wrap gap-1.5');
    chips.appendChild(chip('Perfil público'));
    // Marca distintiva para perfiles sin nombre: handle único + aviso sutil.
    if (fromHandle) {
      chips.appendChild(chip(handleFromSlug(p.slug), 'text-gray-400 bg-brand-900/60 border-gray-600/40'));
      chips.appendChild(chip('sin nombre', 'text-brand-400 bg-brand-950/30 border-brand-600/40'));
    } else if (nameless) {
      chips.appendChild(chip('sin nombre', 'text-brand-400 bg-brand-950/30 border-brand-600/40'));
    }
    if (p.realm) chips.appendChild(chip(p.realm, 'text-brand-200 bg-brand-800/60 border-brand-600/30'));
    if (gmVisible) chips.appendChild(chip('Maestro', 'text-fuchsia-300 bg-fuchsia-950/30 border-fuchsia-600/40'));
    link.appendChild(chips);

    const foot = el('p', 'text-xs text-gray-400 mt-4 flex items-center justify-between');
    foot.appendChild(el('span', 'text-brand-300/80 group-hover:text-brand-200 transition-colors', 'Ver perfil →'));
    link.appendChild(foot);
    return link;
  }

  const res = await listPublicPlayers();
  if (!res.ok || !res.players) {
    settleAsyncList(list, 'notice', 'No se pudo cargar el directorio de jugadores.');
  } else if (res.players.length === 0) {
    settleAsyncList(list, 'empty');
  } else {
    document.title = `${res.players.length} jugador${res.players.length === 1 ? '' : 'es'} — RaidDominion`;
    const infos = await getPublicAccountNames(res.players.map((p) => p.id));
    const items = res.players.map((p) => derive(p, infos.get(p.id)));

    // Panel estándar (src/lib/ui/filterBar.ts): buscador (nombre, personaje,
    // reino, @handle) + selector dinámico de reino, Maestro y Sin nombre.
    createFilterBar({
      mount: filtersEl,
      items,
      getSearchText: (it) => `${it.name} ${it.p.character_name ?? ''} ${it.p.realm ?? ''} ${handleFromSlug(it.p.slug)}`,
      searchPlaceholder: 'Buscar por nombre, personaje, reino o @handle…',
      searchLabel: 'Buscar jugadores por nombre, personaje, reino o handle',
      facets: [
        {
          id: 'reino',
          label: 'Filtrar por reino',
          getValues: (it) => [(it.p.realm ?? '').trim()].filter(Boolean),
        },
        {
          kind: 'flag',
          id: 'gm',
          label: 'Filtrar maestros de hermandad',
          getFlag: (it) => it.gmVisible,
          chipLabel: 'Maestro',
          icon: 'estrella',
        },
        {
          kind: 'flag',
          id: 'anon',
          label: 'Filtrar perfiles sin nombre',
          getFlag: (it) => it.nameless,
          chipLabel: 'Sin nombre',
        },
      ],
      resultNoun: (n) => `${n} jugador${n === 1 ? '' : 'es'}`,
      onChange: (filtered, state) => {
        // La barra del paginador se descarta entera en los estados de aviso.
        pagerEl.textContent = '';
        if (filtered.length === 0) {
          clearListItems(list);
          settleAsyncList(list, 'notice', state.query.trim()
            ? `Ningún jugador coincide con "${state.query.trim()}".`
            : 'Sin resultados con los filtros aplicados.');
          return;
        }
        // Paginación (paginator.ts): 12 por página; la barra se monta en #pager
        // solo cuando hay más de una página. El render de cada página limpia los
        // ítems previos (el bloque de carga se conserva hasta el ready).
        const paginator = createPaginator({
          pageSize: PAGE_SIZE_GRID,
          totalItems: filtered.length,
          summary: `${filtered.length} jugador${filtered.length === 1 ? '' : 'es'}`,
          renderPage: (page) => {
            clearListItems(list);
            const start = (page - 1) * PAGE_SIZE_GRID;
            filtered.slice(start, start + PAGE_SIZE_GRID).forEach((it) => gridEl.appendChild(card(it)));
          },
        });
        if (paginator.bar) pagerEl.appendChild(paginator.bar);
        paginator.update();
        settleAsyncList(list, 'ready');
      },
    });
  }
</script>
