---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
---

<Layout title="Hermandades - RaidDominion" description="Directorio público de hermandades de la comunidad RaidDominion: roster, bandas y reglas de cada portal.">
  <Navigation currentPath="/guilds" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto px-4">

      <header class="text-center mb-10 animate-fade-in-1">
        <h1 class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase">Hermandades</h1>
        <p class="text-gray-400 italic mt-3 max-w-2xl mx-auto">
          Portales públicos de las hermandades que usan RaidDominion: roster, bandas,
          horarios y reglas, actualizados por sus propios maestros.
        </p>
      </header>

      <!-- Filtros -->
      <div class="flex flex-col sm:flex-row gap-3 mb-8 animate-fade-in-1" style="animation-delay: 0.1s">
        <div class="relative flex-1">
          <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="search" id="search" placeholder="Buscar por nombre o reino…"
            class="w-full pl-9 pr-4 py-2.5 rounded-lg bg-gray-900/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600" />
        </div>
        <select id="faction-filter"
          class="px-4 py-2.5 rounded-lg bg-gray-900/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm sm:w-48">
          <option value="">Toda facción</option>
          <option value="Horde">Horde</option>
          <option value="Alliance">Alliance</option>
        </select>
      </div>

      <!-- Resultados -->
      <p id="status" class="text-sm text-gray-400 italic mb-4" aria-live="polite">Cargando hermandades…</p>
      <section id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" aria-label="Listado de hermandades"></section>

      <!-- Vacío -->
      <div id="empty" class="hidden bg-gray-900/60 border border-amber-600/25 rounded-lg p-10 text-center">
        <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        <p class="font-bold text-white mb-1">Aún no hay hermandades públicas</p>
        <p class="text-sm text-gray-400 max-w-md mx-auto">Los maestros de hermandad publican su portal desde el dashboard al reclamar su guild.</p>
        <a href="/upload" class="inline-block mt-5 px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105">Sube tu SavedVariables</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { listPublicGuilds } from '@/lib/api';
  import type { GuildRow } from '@/types/database';

  const statusEl = document.getElementById('status') as HTMLElement;
  const gridEl = document.getElementById('grid') as HTMLElement;
  const emptyEl = document.getElementById('empty') as HTMLElement;
  const searchEl = document.getElementById('search') as HTMLInputElement;
  const factionEl = document.getElementById('faction-filter') as HTMLSelectElement;

  let guilds: GuildRow[] = [];

  function card(g: GuildRow): HTMLElement {
    const link = document.createElement('a');
    link.href = `/${g.slug}`;
    link.className = 'group block bg-gray-900/60 border border-amber-600/25 hover:border-amber-500/50 rounded-lg p-5 transition-all duration-300 transform hover:-translate-y-0.5';

    const head = document.createElement('div');
    head.className = 'flex items-start justify-between gap-3 mb-3';
    const name = document.createElement('h2');
    name.className = 'font-bold text-white group-hover:text-amber-200 transition-colors text-base leading-snug';
    name.textContent = g.name;
    const faction = g.faction
      ? document.createElement('span')
      : null;
    if (faction) {
      faction.className = `shrink-0 px-2 py-0.5 rounded-lg text-[9px] font-black uppercase tracking-widest border ${g.faction === 'Horde' ? 'bg-red-950/40 border-red-700/50 text-red-300' : 'bg-sky-950/40 border-sky-700/50 text-sky-300'}`;
      faction.textContent = g.faction === 'Horde' ? 'Horda' : 'Alianza';
      head.appendChild(faction);
    }
    head.insertBefore(name, faction);
    link.appendChild(head);

    if (g.description) {
      const desc = document.createElement('p');
      desc.className = 'text-sm text-gray-400 italic line-clamp-2 mb-3';
      desc.textContent = g.description;
      link.appendChild(desc);
    }

    const meta = document.createElement('div');
    meta.className = 'flex items-center justify-between mt-auto pt-3 border-t border-amber-600/15';
    const realm = document.createElement('span');
    realm.className = 'text-[10px] font-black uppercase tracking-widest text-gray-500';
    realm.textContent = g.realm || 'Reino no especificado';
    const cta = document.createElement('span');
    cta.className = 'text-[10px] font-black uppercase tracking-widest text-amber-400 group-hover:text-amber-300 transition-colors';
    cta.textContent = 'Ver portal →';
    meta.append(realm, cta);
    link.appendChild(meta);

    return link;
  }

  function render(): void {
    const q = searchEl.value.trim().toLowerCase();
    const f = factionEl.value;
    gridEl.innerHTML = '';

    const filtered = guilds.filter((g) => {
      const matchQ = !q || g.name.toLowerCase().includes(q) || (g.realm ?? '').toLowerCase().includes(q);
      const matchF = !f || g.faction === f;
      return matchQ && matchF;
    });

    if (filtered.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    filtered.forEach((g) => gridEl.appendChild(card(g)));
  }

  searchEl.addEventListener('input', render);
  factionEl.addEventListener('change', render);

  const res = await listPublicGuilds();
  if (!res.ok) {
    // #status se usa SOLO para el error de red; en éxito se oculta siempre.
    statusEl.textContent = 'No se pudo cargar el directorio. Intenta de nuevo más tarde.';
  } else {
    guilds = res.guilds ?? [];
    document.title = guilds.length > 0
      ? `${guilds.length} hermandad${guilds.length === 1 ? '' : 'es'} — RaidDominion`
      : 'Hermandades - RaidDominion';
    statusEl.classList.add('hidden');
    render();
  }
</script>