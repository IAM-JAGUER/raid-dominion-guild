---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import PanelWindow from '@/components/ui/PanelWindow.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { ui } from '@/lib/ui/design';
---

<Layout title="Bandas - RaidDominion" description="Bandas de raid públicas de las hermandades que usan RaidDominion: horario, GS mínimo y roster.">
  <Navigation currentPath="/bandas" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />
      <PageHeader
        eyebrow="Directorio público"
        title="Bandas"
        intro="Bandas de raid públicas de la comunidad: horarios, requisitos de GS y miembros, extraídos de los SavedVariables de cada jugador."
      />
      <div class={`${ui.dividerFadeBoth} mt-6 mb-10`} aria-hidden="true"></div>

      <div id="directorio">
        <p id="status" class={`${ui.loading.liveText} italic mb-4`} aria-live="polite">Cargando bandas…</p>

        <!-- Modelo de ventana (encabezado + contenido): el encabezado lleva el
             filtro por día y el cuerpo la lista de bandas organizada de lunes a
             domingo por hora de inicio (bandSchedule.ts). -->
        <PanelWindow title="Bandas" bodyCls="space-y-8">
          <div slot="head">
            <!-- Filtro por día del modelo /bandas (módulo renderBandasPanel). -->
            <div class="mt-4" id="filtro-dia" role="group" aria-label="Filtrar bandas por día" aria-live="polite"></div>
          </div>
          <div id="bandas-content" class="space-y-8"></div>
        </PanelWindow>
      </div>

      <EmptyState
        id="empty"
        hidden
        icon="group"
        eyebrow="Directorio público"
        title="Aún no hay bandas públicas"
        titleCls="font-black italic text-white"
        gradient={false}
        message="Publica tus bandas desde tu dashboard subiendo tu SavedVariables; cada banda puede ser personal o pertenecer a tu hermandad."
        cta={{ label: 'Sube tu SavedVariables', href: '/upload' }}
        ctaCls="transform hover:scale-105"
        align="center"
      />
      <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
    </div>
  </main>
</Layout>

<script>
  import { listPublicBands } from '@/lib/api';
  import { resolveBandOwners, mergeDirectoryBands, type MergedBand } from '@/lib/bandListing';
  import { renderBandCard } from '@/lib/ui/cards';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';

  const statusEl = document.getElementById('status') as HTMLElement;
  const filtroEl = document.getElementById('filtro-dia') as HTMLElement;
  const contentEl = document.getElementById('bandas-content') as HTMLElement;
  const directorioEl = document.getElementById('directorio') as HTMLElement;
  const emptyEl = document.getElementById('empty') as HTMLElement;

  // Las bandas viven en raiddominion_bands (personales o de hermandad) y se
  // publican con su visibilidad espejo (perfil del dueño o portal de la guild).
  const res = await listPublicBands();
  if (!res.ok || !res.bands) {
    statusEl.textContent = 'No se pudo cargar el directorio de bandas.';
  } else if (res.bands.length === 0) {
    directorioEl.classList.add('hidden');
    emptyEl.classList.remove('hidden');
  } else {
    const owners = await resolveBandOwners(res.bands);
    const merged = mergeDirectoryBands(res.bands, owners);
    document.title = `${merged.length} banda${merged.length === 1 ? '' : 's'} — RaidDominion`;
    // Modelo compartido (bandasPanel.ts): filtro por día + grilla de días;
    // mismo comportamiento que las pestañas Bandas de perfil/personaje/reino.
    renderBandasPanel({
      filtro: filtroEl,
      content: contentEl,
      items: merged,
      getSchedule: (item: MergedBand) => item.b.schedule,
      // Búsqueda por nombre de banda / jugadores / personaje que subió / hermandad.
      getSearchText: (item: MergedBand) => [
        item.b.name,
        Array.isArray(item.b.players) ? (item.b.players as Array<{ name?: string }>).map((p) => p.name).join(' ') : '',
        item.b.character_name,
        owners.get(item.b.guild_id || item.b.owner_id)?.label,
      ].filter(Boolean).join(' '),
      renderCard: (item: MergedBand) => renderBandCard(item.b, {
        source: item.source,
        playerCount: item.playerCount,
        owner: owners.get(item.b.guild_id || item.b.owner_id),
        // guildId alimenta la atribución propia: `null` = banda personal
        // (chip "Personal" si no hay dueño público); undefined no infiere.
        guildId: item.b.guild_id,
      }),
    });
    statusEl.classList.add('hidden');
  }
</script>