---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import LoadingBlock from '@/components/ui/LoadingBlock.astro';
import { ui } from '@/lib/ui/design';
import { PAGE_META, breadcrumbSchema, collectionPageSchema } from '@/lib/seo';

const meta = PAGE_META['/bandas'];
const jsonLd = [
  collectionPageSchema('Bandas de raid públicas de WoW 3.3.5a', meta.description, '/bandas'),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Bandas', path: '/bandas' },
  ]),
];
---

<Layout
  title={meta.title}
  description={meta.description}
  jsonLd={jsonLd}
  particles="ember"
>
  <Navigation currentPath="/bandas" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />
      <PageHeader
        title="Bandas"
        icon="espadas"
        image="/images/headers/bandas.webp"
        tone="ember"
        intro="Descubre bandas de raid públicas de WoW 3.3.5a por día, tipo y reino. Consulta horario, gearscore mínimo, roster y reglas compartidos por cada jugador."
      >
        <div slot="filters" id="filters" data-rd-filter-bar class={ui.filter.headerMount}></div>
      </PageHeader>
      <div class={`${ui.dividerFadeBoth} mt-6`} aria-hidden="true"></div>

      <!-- Tablero abierto: la lista vive directamente bajo el header, sin la
           ventana de contenido de las fichas. Los filtros (buscador + selector
           de día y tipo) viven en el header vía PageHeader → #filters; el
           contador vive en la barra y el paginador solo aporta la página. -->
      <div id="directorio" data-rd-list-frame class={ui.directory.board}>
        <!-- Ítems anidados (secciones por día): el selector `.rd-card` los
             funde escalonados en una sola cascada. -->
        <div id="bandas-content" data-rd-list-content data-rd-reveal-cards=".rd-card" class={ui.directory.groups}>
          <LoadingBlock text="Cargando bandas…" listStatus pad="md" />
        </div>
      </div>

      <EmptyState
        id="empty"
        cls={ui.directory.empty}
        hidden
        icon="espadas"
        title="Aún no hay bandas públicas"
        titleCls="font-black italic text-white"
        gradient={false}
        message="Publica tus bandas desde tu dashboard subiendo el archivo del addon; cada banda puede ser personal o pertenecer a tu hermandad."
        cta={{ label: 'Sube el archivo del addon', href: '/upload' }}
        ctaCls="transform hover:scale-105"
        align="center"
      />
      <section class={`${ui.panel} ${ui.tone.ember} ${ui.tonePanel} relative overflow-hidden mt-10 p-6 sm:p-7`}>
        <span class={`${ui.cardTop} ${ui.toneTop}`} aria-hidden="true"></span>
        <h2 class={`${ui.text.h1} ${ui.gradientTitle} ${ui.toneTitle} mb-2`}>¿Cómo publicar tus bandas?</h2>
        <p class={`${ui.text.body} leading-relaxed max-w-md`}>
          Registra tus bandas en el addon, sube el archivo y activa su visibilidad. Cada banda puede ser
          personal o pertenecer a tu hermandad, con horario, gearscore mínimo y reglas propias.
        </p>
        <a href="/upload" class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.sm} mt-5`}>Subir archivo del addon</a>
      </section>

      <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
    </div>
  </main>
</Layout>

<script>
  import { listPublicBands } from '@/lib/api';
  import { resolveBandOwners, mergeDirectoryBands, type MergedBand } from '@/lib/bandListing';
  import { renderBandCard } from '@/lib/ui/cards';
  import { renderBandasPanel } from '@/lib/ui/bandasPanel';
  import { resolveAsyncList, settleAsyncList } from '@/lib/ui/list';

  const list = resolveAsyncList();
  const filtersEl = document.getElementById('filters') as HTMLElement;
  const contentEl = document.getElementById('bandas-content') as HTMLElement;

  // Las bandas viven en raiddominion_bands (personales o de hermandad) y se
  // publican con su visibilidad espejo (perfil del dueño o portal de la guild).
  const res = await listPublicBands();
  if (!res.ok || !res.bands) {
    settleAsyncList(list, 'notice', 'No se pudo cargar el directorio de bandas.');
  } else if (res.bands.length === 0) {
    settleAsyncList(list, 'empty');
  } else {
    const owners = await resolveBandOwners(res.bands);
    const merged = mergeDirectoryBands(res.bands, owners);
    document.title = `${merged.length} banda${merged.length === 1 ? '' : 's'} — RaidDominion`;
    // Modelo compartido (bandasPanel.ts): buscador + filtro por día y tipo;
    // mismo comportamiento que las pestañas Bandas de perfil/personaje/reino.
    renderBandasPanel({
      filtro: filtersEl,
      content: contentEl,
      items: merged,
      getSchedule: (item: MergedBand) => item.b.schedule,
      // Búsqueda por nombre de banda / jugadores / personaje que subió / hermandad.
      getSearchText: (item: MergedBand) => [
        item.b.name,
        Array.isArray(item.b.players) ? (item.b.players as Array<{ name?: string }>).map((p) => p.name).join(' ') : '',
        item.b.character_name,
        owners.get(item.b.guild_id || item.b.owner_id)?.label,
      ].filter(Boolean).join(' '),
      // Tipo para el chip Personal / De hermandad (guild_id NULL = personal).
      getType: (item: MergedBand) => (item.b.guild_id === null ? 'personal' : 'guild'),
      renderCard: (item: MergedBand) => renderBandCard(item.b, {
        source: item.source,
        playerCount: item.playerCount,
        owner: owners.get(item.b.guild_id || item.b.owner_id),
        // guildId alimenta la atribución propia: `null` = banda personal
        // (chip "Personal" si no hay dueño público); undefined no infiere.
        guildId: item.b.guild_id,
      }),
      // Contrato de lista: ready/notice de los filtros se asientan aquí.
      list,
    });
  }
</script>
