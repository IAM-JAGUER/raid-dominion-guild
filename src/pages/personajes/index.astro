---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import DirectoryPage from '@/components/layout/DirectoryPage.astro';
import { PAGE_META, breadcrumbSchema, collectionPageSchema } from '@/lib/seo';

const meta = PAGE_META['/personajes'];
const jsonLd = [
  collectionPageSchema('Personajes públicos de WoW 3.3.5a', meta.description, '/personajes'),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Personajes', path: '/personajes' },
  ]),
];
---

<Layout
  title={meta.title}
  description={meta.description}
  jsonLd={jsonLd}
  particles="arcane"
>
  <Navigation currentPath="/personajes" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <DirectoryPage
        hero="Personajes"
        tone="valor"
        panelIcon="personaje"
        heroImage="/images/headers/personajes.webp"
        heroTitleCls="rd-title rd-ornament"
        intro="Explora personajes públicos de WoW 3.3.5a con equipo, iLevel y bandas. Solo aparecen los personajes que su dueño decidió hacer visibles desde el portal."
        loadingText="Cargando personajes…"
        context={{
          title: '¿Qué muestra una ficha de personaje?',
          text: 'Equipo, iLevel y bandas registradas con el addon. Las metas de equipo y moneda y las instancias guardadas se consultan solo en el tracker privado de cada cuenta; la nota privada no se publica salvo que su dueño active su visibilidad.',
          cta: { label: 'Subir archivo del addon', href: '/upload' },
        }}
        gridLabel="Listado de personajes"
        empty={{
          icon: 'personaje',
          title: 'Aún no hay personajes públicos',
          titleCls: 'font-black italic',
          message: 'Sube el archivo del addon, valida tus personajes y activa su visibilidad desde el dashboard.',
          cta: { label: 'Sube el archivo del addon', href: '/upload' },
        }}
      />
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '@/lib/supabase';
  import { ensureMyCharacterSlugs, type CharacterRow } from '@/lib/api';
  import { renderCharacterCard } from '@/lib/ui/cards';
  import { CLASS_LABELS, classKey } from '@/lib/ui/classColors';
  import { classIconEl } from '@/lib/ui/classIcon';
  import { PAGE_SIZE_GRID } from '@/lib/ui/paginator';
  import { resolveAsyncList, settleAsyncList, clearListItems, mountPagedList } from '@/lib/ui/list';

  // Ítems por página del directorio (grilla 3 columnas × 4 filas).

  const list = resolveAsyncList();
  const gridEl = document.getElementById('grid') as HTMLElement;
  const filtersEl = document.getElementById('filters') as HTMLElement;
  const pagerEl = document.getElementById('pager') as HTMLElement;

  let chars: CharacterRow[] = [];
  const profiles = new Map<string, { slug: string | null; display_name: string | null; character_name: string | null }>();

  async function load(): Promise<void> {
    const [charsRes, profRes] = await Promise.all([
      supabase
        .from('raiddominion_characters')
        .select('*')
        .eq('is_public', true)
        .eq('member_verified', true)
        .order('avg_ilvl', { ascending: false })
        .limit(200),
      supabase.from('raiddominion_profiles').select('id, slug, display_name, character_name').eq('is_public', true),
    ]);

    chars = (charsRes.data as CharacterRow[] | null) ?? [];
    (profRes.data as Array<{ id: string; slug: string | null; display_name: string | null; character_name: string | null }> | null)?.forEach((p) =>
      profiles.set(p.id, { slug: p.slug, display_name: p.display_name, character_name: p.character_name })
    );

    // Slugs propios: generarlos en el momento si hace falta (RPC idempotente)
    // para que los cards enlacen a /personaje/<slug>.
    const session = await supabase.auth.getSession();
    if (session.data.session?.user) {
      const ensure = await ensureMyCharacterSlugs();
      if (ensure.ok && ensure.slugs) {
        const slugById = new Map(ensure.slugs.map((s) => [s.id, s.slug]));
        chars.forEach((c) => { if (!c.slug) c.slug = slugById.get(c.id) ?? null; });
      }
    }

    if (chars.length === 0) {
      settleAsyncList(list, 'empty');
      return;
    }

    // Panel estándar (src/lib/ui/filterBar.ts): buscador + selector dinámico
    // de clase (con ícono WoW y conteo), reino y Maestro (solo si aportan).
    mountPagedList({
      mount: filtersEl,
      items: chars,
      pageSize: PAGE_SIZE_GRID,
      pager: pagerEl,
      container: gridEl,
      renderItem: (c) => renderCharacterCard(c, { profiles }),
      getSearchText: (c) => `${c.name} ${c.realm ?? ''} ${c.class ?? ''} ${c.sv_guild_name ?? ''}`,
      searchPlaceholder: 'Buscar por personaje, reino, clase o hermandad…',
      searchLabel: 'Buscar personajes por nombre, reino, clase o hermandad',
      facets: [
        {
          id: 'clase',
          label: 'Filtrar por clase',
          // Clave canónica (class_file o nombre esMX): agrupa variantes.
          getValues: (c) => [classKey(c.class, c.class_file) ?? '__none__'],
          labelOf: (v) => (v === '__none__' ? 'Sin clase' : CLASS_LABELS[v] ?? v),
          iconOf: (v) => (v === '__none__' ? null : classIconEl(v, null, 'w-4 h-4 rounded-full shrink-0 object-contain')),
        },
        {
          id: 'reino',
          label: 'Filtrar por reino',
          getValues: (c) => [(c.realm ?? '').trim()].filter(Boolean),
        },
        {
          kind: 'flag',
          id: 'gm',
          label: 'Filtrar maestros de hermandad',
          getFlag: (c) => c.sv_is_gm === true,
          chipLabel: 'Maestro',
          icon: 'estrella',
        },
      ],
      resultNoun: (n) => `${n} personaje${n === 1 ? '' : 's'}`,
      // El contador total vive en el filtro; el paginador solo da la página.
      summary: () => '',
      clear: () => clearListItems(list),
      emptyMessage: (state) => state.query.trim()
        ? `Ningún personaje coincide con "${state.query.trim()}".`
        : 'Sin resultados con los filtros aplicados.',
      renderEmpty: (message) => settleAsyncList(list, 'notice', message),
      onReady: () => settleAsyncList(list, 'ready'),
    });
  }

  void load();
</script>
