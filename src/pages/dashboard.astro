---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import { ui } from '@/lib/ui/design';

const ctaPrincipal = `${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest`;
const ctaVacio = `${ui.btnBase} ${ui.btnPrimary} px-6 py-3 text-sm`;
---

<Layout title="Mi Dashboard - RaidDominion" description="Tu espacio en la comunidad RaidDominion: registro, hermandad y perfil.">
  <Navigation currentPath="/dashboard" />
  <main class="relative py-16">
    <div class="max-w-5xl mx-auto px-4">

      <!-- Encabezado del espacio personal -->
      <header class="flex flex-col sm:flex-row items-center sm:items-end justify-between gap-4 mb-8 animate-fade-in-1">
        <div class="flex items-center gap-4">
          <div id="avatar" class="w-14 h-14 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center text-black text-xl font-black shadow-lg shadow-amber-900/30 select-none">–</div>
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase">Mi Espacio</h1>
            <p id="user-email" class="text-gray-400 text-sm italic"></p>
          </div>
        </div>
        <span id="role-badge" class="px-3 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-widest border bg-gray-800/70 border-gray-600 text-gray-300">…</span>
      </header>

      <!-- Pestañas (navegación con ←/→/Home/End; activación automática al enfocar) -->
      <nav class="flex flex-wrap gap-1 mb-6 border-b border-amber-600/30 animate-fade-in-1" style="animation-delay: 0.15s" role="tablist" aria-label="Secciones del panel">
        <button id="tab-resumen" data-tab="resumen" role="tab" aria-selected="true" aria-controls="panel-resumen" tabindex="0"
          class="tab-btn px-3 sm:px-4 py-2.5 text-xs font-black uppercase tracking-widest border-b-2 border-amber-400 text-amber-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-lg">Resumen</button>
        <button id="tab-addon" data-tab="addon" role="tab" aria-selected="false" aria-controls="panel-addon" tabindex="-1"
          class="tab-btn px-3 sm:px-4 py-2.5 text-xs font-black uppercase tracking-widest border-b-2 border-transparent text-gray-500 hover:text-gray-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-lg">Mi Registro</button>
        <button id="tab-hermandad" data-tab="hermandad" role="tab" aria-selected="false" aria-controls="panel-hermandad" tabindex="-1"
          class="tab-btn px-3 sm:px-4 py-2.5 text-xs font-black uppercase tracking-widest border-b-2 border-transparent text-gray-500 hover:text-gray-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-lg">Mi Hermandad</button>
        <button id="tab-perfil" data-tab="perfil" role="tab" aria-selected="false" aria-controls="panel-perfil" tabindex="-1"
          class="tab-btn px-3 sm:px-4 py-2.5 text-xs font-black uppercase tracking-widest border-b-2 border-transparent text-gray-500 hover:text-gray-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-md ml-auto">Mi Perfil</button>
      </nav>

      <!-- ── Resumen ─────────────────────────────────────────────────────── -->
      <section id="panel-resumen" role="tabpanel" aria-labelledby="tab-resumen" class="space-y-6">
        <div class="bg-gradient-to-br from-gray-900/80 to-gray-800/50 border border-amber-600/30 rounded-lg p-6">
          <h2 class="text-lg font-bold text-amber-200 mb-2">Bienvenido a tu comunidad</h2>
          <p class="text-sm text-gray-400 leading-relaxed max-w-2xl">
            Este es tu espacio dentro del portal RaidDominion. Sube tus SavedVariables para
            mantener tus datos al día, controla la visibilidad de tu perfil y, si lideras una
            hermandad, administra su página pública con control total.
          </p>
        </div>

        <!-- KPIs (solo en Resumen) -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" aria-label="Resumen de actividad">
          <div class={`${ui.panel} p-4`}>
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-500">Análisis guardados</p>
            <p class="text-3xl font-black text-amber-300 mt-1" id="kpi-uploads">—</p>
          </div>
          <div class={`${ui.panel} p-4`}>
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-500">Último upload</p>
            <p class="text-sm font-bold text-amber-200 mt-2" id="kpi-last">—</p>
          </div>
          <div class={`${ui.panel} p-4`}>
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-500">Perfil</p>
            <p class="text-sm font-bold mt-2" id="kpi-visibility"><span class="text-gray-400">—</span></p>
          </div>
          <div class={`${ui.panel} p-4`}>
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-500">Hermandad</p>
            <p class="text-sm font-bold text-amber-200 mt-2" id="kpi-guild">—</p>
          </div>
        </div>

        <!-- CTA primario único -->
        <div class="flex flex-wrap items-center gap-4">
          <a href="/upload" class={ctaPrincipal}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
            Subir SavedVariables
          </a>
          <p class="text-xs text-gray-500 italic">Roster, bandas y reglas se actualizan con cada archivo.</p>
        </div>

        <!-- Accesos secundarios -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <button type="button" data-goto="perfil" class={`goto-btn group text-left ${ui.panel} ${ui.panelHover} p-5 transform hover:-translate-y-0.5`}>
            <svg class="w-7 h-7 text-amber-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <p class="font-bold text-white group-hover:text-amber-200 transition-colors">Mi Perfil</p>
            <p class="text-xs text-gray-500 mt-1">Datos, personajes y seguridad.</p>
          </button>
          <button type="button" data-goto="hermandad" id="quick-guild" class={`hidden goto-btn group text-left ${ui.panel} ${ui.panelHover} p-5 transform hover:-translate-y-0.5`}>
            <svg class="w-7 h-7 text-amber-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <p class="font-bold text-white group-hover:text-amber-200 transition-colors">Mi Hermandad</p>
            <p class="text-xs text-gray-500 mt-1">Portal público y ficha.</p>
          </button>
          <a href="/moderate" id="quick-moderate" class="hidden group bg-gray-900/60 border border-sky-700/30 hover:border-sky-500/50 rounded-lg p-5 transition-all duration-300 transform hover:-translate-y-0.5">
            <svg class="w-7 h-7 text-sky-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="font-bold text-white group-hover:text-sky-200 transition-colors">Moderación</p>
            <p class="text-xs text-gray-500 mt-1">Claims y portales.</p>
          </a>
          <a href="/admin" id="quick-admin" class="hidden group bg-gray-900/60 border border-red-800/40 hover:border-red-600/50 rounded-lg p-5 transition-all duration-300 transform hover:-translate-y-0.5">
            <svg class="w-7 h-7 text-red-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <p class="font-bold text-white group-hover:text-red-200 transition-colors">Administración</p>
            <p class="text-xs text-gray-500 mt-1">Usuarios y roles.</p>
          </a>
        </div>
      </section>

      <!-- ── Mi Registro (config + historial + visor) ─────────────────────── -->
      <section id="panel-addon" role="tabpanel" aria-labelledby="tab-addon" class="hidden space-y-6">
        <!-- Estado vacío -->
        <div id="addon-empty" class={`hidden ${ui.panel} p-8 max-w-2xl mx-auto text-center`}>
          <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          <p class="font-bold text-white mb-1">Aún no subes ningún SavedVariables</p>
          <p class="text-sm text-gray-400 mb-6">Sube tu archivo <code class="text-amber-300">RaidDominion.lua</code> para ver aquí todo tu registro: personaje, hermandad, bandas y reglas.</p>
          <a href="/upload" class={ctaVacio}>Ir a Subir SavedVariables</a>
          <p id="addon-empty-note" class="hidden mt-4 text-xs text-red-300"></p>
        </div>

        <div id="addon-main" class="hidden space-y-6">
          <!-- Selector + historial -->
          <div class={`${ui.panel} p-6`}>
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <h2 class="text-lg font-bold text-amber-200 flex items-center">
                <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
                Mi Registro
              </h2>
              <span class="text-[11px] text-gray-500 italic">Se actualiza re-subiendo tu SavedVariables</span>
            </div>

            <label for="sv-select" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Análisis a mostrar</label>
            <div class="relative">
              <select id="sv-select" class="w-full appearance-none cursor-pointer pl-3 pr-10 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 hover:border-gray-600 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/50 focus-visible:outline-none outline-none text-gray-100 text-sm transition-colors"></select>
              <svg aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>

            <details id="sv-history" class="mt-3 group">
              <summary class="cursor-pointer select-none list-none inline-flex items-center gap-1.5 rounded-lg px-1 -mx-1 py-0.5 text-xs font-black uppercase tracking-widest text-amber-300/80 hover:text-amber-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
                <svg aria-hidden="true" class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                Análisis anteriores (<span id="sv-history-count">0</span>)
              </summary>
              <ul id="history-list" class="mt-3 space-y-2"></ul>
            </details>
          </div>

          <!-- Banner de reclamo condicional (acento ámbar intenso: acción destacada) -->
          <div id="claim-banner" class="hidden border border-amber-400/60 bg-gradient-to-br from-amber-950/40 to-gray-900/60 rounded-lg p-6 shadow-lg shadow-amber-500/10">
            <h3 class="text-base font-black uppercase tracking-widest text-amber-300 mb-1">¿Lideras una o más hermandades?</h3>
            <p class="text-sm text-gray-300 mb-4">Tu SavedVariables acredita rango de liderazgo. Reclámalas y obtén el portal web gratuito de cada guild (puedes ser maestro de varias):</p>
            <ol class="space-y-2 mb-5 text-sm text-gray-300 list-none">
              <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center">1</span><span>Sube tu SavedVariables donde el addon te reporte como Maestro (<code class="text-amber-300">registry.guild.isGM</code>).</span></li>
              <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center">2</span><span>Reclama aquí tus hermandades: la ficha de cada una nace con los datos exactos del juego.</span></li>
              <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center">3</span><span>Publícalas desde Mi Hermandad y comparte <code class="text-amber-300">/tu-hermandad</code>.</span></li>
            </ol>
            <button type="button" id="claim-btn" class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest`}>Reclamar mis hermandades</button>
            <p id="claim-msg" class="hidden mt-3 text-sm rounded-lg px-4 py-2.5" role="status"></p>
          </div>

          <!-- Visor único del snapshot seleccionado -->
          <div class={`${ui.panel} p-6 space-y-6`}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-lg font-bold text-amber-300">Visor del análisis <span id="viewer-date" class="text-sm text-gray-400 font-normal italic"></span></h3>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class={`${ui.panel} p-4 text-center`}>
                <p class="text-3xl font-bold text-amber-300" id="stat-guild-size">0</p>
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Miembros</p>
              </div>
              <div class={`${ui.panel} p-4 text-center`}>
                <p class="text-3xl font-bold text-amber-300" id="stat-bands">0</p>
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Bandas</p>
              </div>
              <div class={`${ui.panel} p-4 text-center`}>
                <p class="text-3xl font-bold text-amber-300" id="stat-roles">0</p>
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Roles</p>
              </div>
              <div class={`${ui.panel} p-4 text-center`}>
                <p class="text-3xl font-bold text-amber-300" id="stat-mechanics">0</p>
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Mecánicas</p>
              </div>
            </div>

            <!-- Mi personaje registrado (registry.player) + Hermandades del registro (registry.*.guild) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4">
                <h4 class={ui.subTitle}>Mi personaje registrado</h4>
                <div id="viewer-player" class="mt-2"></div>
              </div>
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4">
                <h4 class={ui.subTitle}>Hermandades en el registro <span class="text-gray-500 text-xs font-normal">(cifras)</span></h4>
                <div id="viewer-guilds" class="mt-2 space-y-2"></div>
              </div>
            </div>

            <!-- Personajes de la cuenta (config compartida) -->
            <div>
              <h4 class={ui.subTitle}>Personajes de la cuenta <span id="cnt-account-chars" class="text-gray-500"></span></h4>
              <div id="viewer-account-chars" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Registros por personaje (registry["Nombre-Reino"]) -->
            <details id="registries-details" class="group">
              <summary class="cursor-pointer select-none list-none inline-flex items-center gap-1.5 rounded-lg px-1 -mx-1 py-0.5 text-xs font-black uppercase tracking-widest text-amber-300/80 hover:text-amber-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
                <svg aria-hidden="true" class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                Registros por personaje (<span id="cnt-registries">0</span>)
              </summary>
              <div id="viewer-registries" class="mt-3 space-y-2"></div>
            </details>

            <!-- Submenús activos -->
            <div>
              <h4 class={ui.subTitle}>Submenús activos en tu addon</h4>
              <div id="addon-menus" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Listas configurables (orden real del addon) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4"><h4 class={ui.subTitle}>Habilidades <span id="cnt-abilities" class="text-gray-500"></span></h4><div id="list-abilities" class="space-y-1"></div></div>
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4"><h4 class={ui.subTitle}>Roles <span id="cnt-roles" class="text-gray-500"></span></h4><div id="list-roles" class="space-y-1"></div></div>
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4"><h4 class={ui.subTitle}>Bendiciones <span id="cnt-buffs" class="text-gray-500"></span></h4><div id="list-buffs" class="space-y-1"></div></div>
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4"><h4 class={ui.subTitle}>Auras <span id="cnt-auras" class="text-gray-500"></span></h4><div id="list-auras" class="space-y-1"></div></div>
            </div>

            <!-- Mecánicas -->
            <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4">
              <h4 class={ui.subTitle}>Mecánicas <span id="cnt-mechanics" class="text-gray-500"></span></h4>
              <div id="list-mechanics"></div>
            </div>

            <!-- Reglas completas (sin corte) -->
            <div class="bg-gray-800/50 border border-amber-700/30 rounded-lg p-4">
              <h4 class={ui.subTitle}>Reglas de banda <span id="cnt-rules" class="text-gray-500"></span></h4>
              <div id="list-rules"></div>
            </div>

            <!-- Bandas -->
            <div>
              <h4 class={ui.subTitle}>Bandas</h4>
              <div id="viewer-bands" class="space-y-4"></div>
            </div>

            <!-- Asignaciones (mapa nombre → jugador) -->
            <div>
              <h4 class={ui.subTitle}>Asignaciones</h4>
              <div id="viewer-assignments" class="space-y-2"></div>
            </div>

            <!-- General / chat / registro -->
            <div>
              <h4 class={ui.subTitle}>General</h4>
              <div id="addon-general" class="flex flex-wrap gap-2"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Mi Hermandad ────────────────────────────────────────────────── -->
      <section id="panel-hermandad" role="tabpanel" aria-labelledby="tab-hermandad" class="hidden space-y-6">
        <!-- Sin hermandad aún: solo vía SV (registry.guild.isGM) -->
          <div id="guild-empty" class={`${ui.panel} p-8 max-w-2xl mx-auto`}>
          <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <p class="font-bold text-white text-center mb-1">Tu hermandad nace de tu SavedVariables</p>
          <p class="text-sm text-gray-400 text-center mb-6">Sin formularios: los datos provienen del addon y cada re-upload los mantiene actualizados.</p>
          <ol class="space-y-3 mb-7 text-sm text-gray-300 list-none">
            <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center">1</span><span>Sube un SavedVariables donde el addon te reporte como Maestro (<code class="text-amber-300">registry.guild.isGM</code>) con más de dos personajes registrados.</span></li>
            <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center">2</span><span>Reclama la hermandad desde Mi Registro: tu rol de Maestro se asigna verificado por el addon.</span></li>
            <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center">3</span><span>Publica el portal y comparte su dirección con tu comunidad.</span></li>
          </ol>
          <div class="text-center">
            <a href="/upload" class={ctaVacio}>Subir SavedVariables</a>
          </div>
        </div>

        <!-- Gestión multi-hermandad -->
        <div id="guild-manage" class="hidden space-y-6">
          <div class={`${ui.panel} p-6`}>
            <h2 class="text-lg font-bold text-amber-200 flex items-center mb-4">
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
              Tus hermandades
            </h2>
            <p class="text-[11px] text-gray-500 italic">Si eres maestro de varias hermandades, cada una tiene su ficha, portal y roster.</p>
          </div>
          <div id="guild-cards" class="space-y-6"></div>
        </div>
      </section>

      <!-- ── Mi Perfil (datos + personajes + seguridad) ──────────────────── -->
      <section id="panel-perfil" role="tabpanel" aria-labelledby="tab-perfil" class="hidden space-y-6">
        <!-- Datos del perfil -->
        <div class={`${ui.panel} p-6`}>
          <h2 class="text-lg font-bold text-amber-200 mb-5 flex items-center">
            <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
            Datos del perfil
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="display-name" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Nombre visible</label>
              <input type="text" id="display-name" maxlength="40" placeholder="Tu nombre en el portal"
                class="w-full px-3 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600" />
            </div>
            <div>
              <label for="character-main" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Personaje principal</label>
              <div class="relative">
                <select id="character-main" disabled
                  class="w-full appearance-none cursor-pointer pl-3 pr-10 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 hover:border-gray-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 focus-visible:outline-none outline-none text-gray-100 text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed"></select>
                <svg aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
              <p id="character-main-hint" class="text-[11px] text-gray-500 mt-1.5 italic">Solo puedes elegir entre los personajes detectados en tu SavedVariables.</p>
            </div>
          </div>

          <label for="profile-public" class="mt-6 flex items-start gap-3 cursor-pointer select-none border border-gray-700/60 hover:border-amber-600/40 rounded-lg p-4 transition-colors">
            <input type="checkbox" id="profile-public" class="mt-0.5 w-4 h-4 accent-amber-500" />
            <span class="text-sm text-gray-300 font-medium">Perfil y datos públicos
              <span class="block text-xs text-gray-500 italic mt-0.5">Al activarlo, tu perfil de jugador será visible públicamente para la comunidad.</span>
            </span>
          </label>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button id="save-profile"
              class="px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:pointer-events-none">
              Guardar cambios
            </button>
            <a id="public-profile-link" href="#" target="_blank" rel="noopener" class="hidden px-4 py-2 rounded-lg border border-emerald-600/40 bg-emerald-950/30 text-emerald-300 hover:bg-emerald-900/40 transition-all text-xs font-black uppercase tracking-widest">Ver perfil público →</a>
          </div>
          <p id="profile-msg" class="hidden mt-3 text-sm rounded-lg px-4 py-2.5" role="status"></p>
        </div>

        <!-- Mis personajes -->
        <div class={`${ui.panel} p-6`}>
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <h2 class="text-lg font-bold text-amber-200 flex items-center">
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
              Mis personajes
            </h2>
            <span class="text-[11px] text-gray-500 italic hidden sm:inline">Los cambios de visibilidad se guardan al instante</span>
          </div>
          <p id="characters-onboarding" class="hidden mb-4 text-xs text-amber-100/90 bg-amber-950/30 border-l-2 border-amber-500/60 px-4 py-3 rounded-lg"></p>
          <div id="characters-list" class="space-y-4"></div>
          <p id="characters-status" class="text-sm text-gray-400"></p>
        </div>

        <!-- Seguridad -->
        <div class={`${ui.panel} p-6`}>
          <h2 class="text-lg font-bold text-amber-200 mb-5 flex items-center">
            <span class="w-2 h-2 rounded-full bg-red-500 mr-3 shadow-[0_0_8px_rgba(239,68,68,0.4)]"></span>
            Seguridad
          </h2>
          <div class="space-y-4">
            <div>
              <label for="new-password" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Nueva contraseña</label>
              <input type="password" id="new-password" autocomplete="new-password" minlength="8"
                class="w-full px-3 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm" />
              <p class="text-[11px] text-gray-500 mt-1.5 italic">Mínimo 8 caracteres, con al menos una letra y un número.</p>
            </div>
            <div>
              <label for="new-password-confirm" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Confirmar nueva contraseña</label>
              <input type="password" id="new-password-confirm" autocomplete="new-password"
                class="w-full px-3 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm" />
            </div>
            <button id="save-password"
              class="px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:pointer-events-none">
              Actualizar contraseña
            </button>
            <p id="password-msg" class="hidden text-sm rounded-lg px-4 py-2.5" role="status"></p>
          </div>

          <div class="border-t border-gray-700/50 mt-6 pt-5 flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-base font-bold text-red-300">Sesión</h3>
              <p class="text-xs text-gray-500">Cierra sesión en este dispositivo.</p>
            </div>
            <button id="logout-btn"
              class="px-6 py-2.5 rounded-lg border border-red-700/50 text-red-300 hover:bg-red-950/40 hover:text-red-200 text-xs font-black uppercase tracking-widest transition-all duration-300">
              Cerrar sesión
            </button>
          </div>
        </div>

        <!-- Zona de peligro (acciones destructivas) -->
        <div class={`${ui.panel} p-6`}>
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <h2 class="text-lg font-bold text-red-300 flex items-center">
              <span class="w-2 h-2 rounded-full bg-red-500 mr-3 shadow-[0_0_8px_rgba(239,68,68,0.4)]"></span>
              Zona de peligro
            </h2>
            <span class="text-[11px] text-gray-500 italic hidden sm:inline">Acciones destructivas</span>
          </div>

          <!-- Resetear datos (moderado: conserva la cuenta) -->
          <div class="border border-amber-800/40 bg-amber-950/10 rounded-lg p-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="max-w-md">
                <h3 class="text-base font-bold text-amber-300">Resetear datos del SV</h3>
                <p class="text-xs text-gray-500 mt-1">Borra tu historial de uploads, los personajes detectados y, si la tienes, tu hermandad con su portal. Tu rol vuelve a <strong class="text-amber-300">visitante</strong> (salvo staff) y podrás re-subir tu SavedVariables para empezar desde cero. Tu cuenta, nombre visible y datos en otras apps del ecosistema se conservan.</p>
              </div>
              <button id="reset-data-btn"
                class="px-6 py-2.5 rounded-lg border border-amber-700/50 text-amber-300 hover:bg-amber-950/40 hover:text-amber-200 text-xs font-black uppercase tracking-widest transition-all duration-300">
                Resetear mis datos
              </button>
            </div>

            <div id="reset-data-confirm" class="hidden mt-4 border border-amber-800/50 bg-amber-950/20 rounded-lg p-5">
              <p class="text-sm text-amber-100 mb-3">Esto borrará permanentemente tu historial de SV, personajes y hermandad. Escribe <span class="font-black uppercase">RESETEAR</span> para confirmar.</p>
              <div class="flex flex-wrap items-center gap-3">
                <input type="text" id="reset-data-input" autocomplete="off" placeholder="RESETEAR"
                  class="w-full sm:w-56 px-3 py-2.5 rounded-lg bg-gray-900/70 border border-amber-900/60 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm uppercase placeholder:normal-case" />
                <button id="reset-data-confirm-btn" disabled
                  class="px-6 py-2.5 rounded-lg bg-amber-800/60 hover:bg-amber-700/70 text-amber-100 text-xs font-black uppercase tracking-widest transition-all duration-300 disabled:opacity-50 disabled:pointer-events-none">
                  Confirmar reseteo
                </button>
                <button id="reset-data-cancel"
                  class="px-4 py-2.5 rounded-lg border border-gray-700 text-gray-400 hover:text-gray-200 text-xs font-black uppercase tracking-widest transition-all duration-300">
                  Cancelar
                </button>
              </div>
              <p id="reset-data-msg" class="hidden mt-3 text-sm rounded-lg px-4 py-2.5" role="status"></p>
            </div>
          </div>

          <!-- Eliminar cuenta (severo) -->
          <div class="border border-red-800/40 bg-red-950/10 rounded-lg p-5 mt-4">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="max-w-md">
                <h3 class="text-base font-bold text-red-400">Eliminar cuenta</h3>
                <p class="text-xs text-gray-500 mt-1">Borra permanentemente tu perfil, personajes, uploads y hermandades de RaidDominion. Tu cuenta de usuario y tus datos en otras apps del ecosistema se conservan.</p>
              </div>
              <button id="delete-account-btn"
                class="px-6 py-2.5 rounded-lg border border-red-700/50 text-red-300 hover:bg-red-950/40 hover:text-red-200 text-xs font-black uppercase tracking-widest transition-all duration-300">
                Eliminar mi cuenta
              </button>
            </div>

            <div id="delete-account-confirm" class="hidden mt-4 border border-red-800/50 bg-red-950/20 rounded-lg p-5">
              <p class="text-sm text-red-200 mb-3">Esto borrará permanentemente todos tus datos de RaidDominion. Escribe <span class="font-black uppercase">ELIMINAR</span> para confirmar.</p>
              <div class="flex flex-wrap items-center gap-3">
                <input type="text" id="delete-account-input" autocomplete="off" placeholder="ELIMINAR"
                  class="w-full sm:w-56 px-3 py-2.5 rounded-lg bg-gray-900/70 border border-red-900/60 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 outline-none text-gray-100 text-sm uppercase placeholder:normal-case" />
                <button id="delete-account-confirm-btn" disabled
                  class="px-6 py-2.5 rounded-lg bg-red-900/60 hover:bg-red-700/70 text-red-100 text-xs font-black uppercase tracking-widest transition-all duration-300 disabled:opacity-50 disabled:pointer-events-none">
                  Confirmar eliminación
                </button>
                <button id="delete-account-cancel"
                  class="px-4 py-2.5 rounded-lg border border-gray-700 text-gray-400 hover:text-gray-200 text-xs font-black uppercase tracking-widest transition-all duration-300">
                  Cancelar
                </button>
              </div>
              <p id="delete-account-msg" class="hidden mt-3 text-sm rounded-lg px-4 py-2.5" role="status"></p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '@/lib/supabase';
  import {
    listMyUploads,
    getUpload,
    getMyProfile,
    updateMyProfile,
    getMyGuilds,
    getGuildSnapshot,
    ensureMyProfileSlug,
    getMyCharacters,
    setCharacterVisibility,
    claimGuildFromSV,
    deleteMyAccount,
    resetMyData,
  } from '@/lib/api';
  import type { UploadSummary, CharacterRow } from '@/lib/api';
  import { renderBand, renderRoster, el } from '@/lib/ui/preview';
  import { isStaff } from '@/lib/roles';
  import type { ParsedSavedVariables, ConfigListItem, ContentItem, Assignments, GuildMember, RegistryGuild } from '@/types/parser';
  import type { RaiddominionRole, GuildRow } from '@/types/database';

  const PANELS = ['resumen', 'addon', 'hermandad', 'perfil'] as const;
  type PanelName = (typeof PANELS)[number];

  const emailEl = document.getElementById('user-email') as HTMLElement;
  const avatarEl = document.getElementById('avatar') as HTMLElement;
  const badgeEl = document.getElementById('role-badge') as HTMLElement;

  const ROLE_LABELS: Record<RaiddominionRole, string> = {
    visitante: 'Visitante',
    member: 'Miembro',
    guild_master: 'Maestro de Hermandad',
    moderator: 'Moderador',
    admin: 'Administrador',
  };
  const ROLE_STYLES: Record<RaiddominionRole, string> = {
    visitante: 'bg-stone-800/70 border-stone-600 text-stone-300',
    member: 'bg-gray-800/70 border-gray-600 text-gray-300',
    guild_master: 'bg-amber-900/40 border-amber-500/60 text-amber-200',
    moderator: 'bg-sky-900/30 border-sky-600/50 text-sky-200',
    admin: 'bg-red-900/30 border-red-600/50 text-red-200',
  };

  function msgBox(id: string, ok: boolean, text: string): void {
    const box = document.getElementById(id) as HTMLElement;
    box.textContent = text;
    box.className = `mt-3 text-sm rounded-lg px-4 py-2.5 ${ok ? 'bg-emerald-950/30 border border-emerald-600/40 text-emerald-300' : 'bg-red-950/40 border border-red-600/40 text-red-300'}`;
  }

  function visibilityHtml(isPublic: boolean | null | undefined): string {
    return isPublic ? '<span class="text-emerald-300">Público</span>' : '<span class="text-gray-400">Privado</span>';
  }

  // Muestra u oculta el enlace al perfil público con un slug conocido o generándolo
  async function syncPublicLink(isPublic: boolean | null | undefined, knownSlug?: string): Promise<void> {
    const link = document.getElementById('public-profile-link') as HTMLAnchorElement;
    if (!isPublic) {
      link.classList.add('hidden');
      return;
    }
    let slug = knownSlug;
    if (!slug) {
      const res = await ensureMyProfileSlug();
      if (res.ok && res.slug) slug = res.slug;
    }
    if (slug) {
      link.href = `/p/${slug}`;
      link.classList.remove('hidden');
    }
  }

  // ── Sesión ───────────────────────────────────────────────────────────────
  const { data: sessionData } = await supabase.auth.getSession();
  if (!sessionData.session?.user) {
    window.location.replace('/login?next=%2Fdashboard');
  } else {
    const email = sessionData.session.user.email ?? '';
    emailEl.textContent = email;
    avatarEl.textContent = (email[0] ?? '?').toUpperCase();

    void loadProfile();
    void loadCharacters();
    void loadHistory();
    void loadGuilds();
  }

  // ── Pestañas ─────────────────────────────────────────────────────────────
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  tabs.forEach((btn) => btn.addEventListener('click', () => activateTab((btn.dataset.tab ?? 'resumen') as PanelName)));
  document.querySelectorAll<HTMLButtonElement>('.goto-btn').forEach((b) =>
    b.addEventListener('click', () => activateTab((b.dataset.goto ?? 'resumen') as PanelName)));

  function activateTab(name: PanelName): void {
    tabs.forEach((b) => {
      const active = b.dataset.tab === name;
      b.setAttribute('aria-selected', String(active));
      b.tabIndex = active ? 0 : -1;
      b.classList.toggle('border-amber-400', active);
      b.classList.toggle('text-amber-200', active);
      b.classList.toggle('border-transparent', !active);
      b.classList.toggle('text-gray-500', !active);
    });
    PANELS.forEach((p) => {
      document.getElementById(`panel-${p}`)?.classList.toggle('hidden', p !== name);
    });
  }

  // Patrón ARIA tabs: ←/→ mueven foco (con activación), Home/End saltan a los extremos
  document.querySelector('nav[role="tablist"]')?.addEventListener('keydown', (e) => {
    const ev = e as KeyboardEvent;
    const idx = tabs.indexOf(ev.target as HTMLButtonElement);
    if (idx === -1) return;
    let next: number | null = null;
    if (ev.key === 'ArrowRight') next = (idx + 1) % tabs.length;
    else if (ev.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
    else if (ev.key === 'Home') next = 0;
    else if (ev.key === 'End') next = tabs.length - 1;
    if (next === null) return;
    ev.preventDefault();
    const target = tabs[next];
    target.focus();
    activateTab((target.dataset.tab ?? 'resumen') as PanelName);
  });

  // ── Perfil ───────────────────────────────────────────────────────────────
  let currentRole: RaiddominionRole = 'member';
  let myCharacters: CharacterRow[] = [];
  let profileCharacterName: string | null = null;

  // Rellena el <select> del personaje principal SOLO con personajes del SV
  function populateMainCharacterSelect(): void {
    const sel = document.getElementById('character-main') as HTMLSelectElement;
    const hint = document.getElementById('character-main-hint') as HTMLElement;
    sel.innerHTML = '';
    myCharacters.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.realm ? `${c.name} · ${c.realm}` : c.name;
      sel.appendChild(opt);
    });
    if (myCharacters.length === 0) {
      sel.disabled = true;
      hint.textContent = 'Sube tu SavedVariables para detectar tus personajes y elegir tu principal.';
      return;
    }
    sel.disabled = false;
    hint.textContent = 'Solo puedes elegir entre los personajes detectados en tus SavedVariables.';
    syncMainCharacterSelect();
  }

  // Preselecciona el personaje guardado en el perfil; si no coincide, el más reciente
  function syncMainCharacterSelect(): void {
    const sel = document.getElementById('character-main') as HTMLSelectElement;
    if (myCharacters.length === 0) return;
    const match = profileCharacterName
      ? myCharacters.find((c) => c.name.toUpperCase() === profileCharacterName!.toUpperCase())
      : undefined;
    sel.value = match ? match.id : (myCharacters[0]?.id ?? '');
  }

  async function loadProfile(): Promise<void> {
    const nameInput = document.getElementById('display-name') as HTMLInputElement;
    const publicToggle = document.getElementById('profile-public') as HTMLInputElement;
    const kpiVis = document.getElementById('kpi-visibility') as HTMLElement;

    const res = await getMyProfile();
    if (!res.ok || !res.profile) {
      badgeEl.textContent = 'Visitante';
      return;
    }
    const p = res.profile;
    currentRole = p.role;
    badgeEl.textContent = ROLE_LABELS[p.role] ?? p.role;
    badgeEl.className = `px-3 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-widest border ${ROLE_STYLES[p.role] ?? ROLE_STYLES.member}`;

    if (p.display_name) {
      nameInput.value = p.display_name;
      avatarEl.textContent = p.display_name[0].toUpperCase();
    }
    profileCharacterName = p.character_name;
    syncMainCharacterSelect();
    publicToggle.checked = p.is_public === true;
    kpiVis.innerHTML = visibilityHtml(p.is_public);

    await syncPublicLink(p.is_public, p.slug ?? undefined);

    // La pestaña de hermandad está abierta a todos (los pasos guían el reclamo);
    // el acceso rápido del Resumen solo para quienes ya gestionan una.
    if (p.role === 'guild_master' || p.role === 'moderator' || p.role === 'admin') {
      document.getElementById('quick-guild')?.classList.remove('hidden');
    }
    if (isStaff(p.role)) {
      document.getElementById('quick-moderate')?.classList.remove('hidden');
    }
    if (p.role === 'admin') {
      document.getElementById('quick-admin')?.classList.remove('hidden');
    }
  }

  // La visibilidad pública se persiste al instante (no requiere Guardar)
  document.getElementById('profile-public')?.addEventListener('change', async (e) => {
    const box = e.target as HTMLInputElement;
    box.disabled = true;
    const res = await updateMyProfile({ is_public: box.checked });
    box.disabled = false;
    const kpiVis = document.getElementById('kpi-visibility') as HTMLElement;
    if (!res.ok) {
      box.checked = !box.checked;
      msgBox('profile-msg', false, 'No se pudo cambiar la visibilidad: ' + (res.error || ''));
      return;
    }
    kpiVis.innerHTML = visibilityHtml(box.checked);
    await syncPublicLink(box.checked);
    msgBox('profile-msg', true, box.checked ? 'Perfil público activado.' : 'Perfil privado.');
  });

  document.getElementById('save-profile')?.addEventListener('click', async () => {
    const btn = document.getElementById('save-profile') as HTMLButtonElement;
    const nameInput = document.getElementById('display-name') as HTMLInputElement;
    const publicToggle = document.getElementById('profile-public') as HTMLInputElement;
    const kpiVis = document.getElementById('kpi-visibility') as HTMLElement;
    const charSel = document.getElementById('character-main') as HTMLSelectElement;
    const selectedChar = myCharacters.find((c) => c.id === charSel.value);

    btn.disabled = true; btn.textContent = 'Guardando…';
    const res = await updateMyProfile({
      display_name: nameInput.value.trim() || undefined,
      character_name: selectedChar?.name,
      is_public: publicToggle.checked,
    });
    btn.disabled = false; btn.textContent = 'Guardar cambios';

    if (res.ok) {
      profileCharacterName = selectedChar?.name ?? null;
      const nameSource = nameInput.value.trim() || selectedChar?.name || '';
      if (nameSource) avatarEl.textContent = nameSource[0].toUpperCase();
      kpiVis.innerHTML = visibilityHtml(publicToggle.checked);
      await syncPublicLink(publicToggle.checked);
      msgBox('profile-msg', true, publicToggle.checked
        ? 'Cambios guardados. Tu perfil es público.'
        : 'Cambios guardados. Tu perfil es privado.');
    } else {
      msgBox('profile-msg', false, 'No se pudo guardar: ' + (res.error || ''));
    }
  });

  // ── Mis Personajes ───────────────────────────────────────────────────────
  async function loadCharacters(): Promise<void> {
    const listEl = document.getElementById('characters-list') as HTMLElement;
    const statusEl = document.getElementById('characters-status') as HTMLElement;
    const onboardingEl = document.getElementById('characters-onboarding') as HTMLElement;

    const res = await getMyCharacters();
    if (!res.ok) {
      statusEl.textContent = 'No se pudieron cargar tus personajes.';
      return;
    }
    const items = res.items ?? [];
    myCharacters = items;
    populateMainCharacterSelect();
    listEl.innerHTML = '';
    statusEl.classList.toggle('hidden', items.length > 0);
    if (items.length === 0) {
      statusEl.innerHTML = 'Aún no registras personajes. Sube tu SavedVariables desde el addon y aparecerán aquí. <a href="/upload" class="text-amber-300 underline hover:text-amber-200">Subir ahora →</a>';
      return;
    }

    // La promoción a Miembro no requiere que otro usuario suba un roster:
    // un SV con maestría de hermandad + más de dos personajes la dispara sola.
    onboardingEl.classList.add('hidden');

    items.forEach((c) => listEl.appendChild(characterCard(c)));
  }

  function characterCard(c: CharacterRow): HTMLElement {
    const card = document.createElement('div');
    card.className = 'bg-gray-800/50 border border-amber-700/40 rounded-lg p-4';

    const header = document.createElement('div');
    header.className = 'flex flex-wrap items-center justify-between gap-3';
    const info = document.createElement('div');
    const title = document.createElement('p');
    title.className = 'text-sm font-bold text-white';
    title.textContent = `${c.name}${c.realm ? '-' + c.realm : ''}`;
    const chips = document.createElement('div');
    chips.className = 'flex flex-wrap gap-2 mt-1.5';
    const chipCls = 'text-[10px] font-black uppercase tracking-widest text-gray-400 bg-gray-900/60 border border-amber-600/30 rounded-lg px-2.5 py-1';
    if (c.class) chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls, textContent: c.class }));
    if (c.race) chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls, textContent: c.race }));
    if (typeof c.level === 'number') chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls, textContent: `Nivel ${c.level}` }));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) {
      chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls + ' !text-amber-300 !border-amber-500/40', textContent: `ilvl ${c.avg_ilvl}` }));
    }
    if (c.member_verified) {
      chips.appendChild(Object.assign(document.createElement('span'), { className: 'text-[10px] font-black uppercase tracking-widest text-emerald-300 bg-emerald-950/30 border border-emerald-600/40 rounded-lg px-2.5 py-1', textContent: '✓ Validado' }));
    }
    if (c.sv_guild_name) {
      chips.appendChild(Object.assign(document.createElement('span'), { className: 'text-[10px] font-black uppercase tracking-widest ' + (c.sv_is_gm ? 'text-amber-300 bg-amber-950/30 border border-amber-500/40' : 'text-sky-200 bg-gray-900/60 border border-sky-600/30') + ' rounded-lg px-2.5 py-1', textContent: c.sv_is_gm ? `★ ${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}` }));
    }
    info.append(title, chips);
    header.appendChild(info);

    const visLabel = document.createElement('label');
    visLabel.className = 'flex items-center gap-2 cursor-pointer select-none text-xs text-gray-400';
    const visCheck = document.createElement('input');
    visCheck.type = 'checkbox';
    visCheck.checked = c.is_public;
    visCheck.className = 'w-4 h-4 accent-amber-500';
    const visStatus = document.createElement('span');
    visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest';
    visCheck.addEventListener('change', async () => {
      visCheck.disabled = true;
      visStatus.textContent = '· guardando…';
      visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-amber-300';
      const res = await setCharacterVisibility(c.id, visCheck.checked);
      visCheck.disabled = false;
      if (res.ok) {
        visStatus.textContent = '✓ guardado';
        visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-emerald-400';
      } else {
        visCheck.checked = !visCheck.checked;
        visStatus.textContent = '✗ error';
        visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-red-400';
      }
      window.setTimeout(() => { visStatus.textContent = ''; }, 2500);
    });
    visLabel.append(visCheck, document.createTextNode('Público'), visStatus);
    header.appendChild(visLabel);
    card.appendChild(header);

    if ((c.equipment ?? []).length > 0) {
      const details = document.createElement('details');
      details.className = 'mt-3';
      const summary = document.createElement('summary');
      summary.className = 'text-xs text-amber-300/80 cursor-pointer hover:text-amber-200';
      summary.textContent = `Equipamiento (${c.equipment.length} piezas)`;
      const grid = document.createElement('div');
      grid.className = 'grid grid-cols-1 sm:grid-cols-2 gap-1 mt-2';
      c.equipment.forEach((piece) => {
        const row = document.createElement('div');
        row.className = 'text-xs text-gray-300 flex justify-between gap-3 bg-gray-900/40 rounded px-2 py-1';
        const nm = document.createElement('span'); nm.textContent = piece.name;
        const st = document.createElement('span'); st.className = 'text-gray-500 whitespace-nowrap'; st.textContent = `i${piece.ilvl} · q${piece.quality}`;
        row.append(nm, st);
        grid.appendChild(row);
      });
      details.append(summary, grid);
      card.appendChild(details);
    }
    return card;
  }

  // ── Mi Registro: historial + visor del snapshot seleccionado ────────────
  let uploadsCache: UploadSummary[] = [];
  let currentSvId = '';
  let lastLeads = false;
  // Hermandades con isGM en el snapshot mostrado (puede haber varias)
  let snapshotGmGuilds: string[] = [];
  // Hermandades reclamadas por el usuario (multi-hermandad)
  let myGuilds: GuildRow[] = [];

  function fmtDateTime(iso: string): string {
    return new Date(iso).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' });
  }

  function svLabel(item: UploadSummary): string {
    const who = item.generatedBy ? ` · ${item.generatedBy}` : '';
    return `${fmtDateTime(item.parsedAt)}${who}`;
  }

  function showAddonEmpty(note?: string): void {
    document.getElementById('addon-empty')?.classList.remove('hidden');
    document.getElementById('addon-main')?.classList.add('hidden');
    const noteEl = document.getElementById('addon-empty-note') as HTMLElement;
    if (note) {
      noteEl.textContent = note;
      noteEl.classList.remove('hidden');
    } else {
      noteEl.classList.add('hidden');
    }
  }

  async function loadHistory(): Promise<void> {
    const kpiUp = document.getElementById('kpi-uploads') as HTMLElement;
    const kpiLast = document.getElementById('kpi-last') as HTMLElement;
    const select = document.getElementById('sv-select') as HTMLSelectElement;
    const listEl = document.getElementById('history-list') as HTMLElement;
    const countEl = document.getElementById('sv-history-count') as HTMLElement;

    const res = await listMyUploads();
    if (!res.ok) {
      kpiUp.textContent = '—';
      showAddonEmpty('No se pudo cargar tu historial de análisis.');
      return;
    }
    const items = res.items ?? [];
    uploadsCache = items;
    kpiUp.textContent = String(items.length);
    kpiLast.textContent = items.length > 0 ? fmtDateTime(items[0].parsedAt) : 'Sin uploads aún';

    if (items.length === 0) {
      showAddonEmpty();
      return;
    }

    // Con análisis disponibles: muestra el visor y oculta el estado vacío
    document.getElementById('addon-empty')?.classList.add('hidden');
    document.getElementById('addon-main')?.classList.remove('hidden');

    select.innerHTML = '';
    items.forEach((item) => {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = svLabel(item);
      select.appendChild(opt);
    });
    select.value = items[0].id;

    countEl.textContent = String(items.length);
    listEl.innerHTML = '';
    items.forEach((item) => listEl.appendChild(historyItem(item)));

    const first = items[0];
    if (first) void renderSnapshot(first.id);
  }

  function historyItem(item: UploadSummary): HTMLElement {
    const li = document.createElement('li');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.dataset.svId = item.id;
    btn.className = 'w-full text-left bg-gray-800/50 hover:bg-gray-700/50 border border-amber-700/40 hover:border-amber-500/60 rounded-lg px-4 py-3 transition-colors';
    btn.appendChild(el('p', 'text-sm font-bold text-white', svLabel(item)));
    btn.appendChild(el('p', 'text-xs text-gray-400 mt-0.5', `${item.members} miembros · ${item.bands} bandas`));
    btn.addEventListener('click', () => {
      const select = document.getElementById('sv-select') as HTMLSelectElement;
      select.value = item.id;
      void renderSnapshot(item.id);
    });
    li.appendChild(btn);
    return li;
  }

  // Resalta el análisis activo dentro de "Análisis anteriores"
  function highlightHistory(id: string): void {
    document.querySelectorAll<HTMLButtonElement>('#history-list [data-sv-id]').forEach((b) => {
      const active = b.dataset.svId === id;
      b.classList.toggle('border-amber-400', active);
      b.classList.toggle('bg-amber-900/20', active);
    });
  }

  async function renderSnapshot(svId: string): Promise<void> {
    currentSvId = svId;
    const dateEl = document.getElementById('viewer-date') as HTMLElement;
    const res = await getUpload(svId);
    if (!res.ok || !res.item?.raw) {
      dateEl.textContent = '· no disponible';
      return;
    }
    const d = res.item.raw as ParsedSavedVariables;
    const item = uploadsCache.find((u) => u.id === svId);
    dateEl.textContent = item ? `· ${svLabel(item)}` : '';

    // Roster efectivo solo como CIFRA (el roster completo vive en Mi Hermandad):
    // memberList v3 (registry.*.guild.memberList) ∪ legacy, dedupe por nombre.
    const rosterNames = new Set<string>();
    const pushRoster = (m: GuildMember): void => {
      const key = m.name.trim().toLowerCase();
      if (!key || rosterNames.has(key)) return;
      rosterNames.add(key);
    };
    for (const reg of d.registries) {
      reg.guild?.memberList?.forEach((gm) => pushRoster({ name: gm.name, class: '', rank: '', publicNote: '', officerNote: '' }));
    }
    if (rosterNames.size === 0) d.guild.members.forEach((m) => pushRoster(m));

    // Stats (cifras)
    (document.getElementById('stat-guild-size') as HTMLElement).textContent = String(rosterNames.size);
    (document.getElementById('stat-bands') as HTMLElement).textContent = String(d.bands.length);
    (document.getElementById('stat-roles') as HTMLElement).textContent = String(d.roles.length);
    (document.getElementById('stat-mechanics') as HTMLElement).textContent = String(d.mechanics.length);

    // Mi personaje registrado + hermandades del registro (cifras)
    renderPlayerSnapshot(d);
    renderGuilds(d);

    // Personajes de la cuenta y registros por personaje
    renderAccountCharacters(d);
    renderRegistries(d);

    // Submenús activos (ui.show*Menu)
    const menusEl = document.getElementById('addon-menus') as HTMLElement;
    menusEl.innerHTML = '';
    const menuLabels: Record<string, string> = {
      showRolesMenu: 'Roles',
      showBuffsMenu: 'Bendiciones',
      showAbilitiesMenu: 'Habilidades',
      showAurasMenu: 'Auras',
      showMechanicsMenu: 'Mecánicas',
      showRulesMenu: 'Reglas',
      showBandsMenu: 'Bandas',
    };
    Object.entries(menuLabels).forEach(([key, label]) => {
      const active = d.menus?.[key] === true;
      menusEl.appendChild(configChip(active ? `✓ ${label}` : label, active));
    });

    // Listas configurables en el orden real del addon
    fillList('list-abilities', 'cnt-abilities', d.abilities);
    fillList('list-roles', 'cnt-roles', d.roles);
    fillList('list-buffs', 'cnt-buffs', d.buffs);
    fillList('list-auras', 'cnt-auras', d.auras);

    // Mecánicas y Reglas completas (sin recorte)
    renderContentList('list-mechanics', 'cnt-mechanics', d.mechanics);
    renderContentList('list-rules', 'cnt-rules', d.rules);

    // Bandas (con detalle de jugadores y spammer)
    const bandsEl = document.getElementById('viewer-bands') as HTMLElement;
    bandsEl.innerHTML = '';
    d.bands.forEach((b) => bandsEl.appendChild(renderBand(b)));

    // Asignaciones detalladas (mapa nombre → jugador)
    renderAssignments(d);

    // General / chat / metadatos del registro
    const genEl = document.getElementById('addon-general') as HTMLElement;
    genEl.innerHTML = '';
    if (d.chat.channel) genEl.appendChild(configChip(`Canal: ${d.chat.channel}`));
    if (d.chat.discordLink) {
      const a = document.createElement('a');
      a.href = /^https?:\/\//.test(d.chat.discordLink) ? d.chat.discordLink : '#';
      a.target = '_blank'; a.rel = 'noopener';
      a.className = 'text-[11px] text-sky-300 underline hover:text-sky-200';
      a.textContent = 'Discord de la comunidad →';
      genEl.appendChild(a);
    }
    if (d.version) genEl.appendChild(configChip(`Parser ${d.version}`));
    if (d.generatedBy) genEl.appendChild(configChip(`Generado por: ${d.generatedBy}`));
    if (typeof d.lastUpdate === 'number') {
      genEl.appendChild(configChip(`Última actualización: ${fmtDateTime(new Date(d.lastUpdate * 1000).toISOString())}`));
    }
    if (d.guild.leaderCandidate) genEl.appendChild(configChip(`Líder candidato: ${d.guild.leaderCandidate}`));
    const asgTotal = Object.values(d.assignments).reduce((acc, m) => acc + Object.keys(m).length, 0);
    genEl.appendChild(configChip(`Asignaciones totales: ${asgTotal}`));

    highlightHistory(svId);
    const leadsAnywhere = d.registryGuild?.isGM === true || d.guild.isLeaderRank ||
      d.registries.some((r) => r.guild?.isGM === true);
    updateClaimBanner(leadsAnywhere);
  }

  function configChip(text: string, highlight = false): HTMLElement {
    return el(
      'span',
      'inline-flex items-center gap-1.5 text-[11px] text-gray-300 bg-gray-900/60 border border-amber-600/30 rounded-lg px-2.5 py-1' + (highlight ? ' !border-amber-500/40' : ''),
      text,
    );
  }

  function fillList(listId: string, cntId: string, items: ConfigListItem[]): void {
    const wrap = document.getElementById(listId) as HTMLElement;
    const cnt = document.getElementById(cntId) as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = `(${items.length})`;
    if (items.length === 0) {
      wrap.innerHTML = '<span class="text-[11px] text-gray-600 italic">Sin elementos aún</span>';
      return;
    }
    items.forEach((it) => wrap.appendChild(configChip(it.name)));
  }

  function renderContentList(listId: string, cntId: string, items: ContentItem[]): void {
    const wrap = document.getElementById(listId) as HTMLElement;
    const cnt = document.getElementById(cntId) as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = `(${items.length})`;
    if (items.length === 0) {
      wrap.innerHTML = '<p class="text-[11px] text-gray-600 italic">Sin elementos aún</p>';
      return;
    }
    const list = document.createElement('ul');
    list.className = 'space-y-2';
    items.forEach((it) => {
      const li = el('li', 'flex items-start text-sm text-gray-300');
      li.appendChild(el('span', 'text-amber-600 mr-2 mt-0.5', '›'));
      const inner = el('div', '');
      inner.appendChild(el('p', 'font-bold text-white', it.title || 'Elemento'));
      if (it.content) inner.appendChild(el('p', 'text-gray-400 text-xs mt-0.5', it.content));
      li.appendChild(inner);
      list.appendChild(li);
    });
    wrap.appendChild(list);
  }

  // Mi personaje registrado (registry.player): datos + equipamiento
  function renderPlayerSnapshot(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-player') as HTMLElement;
    wrap.innerHTML = '';
    const p = d.player;
    if (!p) {
      wrap.appendChild(el('p', 'text-[11px] text-gray-600 italic', 'Sin registro de personaje propio (registry.player).'));
      return;
    }
    wrap.appendChild(el('p', 'text-sm font-bold text-white', `${p.name}${p.realm ? '-' + p.realm : ''}`));
    const chips = el('div', 'flex flex-wrap gap-2 mt-1.5');
    if (p.race) chips.appendChild(configChip(p.race));
    if (p.class) chips.appendChild(configChip(p.class));
    if (typeof p.level === 'number') chips.appendChild(configChip(`Nivel ${p.level}`));
    if (p.talentSpec) chips.appendChild(configChip(`Spec: ${p.talentSpec}`));
    if (typeof p.avgIlvl === 'number') chips.appendChild(configChip(`ilvl ${p.avgIlvl}`, true));
    wrap.appendChild(chips);
    if (p.equipment.length > 0) {
      const details = document.createElement('details');
      details.className = 'mt-2';
      const summary = document.createElement('summary');
      summary.className = 'text-xs text-amber-300/80 cursor-pointer hover:text-amber-200';
      summary.textContent = `Equipamiento (${p.equipment.length} piezas)`;
      const grid = el('div', 'grid grid-cols-1 sm:grid-cols-2 gap-1 mt-2');
      p.equipment.forEach((piece) => {
        const row = el('div', 'text-xs text-gray-300 flex justify-between gap-3 bg-gray-900/40 rounded px-2 py-1');
        row.appendChild(el('span', '', piece.name));
        row.appendChild(el('span', 'text-gray-500 whitespace-nowrap', `i${piece.ilvl} · q${piece.quality}`));
        grid.appendChild(row);
      });
      details.append(summary, grid);
      wrap.appendChild(details);
    }
  }

  // Hermandades del registro (registry.*.guild): CIFRAS, sin roster completo.
  // Un jugador puede tener personajes en varias hermandades y ser GM de varias.
  function renderGuilds(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-guilds') as HTMLElement;
    wrap.innerHTML = '';
    const guilds = new Map<string, {
      name: string;
      isGM: boolean;
      ranks: string[];
      numMembers: number | undefined;
      characters: string[];
    }>();
    const addGuild = (rg: RegistryGuild | null | undefined, charName?: string): void => {
      if (!rg?.name) return;
      const key = rg.name.trim().toLowerCase();
      const cur = guilds.get(key) ?? {
        name: rg.name, isGM: false, ranks: [], numMembers: undefined, characters: [],
      };
      if (rg.isGM) cur.isGM = true;
      if (rg.rank) cur.ranks.push(rg.rank);
      if (typeof rg.numMembers === 'number') cur.numMembers = rg.numMembers;
      if (charName) cur.characters.push(charName);
      guilds.set(key, cur);
    };
    addGuild(d.registryGuild, d.player?.name);
    d.registries.forEach((r) => addGuild(r.guild, r.player?.name));

    snapshotGmGuilds = Array.from(guilds.values()).filter((g) => g.isGM).map((g) => g.name);
    updateClaimBanner();

    if (guilds.size === 0) {
      wrap.appendChild(el('p', 'text-[11px] text-gray-600 italic', 'Sin hermandad en el registro.'));
      return;
    }
    Array.from(guilds.values()).forEach((g) => {
      const card = el('div', 'bg-gray-800/50 border border-amber-700/30 rounded-lg p-4');
      const head = el('div', 'flex flex-wrap items-center gap-2');
      head.appendChild(el('p', 'text-sm font-bold text-amber-200', g.name));
      if (g.isGM) head.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-amber-300 bg-amber-950/30 border border-amber-500/40 rounded-lg px-2.5 py-1', '★ Maestro'));
      card.appendChild(head);
      const meta = el('div', 'flex flex-wrap gap-2 mt-1.5');
      if (typeof g.numMembers === 'number') meta.appendChild(configChip(`${g.numMembers} miembros`));
      if (g.ranks.length > 0) meta.appendChild(configChip(`Rango: ${Array.from(new Set(g.ranks)).join(', ')}`));
      if (g.characters.length > 0) meta.appendChild(configChip(`${g.characters.length} personaje(s)`));
      card.appendChild(meta);
      if (g.characters.length > 0) {
        card.appendChild(el('p', 'text-[11px] text-gray-500 mt-1.5', `Personajes: ${g.characters.join(', ')}`));
      }
      wrap.appendChild(card);
    });
  }

  // Personajes de la cuenta (characters: config compartida del SV)
  function renderAccountCharacters(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-account-chars') as HTMLElement;
    const cnt = document.getElementById('cnt-account-chars') as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = `(${d.characters.length})`;
    if (d.characters.length === 0) {
      wrap.innerHTML = '<span class="text-[11px] text-gray-600 italic">Sin personajes de cuenta aún.</span>';
      return;
    }
    d.characters.forEach((c) => {
      const label = `${c.name}${c.realm ? '-' + c.realm : ''}`;
      wrap.appendChild(configChip(label));
    });
  }

  // Snapshots de registro por personaje (registry["Nombre-Reino"])
  function renderRegistries(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-registries') as HTMLElement;
    const cnt = document.getElementById('cnt-registries') as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = String(d.registries.length);
    if (d.registries.length === 0) {
      wrap.innerHTML = '<p class="text-[11px] text-gray-600 italic">Sin registros por personaje.</p>';
      return;
    }
    d.registries.forEach((reg) => {
      const card = el('div', 'bg-gray-800/50 border border-amber-700/30 rounded-lg p-4');
      const head = el('div', 'flex flex-wrap items-center gap-2');
      head.appendChild(el('p', 'text-sm font-bold text-white', reg.player?.name || reg.key || 'Personaje'));
      if (reg.player) {
        if (reg.player.class) head.appendChild(configChip(reg.player.class));
        if (typeof reg.player.level === 'number') head.appendChild(configChip(`Nivel ${reg.player.level}`));
        if (typeof reg.player.avgIlvl === 'number') head.appendChild(configChip(`ilvl ${reg.player.avgIlvl}`, true));
        if (reg.player.equipment.length > 0) head.appendChild(configChip(`${reg.player.equipment.length} piezas`));
      }
      if (reg.guild) head.appendChild(configChip(`${reg.guild.name}${reg.guild.isGM ? ' · GM' : ''}`));
      if (reg.savedAt) head.appendChild(el('span', 'text-[11px] text-gray-500 italic', reg.savedAt));
      card.appendChild(head);
      wrap.appendChild(card);
    });
  }

  // Asignaciones detalladas por categoría (nombre → jugador)
  function renderAssignments(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-assignments') as HTMLElement;
    wrap.innerHTML = '';
    const labels: Record<keyof Assignments, string> = {
      roles: 'Roles',
      buffs: 'Bendiciones',
      abilities: 'Habilidades',
      auras: 'Auras',
    };
    let any = false;
    (Object.keys(labels) as (keyof Assignments)[]).forEach((cat) => {
      const entries = Object.entries(d.assignments[cat]);
      if (entries.length === 0) return;
      any = true;
      const box = el('div', '');
      box.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1', labels[cat]));
      const rows = el('div', 'grid grid-cols-1 sm:grid-cols-2 gap-1');
      entries.forEach(([name, player]) => {
        const row = el('div', 'text-xs text-gray-300 flex justify-between gap-3 bg-gray-900/40 rounded px-2 py-1');
        row.appendChild(el('span', 'font-bold text-amber-200', name));
        row.appendChild(el('span', 'text-gray-400', player));
        rows.appendChild(row);
      });
      box.appendChild(rows);
      wrap.appendChild(box);
    });
    if (!any) {
      wrap.innerHTML = '<p class="text-[11px] text-gray-600 italic">Sin asignaciones aún.</p>';
    }
  }

  // Banner de reclamo: si el snapshot acredita liderazgo de alguna hermandad
  // que el usuario aún no ha reclamado (puede ser maestro de varias).
  function updateClaimBanner(leads: boolean | null = null): void {
    if (leads !== null) lastLeads = leads;
    const unclaimed = snapshotGmGuilds.filter((n) =>
      !myGuilds.some((g) => g.name.trim().toLowerCase() === n.trim().toLowerCase()));
    document.getElementById('claim-banner')?.classList.toggle('hidden', !(lastLeads && unclaimed.length > 0));
  }

  const claimBtn = document.getElementById('claim-btn') as HTMLButtonElement;
  claimBtn.addEventListener('click', async () => {
    if (!currentSvId) return;
    claimBtn.disabled = true; claimBtn.textContent = 'Reclamando…';
    const res = await claimGuildFromSV(currentSvId);
    claimBtn.disabled = false; claimBtn.textContent = 'Reclamar mis hermandades';
    if (res.ok) {
      msgBox('claim-msg', true, '¡Hermandad(es) reclamada(s)! Ya eres Maestro: publícalas desde Mi Hermandad.');
      updateClaimBanner(false);
      void loadGuilds();
      void loadProfile();
    } else {
      msgBox('claim-msg', false, 'No se pudo reclamar: ' + (res.error || 'inténtalo de nuevo.'));
    }
  });

  (document.getElementById('sv-select') as HTMLSelectElement).addEventListener('change', (e) => {
    const id = (e.target as HTMLSelectElement).value;
    if (id) void renderSnapshot(id);
  });

  // ── Mi Hermandad ─────────────────────────────────────────────────────────
  // ── Mi Hermandad (multi-hermandad) ───────────────────────────────────────

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;');
  }

  function setMsg(el: HTMLElement, ok: boolean, text: string): void {
    el.textContent = text;
    el.className = `mt-3 text-sm rounded-lg px-4 py-2.5 ${ok ? 'bg-emerald-950/30 border border-emerald-600/40 text-emerald-300' : 'bg-red-950/40 border border-red-600/40 text-red-300'}`;
  }

  function updateKpiGuild(): void {
    const kpiGuild = document.getElementById('kpi-guild') as HTMLElement;
    if (myGuilds.length === 0) {
      kpiGuild.innerHTML = '<span class="text-gray-500">Sin hermandad</span>';
      return;
    }
    if (myGuilds.length === 1) {
      const g = myGuilds[0];
      kpiGuild.innerHTML = g.is_public
        ? `<a href="/${g.slug}" class="text-emerald-300 hover:underline">${escapeHtml(g.name)}</a>`
        : `<span class="text-amber-200">${escapeHtml(g.name)}</span> <span class="text-gray-500">(privada)</span>`;
      return;
    }
    const pub = myGuilds.filter((g) => g.is_public);
    kpiGuild.innerHTML = `<span class="text-amber-200">${myGuilds.length} hermandades</span>${
      pub.length > 0 ? ' <a href="/guilds" class="text-emerald-300 hover:underline">ver directorio</a>' : ''
    }`;
  }

  // Carga el roster del portal desde el snapshot público de cada hermandad
  async function loadGuildRoster(g: GuildRow, card: HTMLElement): Promise<void> {
    const body = card.querySelector('.guild-roster-body') as HTMLElement | null;
    if (!body) return;
    const res = await getGuildSnapshot(g.id);
    if (!res.ok || !res.snapshot) {
      body.innerHTML = '<p class="text-sm text-gray-400 italic">Sin snapshot aún. Sube un SV con tu personaje maestro para publicar roster, bandas y reglas.</p>';
      return;
    }
    body.innerHTML = '';
    renderRoster(body, res.snapshot.members);
    const cifras = el('p', 'text-[11px] text-gray-500 italic mt-2', `Bandas: ${res.snapshot.bands.length} · Reglas: ${res.snapshot.rules.length}`);
    body.appendChild(cifras);
  }

  function renderGuildCard(g: GuildRow): HTMLElement {
    const card = el('div', 'bg-gray-900/60 backdrop-blur-sm border border-amber-600/30 rounded-lg p-6');

    // Cabecera: nombre + estado del claim
    const header = el('div', 'flex flex-wrap items-center justify-between gap-3 mb-5');
    const h2 = document.createElement('h2');
    h2.className = 'text-lg font-bold text-amber-200 flex items-center';
    h2.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>${escapeHtml(g.name)}`;
    header.appendChild(h2);
    const badge = document.createElement('span');
    badge.className = 'px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest border';
    const verified = g.claim_status === 'verified';
    badge.textContent = verified ? 'Verificada' : g.claim_status === 'rejected' ? 'Rechazada' : 'En revisión';
    badge.className += verified
      ? ' bg-emerald-950/30 border-emerald-600/40 text-emerald-300'
      : g.claim_status === 'rejected'
        ? ' bg-red-950/30 border-red-600/40 text-red-300'
        : ' bg-amber-950/30 border-amber-600/40 text-amber-300';
    header.appendChild(badge);
    card.appendChild(header);

    // Ficha (solo lectura; los datos vienen del SV)
    const ficha = el('div', 'space-y-3 bg-gray-800/40 border border-gray-700/50 rounded-lg p-4');
    const row = (label: string, value: string): HTMLElement => {
      const div = el('div', 'flex flex-wrap justify-between gap-2');
      div.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500', label));
      div.appendChild(el('span', 'text-sm text-gray-300', value));
      return div;
    };
    ficha.appendChild(row('Nombre', g.name));
    ficha.appendChild(row('Reino', g.realm || '—'));
    ficha.appendChild(row('Facción', g.faction === 'Horde' ? 'Horda' : g.faction === 'Alliance' ? 'Alianza' : '—'));
    const dRow = el('div', 'flex flex-wrap justify-between gap-2 items-center');
    dRow.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500', 'Discord'));
    if (g.discord_link) {
      const a = document.createElement('a');
      a.href = /^https?:\/\//.test(g.discord_link) ? g.discord_link : '#';
      a.target = '_blank'; a.rel = 'noopener';
      a.className = 'text-xs text-sky-300 underline hover:text-sky-200';
      a.textContent = 'Abrir enlace →';
      dRow.appendChild(a);
    } else {
      dRow.appendChild(el('span', 'text-sm text-gray-600 italic', '—'));
    }
    ficha.appendChild(dRow);
    ficha.appendChild(el('p', 'text-[11px] text-gray-500 border-t border-gray-700/50 pt-2 italic', 'Los datos provienen de tu SavedVariables; se actualizan con cada re-upload.'));
    card.appendChild(ficha);

    // Portal
    const url = `${window.location.origin}/${g.slug}`;
    const portal = el('div', 'mt-4');
    portal.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5', 'Dirección de tu portal'));
    const urlRow = el('div', 'flex flex-wrap items-center gap-2');
    const code = el('code', 'flex-1 min-w-[240px] px-3 py-2.5 rounded-lg bg-gray-950/70 border border-gray-700 text-amber-300 text-sm truncate', url);
    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'px-4 py-2.5 rounded-lg border border-amber-600/30 bg-gray-800/80 text-amber-200 hover:bg-amber-900/40 hover:text-white transition-all text-xs font-black uppercase tracking-widest';
    copyBtn.textContent = 'Copiar';
    const openLink = document.createElement('a');
    openLink.href = url; openLink.target = '_blank'; openLink.rel = 'noopener';
    openLink.className = 'hidden px-4 py-2.5 rounded-lg border border-emerald-600/40 bg-emerald-950/30 text-emerald-300 hover:bg-emerald-900/40 transition-all text-xs font-black uppercase tracking-widest';
    openLink.textContent = 'Ver portal →';
    urlRow.append(code, copyBtn, openLink);
    portal.appendChild(urlRow);

    const label = document.createElement('label');
    label.className = 'mt-5 flex items-start gap-3 cursor-pointer select-none border border-gray-700/60 hover:border-amber-600/40 rounded-lg p-4 transition-colors';
    const input = document.createElement('input');
    input.type = 'checkbox';
    input.className = 'mt-0.5 w-4 h-4 accent-amber-500';
    input.checked = g.is_public;
    const span = document.createElement('span');
    span.className = 'text-sm text-gray-300 font-medium';
    span.innerHTML = 'Publicar portal de la hermandad <span class="block text-xs text-gray-500 italic mt-0.5">Visible para toda la comunidad con roster, bandas y reglas de tu último análisis verificado.</span>';
    label.append(input, span);
    portal.appendChild(label);
    const msg = document.createElement('p');
    msg.className = 'hidden mt-3 text-sm rounded-lg px-4 py-2.5';
    msg.setAttribute('role', 'status');
    portal.appendChild(msg);
    card.appendChild(portal);

    // Roster (reservado aquí, NO en Mi Registro)
    const rosterSec = el('div', 'mt-4');
    rosterSec.appendChild(el('h4', 'text-xs font-black uppercase tracking-widest text-gray-400 mb-2', 'Roster de la hermandad'));
    const rosterBody = el('div', 'guild-roster-body overflow-x-auto');
    rosterBody.innerHTML = '<p class="text-sm text-gray-400 italic">Cargando roster…</p>';
    rosterSec.appendChild(rosterBody);
    card.appendChild(rosterSec);

    // Eventos
    input.addEventListener('change', async () => {
      input.disabled = true;
      const { error } = await supabase
        .from('raiddominion_guilds')
        .update({ is_public: input.checked })
        .eq('id', g.id);
      input.disabled = false;
      if (error) {
        input.checked = !input.checked;
        setMsg(msg, false, 'No se pudo cambiar la publicación del portal.');
        return;
      }
      openLink.classList.toggle('hidden', !input.checked);
      g.is_public = input.checked;
      setMsg(msg, true, input.checked ? 'Portal publicado: ya es visible en /' + g.slug : 'Portal oculto: solo tú puedes verlo.');
      updateKpiGuild();
    });
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        setMsg(msg, true, 'Enlace copiado al portapapeles.');
      } catch {
        setMsg(msg, false, 'No se pudo copiar automáticamente.');
      }
    });
    if (g.is_public) openLink.classList.remove('hidden');

    void loadGuildRoster(g, card);
    return card;
  }

  async function loadGuilds(): Promise<void> {
    const empty = document.getElementById('guild-empty') as HTMLElement;
    const manage = document.getElementById('guild-manage') as HTMLElement;

    const res = await getMyGuilds();
    if (!res.ok) {
      myGuilds = [];
      updateKpiGuild();
      updateClaimBanner();
      return;
    }
    const items = res.items ?? [];
    myGuilds = items;

    if (items.length === 0) {
      empty.classList.remove('hidden');
      manage.classList.add('hidden');
      updateKpiGuild();
      updateClaimBanner();
      return;
    }

    empty.classList.add('hidden');
    manage.classList.remove('hidden');
    const cardsEl = document.getElementById('guild-cards') as HTMLElement;
    cardsEl.innerHTML = '';
    items.forEach((g) => cardsEl.appendChild(renderGuildCard(g)));
    updateKpiGuild();
    updateClaimBanner();
  }

  // ── Seguridad: contraseña y sesión ───────────────────────────────────────
  document.getElementById('save-password')?.addEventListener('click', async () => {
    const btn = document.getElementById('save-password') as HTMLButtonElement;
    const pass = (document.getElementById('new-password') as HTMLInputElement).value;
    const confirm = (document.getElementById('new-password-confirm') as HTMLInputElement).value;

    const strong = pass.length >= 8 && /[a-zA-Záéíóúüñ]/.test(pass) && /\d/.test(pass);
    if (!strong) { msgBox('password-msg', false, 'La contraseña debe tener 8+ caracteres con letra y número.'); return; }
    if (pass !== confirm) { msgBox('password-msg', false, 'Las contraseñas no coinciden.'); return; }

    btn.disabled = true; btn.textContent = 'Actualizando…';
    const { error } = await supabase.auth.updateUser({ password: pass });
    btn.disabled = false; btn.textContent = 'Actualizar contraseña';

    if (error) {
      msgBox('password-msg', false, error.message.includes('rate limit')
        ? 'Demasiados intentos; espera un momento.'
        : 'No se pudo actualizar la contraseña.');
      return;
    }
    (document.getElementById('new-password') as HTMLInputElement).value = '';
    (document.getElementById('new-password-confirm') as HTMLInputElement).value = '';
    msgBox('password-msg', true, 'Contraseña actualizada correctamente.');
  });

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.assign('/');
  });

  // ── Eliminar cuenta (solo RaidDominion; no toca auth ni otras apps) ────
  const delBtn = document.getElementById('delete-account-btn') as HTMLButtonElement;
  const delConfirm = document.getElementById('delete-account-confirm') as HTMLElement;
  const delInput = document.getElementById('delete-account-input') as HTMLInputElement;
  const delConfirmBtn = document.getElementById('delete-account-confirm-btn') as HTMLButtonElement;
  const delCancel = document.getElementById('delete-account-cancel') as HTMLButtonElement;
  const delMsg = document.getElementById('delete-account-msg') as HTMLElement;

  delBtn.addEventListener('click', () => {
    delConfirm.classList.toggle('hidden');
    if (delConfirm.classList.contains('hidden')) {
      delInput.value = '';
      delMsg.classList.add('hidden');
    }
    delConfirmBtn.disabled = true;
  });

  delCancel.addEventListener('click', () => {
    delConfirm.classList.add('hidden');
    delInput.value = '';
    delConfirmBtn.disabled = true;
    delMsg.classList.add('hidden');
  });

  delInput.addEventListener('input', () => {
    delConfirmBtn.disabled = delInput.value.trim().toUpperCase() !== 'ELIMINAR';
  });

  delConfirmBtn.addEventListener('click', async () => {
    delConfirmBtn.disabled = true;
    delConfirmBtn.textContent = 'Eliminando…';
    const res = await deleteMyAccount();
    if (!res.ok) {
      delConfirmBtn.disabled = false;
      delConfirmBtn.textContent = 'Confirmar eliminación';
      msgBox('delete-account-msg', false, 'No se pudo eliminar la cuenta: ' + (res.error || ''));
      return;
    }
    msgBox('delete-account-msg', true, 'Cuenta eliminada. Cerrando sesión…');
    await supabase.auth.signOut();
    window.location.assign('/');
  });

  // ── Resetear datos del flujo SV (uploads, personajes, hermandad) ───────
  const resetBtn = document.getElementById('reset-data-btn') as HTMLButtonElement;
  const resetConfirm = document.getElementById('reset-data-confirm') as HTMLElement;
  const resetInput = document.getElementById('reset-data-input') as HTMLInputElement;
  const resetConfirmBtn = document.getElementById('reset-data-confirm-btn') as HTMLButtonElement;
  const resetCancel = document.getElementById('reset-data-cancel') as HTMLButtonElement;
  const resetMsg = document.getElementById('reset-data-msg') as HTMLElement;

  resetBtn.addEventListener('click', () => {
    resetConfirm.classList.toggle('hidden');
    if (resetConfirm.classList.contains('hidden')) {
      resetInput.value = '';
      resetMsg.classList.add('hidden');
    }
    resetConfirmBtn.disabled = true;
  });

  resetCancel.addEventListener('click', () => {
    resetConfirm.classList.add('hidden');
    resetInput.value = '';
    resetConfirmBtn.disabled = true;
    resetMsg.classList.add('hidden');
  });

  resetInput.addEventListener('input', () => {
    resetConfirmBtn.disabled = resetInput.value.trim().toUpperCase() !== 'RESETEAR';
  });

  resetConfirmBtn.addEventListener('click', async () => {
    resetConfirmBtn.disabled = true;
    resetConfirmBtn.textContent = 'Reseteando…';
    const res = await resetMyData();
    if (!res.ok) {
      resetConfirmBtn.disabled = false;
      resetConfirmBtn.textContent = 'Confirmar reseteo';
      msgBox('reset-data-msg', false, 'No se pudo resetear: ' + (res.error || ''));
      return;
    }
    msgBox('reset-data-msg', true, 'Datos reseteados. Recargando tu espacio…');
    resetConfirm.classList.add('hidden');
    resetInput.value = '';
    resetConfirmBtn.disabled = true;
    resetConfirmBtn.textContent = 'Confirmar reseteo';
    void loadProfile();
    void loadCharacters();
    void loadHistory();
    void loadGuilds();
  });
</script>
