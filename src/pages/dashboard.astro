<script>
  import { supabase } from '@/lib/supabase';
  import {
    listMyUploads,
    getUpload,
    getMyProfile,
    updateMyProfile,
    getMyGuilds,
    getGuildSnapshot,
    getGuildRules,
    setGuildRules,
    ensureMyProfileSlug,
    getMyCharacters,
    setCharacterVisibility,
    getMyBands,
    setBandVisibility,
    setBandHidePlayers,
    setBandGuild,
    getMyMembershipGuilds,
    setBandRules,
    getMyRulesCatalog,
    proposeBandIntegration,
    setBandIntegration,
    getGuildBandProposals,
    getGuildBandIntegrationRules,
    setGuildBandIntegrationRules,
    listGuildPortalBands,
    claimGuildFromSV,
    tryPromoteMember,
    deleteMyAccount,
    resetMyData,
  } from '@/lib/api';
  import type { UploadSummary, CharacterRow } from '@/lib/api';
  import type { BandRow } from '@/types/database';
  import { el } from '@/lib/ui/preview';
  import { resolveRankName } from '@/lib/ui/ranks';
  import { handleFromSlug } from '@/lib/ui/playerNames';
  import { DASHBOARD_TABS, tabFromHash, tabHash } from '@/lib/ui/tabs';
  import { isStaff } from '@/lib/roles';
  import { bandMergeKey, mergeBandPlayers } from '@/lib/bandMerge';
  import type { ParsedSavedVariables, ConfigListItem, ContentItem, Assignments, RegistryGuild } from '@/types/parser';
  import type { RaiddominionRole, GuildRow } from '@/types/database';

  const PANELS = DASHBOARD_TABS.map((t) => t.id) as string[];
  type PanelName = (typeof PANELS)[number];

  const emailEl = document.getElementById('user-email') as HTMLElement;
  const avatarEl = document.getElementById('avatar') as HTMLElement;
  const badgeEl = document.getElementById('role-badge') as HTMLElement;

  const ROLE_LABELS: Record<RaiddominionRole, string> = {
    visitante: 'Visitante',
    member: 'Miembro',
    guild_master: 'Maestro de Hermandad',
    moderator: 'Moderador',
    admin: 'Administrador',
  };
  const ROLE_STYLES: Record<RaiddominionRole, string> = {
    visitante: 'bg-stone-800/70 border-stone-600 text-stone-300',
    member: 'bg-gray-800/70 border-gray-600 text-gray-300',
    guild_master: 'bg-amber-900/40 border-amber-500/60 text-amber-200',
    moderator: 'bg-sky-900/30 border-sky-600/50 text-sky-200',
    admin: 'bg-red-900/30 border-red-600/50 text-red-200',
  };

  // ── Estado reactivo (declarado antes de las llamadas void load*) ─────────
  let currentRole: RaiddominionRole = 'member';
  let myCharacters: CharacterRow[] = [];
  let profileCharacterName: string | null = null;
  let uploadsCache: UploadSummary[] = [];
  let currentSvId = '';
  let lastLeads = false;
  let snapshotGmGuilds: string[] = [];
  let myGuilds: GuildRow[] = [];
  let membershipGuilds: GuildRow[] = [];
  let rulesCatalog: ContentItem[] = [];
  // Último análisis renderizado: los indicadores del encabezado de Registro
  // se calculan de él (liberan al visor de repetir cifras).
  let lastSnapshot: ParsedSavedVariables | null = null;
  // Bandas del usuario y banda actualmente seleccionada en el navegador.
  let allBands: BandRow[] = [];
  let currentBandId: string | null = null;
  // Hermandad actualmente seleccionada en el navegador de hermandades.
  let currentGuildId: string | null = null;
  // Integrantes, bandas integradas y reglas por hermandad (roster/portal del
  // último análisis cargado), para los indicadores de cabecera de la ficha
  // seleccionada.
  const guildMembersCount = new Map<string, number>();
  const guildBandsCount = new Map<string, number>();
  const guildRulesCount = new Map<string, number>();

  // ── Indicadores de los encabezados de bloque (Registro/Bandas/Hermandad) ──
  function setHdrChip(id: string, value: number | string): void {
    const el = document.getElementById(id);
    if (el) el.textContent = String(value ?? 0);
  }

  // Registro: personajes, hermandades, bandas y reglas del análisis activo +
  // nº de análisis subidos. Leyendo de lastSnapshot (no del DOM) los chips
  // quedan también correctos antes de que termine el render del visor.
  function refreshHdrAddon(): void {
    const d = lastSnapshot;
    if (!d) {
      setHdrChip('hdr-addon-chars', 0);
      setHdrChip('hdr-addon-guilds', 0);
      setHdrChip('hdr-addon-bands', 0);
      setHdrChip('hdr-addon-rules', 0);
      return;
    }
    const guildNames = new Set<string>();
    if (d.registryGuild?.name) guildNames.add(d.registryGuild.name.trim().toLowerCase());
    d.registries.forEach((reg) => {
      if (reg.guild?.name) guildNames.add(reg.guild!.name.trim().toLowerCase());
    });
    setHdrChip('hdr-addon-chars', d.characters.length);
    setHdrChip('hdr-addon-guilds', guildNames.size);
    setHdrChip('hdr-addon-bands', d.bands.length);
    setHdrChip('hdr-addon-rules', d.rules.length);
  }

  // Los toggles y cambios de estado llaman a refreshHdrBands (nombre legado):
  // ahora solo refresca los indicadores de la banda seleccionada en el header.
  function refreshHdrBands(): void {
    void refreshHdrBandSelected();
  }

  // Conteo de jugadores de una banda INTEGRADA ya combinado con las demás
  // bandas públicas del mismo grupo (clave name|horario|GS). null si no hay
  // grupo (o falla la consulta): en ese caso se usa el roster propio.
  async function mergedBandPlayerCount(b: BandRow): Promise<number | null> {
    try {
      const portal = await listGuildPortalBands(b.guild_id as string);
      if (!portal.ok || !portal.bands) return null;
      const key = bandMergeKey(b);
      const group = portal.bands.filter((x) => bandMergeKey(x) === key);
      if (group.length === 0) return null;
      return mergeBandPlayers(group).length;
    } catch {
      return null;
    }
  }

  // Banda seleccionada en el navegador: nombre·horario·GS en el título del
  // encabezado (formato del selector, el SPAN interno preserva el icono "ul")
  // + indicadores (jugadores, reglas y el estado de integración si lo tiene).
  // El detalle ya no repite título ni badges; esta función se llama en los
  // mismos puntos que refreshHdrBands (toggles y cambios de estado). Para
  // bandas que se combinan por match de nombre|horario, el conteo de jugadores
  // es la UNIÓN del grupo (mismo criterio que el portal y la página de banda).
  async function refreshHdrBandSelected(): Promise<void> {
    const band = currentBandId ? allBands.find((b) => b.id === currentBandId) : undefined;
    const titleEl = document.getElementById('hdr-band-name-text');
    if (titleEl) {
      if (!band) {
        titleEl.textContent = 'Mis bandas';
      } else {
        const parts = [band.name || 'Banda sin nombre'];
        if (band.schedule) parts.push(band.schedule);
        if (typeof band.min_gs === 'number' && band.min_gs > 0) parts.push(`GS ${band.min_gs}`);
        titleEl.textContent = parts.join(' · ');
      }
    }
    let playersLabel: number | string = band ? (band.hide_players ? 'ocultos' : bandPlayerCount(band)) : 0;
    if (band && band.guild_id && band.is_rank_integrated && !band.hide_players) {
      const merged = await mergedBandPlayerCount(band);
      if (merged !== null) playersLabel = merged;
    }
    setHdrChip('hdr-band-players', playersLabel);
    setHdrChip('hdr-band-rules', band ? bandRuleCount(band) : 0);

    const statusEl = document.getElementById('hdr-band-status') as HTMLElement | null;
    if (!statusEl) return;
    const chipBase = 'inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest border rounded-md px-2.5 py-1';
    const st = (band?.integration_status ?? 'none') as string;
    if (st !== 'none') {
      let text = '';
      let cls = '';
      if (st === 'approved' && band!.guild_id && band!.is_public) {
        text = '✓ en el portal de la hermandad';
        cls = 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40';
      } else if (st === 'approved' && band!.guild_id) {
        text = '✓ integrada · privada';
        cls = 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40';
      } else if (st === 'pending') {
        text = '⏳ propuesta pendiente';
        cls = 'text-sky-300 bg-sky-950/30 border-sky-600/40';
      } else if (st === 'rejected') {
        text = '✗ propuesta rechazada';
        cls = 'text-red-300 bg-red-950/30 border-red-600/40';
      }
      if (text) {
        statusEl.textContent = text;
        statusEl.className = chipBase + ' ' + cls;
        statusEl.classList.remove('hidden');
        return;
      }
    }
    statusEl.classList.add('hidden');
  }

  // Hermandad: la ficha seleccionada en el navegador → nombre en el título del
  // encabezado (el SPAN interno preserva el icono "ul") + indicadores de ESA
  // hermandad: integrantes, bandas integradas y estados de publicación y de
  // verificación. La ficha ya no repite título ni badges; el total de
  // hermandades vive en el contador del selector ("Hermandad N/total").
  function refreshHdrGuild(): void {
    const guild = currentGuildId ? myGuilds.find((g) => g.id === currentGuildId) : undefined;

    const nameEl = document.getElementById('hdr-guild-name-text');
    if (nameEl) {
      nameEl.textContent = guild
        ? `${guild.name || 'Hermandad sin nombre'}${guild.realm ? ` · ${guild.realm}` : ''}`
        : 'Tus hermandades';
    }

    setHdrChip('hdr-guild-members', guild ? (guildMembersCount.get(guild.id) ?? 0) : 0);
    setHdrChip('hdr-guild-bands', guild ? (guildBandsCount.get(guild.id) ?? 0) : 0);
    setHdrChip('hdr-guild-rules', guild ? (guildRulesCount.get(guild.id) ?? 0) : 0);

    const chipBase = 'inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest border rounded-md px-2.5 py-1';
    const visEl = document.getElementById('hdr-guild-vis') as HTMLElement | null;
    if (visEl) {
      if (!guild) {
        visEl.classList.add('hidden');
      } else {
        visEl.textContent = guild.is_public ? '✓ pública' : 'privada';
        visEl.className = chipBase + (guild.is_public
          ? ' text-emerald-300 bg-emerald-950/30 border-emerald-600/40'
          : ' text-gray-400 bg-gray-950/50 border-gray-700/50');
        visEl.classList.remove('hidden');
      }
    }

    const claimEl = document.getElementById('hdr-guild-claim') as HTMLElement | null;
    if (claimEl) {
      if (!guild) {
        claimEl.classList.add('hidden');
      } else {
        const verified = guild.claim_status === 'verified';
        claimEl.textContent = verified ? '✓ verificada' : guild.claim_status === 'rejected' ? '✗ rechazada' : '⏳ en revisión';
        claimEl.className = chipBase + (verified
          ? ' text-emerald-300 bg-emerald-950/30 border-emerald-600/40'
          : guild.claim_status === 'rejected'
            ? ' text-red-300 bg-red-950/30 border-red-600/40'
            : ' text-amber-300 bg-amber-950/30 border-amber-600/40');
        claimEl.classList.remove('hidden');
      }
    }
  }

  // ¿Puede publicar bandas/personajes? Un Visitante sin personajes validados
  // no puede activar visibilidad pública hasta validar como Miembro (regla
  // 20260830: >= 2 personajes registrados validan la cuenta y la promueven).
  function canPublishContent(): boolean {
    if (currentRole === 'visitante') {
      return myCharacters.some((c) => c.member_verified);
    }
    return true;
  }
  const PUBLISH_GATE_MSG = 'Estás en Visitante y tus personajes aún no están validados. Para publicar personajes y bandas, sube tu SavedVariables con al menos dos personajes: tu cuenta quedará validada como Miembro y podrás activar su visibilidad pública.';
  // Resuelve cuando loadProfile fija currentRole; personajes/bandas esperan
  // por él para aplicar correctamente el gate de publicación.
  let resolveProfileReady: () => void;
  const profileReady = new Promise<void>((r) => { resolveProfileReady = r; });

  function msgBox(id: string, ok: boolean, text: string): void {
    const box = document.getElementById(id) as HTMLElement;
    box.textContent = text;
    box.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ok ? 'bg-emerald-950/30 border border-emerald-600/40 text-emerald-300' : 'bg-red-950/40 border border-red-600/40 text-red-300'}`;
  }

  // Muestra u oculta el enlace al perfil público con un slug conocido o generándolo
  async function syncPublicLink(isPublic: boolean | null | undefined, knownSlug?: string): Promise<void> {
    const link = document.getElementById('public-profile-link') as HTMLAnchorElement;
    if (!isPublic) {
      link.classList.add('hidden');
      return;
    }
    let slug = knownSlug;
    if (!slug) {
      const res = await ensureMyProfileSlug();
      if (res.ok && res.slug) slug = res.slug;
    }
    if (slug) {
      link.href = `/p/${slug}`;
      link.classList.remove('hidden');
    }
  }

  // ── Sesión ───────────────────────────────────────────────────────────────
  const { data: sessionData } = await supabase.auth.getSession();
  if (!sessionData.session?.user) {
    window.location.replace('/login?next=%2Fdashboard');
  } else {
    const email = sessionData.session.user.email ?? '';
    emailEl.textContent = email;
    avatarEl.textContent = (email[0] ?? '?').toUpperCase();

    void loadProfile();
    void loadCharacters();
    void loadHistory();
    void loadGuilds();
    void loadBands();
  }

  // ── Pestañas ─────────────────────────────────────────────────────────────
  // La barra de pestañas se genera desde src/lib/ui/tabs.ts (contrato único):
  // ids, labels y hashes salen SOLO de ahí, nunca hardcodeados aquí.
  const tabBar = document.getElementById('tab-bar') as HTMLElement;
  const tabBtnCls =
    'tab-btn shrink-0 whitespace-nowrap px-2 sm:px-4 py-2.5 text-xs font-black uppercase tracking-widest border-b-2 rounded-t-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400';
  const tabs: HTMLButtonElement[] = DASHBOARD_TABS.map((t) => {
    const btn = document.createElement('button');
    btn.id = `tab-${t.id}`;
    btn.dataset.tab = t.id;
    btn.setAttribute('role', 'tab');
    btn.setAttribute('aria-controls', `panel-${t.id}`);
    // Contrato de barra: todas las pestañas alineadas a la izquierda; el
    // scroll horizontal (oculto) deja ver el resto en pantallas estrechas.
    btn.className = tabBtnCls;
    btn.textContent = t.label;
    tabBar.appendChild(btn);
    return btn;
  });

  function activateTab(name: PanelName, updateHash = true): void {
    tabs.forEach((b) => {
      const active = b.dataset.tab === name;
      b.setAttribute('aria-selected', String(active));
      b.tabIndex = active ? 0 : -1;
      b.classList.toggle('border-amber-400', active);
      b.classList.toggle('text-amber-200', active);
      b.classList.toggle('border-transparent', !active);
      b.classList.toggle('text-gray-500', !active);
    });
    PANELS.forEach((p) => {
      document.getElementById(`panel-${p}`)?.classList.toggle('hidden', p !== name);
    });
    if (updateHash) {
      const target = tabHash(name);
      if (window.location.hash !== target) {
        // replaceState evita saltar y no ensucia el historial con cada click
        window.history.replaceState(null, '', target);
      }
    }
  }

  tabs.forEach((btn) => btn.addEventListener('click', () => activateTab((btn.dataset.tab ?? 'addon') as PanelName)));
  document.querySelectorAll<HTMLButtonElement>('.goto-btn').forEach((b) =>
    b.addEventListener('click', () => activateTab((b.dataset.goto ?? 'addon') as PanelName)));

  // Deep-link / hash: al cargar o al cambiar el hash se activa la pestaña.
  function syncTabFromHash(): void {
    const id = tabFromHash(window.location.hash);
    activateTab((PANELS.includes(id) ? id : 'addon') as PanelName, false);
  }
  window.addEventListener('hashchange', syncTabFromHash);
  syncTabFromHash();

  // Patrón ARIA tabs: ←/→ mueven foco (con activación), Home/End saltan a los extremos
  tabBar.addEventListener('keydown', (e) => {
    const ev = e as KeyboardEvent;
    const idx = tabs.indexOf(ev.target as HTMLButtonElement);
    if (idx === -1) return;
    let next: number | null = null;
    if (ev.key === 'ArrowRight') next = (idx + 1) % tabs.length;
    else if (ev.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
    else if (ev.key === 'Home') next = 0;
    else if (ev.key === 'End') next = tabs.length - 1;
    if (next === null) return;
    ev.preventDefault();
    const target = tabs[next];
    target.focus();
    activateTab((target.dataset.tab ?? 'addon') as PanelName);
  });

  // ── Perfil ───────────────────────────────────────────────────────────────

  // Rellena el <select> del personaje principal SOLO con personajes PÚBLICOS.
  // Incluye la opción "Ninguno" para poder desmarcar el principal.
  function populateMainCharacterSelect(): void {
    const sel = document.getElementById('character-main') as HTMLSelectElement;
    const hint = document.getElementById('character-main-hint') as HTMLElement;
    sel.innerHTML = '';
    const none = document.createElement('option');
    none.value = '';
    none.textContent = 'Ninguno';
    sel.appendChild(none);
    // Solo los personajes habilitados como públicos pueden ser principal: un
    // personaje privado no aparece en la lista ni se puede guardar como tal.
    const publicChars = myCharacters.filter((c) => c.is_public);
    publicChars.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.realm ? `${c.name} · ${c.realm}` : c.name;
      sel.appendChild(opt);
    });
    if (publicChars.length === 0) {
      sel.disabled = true;
      sel.selectedIndex = 0;
      hint.textContent = myCharacters.length === 0
        ? 'Sube tu SavedVariables para detectar tus personajes y elegir tu principal.'
        : 'Activa la visibilidad pública de al menos un personaje para elegir tu principal.';
      return;
    }
    sel.disabled = false;
    hint.textContent = 'Solo puedes elegir entre tus personajes públicos.';
    syncMainCharacterSelect();
  }

// Preselecciona el personaje guardado SOLO si es PÚBLICO; si el guardado es
  // privado o no existe, queda "Ninguno" seleccionado (opción índice 0).
  // Nunca auto-selecciona un personaje de forma implícita.
  function syncMainCharacterSelect(): void {
    const sel = document.getElementById('character-main') as HTMLSelectElement;
    if (myCharacters.length === 0) return;
    const match = profileCharacterName
      ? myCharacters.find((c) => c.name.toUpperCase() === profileCharacterName!.toUpperCase())
      : undefined;
    if (match && match.is_public) {
      sel.value = match.id;
    } else {
      sel.selectedIndex = 0; // "Ninguno"
    }
  }

  async function loadProfile(): Promise<void> {
    const nameInput = document.getElementById('display-name') as HTMLInputElement;
    const publicToggle = document.getElementById('profile-public') as HTMLInputElement;

    const res = await getMyProfile();
    if (!res.ok || !res.profile) {
      badgeEl.textContent = 'Visitante';
      resolveProfileReady();
      return;
    }
    const p = res.profile;
    currentRole = p.role;
    badgeEl.textContent = ROLE_LABELS[p.role] ?? p.role;
    badgeEl.className = `px-3 py-1.5 rounded-md text-[11px] font-black uppercase tracking-widest border ${ROLE_STYLES[p.role] ?? ROLE_STYLES.member}`;

    if (p.display_name) {
      nameInput.value = p.display_name;
    }

    // Título de la cuenta: nombre visible → handle estable del slug. NUNCA se
    // usa character_name como nombre de cuenta (el "Personaje principal" es
    // solo un dato del perfil, no el nombre visible de la cuenta): las cuentas
    // sin nombre visible caen a su @hex (p. ej. @e3ef4b2).
    const accountTitle = (p.display_name ?? '').trim() || handleFromSlug(p.slug);
    const titleEl = document.getElementById('account-title');
    if (titleEl) titleEl.textContent = accountTitle || 'Cuenta';
    avatarEl.textContent = (accountTitle.replace(/^@/, '')[0] || '?').toUpperCase();
    profileCharacterName = p.character_name;
    syncMainCharacterSelect();
    publicToggle.checked = p.is_public === true;

    await syncPublicLink(p.is_public, p.slug ?? undefined);
    resolveProfileReady();
  }

  // La visibilidad pública se persiste al instante (no requiere Guardar)
  document.getElementById('profile-public')?.addEventListener('change', async (e) => {
    const box = e.target as HTMLInputElement;
    box.disabled = true;
    const res = await updateMyProfile({ is_public: box.checked });
    box.disabled = false;
    if (!res.ok) {
      box.checked = !box.checked;
      msgBox('profile-msg', false, 'No se pudo cambiar la visibilidad: ' + (res.error || ''));
      return;
    }
    await syncPublicLink(box.checked);
    msgBox('profile-msg', true, box.checked ? 'Perfil público activado.' : 'Perfil privado.');
  });

  document.getElementById('save-profile')?.addEventListener('click', async () => {
    const btn = document.getElementById('save-profile') as HTMLButtonElement;
    const nameInput = document.getElementById('display-name') as HTMLInputElement;
    const publicToggle = document.getElementById('profile-public') as HTMLInputElement;
    const charSel = document.getElementById('character-main') as HTMLSelectElement;
    const selectedChar = myCharacters.find((c) => c.id === charSel.value);

    btn.disabled = true; btn.textContent = 'Guardando…';
    const res = await updateMyProfile({
      display_name: nameInput.value.trim() || null,
      character_name: selectedChar?.name ?? null,
      is_public: publicToggle.checked,
    });
    btn.disabled = false; btn.textContent = 'Guardar cambios';

    if (res.ok) {
      profileCharacterName = selectedChar?.name ?? null;
      // Al retirar el nombre visible, el avatar cae al personaje principal o,
      // en su defecto, a la inicial del correo (nunca queda desactualizado).
      const nameSource = nameInput.value.trim() || selectedChar?.name || email || '';
      avatarEl.textContent = nameSource[0]?.toUpperCase() || '?';
      await syncPublicLink(publicToggle.checked);
      msgBox('profile-msg', true, publicToggle.checked
        ? 'Cambios guardados. Tu perfil es público.'
        : 'Cambios guardados. Tu perfil es privado.');
    } else {
      msgBox('profile-msg', false, 'No se pudo guardar: ' + (res.error || ''));
    }
  });

  // ── Mis Personajes ───────────────────────────────────────────────────────
  async function loadCharacters(): Promise<void> {
    await profileReady;
    const listEl = document.getElementById('characters-list') as HTMLElement;
    const statusEl = document.getElementById('characters-status') as HTMLElement;
    const onboardingEl = document.getElementById('characters-onboarding') as HTMLElement;

    const res = await getMyCharacters();
    if (!res.ok) {
      statusEl.textContent = 'No se pudieron cargar tus personajes.';
      return;
    }
    const items = res.items ?? [];
    myCharacters = items;
    populateMainCharacterSelect();
    listEl.innerHTML = '';
    statusEl.classList.toggle('hidden', items.length > 0);
    if (items.length === 0) {
      statusEl.innerHTML = 'Aún no registras personajes. Sube tu SavedVariables desde el addon y aparecerán aquí. <a href="/upload" class="text-amber-300 underline hover:text-amber-200">Subir ahora →</a>';
      return;
    }

    // Onboarding: un Visitante sin personajes validados no puede publicar;
    // el mensaje explica la regla hasta que valide como Miembro.
    if (!canPublishContent()) {
      onboardingEl.classList.remove('hidden');
      onboardingEl.textContent = PUBLISH_GATE_MSG;
    } else {
      onboardingEl.classList.add('hidden');
    }

    items.forEach((c) => listEl.appendChild(characterCard(c)));
  }

  function characterCard(c: CharacterRow): HTMLElement {
    const card = document.createElement('div');
    card.className = 'bg-gray-800/50 border border-amber-700/40 rounded-md p-4';

    const header = document.createElement('div');
    header.className = 'flex flex-wrap items-center justify-between gap-3';
    const info = document.createElement('div');
    const title = document.createElement('p');
    title.className = 'text-sm font-bold text-white';
    title.textContent = `${c.name}${c.realm ? '-' + c.realm : ''}`;
    const chips = document.createElement('div');
    chips.className = 'flex flex-wrap gap-2 mt-1.5';
    const chipCls = 'text-[10px] font-black uppercase tracking-widest text-gray-400 bg-gray-900/60 border border-amber-600/30 rounded-md px-2.5 py-1';
    if (c.class) chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls, textContent: c.class }));
    if (c.race) chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls, textContent: c.race }));
    if (typeof c.level === 'number') chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls, textContent: `Nivel ${c.level}` }));
    if (c.avg_ilvl !== null && c.avg_ilvl !== undefined) {
      chips.appendChild(Object.assign(document.createElement('span'), { className: chipCls + ' !text-amber-300 !border-amber-500/40', textContent: `ilvl ${c.avg_ilvl}` }));
    }
    if (c.member_verified) {
      chips.appendChild(Object.assign(document.createElement('span'), { className: 'text-[10px] font-black uppercase tracking-widest text-emerald-300 bg-emerald-950/30 border border-emerald-600/40 rounded-md px-2.5 py-1', textContent: '✓ Validado' }));
    }
    if (c.sv_guild_name) {
      chips.appendChild(Object.assign(document.createElement('span'), { className: 'text-[10px] font-black uppercase tracking-widest ' + (c.sv_is_gm ? 'text-amber-300 bg-amber-950/30 border border-amber-500/40' : 'text-sky-200 bg-gray-900/60 border border-sky-600/30') + ' rounded-md px-2.5 py-1', textContent: c.sv_is_gm ? `★ ${c.sv_guild_name} · Maestro` : `${c.sv_guild_name}${c.sv_guild_rank ? ' · ' + c.sv_guild_rank : ''}` }));
    }
    info.append(title, chips);
    header.appendChild(info);

    const visLabel = document.createElement('label');
    visLabel.className = 'flex items-center gap-2 cursor-pointer select-none text-xs text-gray-400';
    const visCheck = document.createElement('input');
    visCheck.type = 'checkbox';
    visCheck.checked = c.is_public;
    visCheck.className = 'w-4 h-4 accent-amber-500';
    const visStatus = document.createElement('span');
    visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest';
    if (!canPublishContent()) {
      visCheck.disabled = true;
      visCheck.checked = false;
      visCheck.className += ' opacity-40';
      visLabel.className += ' opacity-70 cursor-not-allowed';
      visLabel.title = 'Requiere cuenta Miembro validada (2+ personajes).';
      visStatus.textContent = 'bloqueado';
      visStatus.className += ' text-gray-500';
    } else {
      visCheck.addEventListener('change', async () => {
        visCheck.disabled = true;
        visStatus.textContent = '· guardando…';
        visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-amber-300';
        const res = await setCharacterVisibility(c.id, visCheck.checked);
        visCheck.disabled = false;
        if (res.ok) {
          c.is_public = visCheck.checked;
          visStatus.textContent = '✓ guardado';
          visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-emerald-400';
          populateMainCharacterSelect();
        } else {
          visCheck.checked = !visCheck.checked;
          visStatus.textContent = '✗ error';
          visStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-red-400';
        }
        window.setTimeout(() => { visStatus.textContent = ''; }, 2500);
      });
    }
    visLabel.append(visCheck, document.createTextNode('Público'), visStatus);
    header.appendChild(visLabel);
    card.appendChild(header);

    // El equipamiento vive solo en la ficha dedicada /personaje/:slug: la
    // card del dashboard es un enlace compacto, sin lista de piezas.
    if (c.slug) {
      const ficha = document.createElement('a');
      ficha.href = `/personaje/${c.slug}`;
      ficha.className = 'inline-block mt-3 text-xs text-amber-300 hover:text-amber-200 underline';
      ficha.textContent = 'Ver ficha del personaje →';
      card.appendChild(ficha);
    }
    return card;
  }

  // ── Mi Registro: historial + visor del snapshot seleccionado ────────────

  function fmtDateTime(iso: string): string {
    return new Date(iso).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' });
  }

  function svLabel(item: UploadSummary): string {
    const who = item.generatedBy ? ` · ${item.generatedBy}` : '';
    return `${fmtDateTime(item.parsedAt)}${who}`;
  }

  // Contador "Análisis N/total" del selector de análisis (patrón de bandas).
  function updateSvCounter(): void {
    const counter = document.getElementById('sv-counter') as HTMLElement | null;
    if (!counter) return;
    const total = uploadsCache.length;
    if (total === 0) {
      counter.textContent = '';
      return;
    }
    const idx = currentSvId ? uploadsCache.findIndex((u) => u.id === currentSvId) + 1 : 1;
    counter.textContent = `${idx} de ${total}`;
  }

  function showAddonEmpty(note?: string): void {
    document.getElementById('addon-empty')?.classList.remove('hidden');
    document.getElementById('addon-main')?.classList.add('hidden');
    const noteEl = document.getElementById('addon-empty-note') as HTMLElement;
    if (note) {
      noteEl.textContent = note;
      noteEl.classList.remove('hidden');
    } else {
      noteEl.classList.add('hidden');
    }
  }

  function showBandsEmpty(): void {
    // Las bandas se gestionan desde Mis Bandas (loadBands, datos de BD).
    document.getElementById('band-detail')?.classList.add('hidden');
    document.getElementById('band-select-wrap')?.classList.add('hidden');
  }

  async function loadHistory(): Promise<void> {
    const select = document.getElementById('sv-select') as HTMLSelectElement;

    const res = await listMyUploads();
    if (!res.ok) {
      showAddonEmpty('No se pudo cargar tu historial de análisis.');
      showBandsEmpty();
      return;
    }
    const items = res.items ?? [];
    uploadsCache = items;
    refreshHdrAddon();

    if (items.length === 0) {
      showAddonEmpty();
      showBandsEmpty();
      return;
    }

    // Con análisis disponibles: muestra el visor y oculta el estado vacío
    document.getElementById('addon-empty')?.classList.add('hidden');
    document.getElementById('addon-main')?.classList.remove('hidden');

    select.innerHTML = '';
    items.forEach((item, i) => {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = `${i + 1}. ${svLabel(item)}`;
      select.appendChild(opt);
    });
    select.value = items[0].id;
    updateSvCounter();

    const first = items[0];
    if (first) void renderSnapshot(first.id);
  }

  async function renderSnapshot(svId: string): Promise<void> {
    currentSvId = svId;
    updateSvCounter();
    const res = await getUpload(svId);
    if (!res.ok || !res.item?.raw) return;
    const d = res.item.raw as ParsedSavedVariables;
    const item = uploadsCache.find((u) => u.id === svId);

    // Título del encabezado = título + fecha del análisis seleccionado. Se
    // setea el SPAN interno para preservar el icono "ul" del encabezado.
    const hdrTitle = document.getElementById('hdr-addon-title-text');
    if (hdrTitle) hdrTitle.textContent = item ? svLabel(item) : 'Análisis';

    // Cifras del análisis en los chips del encabezado; el visor no repite
    // estadísticas: solo muestra el contenido del registro.
    lastSnapshot = d;
    refreshHdrAddon();

    // Mi personaje registrado + hermandades del registro (cifras)
    renderPlayerSnapshot(d);
    renderGuilds(d);

    // Personajes de la cuenta y registros por personaje
    renderAccountCharacters(d);
    renderRegistries(d);

    // Submenús activos (ui.show*Menu)
    const menusEl = document.getElementById('addon-menus') as HTMLElement;
    menusEl.innerHTML = '';
    const menuLabels: Record<string, string> = {
      showRolesMenu: 'Roles',
      showBuffsMenu: 'Bendiciones',
      showAbilitiesMenu: 'Habilidades',
      showAurasMenu: 'Auras',
      showMechanicsMenu: 'Mecánicas',
      showRulesMenu: 'Reglas',
      showBandsMenu: 'Bandas',
    };
    Object.entries(menuLabels).forEach(([key, label]) => {
      const active = d.menus?.[key] === true;
      menusEl.appendChild(configChip(active ? `✓ ${label}` : label, active));
    });

    // Listas configurables en el orden real del addon
    fillList('list-abilities', 'cnt-abilities', d.abilities);
    fillList('list-roles', 'cnt-roles', d.roles);
    fillList('list-buffs', 'cnt-buffs', d.buffs);
    fillList('list-auras', 'cnt-auras', d.auras);

    // Reglas completas (sin recorte). Las bandas viven en Mis Bandas (se leen
    // de la BD por loadBands, no del SV).
    renderContentList('list-rules', 'cnt-rules', d.rules);

    // Asignaciones detalladas (mapa nombre → jugador)
    renderAssignments(d);

    // General / chat / metadatos del registro
    const genEl = document.getElementById('addon-general') as HTMLElement;
    genEl.innerHTML = '';
    if (d.chat.channel) genEl.appendChild(configChip(`Canal: ${d.chat.channel}`));
    if (d.chat.discordLink) {
      const a = document.createElement('a');
      a.href = /^https?:\/\//.test(d.chat.discordLink) ? d.chat.discordLink : '#';
      a.target = '_blank'; a.rel = 'noopener';
      a.className = 'text-[11px] text-sky-300 underline hover:text-sky-200';
      a.textContent = 'Discord de la comunidad →';
      genEl.appendChild(a);
    }
    if (d.version) genEl.appendChild(configChip(`Parser ${d.version}`));
    if (d.generatedBy) genEl.appendChild(configChip(`Generado por: ${d.generatedBy}`));
    if (typeof d.lastUpdate === 'number') {
      genEl.appendChild(configChip(`Última actualización: ${fmtDateTime(new Date(d.lastUpdate * 1000).toISOString())}`));
    }

    const leadsAnywhere = d.registryGuild?.isGM === true ||
      d.registries.some((r) => r.guild?.isGM === true);
    updateClaimBanner(leadsAnywhere);
  }

function configChip(text: string, highlight = false): HTMLElement {
    return el(
      'span',
      'inline-flex items-center gap-1.5 text-[11px] text-gray-300 bg-gray-900/60 border border-amber-600/30 rounded-md px-2.5 py-1' + (highlight ? ' !border-amber-500/40' : ''),
      text,
    );
  }

  function fillList(listId: string, cntId: string, items: ConfigListItem[]): void {
    const wrap = document.getElementById(listId) as HTMLElement;
    const cnt = document.getElementById(cntId) as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = `(${items.length})`;
    if (items.length === 0) {
      wrap.innerHTML = '<span class="text-[11px] text-gray-600 italic">Sin elementos aún</span>';
      return;
    }
    items.forEach((it) => wrap.appendChild(configChip(it.name)));
  }

  function renderContentList(listId: string, cntId: string, items: ContentItem[]): void {
    const wrap = document.getElementById(listId) as HTMLElement;
    const cnt = document.getElementById(cntId) as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = `(${items.length})`;
    if (items.length === 0) {
      wrap.innerHTML = '<p class="text-[11px] text-gray-600 italic">Sin elementos aún</p>';
      return;
    }
    const list = document.createElement('ul');
    list.className = 'space-y-2';
    items.forEach((it) => {
      const li = el('li', 'flex items-start text-sm text-gray-300');
      li.appendChild(el('span', 'text-amber-600 mr-2 mt-0.5', '›'));
      const inner = el('div', '');
      inner.appendChild(el('p', 'font-bold text-white', it.title || 'Elemento'));
      if (it.content) inner.appendChild(el('p', 'text-gray-400 text-xs mt-0.5', it.content));
      li.appendChild(inner);
      list.appendChild(li);
    });
    wrap.appendChild(list);
  }

  // Mi personaje registrado (registry.player): datos + equipamiento
  function renderPlayerSnapshot(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-player') as HTMLElement;
    wrap.innerHTML = '';
    const p = d.player;
    if (!p) {
      wrap.appendChild(el('p', 'text-[11px] text-gray-600 italic', 'Sin registro de personaje propio (registry.player).'));
      return;
    }
    wrap.appendChild(el('p', 'text-sm font-bold text-white', `${p.name}${p.realm ? '-' + p.realm : ''}`));
    const chips = el('div', 'flex flex-wrap gap-2 mt-1.5');
    if (p.race) chips.appendChild(configChip(p.race));
    if (p.class) chips.appendChild(configChip(p.class));
    if (typeof p.level === 'number') chips.appendChild(configChip(`Nivel ${p.level}`));
    if (p.talentSpec) chips.appendChild(configChip(`Spec: ${p.talentSpec}`));
    if (typeof p.avgIlvl === 'number') chips.appendChild(configChip(`ilvl ${p.avgIlvl}`, true));
    wrap.appendChild(chips);
  }

  // Hermandades del registro (registry.*.guild): CIFRAS + jerarquía de rangos,
  // sin roster completo. Un jugador puede tener personajes en varias hermandades
  // y ser GM de varias.
  function renderGuilds(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-guilds') as HTMLElement;
    wrap.innerHTML = '';
    const guilds = new Map<string, {
      name: string;
      isGM: boolean;
      ranks: NonNullable<RegistryGuild['ranks']>;
      ownRankIndex: number | undefined;
      ownRank: string | undefined;
      numMembers: number | undefined;
      characters: string[];
    }>();
    const addGuild = (rg: RegistryGuild | null | undefined, charName?: string): void => {
      if (!rg?.name) return;
      const key = rg.name.trim().toLowerCase();
      const cur = guilds.get(key) ?? {
        name: rg.name, isGM: false, ranks: [], ownRankIndex: undefined, ownRank: undefined,
        numMembers: undefined, characters: [],
      };
      if (rg.isGM) cur.isGM = true;
      if (typeof rg.rankIndex === 'number') cur.ownRankIndex = rg.rankIndex;
      if (rg.rank) cur.ownRank = rg.rank;
      if (rg.ranks && rg.ranks.length > 0 && cur.ranks.length === 0) {
        cur.ranks = [...rg.ranks].sort((a, b) => a.index - b.index);
      }
      if (typeof rg.numMembers === 'number') cur.numMembers = rg.numMembers;
      if (charName) cur.characters.push(charName);
      guilds.set(key, cur);
    };
    addGuild(d.registryGuild, d.player?.name);
    d.registries.forEach((r) => addGuild(r.guild, r.player?.name));

    snapshotGmGuilds = Array.from(guilds.values()).filter((g) => g.isGM).map((g) => g.name);
    updateClaimBanner();

    if (guilds.size === 0) {
      wrap.appendChild(el('p', 'text-[11px] text-gray-600 italic', 'Sin hermandad en el registro.'));
      return;
    }
    Array.from(guilds.values()).forEach((g) => {
      const card = el('div', 'bg-gray-800/50 border border-amber-700/30 rounded-md p-4');
      const head = el('div', 'flex flex-wrap items-center gap-2');
      head.appendChild(el('p', 'text-sm font-bold text-amber-200', g.name));
      if (g.isGM) head.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-amber-300 bg-amber-950/30 border border-amber-500/40 rounded-md px-2.5 py-1', '★ Maestro'));
      card.appendChild(head);

      // El rango propio se detecta por rankIndex contra la jerarquía; el
      // índice 0 (o isGM) es SIEMPRE el líder.
      const ownIndex = g.isGM ? 0 : g.ownRankIndex;
      const ownRankName = resolveRankName({
        rankIndex: ownIndex,
        rank: g.ownRank,
        ranks: g.ranks,
        isGM: g.isGM,
      });

      const meta = el('div', 'flex flex-wrap gap-2 mt-1.5');
      if (typeof g.numMembers === 'number') meta.appendChild(configChip(`${g.numMembers} miembros`));
      if (g.characters.length > 0) meta.appendChild(configChip(`${g.characters.length} personaje(s)`));
      meta.appendChild(configChip(`Tu rango: ${ownRankName}`, g.isGM));
      card.appendChild(meta);

      // Jerarquía completa de rangos (registry.guild.ranks), ordenada por index
      // (0 = líder). El rango del propio usuario se marca si está disponible.
      if (g.ranks.length > 0) {
        const hier = el('div', 'flex flex-wrap items-center gap-1.5 mt-2');
        hier.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500', 'Rangos:'));
        g.ranks.forEach((r) => {
          const isMine = ownIndex !== undefined
            ? r.index === ownIndex
            : (!!g.ownRank && r.name.trim().toLowerCase() === g.ownRank.trim().toLowerCase());
          const label = r.name.trim() || (r.index === 0 ? 'Líder' : `Rango ${r.index}`);
          const cls = isMine
            ? 'text-amber-300 border-amber-500/50 bg-amber-900/30'
            : r.index === 0
              ? 'text-amber-200/90 border-amber-600/30 bg-gray-900/60'
              : 'text-gray-400 border-gray-700/40 bg-gray-900/60';
          hier.appendChild(el('span', `text-[10px] px-2 py-0.5 rounded-md border ${cls}`,
            `${r.index}: ${label}${isMine ? ' · tú' : ''}`));
        });
        card.appendChild(hier);
      }
      if (g.characters.length > 0) {
        card.appendChild(el('p', 'text-[11px] text-gray-500 mt-1.5', `Personajes: ${g.characters.join(', ')}`));
      }
      wrap.appendChild(card);
    });
  }

  // Personajes de la cuenta (characters: config compartida del SV)
  function renderAccountCharacters(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-account-chars') as HTMLElement;
    const cnt = document.getElementById('cnt-account-chars') as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = `(${d.characters.length})`;
    if (d.characters.length === 0) {
      wrap.innerHTML = '<span class="text-[11px] text-gray-600 italic">Sin personajes de cuenta aún.</span>';
      return;
    }
    d.characters.forEach((c) => {
      const label = `${c.name}${c.realm ? '-' + c.realm : ''}`;
      wrap.appendChild(configChip(label));
    });
  }

  // Snapshots de registro por personaje (registry["Nombre-Reino"])
  function renderRegistries(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-registries') as HTMLElement;
    const cnt = document.getElementById('cnt-registries') as HTMLElement;
    wrap.innerHTML = '';
    cnt.textContent = String(d.registries.length);
    if (d.registries.length === 0) {
      wrap.innerHTML = '<p class="text-[11px] text-gray-600 italic">Sin registros por personaje.</p>';
      return;
    }
    d.registries.forEach((reg) => {
      const card = el('div', 'bg-gray-800/50 border border-amber-700/30 rounded-md p-4');
      const head = el('div', 'flex flex-wrap items-center gap-2');
      head.appendChild(el('p', 'text-sm font-bold text-white', reg.player?.name || reg.key || 'Personaje'));
      if (reg.player) {
        if (reg.player.class) head.appendChild(configChip(reg.player.class));
        if (typeof reg.player.level === 'number') head.appendChild(configChip(`Nivel ${reg.player.level}`));
        if (typeof reg.player.avgIlvl === 'number') head.appendChild(configChip(`ilvl ${reg.player.avgIlvl}`, true));
      }
      if (reg.guild) head.appendChild(configChip(`${reg.guild.name}${reg.guild.isGM ? ' · GM' : ''}`));
      if (reg.savedAt) head.appendChild(el('span', 'text-[11px] text-gray-500 italic', reg.savedAt));
      card.appendChild(head);
      wrap.appendChild(card);
    });
  }

  // Asignaciones detalladas por categoría (nombre → jugador)
  function renderAssignments(d: ParsedSavedVariables): void {
    const wrap = document.getElementById('viewer-assignments') as HTMLElement;
    wrap.innerHTML = '';
    const labels: Record<keyof Assignments, string> = {
      roles: 'Roles',
      buffs: 'Bendiciones',
      abilities: 'Habilidades',
      auras: 'Auras',
    };
    let any = false;
    (Object.keys(labels) as (keyof Assignments)[]).forEach((cat) => {
      const entries = Object.entries(d.assignments[cat]);
      if (entries.length === 0) return;
      any = true;
      const box = el('div', '');
      box.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1', labels[cat]));
      const rows = el('div', 'grid grid-cols-1 sm:grid-cols-2 gap-1');
      entries.forEach(([name, player]) => {
        const row = el('div', 'text-xs text-gray-300 flex justify-between gap-3 bg-gray-900/40 rounded px-2 py-1');
        row.appendChild(el('span', 'font-bold text-amber-200', name));
        row.appendChild(el('span', 'text-gray-400', player));
        rows.appendChild(row);
      });
      box.appendChild(rows);
      wrap.appendChild(box);
    });
    if (!any) {
      wrap.innerHTML = '<p class="text-[11px] text-gray-600 italic">Sin asignaciones aún.</p>';
    }
  }

  // Banner de reclamo: si el snapshot acredita liderazgo de alguna hermandad
  // que el usuario aún no ha reclamado (puede ser maestro de varias).
  function updateClaimBanner(leads: boolean | null = null): void {
    if (leads !== null) lastLeads = leads;
    const unclaimed = snapshotGmGuilds.filter((n) =>
      !myGuilds.some((g) => g.name.trim().toLowerCase() === n.trim().toLowerCase()));
    document.getElementById('claim-banner')?.classList.toggle('hidden', !(lastLeads && unclaimed.length > 0));
  }

  const claimBtn = document.getElementById('claim-btn') as HTMLButtonElement;
  claimBtn.addEventListener('click', async () => {
    if (!currentSvId) return;
    claimBtn.disabled = true; claimBtn.textContent = 'Reclamando…';

    // Promoción pendiente: una cuenta con >= 2 personajes registrados pasa a
    // Miembro en BD. Sin esto, un Visitante que ya cumple la regla chocaría
    // con "Requiere ser Miembro o Maestro" del RPC de reclamo.
    const promo = await tryPromoteMember(currentSvId);
    if (promo.ok && promo.data?.promoted) {
      currentRole = 'member';
      badgeEl.textContent = ROLE_LABELS.member ?? 'member';
      badgeEl.className = `px-3 py-1.5 rounded-md text-[11px] font-black uppercase tracking-widest border ${ROLE_STYLES.member}`;
    }

    const res = await claimGuildFromSV(currentSvId);
    claimBtn.disabled = false; claimBtn.textContent = 'Reclamar mis hermandades';
    if (res.ok) {
      msgBox('claim-msg', true, '¡Hermandad(es) reclamada(s)! Ya eres Maestro: publícalas desde Hermandad.');
      updateClaimBanner(false);
      void loadGuilds();
      void loadProfile();
    } else {
      const err = res.error || '';
      if (err.includes('3 personajes')) {
        msgBox('claim-msg', false, 'Tu SV acredita maestría de hermandad, pero el reclamo requiere al menos 3 personajes validados. Registra otro personaje y vuelve a subir tu SV.');
      } else if (err.includes('Miembro')) {
        msgBox('claim-msg', false, 'La promoción a Miembro requiere al menos dos personajes registrados. El reclamo se completará cuando tu cuenta quede validada.');
      } else {
        msgBox('claim-msg', false, 'No se pudo reclamar: ' + err);
      }
    }
  });

  (document.getElementById('sv-select') as HTMLSelectElement).addEventListener('change', (e) => {
    const id = (e.target as HTMLSelectElement).value;
    if (id) void renderSnapshot(id);
  });

  // ── Mis Bandas ───────────────────────────────────────────────────────────
  // Las bandas y reglas nacen del SV (el addon es la única fuente; sin
  // formularios). Aquí solo se controla la visibilidad pública de cada una.
  function bandPlayerCount(b: BandRow): number {
    if (!Array.isArray(b.players)) return 0;
    return b.players.length;
  }

  function bandRuleCount(b: BandRow): number {
    if (!Array.isArray(b.rules)) return 0;
    return b.rules.length;
  }

  function bandAssignedRules(b: BandRow): ContentItem[] {
    if (!Array.isArray(b.rules)) return [];
    return b.rules as ContentItem[];
  }

  // Clave de identidad de una regla (para marcar/desmarcar en el catálogo).
  function ruleKey(r: ContentItem): string {
    return `${(r.title ?? '').trim()}|${(r.content ?? '').trim()}`;
  }

  // Identidad ESTABLE de una regla para el toggle del GM: el TÍTULO (o el
  // contenido si no hay título). Al cambiar el CONTENIDO de una regla del
  // proponente, la selección del GM sigue coincidiendo y la página de banda
  // permanece sincronizada (el toggle no se congela con title|content).
  function ruleId(r: { title?: string | null; content?: string | null }): string {
    return (r.title ?? '').trim() || (r.content ?? '').trim();
  }

function renderBandDetail(b: BandRow): HTMLElement {
    const card = el('div', 'bg-gray-900/60 backdrop-blur-sm border border-amber-600/30 rounded-md p-5');
    const blocked = !canPublishContent();

    // ── Visibilidad: switches tipo pill ────────────────────────────────────
    // Interruptor on/off con knob deslizante (Tailwind peer). El label lleva
    // el checkbox sr-only; el track usa after: para el knob animado.
    const makeSwitch = (
      checked: boolean,
      text: string,
      on: (input: HTMLInputElement, status: HTMLElement) => Promise<void>,
    ): HTMLElement => {
      const label = document.createElement('label');
      label.className = 'flex items-center gap-2.5 cursor-pointer select-none text-xs text-gray-400';
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'peer sr-only';
      input.checked = checked;
      const track = el('span', 'relative w-9 h-5 rounded-full bg-gray-700/80 border border-gray-600/60 transition-colors after:content-[""] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-gray-300 after:shadow after:transition-transform after:duration-200 peer-checked:bg-amber-600/70 peer-checked:border-amber-500/60 peer-checked:after:translate-x-4 peer-checked:after:bg-white');
      const textEl = el('span', '', text);
      const status = el('span', 'text-[10px] font-bold uppercase tracking-widest', '');
      label.append(input, track, textEl, status);
      if (blocked) {
        input.disabled = true;
        track.classList.add('opacity-40');
        label.classList.add('opacity-70', 'cursor-not-allowed');
        label.title = 'Requiere cuenta Miembro validada (2+ personajes).';
        status.textContent = 'bloqueado';
        status.className = 'text-[10px] font-bold uppercase tracking-widest text-gray-500';
      } else {
        input.addEventListener('change', () => void on(input, status));
      }
      return label;
    };

    const visBox = el('div', 'space-y-3');
    visBox.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-gray-500', 'Visibilidad pública'));
    const toggles = el('div', 'flex flex-wrap gap-5');
    toggles.appendChild(makeSwitch(b.is_public, 'Pública', async (input, status) => {
      input.disabled = true;
      status.textContent = 'guardando…';
      status.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
      const res = await setBandVisibility(b.id, input.checked);
      input.disabled = false;
      if (res.ok) {
        b.is_public = input.checked;
        refreshHdrBands();
        status.textContent = input.checked ? '✓ pública' : '✓ privada';
        status.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
      } else {
        input.checked = !input.checked;
        status.textContent = '✗ error';
        status.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
      }
      window.setTimeout(() => { status.textContent = ''; }, 2500);
    }));
    toggles.appendChild(makeSwitch(b.hide_players, 'Ocultar jugadores', async (input, status) => {
      input.disabled = true;
      status.textContent = 'guardando…';
      status.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
      const res = await setBandHidePlayers(b.id, input.checked);
      input.disabled = false;
      if (res.ok) {
        b.hide_players = input.checked;
        status.textContent = input.checked ? '✓ ocultos' : '✓ visibles';
        status.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
      } else {
        input.checked = !input.checked;
        status.textContent = '✗ error';
        status.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
      }
      window.setTimeout(() => { status.textContent = ''; }, 2500);
    }));
    visBox.appendChild(toggles);
    card.appendChild(visBox);

    // ── Hermandad: asignación (1:N) + propuesta de integración ─────────────
    const assign = el('div', 'mt-4 border-t border-gray-700/50 pt-3 space-y-3');
    assign.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-gray-500', 'Hermandad'));

    // El texto de la propuesta muestra el maestro destino (la hermandad del
    // select): la solicitud va al GM de esa guild, no a otra. El select fija
    // el DESTINO (integration_target_guild_id); la atribución real (guild_id)
    // ocurre solo cuando el GM la aprueba.
    const effGuild = b.integration_target_guild_id ?? b.guild_id;
    let propTarget: Text | null = null;
    const refreshPropTarget = (): void => {
      if (!propTarget) return;
      const g = membershipGuilds.find((x) => x.id === (b.integration_target_guild_id ?? b.guild_id));
      propTarget.textContent = g
        ? `Enviar solicitud de integración al maestro de ${g.name}`
        : 'Proponer integración al maestro';
    };

    const gRow = el('div', 'flex flex-wrap items-center gap-2');
    const select = document.createElement('select');
    select.className = 'flex-1 min-w-[200px] px-3 py-2 rounded-md bg-gray-950/70 border border-gray-700 text-sm text-gray-200 focus:border-amber-600/60 focus:outline-none';
    const personalOpt = document.createElement('option');
    personalOpt.value = '';
    personalOpt.textContent = 'Sin hermandad (personal)';
    select.appendChild(personalOpt);
    membershipGuilds.forEach((g) => {
      const opt = document.createElement('option');
      opt.value = g.id;
      opt.textContent = g.name;
      if (effGuild === g.id) opt.selected = true;
      select.appendChild(opt);
    });
    if (!effGuild) personalOpt.selected = true;
    const gStatus = el('span', 'text-[10px] font-bold uppercase tracking-widest', '');
    const gErr = el('span', 'text-[10px] font-bold uppercase tracking-widest text-red-400', '');
    if (blocked) {
      select.disabled = true;
      select.className += ' opacity-40';
      gStatus.textContent = 'bloqueado';
      gStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-gray-500';
    } else {
      select.addEventListener('change', async () => {
        select.disabled = true;
        gStatus.textContent = 'guardando…';
        gStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
        gErr.textContent = '';
        const gid = select.value === '' ? null : select.value;
        const res = await setBandGuild(b.id, gid);
        select.disabled = false;
        if (res.ok) {
          // El select fija el DESTINO de la propuesta; la atribución (guild_id)
          // solo la concede el GM al aprobar. Al cambiar de hermandad (o a
          // personal) la banda sale del portal y vuelve a 'none' en espera.
          const prevEff = b.integration_target_guild_id ?? b.guild_id;
          b.integration_target_guild_id = gid;
          if (gid !== prevEff) {
            b.guild_id = null;
            b.integration_status = 'none';
            b.is_rank_integrated = false;
            b.integration_proposed_by = null;
            b.integration_proposed_at = null;
            b.integration_decided_at = null;
          }
          refreshHdrBands();
          prop.checked = false;
          refreshPropose();
          refreshPropTarget();
          gStatus.textContent = '✓';
          gStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
        } else {
          select.value = b.integration_target_guild_id ?? b.guild_id ?? '';
          gStatus.textContent = '';
          gErr.textContent = res.error || 'error';
        }
        window.setTimeout(() => { gStatus.textContent = ''; }, 2500);
      });
    }
    gRow.append(select, gStatus, gErr);
    assign.appendChild(gRow);

    // Checkbox "proponer integración" — solo si la banda está asignada a una
    // hermandad y aún no está integrada/aprobada. El maestro la valida.
    const propLabel = document.createElement('label');
    propLabel.className = 'flex items-center gap-2 cursor-pointer select-none text-xs text-gray-400';
    const prop = document.createElement('input');
    prop.type = 'checkbox';
    prop.className = 'w-4 h-4 accent-amber-500';
    prop.checked = b.integration_status === 'pending';
    const propStatus = el('span', 'ml-1 text-[10px] font-bold uppercase tracking-widest', '');
    // Estado del control de propuesta: reactivo al DESTINO (target) y al estado
    // de integración. Se evalúa al renderizar y se re-evalúa al cambiar la
    // hermandad (elegir una guild habilita el check, "Sin hermandad" lo deshabilita).
    const refreshPropose = (): void => {
      const effG = b.integration_target_guild_id ?? b.guild_id;
      const canPropose = !blocked && !!effG && b.integration_status !== 'approved';
      const baseLabelCls = 'flex items-center gap-2 cursor-pointer select-none text-xs text-gray-400';
      if (!canPropose) {
        prop.disabled = true;
        prop.className = 'w-4 h-4 accent-amber-500 opacity-40';
        propLabel.className = baseLabelCls + ' opacity-60 cursor-not-allowed';
        propLabel.title = !effG
          ? 'Asigna la banda a una hermandad para proponer su integración.'
          : (b.integration_status === 'approved' ? 'Esta banda ya está integrada al portal.' : 'Requiere cuenta Miembro validada.');
      } else {
        prop.disabled = false;
        prop.className = 'w-4 h-4 accent-amber-500';
        propLabel.className = baseLabelCls;
        propLabel.title = '';
      }
    };
    refreshPropose();
    prop.addEventListener('change', async () => {
      if (!prop.checked) return; // retirar propuesta = el GM decide; aquí no se despropone
      prop.disabled = true;
      propStatus.textContent = 'proponiendo…';
      propStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-sky-300';
      const res = await proposeBandIntegration(b.id);
      prop.disabled = false;
      if (res.ok) {
        b.integration_status = 'pending';
        prop.checked = true;
        propStatus.textContent = '✓ propuesta enviada al maestro';
        propStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-sky-300';
        refreshHdrBands();
      } else {
        prop.checked = false;
        propStatus.textContent = '✗ ' + (res.error || 'error');
        propStatus.className = 'ml-1 text-[10px] font-bold uppercase tracking-widest text-red-400';
      }
      window.setTimeout(() => { propStatus.textContent = ''; }, 3500);
    });
    propTarget = document.createTextNode('');
    refreshPropTarget();
    propLabel.append(prop, document.createTextNode(' '), propTarget, propStatus);
    assign.appendChild(propLabel);
    card.appendChild(assign);

    // ── Reglas: tags removibles + select de agregar ────────────────────────
    const rulesBox = el('div', 'mt-4 border-t border-gray-700/50 pt-3 space-y-2');
    const rulesHead = el('div', 'flex flex-wrap items-center justify-between gap-2');
    rulesHead.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500', 'Reglas de esta banda'));
    const rulesStatus = el('span', 'text-[10px] font-bold uppercase tracking-widest', '');
    rulesHead.appendChild(rulesStatus);
    rulesBox.appendChild(rulesHead);
    // Jerarquía: si la banda está destinada (target) o integrada (guild_id) a
    // una hermandad, la publicación final la decide el maestro en su visor:
    // estas reglas son el CONTENIDO que el GM activa/desactiva.
    const genderJ = b.integration_target_guild_id || b.guild_id;
    if (genderJ) {
      rulesBox.appendChild(el('p', 'text-[10px] text-gray-500 italic', 'Integrada a una hermandad: el maestro decide cuáles de estas reglas se publican en el portal (visor "Bandas propuestas"). Aquí solo editas el contenido del catálogo.'));
    }

    const tagsWrap = el('div', 'flex flex-wrap gap-2');
    rulesBox.appendChild(tagsWrap);

    const renderTags = (): void => {
      tagsWrap.innerHTML = '';
      const assigned = bandAssignedRules(b);
      if (assigned.length === 0) {
        tagsWrap.appendChild(el('p', 'text-[11px] text-gray-500 italic', 'Sin reglas asignadas a esta banda.'));
        return;
      }
      assigned.forEach((r) => {
        const tag = el('span', 'inline-flex items-center gap-1.5 text-[11px] text-amber-100 bg-amber-950/40 border border-amber-600/40 rounded-md pl-2.5 pr-1 py-1');
        const full = r.content && r.content !== r.title ? r.content : undefined;
        tag.title = full ?? '';
        tag.appendChild(el('span', '', r.title ?? r.content ?? 'Regla'));
        if (!blocked) {
          const rm = document.createElement('button');
          rm.type = 'button';
          rm.className = 'w-4 h-4 shrink-0 rounded-md text-amber-200/70 hover:text-red-300 hover:bg-red-950/40 flex items-center justify-center transition-colors';
          rm.textContent = '×';
          rm.title = 'Quitar regla';
          rm.addEventListener('click', () => {
            const prev = bandAssignedRules(b).slice();
            const next = prev.filter((a) => ruleKey(a) !== ruleKey(r));
            if (next.length === prev.length) return;
            b.rules = next as unknown as BandRow['rules'];
            renderTags();
            rebuildAddSelect();
            void saveRules(next, prev);
          });
          tag.appendChild(rm);
        }
        tagsWrap.appendChild(tag);
      });
    };
    renderTags();

    // Select "agregar regla": lista SOLO las reglas del catálogo aún no
    // asignadas a esta banda; elegir una la añade como tag y persiste.
    const addRow = el('div', 'flex flex-wrap items-center gap-2');
    const addSelect = document.createElement('select');
    addSelect.className = 'flex-1 min-w-[220px] px-3 py-2 rounded-md bg-gray-950/70 border border-gray-700 text-sm text-gray-200 focus:border-amber-600/60 focus:outline-none';
    const rebuildAddSelect = (): void => {
      addSelect.innerHTML = '';
      const assigned = bandAssignedRules(b);
      const assignedKeys = new Set(assigned.map(ruleKey));
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.disabled = true;
      placeholder.selected = true;
      placeholder.textContent = assignedKeys.size === rulesCatalog.length
        ? 'No quedan reglas del catálogo por agregar'
        : '+ Agregar regla del catálogo…';
      addSelect.appendChild(placeholder);
      rulesCatalog.forEach((r) => {
        if (assignedKeys.has(ruleKey(r))) return;
        const opt = document.createElement('option');
        opt.value = ruleKey(r);
        opt.textContent = r.title ?? r.content ?? 'Regla sin texto';
        addSelect.appendChild(opt);
      });
      addSelect.disabled = blocked || rulesCatalog.length === 0;
      if (addSelect.disabled) addSelect.classList.add('opacity-40');
      else addSelect.classList.remove('opacity-40');
    };
    rebuildAddSelect();
    addSelect.addEventListener('change', async () => {
      const key = addSelect.value;
      if (!key) return;
      const r = rulesCatalog.find((x) => ruleKey(x) === key);
      if (!r) return;
      const prev = bandAssignedRules(b).slice();
      const next = bandAssignedRules(b);
      if (!next.some((a) => ruleKey(a) === key)) next.push(r);
      b.rules = next as unknown as BandRow['rules'];
      renderTags();
      rebuildAddSelect();
      addSelect.value = '';
      void saveRules(next, prev);
    });

    const saveRules = async (next: ContentItem[], prev: ContentItem[]): Promise<void> => {
      rulesStatus.textContent = 'guardando…';
      rulesStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
      const res = await setBandRules(b.id, next);
      if (res.ok) {
        b.rules = next as unknown as BandRow['rules'];
        rulesStatus.textContent = '✓';
        rulesStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
      } else {
        b.rules = prev as unknown as BandRow['rules'];
        rulesStatus.textContent = '✗ ' + (res.error || 'error');
        rulesStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
      }
      renderTags();
      rebuildAddSelect();
      window.setTimeout(() => { rulesStatus.textContent = ''; }, 2500);
    };

    rulesBox.appendChild(addRow);
    addRow.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500 shrink-0', 'Agregar'));
    addRow.appendChild(addSelect);
    if (rulesCatalog.length === 0) {
      addSelect.classList.add('hidden');
      addRow.appendChild(el('span', 'text-[11px] text-gray-500 italic', 'Sin reglas disponibles: sube un SavedVariables con reglas para asignarlas a esta banda.'));
    }
    card.appendChild(rulesBox);

    card.appendChild(el('p', 'mt-3 text-[11px] text-gray-500 italic', 'Jugadores y horario se actualizan re-subiendo tu SavedVariables; las reglas de esta banda las eliges tú aquí.'));

    return card;
  }

  function populateBandSelect(): void {
    const wrap = document.getElementById('band-select-wrap') as HTMLElement;
    const sel = document.getElementById('band-select') as HTMLSelectElement;
    sel.innerHTML = '';
    allBands.forEach((b, i) => {
      const opt = document.createElement('option');
      opt.value = b.id;
      const name = b.name || 'Banda sin nombre';
      opt.textContent = b.schedule ? `${i + 1}. ${name} · ${b.schedule}` : `${i + 1}. ${name}`;
      if (b.id === currentBandId) opt.selected = true;
      sel.appendChild(opt);
    });
    updateBandCounter();
    // Evita listeners duplicados si loadBands corre varias veces.
    sel.replaceWith(sel.cloneNode(true));
    (document.getElementById('band-select') as HTMLSelectElement).addEventListener('change', (e) => {
      const id = (e.target as HTMLSelectElement).value;
      currentBandId = id;
      showBandDetail(id);
    });
    wrap.classList.toggle('hidden', allBands.length === 0);
  }

  function updateBandCounter(): void {
    const counter = document.getElementById('band-counter') as HTMLElement | null;
    if (!counter) return;
    const total = allBands.length;
    if (total === 0) {
      counter.textContent = '';
      return;
    }
    const idx = currentBandId ? allBands.findIndex((x) => x.id === currentBandId) + 1 : 1;
    counter.textContent = `${idx} de ${total}`;
  }

  function showBandDetail(id: string): void {
    const detailEl = document.getElementById('band-detail') as HTMLElement;
    const band = allBands.find((b) => b.id === id);
    if (!band) {
      detailEl.classList.add('hidden');
      updateBandCounter();
      refreshHdrBandSelected();
      return;
    }
    updateBandCounter();
    refreshHdrBandSelected();
    detailEl.innerHTML = '';
    detailEl.classList.remove('hidden');
    detailEl.appendChild(renderBandDetail(band));
  }

  // ── Navegador de hermandades (patrón del selector de bandas) ─────────────

  function populateGuildSelect(): void {
    const wrap = document.getElementById('guild-select-wrap') as HTMLElement;
    const sel = document.getElementById('guild-select') as HTMLSelectElement;
    sel.innerHTML = '';
    myGuilds.forEach((g, i) => {
      const opt = document.createElement('option');
      opt.value = g.id;
      const realm = g.realm ? ` · ${g.realm}` : '';
      opt.textContent = `${i + 1}. ${g.name}${realm}`;
      if (g.id === currentGuildId) opt.selected = true;
      sel.appendChild(opt);
    });
    updateGuildCounter();
    // Evita listeners duplicados si loadGuilds corre varias veces.
    sel.replaceWith(sel.cloneNode(true));
    (document.getElementById('guild-select') as HTMLSelectElement).addEventListener('change', (e) => {
      const id = (e.target as HTMLSelectElement).value;
      currentGuildId = id;
      showGuildDetail(id);
    });
    wrap.classList.toggle('hidden', myGuilds.length === 0);
  }

  function updateGuildCounter(): void {
    const counter = document.getElementById('guild-counter') as HTMLElement | null;
    if (!counter) return;
    const total = myGuilds.length;
    if (total === 0) {
      counter.textContent = '';
      return;
    }
    const idx = currentGuildId ? myGuilds.findIndex((x) => x.id === currentGuildId) + 1 : 1;
    counter.textContent = `${idx} de ${total}`;
  }

  function showGuildDetail(id: string): void {
    const cardsEl = document.getElementById('guild-cards') as HTMLElement;
    const guild = myGuilds.find((g) => g.id === id);
    if (!guild) {
      cardsEl.innerHTML = '';
      updateGuildCounter();
      return;
    }
    updateGuildCounter();
    refreshHdrGuild();
    cardsEl.innerHTML = '';
    cardsEl.appendChild(renderGuildCard(guild));
  }

  async function loadBands(): Promise<void> {
    await profileReady;
    const selectWrap = document.getElementById('band-select-wrap') as HTMLElement;
    const detailEl = document.getElementById('band-detail') as HTMLElement;
    const emptyEl = document.getElementById('bands-empty') as HTMLElement;
    const statusEl = document.getElementById('bands-status') as HTMLElement;

    const [res, memRes, rulesRes] = await Promise.all([getMyBands(), getMyMembershipGuilds(), getMyRulesCatalog()]);
    if (!res.ok) {
      selectWrap.classList.add('hidden');
      detailEl.classList.add('hidden');
      emptyEl.classList.add('hidden');
      statusEl.textContent = 'No se pudieron cargar tus bandas: ' + (res.error || '');
      return;
    }
    if (memRes.ok) membershipGuilds = memRes.items ?? [];
    if (rulesRes.ok) rulesCatalog = rulesRes.items ?? [];
    const items = res.items ?? [];
    allBands = items;
    currentBandId = items[0]?.id ?? null;
    const onboardingEl = document.getElementById('bands-onboarding') as HTMLElement;

    selectWrap.classList.toggle('hidden', items.length === 0);
    emptyEl.classList.toggle('hidden', items.length > 0);
    statusEl.textContent = '';
    refreshHdrBands();
    if (items.length > 0) {
      populateBandSelect();
      showBandDetail(currentBandId!);
    } else {
      detailEl.innerHTML = '';
      detailEl.classList.add('hidden');
    }

    // Onboarding: un Visitante sin personajes validados no puede publicar.
    onboardingEl.classList.toggle('hidden', !(items.length > 0 && !canPublishContent()));
    onboardingEl.textContent = PUBLISH_GATE_MSG;
  }

  // ── Mi Hermandad ─────────────────────────────────────────────────────────
  // ── Mi Hermandad (multi-hermandad) ───────────────────────────────────────

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;');
  }

  function setMsg(el: HTMLElement, ok: boolean, text: string): void {
    el.textContent = text;
    el.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ok ? 'bg-emerald-950/30 border border-emerald-600/40 text-emerald-300' : 'bg-red-950/40 border border-red-600/40 text-red-300'}`;
  }

  // Cifras relevantes de la hermandad para el tab /dashboard#hermandad: número
  // de miembros del roster del snapshot, bandas integradas al portal (leídas en
  // tiempo real) y reglas del último análisis. Sin roster paginado aquí.
  async function loadGuildStats(g: GuildRow): Promise<void> {
    const [res, bandsRes, rulesRes] = await Promise.all([
      getGuildSnapshot(g.id),
      listGuildPortalBands(g.id),
      getGuildRules(g.id),
    ]);
    const members = res.ok && res.snapshot ? res.snapshot.members.length : 0;
    const integrated = bandsRes.ok ? bandsRes.bands?.length ?? 0 : 0;
    // Reglas publicadas = SOLO las que eligió el maestro (el snapshot ya no
    // aporta catálogo desde 2026-09-06; subir un SV no llena reglas).
    const rules = rulesRes.ok && Array.isArray(rulesRes.items)
      ? rulesRes.items.length
      : 0;
    guildMembersCount.set(g.id, members);
    guildBandsCount.set(g.id, integrated);
    guildRulesCount.set(g.id, rules);
    refreshHdrGuild();
  }

  // Propuestas de integración de bandas de los miembros: el GM (owner) ve las
  // bandas de su hermandad propuestas por miembros con rango autorizado. Las
  // reglas provienen SIEMPRE de la banda del proponente: el GM las TOGGLEA
  // (cuáles se publican) sin borrarlas ni grabarlas en su propia data; la
  // selección se guarda en guild_config('band_integration_rules'). Las
  // RE-APROBADAS permanecen en la lista (se pueden re-chazar después); las
  // RECHAZADAS salen de la lista.
  async function loadBandProposals(g: GuildRow, body: HTMLElement): Promise<void> {
    const sec = body.closest<HTMLElement>('[data-prop-sec]');
    const countEl = sec?.querySelector<HTMLElement>('[data-prop-count]') ?? null;

    const [res, rulesRes] = await Promise.all([
      getGuildBandProposals(g.id),
      getGuildBandIntegrationRules(g.id),
    ]);
    if (!res.ok) {
      body.innerHTML = '<p class="text-sm text-gray-400 italic">No se pudieron cargar las propuestas: ' + (res.error || '') + '</p>';
      if (countEl) countEl.textContent = '0 pendientes';
      return;
    }
    // Las bandas rechazadas salen de la lista (solo pendientes y aprobadas).
    const items = (res.items ?? []).filter((bp) => bp.integration_status !== 'rejected');
    // Selección vigente del GM por banda (claves de regla activas). Ninguna
    // regla nace activa: la autoridad ES la selección explícita del visor —
    // el GM activa/desactiva las que quiere PUBLICAR de la banda integrada
    // (las del proponente nunca salen solas por defecto).
    const selection: Record<string, Set<string>> = {};
    if (rulesRes.ok && rulesRes.selection) {
      Object.entries(rulesRes.selection).forEach(([bid, keys]) => {
        selection[bid] = new Set(keys ?? []);
      });
    }
    let pending = items.filter((bp) => bp.integration_status === 'pending').length;
    const renderCount = (): void => {
      if (countEl) countEl.textContent = `${pending} pendiente${pending === 1 ? '' : 's'}`;
    };
    renderCount();

    if (items.length === 0) {
      body.innerHTML = '<p class="text-sm text-gray-400 italic">Aún no hay bandas propuestas por tus miembros.</p>';
      return;
    }

    body.innerHTML = '';
    items.forEach((bp, i) => {
      const row = el('div', 'bg-gray-900/40 border border-amber-600/15 rounded-md px-3 py-2.5');
      const head = el('div', 'flex flex-wrap items-center gap-2');
      const num = el('span', 'shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center', String(i + 1));
      head.appendChild(num);
      const info = el('div', 'min-w-0 flex-1');
      info.appendChild(el('p', 'font-bold text-white text-sm truncate', bp.name));
      // Personaje que propone: se muestra con las reglas para atribuir cada
      // regla al proponente (nunca al aprobante).
      const who = (bp.proposer?.character_name || bp.proposer?.display_name || (bp.proposer?.slug ? `@${bp.proposer.slug.replace(/^perfil-/, '').slice(0, 8)}` : null)) ?? 'cuenta';
      const sub = el('p', 'text-[11px] text-gray-500');
      const stateChip = el('span', 'hidden mt-1 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-widest border rounded-md px-2 py-0.5');
      const refreshState = (): void => {
        if (bp.integration_status === 'pending') {
          sub.textContent = `Propuesta por ${who}${bp.integration_proposed_at ? ' · ' + new Date(bp.integration_proposed_at).toLocaleDateString('es') : ''}`;
          stateChip.classList.add('hidden');
          return;
        }
        const approved = bp.integration_status === 'approved';
        sub.textContent = '';
        stateChip.textContent = approved ? '✓ Aprobada' : '✗ Rechazada';
        stateChip.className = 'mt-1 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-widest border rounded-md px-2 py-0.5 ' +
          (approved ? 'bg-emerald-950/30 border-emerald-600/40 text-emerald-300' : 'bg-red-950/30 border-red-600/40 text-red-300');
        stateChip.appendChild(document.createTextNode(bp.integration_decided_at ? ' · ' + new Date(bp.integration_decided_at).toLocaleDateString('es') : ''));
        stateChip.classList.remove('hidden');
      };
      info.appendChild(sub);
      info.appendChild(stateChip);
      head.appendChild(info);

      const act = el('div', 'flex gap-2 shrink-0');
      const approve = document.createElement('button');
      approve.type = 'button';
      approve.className = 'px-3 py-1.5 rounded-md text-[10px] font-black uppercase tracking-widest border border-emerald-600/40 bg-emerald-950/30 text-emerald-300 hover:bg-emerald-900/40 transition-all';
      approve.textContent = 'Aprobar';
      const reject = document.createElement('button');
      reject.type = 'button';
      reject.className = 'px-3 py-1.5 rounded-md text-[10px] font-black uppercase tracking-widest border border-red-600/40 bg-red-950/30 text-red-300 hover:bg-red-900/40 transition-all';
      reject.textContent = 'Rechazar';
      const saving = el('span', 'text-[10px] font-bold uppercase tracking-widest', '');
      act.append(approve, reject, saving);
      // El GM puede re-decidir en cualquier momento: los botones NUNCA se
      // ocultan; solo se desactiva el de la decisión ya aplicada (p. ej. una
      // banda aprobada sigue pudiendo rechazarse).
      const renderActions = (): void => {
        approve.disabled = bp.integration_status === 'approved';
        reject.disabled = bp.integration_status === 'rejected';
        approve.title = approve.disabled ? 'Ya está aprobada' : 'Aprobar esta banda';
        reject.title = reject.disabled ? 'Ya está rechazada' : 'Rechazar esta banda';
      };
      renderActions();
      head.appendChild(act);
      row.appendChild(head);

      // Reglas de la banda propuesta (SIEMPRE desde el proponente): el GM las
      // TOGGLEA como tags — las activas son las que se publican. Nunca se
      // elimina una regla de la data del proponente (se guarda la selección).
      const proposed = Array.isArray(bp.rules) ? (bp.rules as ContentItem[]) : [];
      // La selección guardada es la AUTORIDAD y nace vacía: el GM ACTIVA cada
      // regla que quiere publicar. Ninguna regla del proponente se publica
      // sola por defecto (ni en pendientes ni en integradas).
      const keyFor = (r: ContentItem): string => ruleId(r);
      const ruleSelected = (keys: Set<string>, r: ContentItem): boolean =>
        keys.has(ruleId(r)) || keys.has(`${(r.title ?? '').trim()}|${(r.content ?? '').trim()}`);
      const baseSelection = (): Set<string> => selection[bp.id] ?? new Set();
      const isOn = (r: ContentItem): boolean => ruleSelected(baseSelection(), r);
      const rulesBox = el('div', 'mt-3 border-t border-amber-600/20 pt-2.5 space-y-2');
      const rulesHead = el('div', 'flex flex-wrap items-center justify-between gap-2');
      rulesHead.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500', 'Reglas propuestas por ' + (escapeHtml(who) || 'el jugador')));
      rulesHead.appendChild(el('span', 'text-[11px] text-gray-500 italic', 'ACTÍVALAS para publicarlas; las que dejes apagadas no salen del proponente al portal. Si apruebas sin activar, la banda se integra sin reglas.'));
      rulesBox.appendChild(rulesHead);
      const tagsWrap = el('div', 'flex flex-wrap gap-2');
      rulesBox.appendChild(tagsWrap);
      let savingRules = false;
      const persistSelection = async (): Promise<void> => {
        if (savingRules) return;
        savingRules = true;
        const map: Record<string, string[]> = {};
        Object.entries(selection).forEach(([bid, keys]) => { map[bid] = Array.from(keys); });
        const saved = await setGuildBandIntegrationRules(g.id, map);
        savingRules = false;
        saving.textContent = saved.ok ? '✓' : '✗ ' + (saved.error || 'error');
        saving.className = 'text-[10px] font-bold uppercase tracking-widest ' + (saved.ok ? 'text-emerald-400' : 'text-red-400');
        window.setTimeout(() => { saving.textContent = ''; }, 1800);
      };
      const renderTags = (): void => {
        tagsWrap.innerHTML = '';
        if (proposed.length === 0) {
          tagsWrap.appendChild(el('p', 'text-[11px] text-gray-500 italic', 'Esta banda no trae reglas propuestas: se integrará sin reglas publicadas.'));
          return;
        }
        proposed.forEach((r) => {
          const on = isOn(r);
          const tag = document.createElement('button');
          tag.type = 'button';
          const label = `${r.title ?? r.content ?? 'Regla'} · ${who}`;
          tag.className = 'inline-flex items-center gap-1.5 text-[11px] rounded-md pl-2.5 pr-2 py-1 border transition-all ' +
            (on
              ? 'text-amber-100 bg-amber-950/40 border-amber-600/40 hover:bg-amber-900/50'
              : 'text-gray-400 bg-gray-900/60 border-gray-700/60 hover:border-gray-500/60');
          tag.title = `Regla de ${who}: ${r.content ?? r.title ?? ''}`;
          tag.appendChild(el('span', '', label));
          const dot = el('span', 'w-1.5 h-1.5 rounded-full ' + (on ? 'bg-amber-400' : 'bg-gray-600'), '');
          tag.appendChild(dot);
          tag.setAttribute('aria-pressed', String(on));
          if (tag.title) tag.title = `Regla de ${who}: ${r.content ?? r.title ?? ''}`;
          tag.addEventListener('click', () => {
            const keys = baseSelection();
            const k = keyFor(r);
            const legacyK = `${(r.title ?? '').trim()}|${(r.content ?? '').trim()}`;
            if (ruleSelected(keys, r)) {
              keys.delete(k);
              keys.delete(legacyK);
            } else {
              keys.delete(legacyK);
              keys.add(k);
            }
            selection[bp.id] = keys;
            renderTags();
            void persistSelection();
          });
          tagsWrap.appendChild(tag);
        });
      };
      renderTags();
      row.appendChild(rulesBox);

      const decide = async (status: 'approved' | 'rejected'): Promise<void> => {
        approve.disabled = true; reject.disabled = true;
        saving.textContent = 'guardando…';
        saving.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
        // Persistir la selección de esta banda SIEMPRE al aprobar (aunque quede
        // vacía): la selección guardada es la autoridad de lo que se publica
        // en la página de banda. Las reglas del proponente NO se tocan.
        if (status === 'approved') {
          const keys = baseSelection();
          selection[bp.id] = keys;
          const map: Record<string, string[]> = {};
          Object.entries(selection).forEach(([bid, ks]) => { map[bid] = Array.from(ks); });
          await setGuildBandIntegrationRules(g.id, map);
        }
        const r = await setBandIntegration(bp.id, status);
        approve.disabled = false; reject.disabled = false;
        if (r.ok) {
          const prevStatus = bp.integration_status;
          bp.integration_status = status;
          bp.integration_decided_at = new Date().toISOString();
          if (prevStatus === 'pending') pending -= 1;
          if (status === 'rejected') {
            // Las rechazadas SALEN de la lista; las aprobadas permanecen
            // (re-decidibles en cualquier momento).
            row.remove();
            renderCount();
            if (body.querySelectorAll('div[data-prop-row]').length === 0) {
              body.innerHTML = '<p class="text-sm text-gray-400 italic">Aún no hay bandas propuestas por tus miembros.</p>';
            }
          } else {
            refreshState();
            renderActions();
            renderCount();
            row.classList.add('border-amber-700/40');
          }
        } else {
          saving.textContent = '✗ error';
          saving.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
          window.setTimeout(() => { saving.textContent = ''; }, 2500);
        }
      };
      approve.addEventListener('click', () => void decide('approved'));
      reject.addEventListener('click', () => void decide('rejected'));
      refreshState();
      row.setAttribute('data-prop-row', '');
      body.appendChild(row);
    });
  }

  function renderGuildCard(g: GuildRow): HTMLElement {
    const card = el('div', 'bg-gray-900/60 backdrop-blur-sm border border-amber-600/30 rounded-md p-4 sm:p-6');

    // Cifras de la hermandad en el encabezado (integrantes, bandas integradas,
    // reglas): miembros, bandas y reglas del último análisis del portal.
    void loadGuildStats(g);

    // Portal (abre la ficha; el resto de secciones llevan separador propio)
    const url = `${window.location.origin}/${g.slug}`;
    const portal = el('div', '');
    portal.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5', 'Dirección de tu portal'));
    const urlRow = el('div', 'flex flex-wrap items-center gap-2');
    const code = el('code', 'flex-1 min-w-[240px] px-3 py-2.5 rounded-md bg-gray-950/70 border border-gray-700 text-amber-300 text-sm truncate', url);
    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'px-4 py-2.5 rounded-md border border-amber-600/30 bg-gray-800/80 text-amber-200 hover:bg-amber-900/40 hover:text-white transition-all text-xs font-black uppercase tracking-widest';
    copyBtn.textContent = 'Copiar';
    const openLink = document.createElement('a');
    openLink.href = url; openLink.target = '_blank'; openLink.rel = 'noopener';
    openLink.className = 'hidden px-4 py-2.5 rounded-md border border-emerald-600/40 bg-emerald-950/30 text-emerald-300 hover:bg-emerald-900/40 transition-all text-xs font-black uppercase tracking-widest';
    openLink.textContent = 'Ver portal →';
    urlRow.append(code, copyBtn, openLink);
    portal.appendChild(urlRow);

    const label = document.createElement('label');
    label.className = 'mt-5 flex items-start gap-3 cursor-pointer select-none border border-gray-700/60 hover:border-amber-600/40 rounded-md p-4 transition-colors';
    const input = document.createElement('input');
    input.type = 'checkbox';
    input.className = 'mt-0.5 w-4 h-4 accent-amber-500';
    input.checked = g.is_public;
    const span = document.createElement('span');
    span.className = 'text-sm text-gray-300 font-medium';
    span.innerHTML = 'Publicar portal de la hermandad <span class="block text-xs text-gray-500 italic mt-0.5">Visible para toda la comunidad con roster, bandas y reglas de tu último análisis verificado.</span>';
    label.append(input, span);
    portal.appendChild(label);
    const msg = document.createElement('p');
    msg.className = 'hidden mt-3 text-sm rounded-md px-4 py-2.5';
    msg.setAttribute('role', 'status');
    portal.appendChild(msg);
    card.appendChild(portal);

    // ── Reglas del portal: el catálogo proviene del SV pero la selección la
    // hace el maestro aquí (mismo patrón que el panel de bandas). Se guarda
    // en su propia fila guild_rules: un re-upload NO pisa esta elección.
    const reglasBox = el('div', 'mt-4 border-t border-gray-700/50 pt-3 space-y-2');
    const reglasHead = el('div', 'flex flex-wrap items-center justify-between gap-2');
    reglasHead.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-amber-500', 'Reglas que aplican a tu portal'));
    const reglasStatus = el('span', 'text-[10px] font-bold uppercase tracking-widest', '');
    reglasHead.appendChild(reglasStatus);
    reglasBox.appendChild(reglasHead);

    const reglasTags = el('div', 'flex flex-wrap gap-2');
    reglasBox.appendChild(reglasTags);

    // Selección vigente: la manual del maestro; si aún no eligió (sin fila
    // guild_rules), se parte del catálogo publicado en el último análisis.
    let guildRules: ContentItem[] = [];
    let guildRulesReady = false;
    let noCatalogHint: HTMLElement | null = null;
    const renderReglasTags = (): void => {
      reglasTags.innerHTML = '';
      if (!guildRulesReady) {
        reglasTags.appendChild(el('p', 'text-[11px] text-gray-500 italic', 'Cargando reglas…'));
        return;
      }
      if (guildRules.length === 0) {
        reglasTags.appendChild(el('p', 'text-[11px] text-gray-500 italic', 'Sin reglas asignadas: tu portal no mostrará sección de reglas.'));
        return;
      }
      guildRules.forEach((r) => {
        const tag = el('span', 'inline-flex items-center gap-1.5 text-[11px] text-amber-100 bg-amber-950/40 border border-amber-600/40 rounded-md pl-2.5 pr-1 py-1');
        const full = r.content && r.content !== r.title ? r.content : undefined;
        tag.title = full ?? '';
        tag.appendChild(el('span', '', r.title ?? r.content ?? 'Regla'));
        const rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'w-4 h-4 shrink-0 rounded-md text-amber-200/70 hover:text-red-300 hover:bg-red-950/40 flex items-center justify-center transition-colors';
        rm.textContent = '×';
        rm.title = 'Quitar regla';
        rm.addEventListener('click', () => {
          const prev = guildRules.slice();
          const next = prev.filter((a) => ruleKey(a) !== ruleKey(r));
          if (next.length === prev.length) return;
          guildRules = next;
          renderReglasTags();
          rebuildReglasSelect();
          void saveGuildReglas(next, prev);
        });
        tag.appendChild(rm);
        reglasTags.appendChild(tag);
      });
    };
    renderReglasTags();

    const reglasAddRow = el('div', 'flex flex-wrap items-center gap-2');
    const reglasAdd = document.createElement('select');
    reglasAdd.className = 'flex-1 min-w-[220px] px-3 py-2 rounded-md bg-gray-950/70 border border-gray-700 text-sm text-gray-200 focus:border-amber-600/60 focus:outline-none';
    const rebuildReglasSelect = (): void => {
      reglasAdd.innerHTML = '';
      const assigned = new Set(guildRules.map(ruleKey));
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.disabled = true;
      placeholder.selected = true;
      placeholder.textContent = assigned.size === rulesCatalog.length
        ? 'No quedan reglas del catálogo por agregar'
        : '+ Agregar regla del catálogo…';
      reglasAdd.appendChild(placeholder);
      rulesCatalog.forEach((r) => {
        if (assigned.has(ruleKey(r))) return;
        const opt = document.createElement('option');
        opt.value = ruleKey(r);
        opt.textContent = r.title ?? r.content ?? 'Regla sin texto';
        reglasAdd.appendChild(opt);
      });
      reglasAdd.disabled = !guildRulesReady || rulesCatalog.length === 0;
      if (reglasAdd.disabled) reglasAdd.classList.add('opacity-40');
      else reglasAdd.classList.remove('opacity-40');
      // Aviso cuando el SV aún no aporta catálogo (se reconcilia al cargar).
      reglasAdd.classList.toggle('hidden', rulesCatalog.length === 0);
      if (rulesCatalog.length === 0) {
        if (!noCatalogHint) {
          noCatalogHint = el('span', 'text-[11px] text-gray-500 italic', 'Sin reglas disponibles: sube un SavedVariables con reglas para asignarlas a tu portal.');
          reglasAddRow.appendChild(noCatalogHint);
        }
      } else if (noCatalogHint) {
        noCatalogHint.remove();
        noCatalogHint = null;
      }
    };
    rebuildReglasSelect();
    reglasAdd.addEventListener('change', async () => {
      const key = reglasAdd.value;
      if (!key) return;
      const r = rulesCatalog.find((x) => ruleKey(x) === key);
      if (!r) return;
      const prev = guildRules.slice();
      const next = guildRules;
      if (!next.some((a) => ruleKey(a) === key)) next.push(r);
      guildRules = next;
      renderReglasTags();
      rebuildReglasSelect();
      reglasAdd.value = '';
      void saveGuildReglas(next, prev);
    });

    const saveGuildReglas = async (next: ContentItem[], prev: ContentItem[]): Promise<void> => {
      reglasStatus.textContent = 'guardando…';
      reglasStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
      const res = await setGuildRules(g.id, next);
      if (res.ok) {
        guildRules = next;
        reglasStatus.textContent = '✓';
        reglasStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
      } else {
        guildRules = prev;
        reglasStatus.textContent = '✗ ' + (res.error || 'error');
        reglasStatus.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
      }
      renderReglasTags();
      rebuildReglasSelect();
      window.setTimeout(() => { reglasStatus.textContent = ''; }, 2500);
    };

    reglasBox.appendChild(reglasAddRow);
    reglasAddRow.appendChild(el('span', 'text-[10px] font-black uppercase tracking-widest text-gray-500 shrink-0', 'Agregar'));
    reglasAddRow.appendChild(reglasAdd);
    reglasBox.appendChild(el('p', 'mt-2 text-[11px] text-gray-500 italic', 'El catálogo proviene de tu SavedVariables (re-subir el SV lo actualiza sin tocar esta selección); tú decides qué reglas publica tu portal.'));
    card.appendChild(reglasBox);

    // Carga inicial: la selección manual del maestro. Sin selección → el
    // portal no muestra reglas (el SV no llena reglas al subir).
    void (async () => {
      const rulesRes = await getGuildRules(g.id);
      if (rulesRes.ok && Array.isArray(rulesRes.items)) guildRules = rulesRes.items;
      guildRulesReady = true;
      renderReglasTags();
      rebuildReglasSelect();
    })();

    // Propuestas de integración de bandas de los miembros (solo el GM owner).
    // El GM aprueba o rechaza; las aprobadas salen en el portal si son públicas.
    const propSec = el('div', 'mt-4 border-t border-gray-700/50 pt-4');
    propSec.setAttribute('data-prop-sec', '');
    propSec.appendChild(el('p', 'text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1', 'Integración de miembros'));
    const propHead = el('div', 'flex flex-wrap items-center justify-between gap-2 mb-2');
    propHead.appendChild(el('h4', 'text-sm font-bold text-amber-200', 'Bandas propuestas por tus miembros'));
    const propCount = document.createElement('span');
    propCount.className = 'text-[10px] font-black uppercase tracking-widest text-amber-300 bg-amber-950/30 border border-amber-600/40 rounded-md px-2 py-0.5';
    propCount.setAttribute('data-prop-count', '');
    propCount.textContent = '0 pendientes';
    propHead.appendChild(propCount);
    propSec.appendChild(propHead);
    const propShell = el('div', 'bg-gray-800/50 border border-amber-700/30 rounded-md p-4');
    const propBody = el('div', 'space-y-2');
    propBody.innerHTML = '<p class="text-sm text-gray-400 italic">Cargando propuestas…</p>';
    propShell.appendChild(propBody);
    propSec.appendChild(propShell);
    card.appendChild(propSec);
    void loadBandProposals(g, propBody);

    // Eventos
    input.addEventListener('change', async () => {
      input.disabled = true;
      const { error } = await supabase
        .from('raiddominion_guilds')
        .update({ is_public: input.checked })
        .eq('id', g.id);
      input.disabled = false;
      if (error) {
        input.checked = !input.checked;
        setMsg(msg, false, 'No se pudo cambiar la publicación del portal.');
        return;
      }
      openLink.classList.toggle('hidden', !input.checked);
      g.is_public = input.checked;
      refreshHdrGuild();
      setMsg(msg, true, input.checked ? 'Portal publicado: ya es visible en /' + g.slug : 'Portal oculto: solo tú puedes verlo.');
    });
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        setMsg(msg, true, 'Enlace copiado al portapapeles.');
      } catch {
        setMsg(msg, false, 'No se pudo copiar automáticamente.');
      }
    });
    if (g.is_public) openLink.classList.remove('hidden');

    return card;
  }

  async function loadGuilds(): Promise<void> {
    const empty = document.getElementById('guild-empty') as HTMLElement;
    const manage = document.getElementById('guild-manage') as HTMLElement;

    const res = await getMyGuilds();
    if (!res.ok) {
      myGuilds = [];
      updateClaimBanner();
      return;
    }
    const items = res.items ?? [];
    myGuilds = items;
    guildMembersCount.clear();
    guildBandsCount.clear();
    guildRulesCount.clear();
    refreshHdrGuild();
    // El aviso de "bandas sin hermandad" depende de myGuilds: se re-evalúa aquí.
    void loadBands();

    if (items.length === 0) {
      empty.classList.remove('hidden');
      manage.classList.add('hidden');
      updateClaimBanner();
      return;
    }

    empty.classList.add('hidden');
    manage.classList.remove('hidden');
    // Catálogo de reglas para el editor de cada ficha de hermandad (el mismo
    // que usa el panel de bandas: unión de raw.rules de los uploads).
    const rulesRes = await getMyRulesCatalog();
    if (rulesRes.ok) rulesCatalog = rulesRes.items ?? [];
    currentGuildId = items[0]?.id ?? null;
    populateGuildSelect();
    if (currentGuildId) showGuildDetail(currentGuildId);
    updateClaimBanner();
  }

  // ── Seguridad: contraseña y sesión ───────────────────────────────────────
  document.getElementById('save-password')?.addEventListener('click', async () => {
    const btn = document.getElementById('save-password') as HTMLButtonElement;
    const pass = (document.getElementById('new-password') as HTMLInputElement).value;
    const confirm = (document.getElementById('new-password-confirm') as HTMLInputElement).value;

    const strong = pass.length >= 8 && /[a-zA-Záéíóúüñ]/.test(pass) && /\d/.test(pass);
    if (!strong) { msgBox('password-msg', false, 'La contraseña debe tener 8+ caracteres con letra y número.'); return; }
    if (pass !== confirm) { msgBox('password-msg', false, 'Las contraseñas no coinciden.'); return; }

    btn.disabled = true; btn.textContent = 'Actualizando…';
    const { error } = await supabase.auth.updateUser({ password: pass });
    btn.disabled = false; btn.textContent = 'Actualizar contraseña';

    if (error) {
      msgBox('password-msg', false, error.message.includes('rate limit')
        ? 'Demasiados intentos; espera un momento.'
        : 'No se pudo actualizar la contraseña.');
      return;
    }
    (document.getElementById('new-password') as HTMLInputElement).value = '';
    (document.getElementById('new-password-confirm') as HTMLInputElement).value = '';
    msgBox('password-msg', true, 'Contraseña actualizada correctamente.');
  });

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.assign('/');
  });

  // ── Eliminar cuenta (solo RaidDominion; no toca auth ni otras apps) ────
  const delBtn = document.getElementById('delete-account-btn') as HTMLButtonElement;
  const delConfirm = document.getElementById('delete-account-confirm') as HTMLElement;
  const delInput = document.getElementById('delete-account-input') as HTMLInputElement;
  const delConfirmBtn = document.getElementById('delete-account-confirm-btn') as HTMLButtonElement;
  const delCancel = document.getElementById('delete-account-cancel') as HTMLButtonElement;
  const delMsg = document.getElementById('delete-account-msg') as HTMLElement;

  delBtn.addEventListener('click', () => {
    delConfirm.classList.toggle('hidden');
    if (delConfirm.classList.contains('hidden')) {
      delInput.value = '';
      delMsg.classList.add('hidden');
    }
    delConfirmBtn.disabled = true;
  });

  delCancel.addEventListener('click', () => {
    delConfirm.classList.add('hidden');
    delInput.value = '';
    delConfirmBtn.disabled = true;
    delMsg.classList.add('hidden');
  });

  delInput.addEventListener('input', () => {
    delConfirmBtn.disabled = delInput.value.trim().toUpperCase() !== 'ELIMINAR';
  });

  delConfirmBtn.addEventListener('click', async () => {
    delConfirmBtn.disabled = true;
    delConfirmBtn.textContent = 'Eliminando…';
    const res = await deleteMyAccount();
    if (!res.ok) {
      delConfirmBtn.disabled = false;
      delConfirmBtn.textContent = 'Confirmar eliminación';
      msgBox('delete-account-msg', false, 'No se pudo eliminar la cuenta: ' + (res.error || ''));
      return;
    }
    msgBox('delete-account-msg', true, 'Cuenta eliminada. Cerrando sesión…');
    await supabase.auth.signOut();
    window.location.assign('/');
  });

  // ── Resetear datos del flujo SV (uploads, personajes, hermandad) ───────
  const resetBtn = document.getElementById('reset-data-btn') as HTMLButtonElement;
  const resetConfirm = document.getElementById('reset-data-confirm') as HTMLElement;
  const resetInput = document.getElementById('reset-data-input') as HTMLInputElement;
  const resetConfirmBtn = document.getElementById('reset-data-confirm-btn') as HTMLButtonElement;
  const resetCancel = document.getElementById('reset-data-cancel') as HTMLButtonElement;
  const resetMsg = document.getElementById('reset-data-msg') as HTMLElement;

  resetBtn.addEventListener('click', () => {
    resetConfirm.classList.toggle('hidden');
    if (resetConfirm.classList.contains('hidden')) {
      resetInput.value = '';
      resetMsg.classList.add('hidden');
    }
    resetConfirmBtn.disabled = true;
  });

  resetCancel.addEventListener('click', () => {
    resetConfirm.classList.add('hidden');
    resetInput.value = '';
    resetConfirmBtn.disabled = true;
    resetMsg.classList.add('hidden');
  });

  resetInput.addEventListener('input', () => {
    resetConfirmBtn.disabled = resetInput.value.trim().toUpperCase() !== 'RESETEAR';
  });

  resetConfirmBtn.addEventListener('click', async () => {
    resetConfirmBtn.disabled = true;
    resetConfirmBtn.textContent = 'Reseteando…';
    const res = await resetMyData();
    if (!res.ok) {
      resetConfirmBtn.disabled = false;
      resetConfirmBtn.textContent = 'Confirmar reseteo';
      msgBox('reset-data-msg', false, 'No se pudo resetear: ' + (res.error || ''));
      return;
    }
    msgBox('reset-data-msg', true, 'Datos reseteados. Recargando tu espacio…');
    resetConfirm.classList.add('hidden');
    resetInput.value = '';
    resetConfirmBtn.disabled = true;
    resetConfirmBtn.textContent = 'Confirmar reseteo';
    void loadProfile();
    void loadCharacters();
    void loadHistory();
    void loadGuilds();
    void loadBands();
  });
</script>
