---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { ui } from '@/lib/ui/design';

const ctaPrincipal = `${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest`;
const ctaVacio = `${ui.btnBase} ${ui.btnPrimary} px-6 py-3 text-sm`;
---

<Layout title="Mi Dashboard - RaidDominion" description="Tu addon en la comunidad RaidDominion: registro, bandas, hermandad y perfil.">
  <Navigation currentPath="/dashboard" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto px-4">
      <Breadcrumb />

      <!-- Encabezado del espacio personal -->
      <header class="flex flex-col sm:flex-row items-center sm:items-end justify-between gap-4 mb-8 animate-fade-in-1">
        <div class="flex items-center gap-4">
          <div id="avatar" class="w-14 h-14 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center text-black text-xl font-black shadow-lg shadow-amber-900/30 select-none">–</div>
          <div>
            <h1 id="account-title" class="text-2xl md:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider">Cuenta</h1>
            <p id="user-email" class="text-gray-400 text-sm italic"></p>
          </div>
        </div>
        <span id="role-badge" class="px-3 py-1.5 rounded-md text-[11px] font-black uppercase tracking-widest border bg-gray-800/70 border-gray-600 text-gray-300">…</span>
        <a href="/upload" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[11px] font-black uppercase tracking-widest border bg-amber-900/40 border-amber-500/40 text-amber-300 hover:bg-amber-800/50 transition-colors" title="Sube tu SavedVariables">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          Subir SV
        </a>
      </header>

      <!-- Pestañas (generadas desde src/lib/ui/tabs.ts = contrato único;
           navegación con ←/→/Home/End; activación automática al enfocar) -->
      <nav id="tab-bar" class="flex flex-nowrap items-center gap-1 mb-6 border-b border-amber-600/30 animate-fade-in-1 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" style="animation-delay: 0.15s" role="tablist" aria-label="Secciones del panel"></nav>

      <!-- ── Resumen ─────────────────────────────────────────────────────── -->
      

      <!-- ── Mi Registro (config + historial + visor) ─────────────────────── -->
      <section id="panel-addon" role="tabpanel" aria-labelledby="tab-addon" class="hidden space-y-6">
        <!-- Estado vacío -->
        <div id="addon-empty" class={`hidden ${ui.panel} p-6 sm:p-8 max-w-2xl mx-auto text-center bg-gradient-to-br from-amber-900/20 to-transparent`}>
          <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1">Registro del addon</p>
          <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          <p class="font-bold text-white mb-1">Aún no subes ningún SavedVariables</p>
          <p class="text-sm text-gray-400 mb-6">Sube tu archivo <code class="text-amber-300">RaidDominion.lua</code> para ver aquí todo tu registro: personaje, hermandad y configuración del addon.</p>
          <a href="/upload" class={ctaVacio}>Ir a Subir SavedVariables</a>
          <p id="addon-empty-note" class="hidden mt-4 text-xs text-red-300"></p>
        </div>

        <div id="addon-main" class="hidden space-y-6">
          <!-- Ventana: cabecera + visor contiguos (sin gap ni radio en la junta,
               esquina inferior cuadrada) -->
          <div>
            <div class={`${ui.sectionHead} bg-gradient-to-br from-amber-900/20 to-transparent`}>
              <div class="md:flex md:items-start md:justify-between gap-6">
              <div class="min-w-0">
                <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1">Registro del addon</p>
                <h2 id="hdr-addon-title" class="text-lg font-bold text-amber-200 flex items-center">
                  <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
                  <span id="hdr-addon-title-text">Registro</span>
                </h2>
                <!-- Indicadores del análisis seleccionado (liberan el contenido
                     de repetir cifras y títulos) -->
                <div class="flex flex-wrap gap-2 mt-3" aria-label="Indicadores del registro">
                  <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                    Personajes <strong id="hdr-addon-chars" class="text-sm font-black text-amber-300">0</strong>
                  </span>
                  <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                    Hermandades <strong id="hdr-addon-guilds" class="text-sm font-black text-amber-300">0</strong>
                  </span>
                  <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                    Bandas <strong id="hdr-addon-bands" class="text-sm font-black text-amber-300">0</strong>
                  </span>
                  <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                    Reglas <strong id="hdr-addon-rules" class="text-sm font-black text-amber-300">0</strong>
                  </span>
                </div>
              </div>

              <div id="sv-select-wrap" class="md:w-80 shrink-0">
                <div class="bg-gray-950/50 border border-amber-700/30 rounded-md p-3 space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="sv-select" class="block text-[11px] font-black uppercase tracking-widest text-gray-500">Registro</label>
                    <span id="sv-counter" class="text-sm font-bold text-amber-300" aria-live="polite"></span>
                  </div>
                  <div class="relative">
                    <select id="sv-select" class="w-full px-4 py-2.5 pr-10 rounded-md bg-gray-950/80 border border-amber-700/40 text-sm text-amber-100 focus:border-amber-500/70 focus:outline-none focus:ring-2 focus:ring-amber-500/20 appearance-none cursor-pointer"></select>
                    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-amber-500/70">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Banner de reclamo condicional: franja contigua a la ventana
               (sin radio ni márgenes) entre la cabecera y el visor -->
          <div id="claim-banner" class="hidden border border-amber-600/30 border-t-0 bg-gradient-to-br from-amber-950/40 to-gray-900/60 p-4 sm:p-6">
            <h3 class="text-base font-black uppercase tracking-widest text-amber-300 mb-1">¿Lideras una o más hermandades?</h3>
            <p class="text-sm text-gray-300 mb-4">Tu SavedVariables acredita rango de liderazgo. Reclámalas y obtén el portal web gratuito de cada guild (puedes ser maestro de varias):</p>
            <ol class="space-y-2 mb-5 text-sm text-gray-300 list-none">
              <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center">1</span><span>Sube tu SavedVariables donde el addon te reporte como Maestro (<code class="text-amber-300">registry.guild.isGM</code>).</span></li>
              <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center">2</span><span>Reclama aquí tus hermandades: la ficha de cada una nace con los datos exactos del juego.</span></li>
              <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center">3</span><span>Publícalas desde Hermandad y comparte <code class="text-amber-300">/tu-hermandad</code>.</span></li>
            </ol>
            <button type="button" id="claim-btn" class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest`}>Reclamar mis hermandades</button>
            <p id="claim-msg" class="hidden mt-3 text-sm rounded-md px-4 py-2.5" role="status"></p>
          </div>

          <!-- Visor único del snapshot seleccionado: fondo sólido distintivo del
               cuerpo. El título y la fecha del análisis viven en el encabezado
               de la pestaña; aquí solo el contenido del registro. -->
          <div class={`${ui.sectionBody} space-y-5`}>

            <!-- Personaje registrado + hermandades del registro, lado a lado -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-md p-4">
                <h4 class={ui.subTitle}>Mi personaje registrado</h4>
                <div id="viewer-player" class="mt-2"></div>
              </div>
              <div class="bg-gray-800/50 border border-amber-700/30 rounded-md p-4">
                <h4 class={ui.subTitle}>Hermandades en el registro</h4>
                <div id="viewer-guilds" class="mt-2 space-y-2"></div>
              </div>
            </div>

            <!-- Personajes de la cuenta (config compartida) -->
            <div>
              <h4 class={ui.subTitle}>Personajes de la cuenta <span id="cnt-account-chars" class="text-gray-500"></span></h4>
              <div id="viewer-account-chars" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Registros por personaje (registry["Nombre-Reino"]) -->
            <details id="registries-details" class="group">
              <summary class="cursor-pointer select-none list-none inline-flex items-center gap-1.5 rounded-md px-1 -mx-1 py-0.5 text-xs font-black uppercase tracking-widest text-amber-300/80 hover:text-amber-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
                <svg aria-hidden="true" class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                Registros por personaje (<span id="cnt-registries">0</span>)
              </summary>
              <div id="viewer-registries" class="mt-3 space-y-2"></div>
            </details>

            <!-- Configuración del addon: submenús + listas + reglas -->
            <div class="bg-gray-800/50 border border-amber-700/30 rounded-md p-4 space-y-5">
              <div>
                <h4 class={ui.subTitle}>Submenús activos en tu addon</h4>
                <div id="addon-menus" class="flex flex-wrap gap-2"></div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><h4 class={ui.subTitle}>Habilidades <span id="cnt-abilities" class="text-gray-500"></span></h4><div id="list-abilities" class="space-y-1"></div></div>
                <div><h4 class={ui.subTitle}>Roles <span id="cnt-roles" class="text-gray-500"></span></h4><div id="list-roles" class="space-y-1"></div></div>
                <div><h4 class={ui.subTitle}>Bendiciones <span id="cnt-buffs" class="text-gray-500"></span></h4><div id="list-buffs" class="space-y-1"></div></div>
                <div><h4 class={ui.subTitle}>Auras <span id="cnt-auras" class="text-gray-500"></span></h4><div id="list-auras" class="space-y-1"></div></div>
              </div>

              <div>
                <h4 class={ui.subTitle}>Reglas <span id="cnt-rules" class="text-gray-500"></span></h4>
                <div id="list-rules"></div>
              </div>

              <div>
                <h4 class={ui.subTitle}>Asignaciones</h4>
                <div id="viewer-assignments" class="space-y-2"></div>
              </div>

              <div>
                <h4 class={ui.subTitle}>General</h4>
                <div id="addon-general" class="flex flex-wrap gap-2"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Mis Bandas ──────────────────────────────────────────────────── -->
      <section id="panel-bandas" role="tabpanel" aria-labelledby="tab-bandas" class="hidden">
        <div class={`${ui.sectionHead} bg-gradient-to-br from-amber-900/20 to-transparent`}>
          <div class="md:flex md:items-start md:justify-between gap-6">
            <div class="min-w-0">
              <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1">Gestión de bandas</p>
              <h2 id="hdr-band-name" class="text-lg font-bold text-amber-200 flex items-center">
                <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
                <span id="hdr-band-name-text">Mis bandas</span>
              </h2>
              <!-- Indicadores de la banda seleccionada en el navegador (liberan
                   el detalle de repetir título y badges). Horario y GS viven en
                   el título, unidos como en el selector. -->
              <div class="flex flex-wrap gap-2 mt-3" aria-label="Indicadores de la banda seleccionada">
                <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                  Jugadores <strong id="hdr-band-players" class="text-sm font-black text-amber-300">0</strong>
                </span>
                <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                  Reglas <strong id="hdr-band-rules" class="text-sm font-black text-amber-300">0</strong>
                </span>
                <span id="hdr-band-status" class="hidden"></span>
              </div>
            </div>

            <!-- Navegador de bandas: el selector elige qué banda se edita. -->
            <div id="band-select-wrap" class="hidden md:w-80 shrink-0">
              <div class="bg-gray-950/50 border border-amber-700/30 rounded-md p-3 space-y-2">
                <div class="flex items-center justify-between gap-2">
                  <label for="band-select" class="block text-[11px] font-black uppercase tracking-widest text-gray-500">Bandas</label>
                  <span id="band-counter" class="text-sm font-bold text-amber-300" aria-live="polite"></span>
                </div>
                <div class="relative">
                  <select id="band-select" class="w-full px-4 py-2.5 pr-10 rounded-md bg-gray-950/80 border border-amber-700/40 text-sm text-amber-100 focus:border-amber-500/70 focus:outline-none focus:ring-2 focus:ring-amber-500/20 appearance-none cursor-pointer"></select>
                  <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-amber-500/70">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class={`${ui.sectionBody} space-y-6`}>
          <!-- Onboarding: visitante sin validar no puede publicar bandas -->
          <div id="bands-onboarding" class="hidden text-xs text-amber-100/90 bg-amber-950/30 border-l-2 border-amber-500/60 px-4 py-3 rounded-md"></div>

          <!-- Detalle de la banda seleccionada -->
          <div id="band-detail" class="hidden"></div>
          <div id="bands-empty" class={`${ui.panel} p-6 sm:p-8 max-w-2xl mx-auto text-center`}>
            <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="font-bold text-white mb-1">Aún no detectamos bandas</p>
            <p class="text-sm text-gray-400 mb-5">Sube tu SavedVariables desde el addon para que tus bandas y reglas aparezcan aquí.</p>
            <a href="/upload" class={ctaVacio}>Subir SavedVariables</a>
          </div>
          <p id="bands-status" class="text-sm text-gray-400" aria-live="polite"></p>
        </div>
      </section>

      <!-- ── Mi Hermandad ────────────────────────────────────────────────── -->
      <section id="panel-hermandad" role="tabpanel" aria-labelledby="tab-hermandad" class="hidden space-y-6">
        <!-- Sin hermandad aún: solo vía SV (registry.guild.isGM) -->
          <div id="guild-empty" class={`${ui.panel} p-6 sm:p-8 max-w-2xl mx-auto bg-gradient-to-br from-amber-900/20 to-transparent`}>
          <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-2 text-center">Hermandad</p>
          <svg class="w-10 h-10 text-amber-500/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <p class="font-bold text-white text-center mb-1">Tu hermandad nace de tu SavedVariables</p>
          <p class="text-sm text-gray-400 text-center mb-6">Sin formularios: los datos provienen del addon y cada re-upload los mantiene actualizados.</p>
          <ol class="space-y-3 mb-7 text-sm text-gray-300 list-none">
            <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center">1</span><span>Sube un SavedVariables donde el addon te reporte como Maestro o con dos o más personajes registrados.</span></li>
            <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center">2</span><span>Reclama la hermandad desde Registro: tu rol de Maestro se asigna verificado por el addon.</span></li>
            <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-full bg-amber-900/40 border border-amber-500/40 text-amber-200 text-xs font-black flex items-center justify-center">3</span><span>Publica el portal y comparte su dirección con tu comunidad.</span></li>
          </ol>
          <div class="text-center">
            <a href="/upload" class={ctaVacio}>Subir SavedVariables</a>
          </div>
        </div>

        <!-- Gestión multi-hermandad -->
        <div id="guild-manage" class="hidden">
          <div class={`${ui.sectionHead} bg-gradient-to-br from-amber-900/20 to-transparent`}>
            <div class="md:flex md:items-start md:justify-between gap-6">
              <div class="min-w-0">
                <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1">Gestión de hermandad</p>
                  <h2 id="hdr-guild-name" class="text-lg font-bold text-amber-200 flex items-center">
                    <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
                    <span id="hdr-guild-name-text">Tus hermandades</span>
                  </h2>
                  <!-- Indicadores de la hermandad seleccionada en el navegador
                       (liberan la ficha de repetir título y badges); el total
                       de hermandades vive en el contador del selector -->
                  <div class="flex flex-wrap gap-2 mt-3" aria-label="Indicadores de la hermandad seleccionada">
                    <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                      Integrantes <strong id="hdr-guild-members" class="text-sm font-black text-amber-300">0</strong>
                    </span>
                    <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                      Bandas integradas <strong id="hdr-guild-bands" class="text-sm font-black text-amber-300">0</strong>
                    </span>
                    <span class="inline-flex items-baseline gap-1.5 text-[10px] font-black uppercase tracking-widest text-gray-500 bg-gray-950/50 border border-amber-700/30 rounded-md px-2.5 py-1">
                      Reglas <strong id="hdr-guild-rules" class="text-sm font-black text-amber-300">0</strong>
                    </span>
                    <span id="hdr-guild-vis" class="hidden"></span>
                    <span id="hdr-guild-claim" class="hidden"></span>
                  </div>
              </div>

              <!-- Navegador de hermandades: el selector elige qué ficha se edita. -->
              <div id="guild-select-wrap" class="hidden md:w-80 shrink-0">
                <div class="bg-gray-950/50 border border-amber-700/30 rounded-md p-3 space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="guild-select" class="block text-[11px] font-black uppercase tracking-widest text-gray-500">Hermandad</label>
                    <span id="guild-counter" class="text-sm font-bold text-amber-300" aria-live="polite"></span>
                  </div>
                  <div class="relative">
                    <select id="guild-select" class="w-full px-4 py-2.5 pr-10 rounded-md bg-gray-950/80 border border-amber-700/40 text-sm text-amber-100 focus:border-amber-500/70 focus:outline-none focus:ring-2 focus:ring-amber-500/20 appearance-none cursor-pointer"></select>
                    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-amber-500/70">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class={`${ui.sectionBody} space-y-6`}>
            <div id="guild-cards" class="space-y-6"></div>
          </div>
        </div>
      </section>

      <!-- ── Mi Perfil (datos + personajes + seguridad) ──────────────────── -->
      <section id="panel-perfil" role="tabpanel" aria-labelledby="tab-perfil" class="hidden space-y-6">
        <!-- Sección 1: Datos del perfil (ventana numerada y colapsable) -->
        <details class="group border border-amber-600/30 rounded-t-md" aria-label="Sección 1: Datos del perfil">
