---
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/Navigation.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import FichaDock from "@/components/ui/FichaDock.astro";
import Icon from "@/components/ui/Icon.astro";
import { ui } from "@/lib/ui/design";
import { PAGE_META } from "@/lib/seo";

const ctaVacio = `${ui.btnBase} ${ui.btnPrimary} px-6 py-3 text-sm`;
const meta = PAGE_META['/dashboard'];
---

<Layout
  title={meta.title}
  description={meta.description}
  noindex={meta.noindex}
  particles="arcane"
>
  <Navigation currentPath="/dashboard" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />

      <!-- Encabezado del espacio personal: mobile-first, alineado a la izquierda,
           compacto (avatar + identidad + acciones en una fila; badges debajo) -->
      <header class="mb-8 animate-fade-in-1">
        <div class={`relative px-4 sm:px-6 py-5 ${ui.plaque}`}>
        <span class={ui.cardTop} aria-hidden="true"></span>
        <div class="flex items-start gap-4">
          <div
            id="avatar"
            aria-hidden="true"
            class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-black text-lg font-black shadow-lg shadow-brand-900/30 ring-2 ring-brand-500/30 select-none"
          >
            –
          </div>
          <div class="min-w-0 flex-1">
            <h1
              id="account-title"
              class={`${ui.text.h1} ${ui.gradientTitle} tracking-wide leading-tight truncate`}
            >
              Cuenta
            </h1>
            <p
              id="user-email"
              class={`${ui.text.caption} italic mt-0.5 truncate`}
            >
            </p>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <a
              href="/upload"
              class={`inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-black uppercase tracking-widest border bg-brand-900/40 border-brand-500/40 text-brand-300 hover:bg-brand-800/50 hover:border-brand-400/70 ${ui.transition} ${ui.focusRing}`}
              title="Sube el archivo del addon"
              aria-label="Sube el archivo del addon"
            >
              <Icon name="subir" size="sm" />
              <span class="hidden sm:inline">Subir archivo</span>
            </a>
            <button
              type="button"
              id="config-btn"
              class={`inline-flex items-center justify-center w-9 h-9 rounded-md text-[11px] font-black uppercase tracking-widest border bg-brand-800/70 border-gray-600 text-gray-300 hover:text-brand-200 hover:border-brand-500/50 ${ui.transition} ${ui.focusRing}`}
              aria-label="Configuración de perfil, seguridad y zona de peligro"
              title="Configuración de perfil, seguridad y zona de peligro"
            >
              <Icon name="engranajes" size="sm" />
            </button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-1.5 mt-3">
          <span
            id="role-badge"
            class={`${ui.badge} ${ui.badgeMd} bg-brand-800/70 border-gray-600 text-gray-300`}
            >…</span
          >
          <span
            id="validated-badge"
            class={`${ui.badge} ${ui.badgeMd} bg-brand-800/70 border-gray-600 text-gray-400`}
            >…</span
          >
          <span
            id="public-badge"
            class={`${ui.badge} ${ui.badgeMd} bg-brand-800/70 border-gray-600 text-gray-400`}
            >…</span
          >
        </div>
        <FichaDock
          slot="dock"
          dockId="dashboard-tab-dock"
          barId="tab-bar"
          label="Secciones del panel"
          bleedCls="-mx-4 -mb-5 sm:-mx-6 px-4 sm:px-6"
        />
        </div>
      </header>

      <!-- ── Resumen ─────────────────────────────────────────────────────── -->

      <!-- ── Mi Registro (config + historial + visor) ─────────────────────── -->
      <section
        id="panel-registro"
        role="tabpanel"
        aria-labelledby="tab-registro"
        class="hidden space-y-8"
      >
        <!-- Estado vacío -->
        <EmptyState
          id="registro-empty"
          hidden
          icon="subir"
          title="Aún no has subido el archivo del addon"
          gradient={false}
          message="Sube tu archivo RaidDominion.lua para ver aquí todo tu registro: personaje, hermandad y configuración del addon."
          cta={{ label: "Ir a subir el archivo", href: "/upload" }}
          ctaCls="px-6 py-3 text-sm"
        >
          <div slot="body">
            <p class="text-sm text-gray-300 max-w-md mx-auto mb-6">
              Sube tu archivo <code class="text-brand-300"
                >RaidDominion.lua</code
              > para ver aquí todo tu registro: personaje, hermandad y configuración
              del addon.
            </p>
            <a href="/upload" class={ctaVacio}>Ir a subir el archivo</a>
            <p
              id="registro-empty-note"
              data-rd-reveal
              class="hidden mt-4 text-xs text-red-300"
            >
            </p>
          </div>
        </EmptyState>

        <div id="registro-main" data-rd-reveal class="hidden space-y-8">
          <!-- Contenido plano de la pestaña Registro: el label/icono ya viven
               en el dock; aquí solo el análisis seleccionado y sus controles. -->
          <div>
            <div class="relative">
              <div
                class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
              >
                <div class="min-w-0">
                  <h2
                    id="hdr-registro-title"
                    class="text-lg font-bold text-brand-200 flex items-center"
                  >
                    <span
                      id="hdr-registro-title-text"
                      class="font-black italic"
                      >Análisis</span
                    >
                  </h2>
                  <!-- Indicadores del análisis seleccionado (liberan el contenido
                     de repetir cifras y títulos) -->
                  <div
                    class="flex flex-wrap gap-2 mt-3"
                    aria-label="Indicadores del registro"
                  >
                    <span class={ui.badgeStat}>
                      Personajes <strong
                        id="hdr-registro-chars"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class={ui.badgeStat}>
                      Hermandades <strong
                        id="hdr-registro-guilds"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class={ui.badgeStat}>
                      Bandas <strong
                        id="hdr-registro-bands"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class={ui.badgeStat}>
                      Reglas <strong
                        id="hdr-registro-rules"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                  </div>
                </div>

                <div id="sv-select-wrap" class="md:w-80 shrink-0">
                  <div
                    class="bg-brand-950/50 border border-brand-700/30 rounded-md p-3 space-y-2"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <label
                        for="sv-select"
                        class="block text-[11px] font-black uppercase tracking-widest text-gray-300"
                        >Registro</label
                      >
                      <span
                        id="sv-counter"
                        class="text-sm font-bold text-brand-300"
                        aria-live="polite"></span>
                    </div>
                    <div class="relative">
                      <select
                        id="sv-select"
                        class="w-full px-4 py-2.5 pr-10 rounded-md bg-brand-950/80 border border-brand-700/40 text-sm text-brand-100 focus:border-brand-500/70 focus:outline-none focus:ring-2 focus:ring-brand-500/20 appearance-none cursor-pointer"
                      ></select>
                      <span
                        class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-brand-500/70"
                      >
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path></svg
                        >
                      </span>
                    </div>
                    <button
                      type="button"
                      id="sv-delete-btn"
                      class="w-full mt-2 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-black uppercase tracking-widest border border-red-800/50 text-red-300 hover:bg-red-950/40 hover:text-red-200 ${ui.transition} ${ui.focusRing}"
                    >
                      <Icon name="eliminar" size="xs" />
                      Eliminar este análisis
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Banner de reclamo condicional: franja contigua a la ventana
               (sin radio ni márgenes) entre la cabecera y el visor -->
            <div
              id="claim-banner"
              data-rd-reveal
              class="hidden border border-brand-600/30 rounded-md bg-gradient-to-br from-brand-950/40 to-brand-900/60 p-4 sm:p-6"
            >
              <h3
                class="text-base font-black uppercase tracking-widest text-brand-300 mb-1"
              >
                ¿Lideras una o más hermandades?
              </h3>
              <p class="text-sm text-gray-300 mb-4">
                El archivo del addon acredita rango de liderazgo. Reclámalas y
                obtén el portal web gratuito de cada guild (puedes ser maestro
                de varias):
              </p>
              <ol class="space-y-2 mb-5 text-sm text-gray-300 list-none">
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-brand-500/15 border border-brand-400/50 text-brand-200 text-xs font-black flex items-center justify-center"
                    >1</span
                  ><span
                    >Sube el archivo del personaje que dirige tu hermandad. El
                    addon debe reconocerte como maestro.</span>
                </li>
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-brand-500/15 border border-brand-400/50 text-brand-200 text-xs font-black flex items-center justify-center"
                    >2</span
                  ><span
                    >Reclama aquí tus hermandades: la ficha de cada una nace con
                    los datos exactos del juego.</span>
                </li>
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-brand-500/15 border border-brand-400/50 text-brand-200 text-xs font-black flex items-center justify-center"
                    >3</span
                  ><span
                    >Publícalas desde Hermandad y comparte <code
                      class="text-brand-300">/hermandad/tu-hermandad</code
                    >.</span>
                </li>
              </ol>
              <button
                type="button"
                id="claim-btn"
                class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest`}
                >Reclamar mis hermandades</button
              >
              <p
                id="claim-msg"
                class={`hidden mt-3 ${ui.alert}`}
                role="status"
              >
              </p>
            </div>

            <!-- Visor único del snapshot seleccionado: fondo sólido distintivo del
               cuerpo. El título y la fecha del análisis viven en el encabezado
               de la pestaña; aquí solo el contenido del registro. -->
            <div class="space-y-5">
              {/* Personajes del registro: fusión de las vistas del archivo,
                 con la card de personaje estandarizada */}
              <div>
                <h4 class={ui.subTitle}>
                  Personajes del registro <span
                    id="cnt-viewer-chars"
                    class="text-gray-400"></span>
                </h4>
                <!-- Motor único de filtros (src/lib/ui/filterBar.ts). -->
                <div id="viewer-chars-filtro" class="mt-3"></div>
                <div
                  id="viewer-characters"
                  class={`${ui.gridCards} mt-2`}
                >
                </div>
                <div id="viewer-chars-pager" class="mt-3"></div>
              </div>

              <!-- Hermandades en el registro -->
              <div
                class="bg-brand-800/50 border border-brand-700/30 rounded-md p-4"
              >
                <h4 class={ui.subTitle}>Hermandades en el registro</h4>
                <div id="viewer-guilds-filtro" class="mt-3"></div>
                <div id="viewer-guilds" class="mt-2 space-y-2"></div>
                <div id="viewer-guilds-pager" class="mt-3"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Mis Personajes ──────────────────────────────────────────────── -->
        <section
          id="panel-personajes"
          role="tabpanel"
          aria-labelledby="tab-personajes"
          class="hidden"
        >
          <!-- Estado vacío: sin personajes detectados -->
          <EmptyState
            id="characters-empty"
            hidden
            cls="mb-6"
            icon="personaje"
            title="Aún no registras personajes"
            gradient={false}
            message="Sube el archivo del addon y aparecerán aquí."
            cta={{ label: "Subir ahora", href: "/upload" }}
            ctaCls="px-6 py-3 text-sm"
          />
          <div id="chars-sectionhead" class="relative">
            <div
              class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
            >
              <div class="min-w-0">
                <div
                  class="flex flex-wrap gap-2"
                  aria-label="Indicadores de personajes"
                >
                  <span class={ui.badgeStat}>
                    Personajes <strong
                      id="hdr-chars-total"
                      class={`${ui.statValue} text-sm`}>0</strong
                    >
                  </span>
                  <span class={ui.badgeStat}>
                    Públicos <strong
                      id="hdr-chars-public"
                      class={`${ui.statValue} text-sm`}>0</strong
                    >
                  </span>
                </div>
              </div>

              {/* Ayuda al stat: detecta más personajes subiendo el archivo */}
              <div class="md:w-80 shrink-0">
                <div
                  class="bg-brand-950/50 border border-brand-700/30 rounded-md p-3 space-y-2"
                >
                  <p
                    class="block text-[11px] font-black uppercase tracking-widest text-gray-300"
                  >
                    ¿Falta algún personaje?
                  </p>
                  <a
                    href="/upload"
                    class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-widest text-brand-300 hover:text-brand-200 transition-colors"
                  >
                    <Icon name="subir" size="xs" />
                    Subir archivo del addon
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div id="chars-sectionbody" class="space-y-5">
            <!-- Datos del perfil: controles dentro del contenido de la ventana de
               personajes (nombre visible, principal, visibilidad pública, guardar).
               Estilo de sub-bloque del cuerpo, igual que los bloques del registro. -->
            <div
              class="bg-brand-800/50 border border-brand-700/30 rounded-md p-4"
            >
              <h4 class={`${ui.subTitle} flex items-center gap-1.5`}><Icon name="editar" size="xs" />Datos del perfil</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="display-name" class={ui.form.label}
                    >Nombre visible</label
                  >
                  <input
                    type="text"
                    id="display-name"
                    maxlength="40"
                    placeholder="Tu nombre en el portal"
                    class={`${ui.form.input} ${ui.focusRing}`}
                  />
                </div>
                <div>
                  <label for="character-main" class={ui.form.label}
                    >Personaje principal</label
                  >
                  <div class="relative">
                    <select
                      id="character-main"
                      disabled
                      class={`${ui.form.input} ${ui.focusRing} appearance-none pl-3 pr-10 disabled:opacity-60 disabled:cursor-not-allowed`}
                    >
                      <option value="">Ninguno</option>
                    </select>
                    <svg
                      aria-hidden="true"
                      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path></svg
                    >
                  </div>
                  <p id="character-main-hint" class={ui.form.helperText}>
                    Solo puedes elegir entre tus personajes públicos.
                  </p>
                </div>
              </div>

              <label
                for="profile-public"
                class={`mt-4 flex items-start gap-3 cursor-pointer select-none border border-gray-700/60 hover:border-brand-600/40 rounded-md p-4 ${ui.transition}`}
              >
                <input
                  type="checkbox"
                  id="profile-public"
                  class="mt-0.5 w-4 h-4 accent-brand-500"
                />
                <span class={`${ui.text.body} font-medium`}
                  >Perfil y datos públicos
                  <span class={`block ${ui.text.caption} italic mt-0.5`}
                    >Al activarlo, tu perfil de jugador será visible
                    públicamente para la comunidad.</span
                  >
                </span>
              </label>

              <div class="mt-4 flex flex-wrap items-center gap-3">
                <button
                  id="save-profile"
                  class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest transform hover:scale-105 disabled:opacity-50 disabled:pointer-events-none`}
                >
                  Guardar cambios
                </button>
                <a
                  id="public-profile-link"
                  href="#"
                  target="_blank"
                  rel="noopener"
                  class={`hidden px-4 py-2 rounded-md text-xs font-black uppercase tracking-widest ${ui.status.success}`}
                  >Ver perfil público →</a
                >
              </div>
              <p
                id="profile-msg"
                class={`hidden mt-3 ${ui.alert}`}
                role="status"
              >
              </p>
            </div>

            <!-- ── Task Tracker (adaptación del tracker wow-rd) ───────────────
                 La sección "Datos del perfil" se mantiene arriba; debajo vive
                 el seguimiento por personaje con datos de las subidas del addon. -->
            <div id="tracker-root" class={ui.tracker.shell}>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div class="min-w-0">
                  <p class={ui.eyebrow}>Seguimiento</p>
                  <h4 class={`${ui.subTitle} flex items-center gap-2`}>
                    <Icon name="validado" size="sm" />
                    <span>Tracker de personajes</span>
                    <span
                      id="tracker-personajes-count"
                      class="inline-flex items-center px-2 py-0.5 rounded-md border border-brand-600/30 bg-brand-950/60 text-[11px] font-black text-brand-200 tabular-nums"
                      aria-live="polite"
                      aria-atomic="true"
                      >0</span
                    >
                  </h4>
                  <p class={`${ui.text.caption} mt-1`}>
                    Tareas manuales, notas locales y seguimiento del roster. Los
                    datos del personaje se actualizan al subir el archivo del addon.
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                  <button
                    type="button"
                    id="tracker-filters-toggle"
                    class={`${ui.btnBase} ${ui.btnSecondary} px-3 py-2 text-[11px] font-black uppercase tracking-widest`}
                    aria-expanded="false"
                    aria-controls="tracker-filtro"
                    title="Mostrar filtros y selección rápida"
                  >
                    <Icon name="filtrar" size="xs" />
                    Filtros
                    <span
                      id="tracker-filters-count"
                      class="hidden h-5 min-w-5 inline-flex items-center justify-center rounded-md border border-brand-500/50 bg-brand-500/20 px-1 text-[11px] font-black text-brand-100 tabular-nums"
                      >0</span
                    >
                  </button>
                  <button
                    type="button"
                    id="tracker-catalog-btn"
                    class={`${ui.btnBase} ${ui.btnPrimary} px-3 py-2 text-[11px] font-black uppercase tracking-widest`}
                    title="Gestionar el catálogo manual de tareas"
                  >
                    <Icon name="pergamino" size="xs" />
                    Catálogo
                  </button>
                  <a
                    href="/upload"
                    class={`${ui.btnBase} ${ui.btnGhost} px-3 py-2 text-[11px] font-black uppercase tracking-widest border border-brand-600/30`}
                  >
                    <Icon name="subir" size="xs" />
                    Subir archivo
                  </a>
                </div>
              </div>

              <div id="tracker-list-view" class="space-y-3">
                <!-- Panel de filtros + selección rápida (modelo wow-rd). -->
                <div id="tracker-filtro" class="hidden space-y-3"></div>
                <div id="tracker-selection" class={`${ui.tracker.dock} ${ui.tracker.selectionDock} hidden`}></div>
                <div
                  id="tracker-catalog-empty"
                  class="hidden flex flex-wrap items-center justify-between gap-3 rounded-md border border-brand-600/30 bg-brand-950/40 px-4 py-3"
                >
                  <p class="text-xs text-gray-300">
                    Aún no tienes tareas en el catálogo. Créalas para activarlas y
                    marcarlas por personaje.
                  </p>
                  <button
                    type="button"
                    id="tracker-catalog-empty-btn"
                    class={`${ui.btnBase} ${ui.btnPrimary} px-3 py-2 text-[11px] font-black uppercase tracking-widest`}
                  >
                    Crear catálogo
                  </button>
                </div>
                <div
                  id="tracker-grid"
                  class={ui.tracker.grid}
                  data-rd-reveal-cards="[data-character-id]"
                >
                  <div data-tracker-group="expanded" class={ui.tracker.group}></div>
                  <div data-tracker-group="collapsed" class={ui.tracker.group}></div>
                </div>
                <div id="tracker-pager"></div>
                <div
                  id="tracker-legend"
                  class={`${ui.tracker.legend} hidden`}
                  aria-label="Leyenda de pestañas del tracker"
                ></div>
              </div>

              <div id="tracker-subview" class="hidden"></div>
            </div>

            <p
              id="characters-onboarding"
              data-rd-reveal
              class="hidden text-xs text-brand-100/90 bg-brand-950/30 border-l-2 border-brand-500/60 px-4 py-3 rounded-md"
            >
            </p>
            <p id="characters-status" class="hidden text-sm text-gray-300"></p>
          </div>
        </section>

        <!-- ── Mis Bandas ──────────────────────────────────────────────────── -->
        <section
          id="panel-bandas"
          role="tabpanel"
          aria-labelledby="tab-bandas"
          class="hidden"
        >
          <!-- Estado vacío: sin bandas registradas. Ventana propia, hermano del
             gestor (mismo modelo que Personajes/Hermandad/Registro). -->
          <EmptyState
            id="bands-empty"
            hidden
            cls="mb-6"
            icon="espadas"
            title="Aún no detectamos bandas"
            gradient={false}
            message="Sube el archivo del addon para que tus bandas y reglas aparezcan aquí."
            cta={{ label: "Subir archivo del addon", href: "/upload" }}
            ctaCls="px-6 py-3 text-sm"
          />

          <div id="bands-sectionhead" class="relative">
            <div
              class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
            >
              <div class="min-w-0">
                <h2
                  id="hdr-band-name"
                  class="text-lg font-bold text-brand-200 flex flex-wrap items-center gap-2"
                >
                  <span
                    id="hdr-band-name-text"
                    class="min-w-0 font-black italic"
                    >Selección actual</span
                  >
                  <a
                    id="hdr-band-open"
                    href="#"
                    class={`hidden ${ui.btnBase} ${ui.btnSecondary} ${ui.focusRing} px-2.5 py-1 text-[11px] font-black uppercase tracking-wider`}
                    >Ver banda</a
                  >
                  <span
                    id="hdr-band-name-meta"
                    class="text-xs font-normal text-gray-300"
                  ></span>
                </h2>
                <!-- Indicadores de la banda seleccionada en el navegador (liberan
                   el detalle de repetir título y badges). Horario y GS viven en
                   el título, unidos como en el selector. -->
                <div
                  class="flex flex-wrap gap-2 mt-3"
                  aria-label="Indicadores de la banda seleccionada"
                >
                  <span class={ui.badgeStat}>
                    Jugadores <strong
                      id="hdr-band-players"
                      class={`${ui.statValue} text-sm`}>0</strong
                    >
                  </span>
                  <span class={ui.badgeStat}>
                    Reglas <strong
                      id="hdr-band-rules"
                      class={`${ui.statValue} text-sm`}>0</strong
                    >
                  </span>
                  <span id="hdr-band-status" class="hidden"></span>
                </div>
              </div>

              <!-- Navegador de bandas: el selector elige qué banda se edita. -->
              <div id="band-select-wrap" class="hidden md:w-80 shrink-0">
                <div
                  class="bg-brand-950/50 border border-brand-700/30 rounded-md p-3 space-y-2"
                >
                  <div class="flex items-center justify-between gap-2">
                    <label
                      for="band-select"
                      class="block text-[11px] font-black uppercase tracking-widest text-gray-300"
                      >Bandas</label
                    >
                    <span
                      id="band-counter"
                      class="text-sm font-bold text-brand-300"
                      aria-live="polite"></span>
                  </div>
                  <div class="relative">
                    <select
                      id="band-select"
                      class="w-full px-4 py-2.5 pr-10 rounded-md bg-brand-950/80 border border-brand-700/40 text-sm text-brand-100 focus:border-brand-500/70 focus:outline-none focus:ring-2 focus:ring-brand-500/20 appearance-none cursor-pointer"
                    ></select>
                    <span
                      class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-brand-500/70"
                    >
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"></path></svg
                      >
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div id="bands-sectionbody" class="space-y-5">
            <!-- Detalle de la banda seleccionada -->
            <div id="band-detail" data-rd-reveal class="hidden"></div>
            <!-- Onboarding: visitante sin validar no puede publicar bandas -->
            <div
              id="bands-onboarding"
              data-rd-reveal
              class="hidden text-xs text-brand-100/90 bg-brand-950/30 border-l-2 border-brand-500/60 px-4 py-3 rounded-md"
            >
            </div>
            <p id="bands-status" class="text-sm text-gray-300" aria-live="polite">
            </p>
          </div>
        </section>

        <!-- ── Mi Hermandad ────────────────────────────────────────────────── -->
        <section
          id="panel-hermandad"
          role="tabpanel"
          aria-labelledby="tab-hermandad"
          class="hidden space-y-8"
        >
          {/* Sin hermandad aún: el portal se crea desde el archivo del addon */}
          <EmptyState
            id="guild-empty"
            hidden
            icon="hermandad"
            title="Tu hermandad nace del archivo del addon"
            gradient={false}
            bodyAlign="start"
          >
            <div slot="body">
              <p class="text-sm text-gray-300 mb-6">
                Sin formularios: los datos provienen del addon y cada nueva subida
                los mantiene actualizados.
              </p>
              <ol class="space-y-3 mb-7 text-sm text-gray-300 list-none">
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-brand-900/40 border border-brand-500/40 text-brand-200 text-xs font-black flex items-center justify-center"
                    >1</span
                  ><span
                    >Sube el archivo del personaje que dirige tu hermandad: el
                    addon debe reconocerte como maestro.</span>
                </li>
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-brand-900/40 border border-brand-500/40 text-brand-200 text-xs font-black flex items-center justify-center"
                    >2</span
                  ><span
                    >El portal reclama tu hermandad de forma automática al
                    analizar ese archivo; revisa la pestaña Registro.</span>
                </li>
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-brand-900/40 border border-brand-500/40 text-brand-200 text-xs font-black flex items-center justify-center"
                    >3</span
                  ><span
                    >Publica el portal y comparte su dirección con tu comunidad.</span>
                </li>
              </ol>
              <div class="text-center">
                <a href="/upload" class={ctaVacio}>Subir archivo del addon</a>
              </div>
            </div>
          </EmptyState>

          <!-- Gestión multi-hermandad -->
          <div id="guild-manage" data-rd-reveal class="hidden">
            <div class="relative">
              <div
                class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
              >
                <div class="min-w-0">
                  <h2
                    id="hdr-guild-name"
                    class="text-lg font-bold text-brand-200 flex items-center"
                  >
                    <span
                      id="hdr-guild-name-text"
                      class="font-black italic"
                      >Selección actual</span
                    >
                  </h2>
                  <!-- Indicadores de la hermandad seleccionada en el navegador
                       (liberan la ficha de repetir título y badges); el total
                       de hermandades vive en el contador del selector -->
                  <div
                    class="flex flex-wrap gap-2 mt-3"
                    aria-label="Indicadores de la hermandad seleccionada"
                  >
                    <span class={ui.badgeStat}>
                      Integrantes <strong
                        id="hdr-guild-members"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class={ui.badgeStat}>
                      Bandas integradas <strong
                        id="hdr-guild-bands"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class={ui.badgeStat}>
                      Reglas <strong
                        id="hdr-guild-rules"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span id="hdr-guild-vis" class="hidden"></span>
                    <span id="hdr-guild-claim" class="hidden"></span>
                  </div>
                </div>

                <!-- Navegador de hermandades: el selector elige qué ficha se edita. -->
                <div id="guild-select-wrap" class="hidden md:w-80 shrink-0">
                  <div
                    class="bg-brand-950/50 border border-brand-700/30 rounded-md p-3 space-y-2"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <label
                        for="guild-select"
                        class="block text-[11px] font-black uppercase tracking-widest text-gray-300"
                        >Hermandad</label
                      >
                      <span
                        id="guild-counter"
                        class="text-sm font-bold text-brand-300"
                        aria-live="polite"></span>
                    </div>
                    <div class="relative">
                      <select
                        id="guild-select"
                        class="w-full px-4 py-2.5 pr-10 rounded-md bg-brand-950/80 border border-brand-700/40 text-sm text-brand-100 focus:border-brand-500/70 focus:outline-none focus:ring-2 focus:ring-brand-500/20 appearance-none cursor-pointer"
                      ></select>
                      <span
                        class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-brand-500/70"
                      >
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path></svg
                        >
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="space-y-6">
              <div id="guild-cards" class="space-y-6"></div>
            </div>
          </div>
        </section>

        <!-- ── Panel oculto de configuración (seguridad + zona de peligro) ────
           No es una pestaña de la barra: se abre con el ícono de engranaje del
           encabezado (DASHBOARD_CONFIG en tabs.ts, hash #cuenta). El hash
           histórico #perfil se redirige a #cuenta (syncConfigFromHash). -->
        <section
          id="panel-cuenta"
          role="region"
          aria-label="Configuración de cuenta, seguridad y zona de peligro"
          class="hidden space-y-8"
        >
          <!-- Sección 1: Seguridad (ventana numerada y colapsable) -->
          <details
            class="group border border-brand-600/30 rounded-t-md"
            aria-label="Sección 1: Seguridad"
          >
            <summary
              class="cursor-pointer select-none list-none flex flex-wrap items-center justify-between gap-3 bg-gradient-to-br from-red-950/20 to-transparent rounded-t-md border-b border-brand-600/30 p-4 sm:p-6"
            >
              <span class="flex items-center gap-3 min-w-0">
                <span
                  class="shrink-0 w-8 h-8 rounded-full bg-red-950/40 border border-red-500/40 text-red-200 text-sm font-black flex items-center justify-center"
                  >1</span
                >
                <span class="min-w-0">
                  <span
                    class="block text-[11px] font-black uppercase tracking-widest text-red-400 mb-1"
                    >Seguridad</span
                  >
                  <span
                    class="block text-lg font-bold text-brand-200 leading-tight flex items-center"
                    ><Icon name="bloqueo-alt" size="md" class="mr-2.5" />Cuenta y contraseña</span
                  >
                </span>
              </span>
              <span class="flex items-center gap-3">
                <span
                  class="text-[11px] font-bold uppercase tracking-widest text-red-400/80"
                  >Protege tu cuenta</span
                >
                <svg
                  aria-hidden="true"
                  class="w-4 h-4 text-red-400 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="bg-brand-900/60 backdrop-blur-sm p-4 sm:p-6">
              <div class="space-y-4">
                <div>
                  <label for="new-password" class={ui.form.label}
                    >Nueva contraseña</label
                  >
                  <input
                    type="password"
                    id="new-password"
                    autocomplete="new-password"
                    minlength="8"
                    class={`${ui.form.input} ${ui.focusRing}`}
                  />
                  <p class={ui.form.helperText}>
                    Mínimo 8 caracteres, con al menos una letra y un número.
                  </p>
                </div>
                <div>
                  <label for="new-password-confirm" class={ui.form.label}
                    >Confirmar nueva contraseña</label
                  >
                  <input
                    type="password"
                    id="new-password-confirm"
                    autocomplete="new-password"
                    class={`${ui.form.input} ${ui.focusRing}`}
                  />
                </div>
                <button
                  id="save-password"
                  class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest transform hover:scale-105 disabled:opacity-50 disabled:pointer-events-none`}
                >
                  Actualizar contraseña
                </button>
                <p
                  id="password-msg"
                  class={`hidden ${ui.alert}`}
                  role="status"
                >
                </p>
              </div>

              <div
                class="border-t border-gray-700/50 mt-6 pt-5 flex flex-wrap items-center justify-between gap-3"
              >
                <div>
                  <h3 class={`${ui.text.h3} text-red-300`}>Sesión</h3>
                  <p class={ui.text.caption}>
                    Cierra sesión en este dispositivo.
                  </p>
                </div>
                <button
                  id="logout-btn"
                  class={`${ui.btnBase} px-6 py-2.5 border border-red-700/50 text-red-300 hover:bg-red-950/40 hover:text-red-200 text-xs font-black uppercase tracking-widest`}
                >
                  Cerrar sesión
                </button>
              </div>
            </div>
          </details>

          <!-- Sección 2: Zona de peligro (ventana numerada y colapsable) -->
          <details
            class="group border border-brand-600/30 rounded-t-md"
            aria-label="Sección 2: Zona de peligro"
          >
            <summary
              class="cursor-pointer select-none list-none flex flex-wrap items-center justify-between gap-3 bg-gradient-to-br from-red-950/20 to-transparent rounded-t-md border-b border-brand-600/30 p-4 sm:p-6"
            >
              <span class="flex items-center gap-3 min-w-0">
                <span
                  class="shrink-0 w-8 h-8 rounded-full bg-red-950/40 border border-red-500/40 text-red-200 text-sm font-black flex items-center justify-center"
                  >2</span
                >
                <span class="min-w-0">
                  <span
                    class="block text-[11px] font-black uppercase tracking-widest text-red-400 mb-1"
                    >Zona de peligro</span
                  >
                  <span
                    class="block text-lg font-bold text-red-300 leading-tight flex items-center"
                    ><Icon name="advertencia" size="md" class="mr-2.5" />Acciones destructivas</span
                  >
                </span>
              </span>
              <span class="flex items-center gap-3">
                <span
                  class="text-[11px] font-bold uppercase tracking-widest text-red-400/80"
                  >Irreversible</span
                >
                <svg
                  aria-hidden="true"
                  class="w-4 h-4 text-red-400 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="bg-brand-900/60 backdrop-blur-sm p-4 sm:p-6">
              <!-- Resetear datos (moderado: conserva la cuenta) -->
              <div
                class="border border-brand-800/40 bg-brand-950/10 rounded-md p-5"
              >
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="max-w-md">
                    <h3 class={`${ui.text.h3} text-brand-300`}>
                      Restablecer datos del addon
                    </h3>
                    <p class={`${ui.text.caption} mt-1`}>
                      Borra tu historial de archivos, los personajes detectados
                      y, si la tienes, tu hermandad con su portal. Tu rol vuelve
                      a <strong class="text-brand-300">Visitante</strong> (salvo staff)
                      y podrás volver a subir el archivo para empezar desde cero.
                      Tu cuenta y tu nombre visible se conservan.
                    </p>
                  </div>
                  <button
                    id="reset-data-btn"
                    class={`${ui.btnBase} px-6 py-2.5 border border-brand-700/50 text-brand-300 hover:bg-brand-950/40 hover:text-brand-200 text-xs font-black uppercase tracking-widest`}
                  >
                    Resetear mis datos
                  </button>
                </div>

                <div
                  id="reset-data-confirm"
                  class="hidden mt-4 border border-brand-800/50 bg-brand-950/20 rounded-md p-5"
                >
                  <p class={`${ui.text.body} text-brand-100 mb-3`}>
                    Esto borrará permanentemente tu historial de archivos, personajes
                    y hermandad. Escribe <span class="font-black uppercase"
                      >RESETEAR</span
                    > para confirmar.
                  </p>
                  <div class="flex flex-wrap items-center gap-3">
                    <input
                      type="text"
                      id="reset-data-input"
                      autocomplete="off"
                      placeholder="RESETEAR"
                      class={`${ui.form.input} ${ui.focusRing} sm:w-56 uppercase placeholder:normal-case`}
                    />
                    <button
                      id="reset-data-confirm-btn"
                      disabled
                      class={`${ui.btnBase} px-6 py-2.5 bg-brand-800/60 hover:bg-brand-700/70 text-brand-100 text-xs font-black uppercase tracking-widest disabled:opacity-50 disabled:pointer-events-none`}
                    >
                      Confirmar reseteo
                    </button>
                    <button
                      id="reset-data-cancel"
                      class={`${ui.btnBase} px-4 py-2.5 border border-gray-700 text-gray-400 hover:text-gray-200 text-xs font-black uppercase tracking-widest`}
                    >
                      Cancelar
                    </button>
                  </div>
                  <p
                    id="reset-data-msg"
                    class={`hidden mt-3 ${ui.alert}`}
                    role="status"
                  >
                  </p>
                </div>
              </div>

              <!-- Eliminar cuenta (severo) -->
              <div
                class="border border-red-800/40 bg-red-950/10 rounded-md p-5 mt-4"
              >
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="max-w-md">
                    <h3 class={`${ui.text.h3} text-red-400`}>
                      Eliminar cuenta
                    </h3>
                    <p class={`${ui.text.caption} mt-1`}>
                      Borra permanentemente tu perfil, personajes, archivos y
                      hermandades de RaidDominion. Tu cuenta de usuario se conserva.
                    </p>
                  </div>
                  <button
                    id="delete-account-btn"
                    class={`${ui.btnBase} px-6 py-2.5 border border-red-700/50 text-red-300 hover:bg-red-950/40 hover:text-red-200 text-xs font-black uppercase tracking-widest`}
                  >
                    Eliminar mi cuenta
                  </button>
                </div>

                <div
                  id="delete-account-confirm"
                  class="hidden mt-4 border border-red-800/50 bg-red-950/20 rounded-md p-5"
                >
                  <p class={`${ui.text.body} text-red-200 mb-3`}>
                    Esto borrará permanentemente todos tus datos de
                    RaidDominion. Escribe <span class="font-black uppercase"
                      >ELIMINAR</span
                    > para confirmar.
                  </p>
                  <div class="flex flex-wrap items-center gap-3">
                    <input
                      type="text"
                      id="delete-account-input"
                      autocomplete="off"
                      placeholder="ELIMINAR"
                      class={`${ui.form.input} ${ui.focusRing} sm:w-56 uppercase placeholder:normal-case`}
                    />
                    <button
                      id="delete-account-confirm-btn"
                      disabled
                      class={`${ui.btnBase} px-6 py-2.5 bg-red-900/60 hover:bg-red-700/70 text-red-100 text-xs font-black uppercase tracking-widest disabled:opacity-50 disabled:pointer-events-none`}
                    >
                      Confirmar eliminación
                    </button>
                    <button
                      id="delete-account-cancel"
                      class={`${ui.btnBase} px-4 py-2.5 border border-gray-700 text-gray-400 hover:text-gray-200 text-xs font-black uppercase tracking-widest`}
                    >
                      Cancelar
                    </button>
                  </div>
                  <p
                    id="delete-account-msg"
                    class={`hidden mt-3 ${ui.alert}`}
                    role="status"
                  >
                  </p>
                </div>
              </div>
            </div>
          </details>
        </section>

        <!-- Modal de confirmación: eliminar un análisis individual -->
        <div
          id="sv-delete-modal"
          class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
          role="dialog"
          aria-modal="true"
          aria-labelledby="sv-delete-title"
        >
          <div
            id="sv-delete-backdrop"
            class="absolute inset-0 bg-black/70 backdrop-blur-sm"
          >
          </div>
          <div
            class="relative w-full max-w-md bg-brand-900 border border-red-900/50 rounded-md shadow-2xl shadow-black/60 overflow-hidden"
          >
            <div
              class="bg-gradient-to-br from-red-950/30 to-transparent border-b border-red-900/40 px-5 py-4"
            >
              <p
                class="text-[11px] font-black uppercase tracking-widest text-red-400 mb-1"
              >
                Registro del addon
              </p>
              <h3
                id="sv-delete-title"
                class="text-lg font-bold text-red-200 flex items-center"
              >
                <Icon name="eliminar" size="md" class="mr-2.5" />
                ¿Eliminar este análisis?
              </h3>
            </div>
            <div class="p-5">
              <p class="text-sm text-gray-300 leading-relaxed">
                Se borrará permanentemente el análisis <strong
                  id="sv-delete-label"
                  class="text-brand-200"></strong> y sus evidencias de roster. Tus
                personajes detectados se conservan.
              </p>
              <p
                id="sv-delete-msg"
                class={`hidden mt-3 ${ui.alert}`}
                role="status"
              >
              </p>
              <div class="mt-5 flex flex-wrap items-center justify-end gap-3">
                <button
                  type="button"
                  id="sv-delete-cancel"
                  class={`${ui.btnBase} px-4 py-2.5 border border-gray-700 text-gray-400 hover:text-gray-200 text-xs font-black uppercase tracking-widest`}
                >
                  Cancelar
                </button>
                <button
                  type="button"
                  id="sv-delete-confirm"
                  class={`${ui.btnBase} px-6 py-2.5 bg-red-900/60 hover:bg-red-800/70 text-red-100 text-xs font-black uppercase tracking-widest disabled:opacity-50 disabled:pointer-events-none`}
                >
                  Eliminar
                </button>
              </div>
            </div>
          </div>
        </div>
        <!-- El modal de eliminación y el divisor viven a nivel del contenedor
             (hermanos de los paneles), no dentro de ninguna pestaña. -->
      </div>
    </main>

  <script>
    import "@/lib/ui/dashboard/page";
  </script>
</Layout>
