---
// Página 404 del portal. Gracias a quitar el catch-all SPA de netlify.toml,
// Netlify sirve dist/404.html para rutas realmente inexistentes (las rutas
// cliente por slug conservan sus rewrites explícitos).
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/lib/ui/design';
---

<Layout
  title="404 - RaidDominion"
  description="La página que buscas no existe en el portal de RaidDominion."
  particles="frost"
>
  <Navigation />
  <main class="relative py-24">
    <div class="max-w-xl mx-auto text-center">
      <p class={`${ui.eyebrow} flex items-center justify-center`}>
        <Icon name="brujula-alt" size="xs" class="mr-1.5" />
        <span>Zona inexplorada</span>
      </p>
      <h1 class={`${ui.titleFicha} ${ui.gradientTitle} mt-3`}>404</h1>
      <p class={`${ui.text.bodyMuted} mt-4 italic`}>
        El pergamino que buscas se perdió en la ventisca: esta ruta no existe,
        es privada o cambió de enlace.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a href="/" class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.md}`}>Volver al portal</a>
        <a href="/hermandades" class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.md}`}>Ver directorio</a>
      </div>
      <div class={`${ui.dividerFadeBoth} mt-12`} aria-hidden="true"></div>
    </div>
  </main>
</Layout>
