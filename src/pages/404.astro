---
// Página 404 del portal. Gracias a quitar el catch-all SPA de netlify.toml,
// Netlify sirve dist/404.html para rutas realmente inexistentes (las rutas
// cliente por slug conservan sus rewrites explícitos).
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import HeaderCover from '@/components/ui/HeaderCover.astro';
import { ui } from '@/lib/ui/design';
import { PAGE_META } from '@/lib/seo';

const meta = PAGE_META['/404'];
---

<Layout
  title={meta.title}
  description={meta.description}
  noindex={meta.noindex}
  omitCanonical
  particles="frost"
>
  <Navigation />
  <main class="relative py-24">
    <div class="max-w-xl mx-auto text-center">
      <header class={`relative px-6 py-8 ${ui.plaque} ${ui.tone.parchment} ${ui.toneHead}`}>
        <span class={`${ui.cardTop} ${ui.toneTop} z-20`} aria-hidden="true"></span>
        <HeaderCover image="/images/headers/404.webp" extraClass="-mx-6 -mt-8" />
        <h1 class={`${ui.titleFicha} ${ui.gradientTitle} ${ui.toneTitle} mt-3`}>404</h1>
        <p class={`${ui.text.bodyMuted} mt-4`}>
          El pergamino que buscas se perdió en la ventisca: esta ruta no existe,
          es privada o cambió de enlace.
        </p>
      </header>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a href="/" class={`${ui.btnBase} ${ui.btnPrimary} ${ui.btnSizes.md}`}>Volver al portal</a>
        <a href="/hermandades" class={`${ui.btnBase} ${ui.btnSecondary} ${ui.btnSizes.md}`}>Ver directorio</a>
      </div>
    </div>
  </main>
</Layout>
