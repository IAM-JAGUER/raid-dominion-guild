---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import GrandLogo from '@/sections/GrandLogo.astro';
import CallToAction from '@/sections/CallToAction.astro';
import YoutubeBanner from '@/sections/YoutubeBanner.astro';
import AboutAddon from '@/sections/AboutAddon.astro';
import Donations from '@/sections/Donations.astro';
import AboutCommunity from '@/sections/AboutCommunity.astro';
import Footer from '@/sections/Footer.astro';
import RaidSection from '@/components/raids/RaidSection.astro';
---

<Layout title="Comunidad Colmillo de Acero - Hermandad World of Warcraft">
	<Navigation />
	<main class="relative">
		<!-- Contenido principal -->
		<div class="relative">
			<!-- Sección Inicio -->
			<section id="inicio" class="scroll-mt-16">
				<GrandLogo></GrandLogo>
			</section>

			<!-- Sección Raids -->
			<section id="raids" class="scroll-mt-16 py-12">
				<div class="max-w-7xl mx-auto">
					<RaidSection />
				</div>
			</section>

			<!-- Sección Comunidad -->
			<section id="comunidad" class="scroll-mt-16 py-12">
				<AboutCommunity></AboutCommunity>
			</section>

			<!-- Sección Guías -->
			<section id="guias" class="scroll-mt-16 py-12">
				<div class="max-w-7xl mx-auto">
					<AboutAddon></AboutAddon>
				</div>
			</section>

			<!-- Sección Media -->
			<section id="media" class="scroll-mt-16 py-12">
				<YoutubeBanner></YoutubeBanner>
			</section>

			<!-- Sección Donaciones -->
			<section id="donaciones" class="scroll-mt-16 py-12">
				<div class="max-w-7xl mx-auto">
					<Donations></Donations>
				</div>
			</section>
		</div>
	</main>
	<Footer></Footer>

	<script>
		// Mostrar el humo después de que cargue la página
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(() => {
				const smokeContainer = document.getElementById('smoke-container');
				if (smokeContainer) {
					smokeContainer.classList.remove('opacity-0');
				}
			}, 500);
		});
	</script>

	<style is:global>
		@keyframes fadeIn {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		.animate-fade-in-1 {
			opacity: 0;
			animation: fadeIn 1s ease-out 0.5s forwards;
		}

		.animate-fade-in-2 {
			opacity: 0;
			animation: fadeIn 1s ease-out 1.5s forwards;
		}

		/* Asegurar que el contenedor del humo esté correctamente posicionado */
		#smoke-container {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 300px;
			z-index: -10;
		}
	</style>
</Layout>