---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import GrandLogo from '@/sections/GrandLogo.astro';
import Donations from '@/sections/Donations.astro';
import AddonSection from '@/sections/AddonSection.astro';
---

<Layout title="RaidDominion - Addon World of Warcraft 3.3.5a">
	<Navigation />
	<main class="relative">
		<div class="max-w-6xl mx-auto">
			<!-- Contenido principal -->
			<div class="relative">
				<!-- Sección Inicio -->
				<section id="inicio" class="scroll-mt-16">
					<GrandLogo></GrandLogo>
				</section>

				<!-- Sección Addon -->
				<AddonSection />

				<!-- Sección Donaciones -->
				<section id="donaciones" class="scroll-mt-16">
					<Donations></Donations>
				</section>
			</div>
		</div>
	</main>

	<script>
		// Mostrar el humo después de que cargue la página
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(() => {
				const smokeContainer = document.getElementById('smoke-container');
				if (smokeContainer) {
					smokeContainer.classList.remove('opacity-0');
				}
			}, 500);
		});
	</script>

	<style is:global>
		@keyframes fadeIn {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		.animate-fade-in-1 {
			opacity: 0;
			animation: fadeIn 1s ease-out 0.5s forwards;
		}

		.animate-fade-in-2 {
			opacity: 0;
			animation: fadeIn 1s ease-out 1.5s forwards;
		}

		/* Asegurar que el contenedor del humo esté correctamente posicionado */
		#smoke-container {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 300px;
			z-index: -10;
		}
	</style>
</Layout>