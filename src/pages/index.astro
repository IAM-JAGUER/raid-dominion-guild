---
import Layout from '@/layouts/Layout.astro';
import PortalEffect from '@/components/PortalEffect.astro';

import GrandLogo from '@/sections/GrandLogo.astro';
import CallToAction from '@/sections/CallToAction.astro';
import YoutubeBanner from '@/sections/YoutubeBanner.astro';
import AboutAddon from '@/sections/AboutAddon.astro';
import Donations from '@/sections/Donations.astro';
import AboutCommunity from '@/sections/AboutCommunity.astro';
import Footer from '@/sections/Footer.astro';
---

<Layout title="Comunidad Colmillo de Acero - Addon World of Warcraft">
	<main class="relative">
		<!-- Efecto de humo (oculto inicialmente) -->
		<div id="smoke-container" class="opacity-0 transition-opacity duration-1000 absolute bottom-0 w-full h-64 -z-20 overflow-hidden">
			<PortalEffect />
		</div>

		<!-- Contenido principal -->
		<div class="relative z-10">
			<GrandLogo></GrandLogo>
			<CallToAction class="opacity-0 animate-fade-in-2"></CallToAction>
			<AboutCommunity></AboutCommunity>
			<AboutAddon></AboutAddon>
			<YoutubeBanner></YoutubeBanner>
			<Donations></Donations>
		</div>
	</main>
	<Footer></Footer>

	<script>
		// Mostrar el humo después de que cargue la página
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(() => {
				const smokeContainer = document.getElementById('smoke-container');
				if (smokeContainer) {
					smokeContainer.classList.remove('opacity-0');
				}
			}, 500);
		});
	</script>

	<style is:global>
		@keyframes fadeIn {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		.animate-fade-in-1 {
			opacity: 0;
			animation: fadeIn 1s ease-out 0.5s forwards;
		}

		.animate-fade-in-2 {
			opacity: 0;
			animation: fadeIn 1s ease-out 1.5s forwards;
		}

		/* Asegurar que el contenedor del humo esté correctamente posicionado */
		#smoke-container {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 300px;
			z-index: -10;
		}
	</style>
</Layout>