---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import GrandLogo from '@/sections/GrandLogo.astro';
import Donations from '@/sections/Donations.astro';
import AddonSection from '@/sections/AddonSection.astro';
import { ui } from '@/lib/ui/design';
---

<Layout
	title="RaidDominion - Addon World of Warcraft 3.3.5a"
	description="Addon gratuito para WoW 3.3.5a: organiza bandas, roles y buffs. Sube tu SavedVariables y publica el portal de tu hermandad."
	particles="snow"
>
	<Navigation />
	<main class="relative">
		<div class={ui.container}>
			<!-- Contenido principal -->
			<div class="relative">
				<!-- Sección Inicio (encabezado de la página) -->
				<section id="inicio" class="scroll-mt-16">
					<GrandLogo></GrandLogo>
				</section>

				<!-- Esqueleto de página (modelo dashboard): separador central +
				     separador izquierdo (la landing no tiene barra de tabs). -->
				<div class={`${ui.dividerFadeBoth} my-8`} aria-hidden="true"></div>
				<div class={`${ui.dividerFadeRight} my-8`} aria-hidden="true"></div>

				<!-- Sección Addon -->
				<AddonSection />

				<div class={`${ui.dividerFadeBoth} my-8`} aria-hidden="true"></div>

				<!-- Sección Donaciones -->
				<section id="donaciones" class="scroll-mt-16">
					<Donations></Donations>
				</section>

				<!-- Separador derecho: cierra el contenido principal. -->
				<div class={`${ui.dividerFadeLeft} my-8`} aria-hidden="true"></div>
			</div>
		</div>
	</main>
</Layout>