---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import GrandLogo from '@/sections/GrandLogo.astro';
import AddonShowcase from '@/sections/AddonShowcase.astro';
import AddonOverview from '@/sections/AddonOverview.astro';
import Donations from '@/sections/Donations.astro';
import AddonSection from '@/sections/AddonSection.astro';
import Faq from '@/sections/Faq.astro';
import { ui } from '@/lib/ui/design';
import { PAGE_META, faqSchema, organizationSchema, softwareApplicationSchema, websiteSchema } from '@/lib/seo';
import { HOME_FAQ } from '@/data/faq';
import { ADDON_FEATURES } from '@/utils/constants';

const meta = PAGE_META['/'];
const jsonLd = [
  organizationSchema(),
  websiteSchema(),
  softwareApplicationSchema(ADDON_FEATURES.map((feature) => feature.title)),
  faqSchema(HOME_FAQ),
];
---

<Layout
	title={meta.title}
	description={meta.description}
	jsonLd={jsonLd}
	particles="snow"
>
	<Navigation />
	<main class="relative">
		<div class={ui.container}>
			<!-- Contenido principal -->
			<div class="relative">
				<!-- Sección Inicio (encabezado de la página) -->
				<section id="inicio" class="scroll-mt-16">
					<GrandLogo></GrandLogo>
				</section>

				<!-- Prueba visual: capturas reales del addon -->
				<AddonShowcase />

				<!-- Presentación editorial: qué es, funciones, audiencias y pasos -->
				<AddonOverview />

				<!-- Sección Addon -->
				<AddonSection />

				<!-- Sección Donaciones -->
				<section id="donaciones" class="scroll-mt-16">
					<Donations></Donations>
				</section>

				<!-- FAQ + glosario (contenido AEO; mismo texto que el FAQPage) -->
				<Faq />
			</div>
		</div>
	</main>
</Layout>
