---
// Shell genérico de DETALLE público (destino de los rewrites de Netlify).
// En producción, /servidor/*, /personaje/* y /banda/* se sirven aquí
// (netlify.toml); en dev el middleware de astro.config.mjs hace lo mismo.
// El shell decide la vista según el PRIMER segmento de la ruta; cada vista
// (src/components/views/*) se auto-activa si el segmento coincide y resuelve
// los datos reales del SV contra src/lib/api.ts.
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ServerView from '@/components/views/ServerView.astro';
import RealmView from '@/components/views/RealmView.astro';
import CharacterView from '@/components/views/CharacterView.astro';
import BandView from '@/components/views/BandView.astro';
import DirView from '@/components/views/DirView.astro';
---

<Layout title="Detalle - RaidDominion">
  <Navigation />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto px-4">
      <Breadcrumb />

      <!-- Cargando -->
      <div id="loading" class="text-center py-20">
        <div class="inline-block w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-sm text-gray-400 italic mt-4">Cargando…</p>
      </div>

      <!-- No encontrado -->
      <div id="not-found" class="hidden bg-gray-900/60 border border-red-900/40 rounded-lg p-10 text-center">
        <svg class="w-10 h-10 text-red-400/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <h1 class="text-xl font-bold text-white mb-2">No encontrado</h1>
        <p id="not-found-msg" class="text-sm text-gray-400 max-w-md mx-auto mb-6">El contenido que buscas no existe, es privado o cambió su enlace.</p>
        <a href="/guilds" class="inline-block px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105">Ver directorio</a>
      </div>

      <!-- Vistas (cada una se auto-activa según el primer segmento) -->
      <ServerView />
      <RealmView />
      <CharacterView />
      <BandView />
      <DirView />

    </div>
  </main>
</Layout>

<script>
  import { currentSection, showNotFound, showView } from '@/lib/routes';

  // Vista por defecto para rutas sin sección resuelta.
  const handled = new Set(['servidor', 'personaje', 'banda']);
  const section = currentSection();
  if (!section) {
    // Ruta raíz del shell sin segmentos → directorio de referencia.
    showView('view-directorio');
  } else if (!handled.has(section)) {
    // Segmento no resuelto por ninguna vista.
    showNotFound('La dirección no coincide con ninguna sección pública del portal.');
  }
  // Si la sección sí está manejada, la vista correspondiente la resuelve.
</script>
