---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
---

<Layout title="Administración - RaidDominion" description="Panel de administración de usuarios del portal RaidDominion.">
  <Navigation currentPath="/admin" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto px-4">

      <!-- Cargando -->
      <div id="loading" class="text-center py-20">
        <div class="inline-block w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-sm text-gray-400 italic mt-4">Verificando permisos…</p>
      </div>

      <!-- Sin autorización -->
      <div id="denied" class="hidden bg-gray-900/60 border border-red-900/40 rounded-lg p-10 text-center">
        <svg class="w-10 h-10 text-red-400/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <h1 class="text-xl font-bold text-white mb-2">Acceso restringido</h1>
        <p class="text-sm text-gray-400 max-w-md mx-auto mb-6">Esta área es exclusiva para administradores.</p>
        <a href="/" class="inline-block px-6 py-2.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-xs font-black uppercase tracking-widest transition-all duration-300 transform hover:scale-105">Volver al inicio</a>
      </div>

      <!-- Panel -->
      <div id="panel" class="hidden space-y-8">
        <header class="animate-fade-in-1">
          <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase">Administración</h1>
          <p class="text-sm text-gray-400 italic mt-2">Gestión de usuarios y roles. El primer admin se siembra manualmente en la base de datos.</p>
        </header>

        <!-- Métricas por rol -->
        <section id="role-stats" class="grid grid-cols-2 md:grid-cols-4 gap-4 animate-fade-in-1" style="animation-delay: 0.05s"></section>

        <!-- Búsqueda -->
        <div class="relative animate-fade-in-1" style="animation-delay: 0.1s">
          <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="search" id="search" placeholder="Buscar por correo, nombre o personaje…"
            class="w-full pl-9 pr-4 py-2.5 rounded-lg bg-gray-900/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600" />
        </div>

        <!-- Usuarios -->
        <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-lg p-6 animate-fade-in-1" style="animation-delay: 0.15s">
          <p id="users-status" class="text-sm text-gray-400 italic mb-3" aria-live="polite">Cargando usuarios…</p>
          <ul id="users-list" class="space-y-3"></ul>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { getMyProfile, adminListUsers, adminSetRole, type AdminUserRow } from '@/lib/api';
  import { ROLES } from '@/lib/roles';
  import type { RaiddominionRole } from '@/types/database';

  const ROLE_LABELS: Record<RaiddominionRole, string> = {
    member: 'Miembro',
    guild_master: 'Maestro',
    moderator: 'Moderador',
    admin: 'Admin',
  };
  const ROLE_BADGE: Record<RaiddominionRole, string> = {
    member: 'bg-gray-800/70 border-gray-600 text-gray-300',
    guild_master: 'bg-amber-900/40 border-amber-500/60 text-amber-200',
    moderator: 'bg-sky-900/30 border-sky-600/50 text-sky-200',
    admin: 'bg-red-900/30 border-red-600/50 text-red-200',
  };

  let users: AdminUserRow[] = [];
  const searchEl = document.getElementById('search') as HTMLInputElement;
  searchEl.addEventListener('input', render);

  const res = await getMyProfile();
  const loading = document.getElementById('loading') as HTMLElement;
  loading.classList.add('hidden');

  if (!res.ok || !res.profile || res.profile.role !== 'admin') {
    if (res.ok && !res.profile) {
      window.location.replace('/login?next=%2Fadmin');
    } else {
      document.getElementById('denied')?.classList.remove('hidden');
    }
  } else {
    document.getElementById('panel')?.classList.remove('hidden');
    await loadUsers();
  }

  async function loadUsers(): Promise<void> {
    const statusEl = document.getElementById('users-status') as HTMLElement;
    const r = await adminListUsers();
    if (!r.ok) {
      statusEl.textContent = r.error || 'No se pudo cargar el listado.';
      return;
    }
    users = r.users ?? [];
    statusEl.textContent = `${users.length} usuario${users.length === 1 ? '' : 's'} registrado${users.length === 1 ? '' : 's'}.`;
    renderStats();
    render();
  }

  function renderStats(): void {
    const wrap = document.getElementById('role-stats') as HTMLElement;
    wrap.innerHTML = '';
    ROLES.forEach((role) => {
      const count = users.filter((u) => u.role === role).length;
      const card = document.createElement('div');
      card.className = `bg-gray-900/60 backdrop-blur-sm border rounded-lg p-4 ${ROLE_BADGE[role]}`;
      const num = document.createElement('p');
      num.className = 'text-3xl font-black';
      num.textContent = String(count);
      const label = document.createElement('p');
      label.className = 'text-[10px] font-black uppercase tracking-widest opacity-80 mt-1';
      label.textContent = ROLE_LABELS[role];
      card.append(num, label);
      wrap.appendChild(card);
    });
  }

  function render(): void {
    const listEl = document.getElementById('users-list') as HTMLElement;
    listEl.innerHTML = '';
    const q = searchEl.value.trim().toLowerCase();

    const filtered = users.filter((u) =>
      !q ||
      (u.email ?? '').toLowerCase().includes(q) ||
      (u.display_name ?? '').toLowerCase().includes(q) ||
      (u.character_name ?? '').toLowerCase().includes(q)
    );

    filtered.forEach((u) => listEl.appendChild(userRow(u)));
  }

  function userRow(u: AdminUserRow): HTMLElement {
    const li = document.createElement('li');
    li.className = 'flex flex-wrap items-center justify-between gap-3 bg-gray-800/40 border border-amber-700/30 rounded-lg px-4 py-3';

    const info = document.createElement('div');
    info.className = 'min-w-0';
    const email = document.createElement('p');
    email.className = 'text-sm font-bold text-white truncate';
    email.textContent = u.email ?? u.id;
    const meta = document.createElement('p');
    meta.className = 'text-xs text-gray-500 mt-0.5 truncate';
    const parts = [
      [u.display_name, u.character_name].filter(Boolean).join(' · ') || 'sin nombre',
      u.realm,
      `desde ${new Date(u.created_at).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}`,
    ].filter(Boolean);
    meta.textContent = parts.join(' · ');
    info.append(email, meta);

    const right = document.createElement('div');
    right.className = 'flex items-center gap-2 shrink-0';

    const badge = document.createElement('span');
    badge.className = `px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest border ${ROLE_BADGE[u.role]}`;
    badge.textContent = ROLE_LABELS[u.role];

    const select = document.createElement('select');
    select.className = 'hidden px-3 py-2 rounded-lg bg-gray-900/80 border border-gray-700 focus:border-amber-500 outline-none text-gray-100 text-xs';
    ROLES.forEach((r) => {
      const opt = document.createElement('option');
      opt.value = r;
      opt.textContent = ROLE_LABELS[r];
      opt.selected = r === u.role;
      select.appendChild(opt);
    });

    const editBtn = document.createElement('button');
    editBtn.type = 'button';
    editBtn.className = 'px-4 py-2 rounded-lg border border-amber-600/30 bg-gray-800/80 text-amber-200 hover:bg-amber-900/40 hover:text-white transition-all text-[11px] font-black uppercase tracking-widest';
    editBtn.textContent = 'Cambiar rol';

    let editing = false;
    editBtn.addEventListener('click', async () => {
      if (!editing) {
        editing = true;
        badge.classList.add('hidden');
        select.classList.remove('hidden');
        editBtn.textContent = 'Guardar';
        return;
      }
      const newRole = select.value as RaiddominionRole;
      if (newRole === u.role) {
        exitEdit();
        return;
      }
      editBtn.disabled = true; editBtn.textContent = 'Guardando…';
      const r = await adminSetRole(u.id, newRole);
      editBtn.disabled = false;
      if (r.ok) {
        u.role = newRole;
        badge.textContent = ROLE_LABELS[newRole];
        badge.className = `px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest border ${ROLE_BADGE[newRole]}`;
        renderStats();
        exitEdit();
      } else {
        editBtn.textContent = r.error || 'Error';
        setTimeout(() => { editBtn.textContent = 'Guardar'; }, 2500);
      }
    });

    function exitEdit(): void {
      editing = false;
      select.classList.add('hidden');
      badge.classList.remove('hidden');
      editBtn.textContent = 'Cambiar rol';
    }

    right.append(badge, select, editBtn);
    li.append(info, right);
    return li;
  }
</script>