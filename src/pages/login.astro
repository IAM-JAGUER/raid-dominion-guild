---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
---

<Layout title="Iniciar Sesión - RaidDominion" description="Inicia sesión o crea tu cuenta en el portal comunitario de RaidDominion.">
  <Navigation currentPath="/login" />
  <main class="relative py-16">
    <div class="max-w-md mx-auto px-4">
      <Breadcrumb />
      <!-- Encabezado con logo -->
      <header class="text-center mb-8 animate-fade-in-1">
        <img src="/logo.png" alt="Raid Dominion" class="h-16 mx-auto mb-4 drop-shadow-[0_0_12px_rgba(245,158,11,0.35)]" loading="eager" decoding="async" />
        <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 tracking-wider uppercase">
          <span id="form-title">Iniciar Sesión</span>
        </h1>
        <p class="text-gray-400 mt-2 text-sm italic">Tu espacio en la comunidad de RaidDominion.</p>
        <div class="w-48 h-0.5 bg-gradient-to-r from-amber-900/0 via-amber-500/80 to-amber-900/0 mx-auto my-5"></div>
      </header>

      <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/30 rounded-lg shadow-xl shadow-black/30 overflow-hidden animate-fade-in-1" style="animation-delay: 0.15s">
        <!-- Alternancia de modo -->
        <div class="grid grid-cols-2 border-b border-amber-600/20" role="tablist" aria-label="Modo de acceso">
          <button id="tab-signin" type="button" role="tab" aria-selected="true"
            class="px-4 py-3 text-xs font-black uppercase tracking-widest transition-all duration-300 border-b-2 border-amber-400 text-amber-200 bg-amber-900/20">
            Ingresar
          </button>
          <button id="tab-signup" type="button" role="tab" aria-selected="false"
            class="px-4 py-3 text-xs font-black uppercase tracking-widest transition-all duration-300 border-b-2 border-transparent text-gray-500 hover:text-gray-300">
            Crear cuenta
          </button>
        </div>

        <form id="auth-form" class="p-6 space-y-4" novalidate>
          <!-- Correo -->
          <div>
            <label for="email" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Correo electrónico</label>
            <div class="relative">
              <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="tucorreo@ejemplo.com"
                class="w-full pl-10 pr-3 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600 transition-colors" />
            </div>
          </div>

          <!-- Contraseña -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Contraseña</label>
              <button type="button" id="forgot-link" class="hidden text-[11px] text-amber-400/90 hover:text-amber-300 underline underline-offset-2 transition-colors">¿Olvidaste tu contraseña?</button>
            </div>
            <div class="relative">
              <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••"
                class="w-full pl-10 pr-11 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600 transition-colors" />
              <button type="button" id="toggle-pass" aria-label="Mostrar u ocultar contraseña" aria-pressed="false"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 p-1 text-gray-500 hover:text-amber-300 transition-colors">
                <svg id="eye-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eye-closed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>

            <!-- Checklist de contraseña (solo registro) -->
            <ul id="pass-checklist" class="hidden mt-2 space-y-1">
              <li data-rule="len" class="flex items-center gap-1.5 text-[11px] text-gray-500"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-600"></span>Mínimo 8 caracteres</li>
              <li data-rule="letter" class="flex items-center gap-1.5 text-[11px] text-gray-500"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-600"></span>Al menos una letra</li>
              <li data-rule="num" class="flex items-center gap-1.5 text-[11px] text-gray-500"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-600"></span>Al menos un número</li>
            </ul>
          </div>

          <!-- Confirmar contraseña (solo registro) -->
          <div id="confirm-wrap" class="hidden">
            <label for="confirm-password" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Confirmar contraseña</label>
            <input type="password" id="confirm-password" autocomplete="new-password" placeholder="••••••••"
              class="w-full px-3 py-2.5 rounded-lg bg-gray-800/70 border border-gray-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/50 outline-none text-gray-100 text-sm placeholder:text-gray-600 transition-colors" />
          </div>

          <!-- Formulario de recuperación -->
          <div id="reset-box" class="hidden border border-amber-600/30 bg-amber-900/10 rounded-lg p-4 space-y-3">
            <p class="text-xs text-gray-300">Te enviaremos un enlace para restablecer tu contraseña.</p>
            <button type="button" id="reset-send"
              class="w-full px-4 py-2.5 rounded-lg border border-amber-500/50 bg-gray-900/60 text-amber-200 hover:bg-amber-900/40 hover:text-white text-xs font-black uppercase tracking-widest transition-all duration-300">
              Enviar enlace de recuperación
            </button>
          </div>

          <button type="submit" id="submit-btn"
            class="w-full px-4 py-3 rounded-lg bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white text-sm font-bold uppercase tracking-widest transition-all duration-300 transform hover:scale-[1.02] hover:shadow-lg hover:shadow-amber-500/20 disabled:opacity-50 disabled:pointer-events-none">
            <span id="submit-label">Entrar</span>
          </button>
        </form>

        <p id="auth-error" class="hidden mx-6 mb-4 text-sm text-red-300 bg-red-950/40 border border-red-600/40 rounded-lg px-4 py-2.5" role="alert"></p>
        <p id="auth-ok" class="hidden mx-6 mb-4 text-sm text-emerald-300 bg-emerald-950/30 border border-emerald-600/40 rounded-lg px-4 py-2.5" role="status"></p>
      </section>

      <p class="text-center text-xs text-gray-500 mt-6">
        Al crear cuenta aceptas ser parte de la comunidad RaidDominion.<br />
        <a href="/" class="hover:text-amber-300 transition-colors">← Volver al portal</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '@/lib/supabase';

  const tabSignin = document.getElementById('tab-signin') as HTMLButtonElement;
  const tabSignup = document.getElementById('tab-signup') as HTMLButtonElement;
  const formTitle = document.getElementById('form-title') as HTMLElement;
  const submitLabel = document.getElementById('submit-label') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const confirmWrap = document.getElementById('confirm-wrap') as HTMLElement;
  const confirmPassword = document.getElementById('confirm-password') as HTMLInputElement;
  const passChecklist = document.getElementById('pass-checklist') as HTMLElement;
  const forgotLink = document.getElementById('forgot-link') as HTMLButtonElement;
  const resetBox = document.getElementById('reset-box') as HTMLElement;
  const resetSend = document.getElementById('reset-send') as HTMLButtonElement;
  const togglePassBtn = document.getElementById('toggle-pass') as HTMLButtonElement;
  const eyeOpen = document.getElementById('eye-open') as SVGElement;
  const eyeClosed = document.getElementById('eye-closed') as SVGElement;
  const form = document.getElementById('auth-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const errorBox = document.getElementById('auth-error') as HTMLElement;
  const okBox = document.getElementById('auth-ok') as HTMLElement;

  let mode: 'signin' | 'signup' | 'reset' = 'signin';

  // Destino tras autenticar (?next=%2Fruta); solo rutas internas seguras
  function nextPath(): string {
    const raw = new URLSearchParams(window.location.search).get('next');
    if (!raw || !raw.startsWith('/') || raw.startsWith('//')) return '/dashboard';
    return raw;
  }

  function setMode(next: 'signin' | 'signup'): void {
    if (mode === 'reset') resetBox.classList.add('hidden');
    mode = next;

    tabSignin.setAttribute('aria-selected', String(mode === 'signin'));
    tabSignup.setAttribute('aria-selected', String(mode === 'signup'));
    const on = ['border-amber-400', 'text-amber-200', 'bg-amber-900/20'];
    const off = ['border-transparent', 'text-gray-500'];
    if (mode === 'signin') {
      tabSignin.classList.add(...on); tabSignin.classList.remove(...off);
      tabSignup.classList.remove(...on); tabSignup.classList.add(...off);
      formTitle.textContent = 'Iniciar Sesión';
      submitLabel.textContent = 'Entrar';
      passwordInput.setAttribute('autocomplete', 'current-password');
      confirmWrap.classList.add('hidden');
      passChecklist.classList.add('hidden');
      forgotLink.classList.remove('hidden');
    } else {
      tabSignup.classList.add(...on); tabSignup.classList.remove(...off);
      tabSignin.classList.remove(...on); tabSignin.classList.add(...off);
      formTitle.textContent = 'Crear Cuenta';
      submitLabel.textContent = 'Crear mi cuenta';
      passwordInput.setAttribute('autocomplete', 'new-password');
      confirmWrap.classList.remove('hidden');
      passChecklist.classList.remove('hidden');
      forgotLink.classList.add('hidden');
    }
    errorBox.classList.add('hidden');
    okBox.classList.add('hidden');
  }

  function showError(msg: string): void { errorBox.textContent = msg; errorBox.classList.remove('hidden'); okBox.classList.add('hidden'); }
  function showOk(msg: string): void { okBox.textContent = msg; okBox.classList.remove('hidden'); errorBox.classList.add('hidden'); }

  // Mensajes sin detalles internos ni enumeración de usuarios
  function friendlyError(err: string): string {
    if (err.includes('Invalid login credentials')) return 'Correo o contraseña incorrectos.';
    if (err.includes('already registered')) return 'Ese correo ya tiene cuenta; inicia sesión.';
    if (err.includes('Email not confirmed')) return 'Confirma tu correo con el enlace que te enviamos e inténtalo de nuevo.';
    if (err.includes('rate limit')) return 'Demasiados intentos; espera un momento e inténtalo de nuevo.';
    return 'No se pudo completar la operación. Verifica tus datos e inténtalo de nuevo.';
  }

  // ── Visibilidad de contraseña ───────────────────────────────────────────
  togglePassBtn.addEventListener('click', () => {
    const show = passwordInput.type === 'password';
    passwordInput.type = show ? 'text' : 'password';
    togglePassBtn.setAttribute('aria-pressed', String(show));
    eyeOpen.classList.toggle('hidden', show);
    eyeClosed.classList.toggle('hidden', !show);
  });

  // ── Checklist de política de contraseñas ───────────────────────────────
  function passRules(p: string): { len: boolean; letter: boolean; num: boolean } {
    return { len: p.length >= 8, letter: /[a-zA-Záéíóúüñ]/.test(p), num: /\d/.test(p) };
  }
  passwordInput.addEventListener('input', () => {
    if (mode !== 'signup') return;
    const rules = passRules(passwordInput.value);
    passChecklist.querySelectorAll('li').forEach((li) => {
      const key = (li as HTMLElement).dataset.rule as keyof typeof rules;
      const dot = li.querySelector('.rule-dot') as HTMLElement;
      const ok = rules[key];
      li.classList.toggle('text-emerald-400', ok);
      li.classList.toggle('text-gray-500', !ok);
      dot.classList.toggle('bg-emerald-400', ok);
      dot.classList.toggle('bg-gray-600', !ok);
    });
  });

  // ── Bloqueo temporal tras intentos fallidos (disuasivo cliente) ────────
  const MAX_ATTEMPTS = 5;
  const LOCK_SECONDS = 60;
  function lockState(): { count: number; until: number } {
    try {
      return JSON.parse(sessionStorage.getItem('rd_auth_lock') || '') as { count: number; until: number };
    } catch {
      return { count: 0, until: 0 };
    }
  }
  function setLockState(state: { count: number; until: number }): void {
    sessionStorage.setItem('rd_auth_lock', JSON.stringify(state));
  }
  async function guardLock(): Promise<boolean> {
    const st = lockState();
    const wait = Math.ceil((st.until - Date.now()) / 1000);
    if (wait > 0) {
      showError(`Demasiados intentos fallidos. Espera ${wait}s para volver a intentar.`);
      return false;
    }
    return true;
  }
  function registerFail(): void {
    const st = lockState();
    const count = st.count + 1;
    setLockState({ count, until: count >= MAX_ATTEMPTS ? Date.now() + LOCK_SECONDS * 1000 : 0 });
  }

  // ── Recuperación de contraseña (respuesta genérica, sin enumeración) ───
  forgotLink.addEventListener('click', () => {
    mode = 'reset';
    resetBox.classList.remove('hidden');
    submitBtn.closest('form')?.classList.add('space-y-4');
    submitLabel.parentElement?.classList.add('hidden');
    okBox.classList.add('hidden');
    errorBox.classList.add('hidden');
    resetSend.focus();
  });
  tabSignin.addEventListener('click', () => { submitLabel.parentElement?.classList.remove('hidden'); setMode('signin'); });
  tabSignup.addEventListener('click', () => { submitLabel.parentElement?.classList.remove('hidden'); setMode('signup'); });

  resetSend.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    if (!email) { showError('Escribe tu correo arriba para enviarte el enlace.'); return; }
    resetSend.disabled = true;
    resetSend.textContent = 'Enviando…';
    await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/login?next=${encodeURIComponent(nextPath())}`,
    });
    // Respuesta genérica siempre: no revela si el correo existe ni depende de SMTP activo
    showOk('Si el correo está registrado, recibirás un enlace en unos minutos.');
    resetSend.disabled = false;
    resetSend.textContent = 'Enviar enlace de recuperación';
  });

  // ── Sesión previa → destino directo ────────────────────────────────────
  supabase.auth.getSession().then(({ data }) => {
    if (data.session?.user) window.location.replace(nextPath());
  });

  // ── Envío principal ────────────────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (mode === 'reset') return;
    errorBox.classList.add('hidden');

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!(await guardLock())) return;
    if (!email || !password) { showError('Completa correo y contraseña.'); return; }

    if (mode === 'signup') {
      const rules = passRules(password);
      if (!rules.len || !rules.letter || !rules.num) { showError('La contraseña no cumple los requisitos marcados.'); return; }
      if (password !== confirmPassword.value) { showError('Las contraseñas no coinciden.'); return; }
    }

    submitBtn.disabled = true;
    submitLabel.textContent = mode === 'signin' ? 'Entrando…' : 'Creando…';

    try {
      if (mode === 'signin') {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) {
          registerFail();
          showError(friendlyError(error.message));
          return;
        }
        setLockState({ count: 0, until: 0 });
        window.location.assign(nextPath());
      } else {
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: { emailRedirectTo: `${window.location.origin}/login?next=${encodeURIComponent(nextPath())}` },
        });
        if (error) { registerFail(); showError(friendlyError(error.message)); return; }

        if (data.session) {
          window.location.assign(nextPath());
          return;
        }
        // Sin sesión: el proyecto puede exigir confirmación de correo
        const retry = await supabase.auth.signInWithPassword({ email, password });
        if (retry.data.session) { window.location.assign(nextPath()); return; }
        showOk('Cuenta creada. Si no entraste directo, confirma tu correo con el enlace que te enviamos.');
        setMode('signin');
      }
    } catch {
      showError('Error de red; verifica tu conexión e inténtalo de nuevo.');
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = mode === 'signin' ? 'Entrar' : 'Crear mi cuenta';
    }
  });
</script>