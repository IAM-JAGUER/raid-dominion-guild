---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Icon from '@/components/ui/Icon.astro';
import FichaDock from '@/components/ui/FichaDock.astro';
import { ui } from '@/lib/ui/design';
import { PAGE_META } from '@/lib/seo';

const meta = PAGE_META['/login'];
---

<Layout
  title={meta.title}
  description={meta.description}
  noindex={meta.noindex}
  particles="frost"
>
  <Navigation currentPath="/login" />
  <!-- Captura el tipo de callback ANTES de que supabase-js consuma el hash
       de recuperación (el SDK limpia la URL al inicializarse). -->
  <script is:inline>
    try {
      var authParams = new URLSearchParams(window.location.hash.slice(1));
      if (authParams.get('type') === 'recovery') {
        document.documentElement.dataset.rdAuthRecovery = '1';
      }
    } catch (e) {
      /* sin hash válido */
    }
  </script>
  <main class="relative py-16">
    <div class="max-w-md mx-auto">
      <Breadcrumb />
      <!-- Encabezado con logo (placa: el texto no se disuelve sobre la imagen) -->
      <header class={`relative text-center px-6 py-6 animate-fade-in-1 ${ui.plaque} ${ui.tone.arcane} ${ui.toneHead}`}>
        <span class={`${ui.cardTop} ${ui.toneTop}`} aria-hidden="true"></span>
        <img src="/logo.png" alt="Logo de RaidDominion" width="64" height="64" class="h-16 w-16 mx-auto mb-4 drop-shadow-[0_0_12px_rgba(0,191,255,0.35)]" loading="eager" decoding="async" />
        <h1 class={`${ui.text.hero} ${ui.titleHero} ${ui.toneTitle}`}>
          <span id="form-title">Iniciar Sesión</span>
        </h1>
        <p class={`${ui.text.bodyMuted} mt-2 italic`}>Tu espacio en la comunidad de RaidDominion.</p>
        <FichaDock
          dockId="login-tab-dock"
          barId="login-tab-bar"
          label="Modo de acceso"
          hidden={false}
          bleedCls="-mx-6 -mb-6 px-6"
          barCls="justify-center"
        >
          <button id="tab-signin" type="button" role="tab" aria-selected="true" aria-controls="auth-form" tabindex="0" class="rd-ficha-tab">
            <span class="rd-ficha-tab__icon"><Icon name="portal" size="sm" /></span>
            Ingresar
          </button>
          <button id="tab-signup" type="button" role="tab" aria-selected="false" aria-controls="auth-form" tabindex="-1" class="rd-ficha-tab">
            <span class="rd-ficha-tab__icon"><Icon name="anadir" size="sm" /></span>
            Crear cuenta
          </button>
        </FichaDock>
      </header>
      <div class={`${ui.dividerFadeBoth} mt-6`} aria-hidden="true"></div>
      <div class={`${ui.dividerFadeRight} mt-8 mb-10`} aria-hidden="true"></div>

      <section id="auth-panel" class={`${ui.panel} ${ui.tone.arcane} ${ui.tonePanel} shadow-xl shadow-black/30 overflow-hidden animate-fade-in-1`} style="animation-delay: 0.15s">
        <form id="auth-form" class="p-4 sm:p-6 space-y-4" novalidate>
<!-- Correo -->
          <div>
            <label for="email" class={ui.form.label}>Correo electrónico</label>
            <div class="relative">
              <Icon name="nota" size="sm" class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="tucorreo@ejemplo.com" aria-describedby="auth-error"
                class={`${ui.form.input} ${ui.focusRing} pl-10`} />
            </div>
          </div>

          <!-- Contraseña -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class={ui.form.label}>Contraseña</label>
              <button type="button" id="forgot-link" class={`hidden inline-flex items-center gap-1 text-[11px] text-brand-400/90 hover:text-brand-300 underline underline-offset-2 ${ui.transition} ${ui.focusRing}`}><Icon name="ayuda" size="xs" />¿Olvidaste tu contraseña?</button>
            </div>
            <div class="relative">
              <Icon name="bloqueo-alt" size="sm" class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
              <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" aria-describedby="auth-error"
                class={`${ui.form.input} ${ui.focusRing} pl-10 pr-11`} />
              <button type="button" id="toggle-pass" aria-label="Mostrar u ocultar contraseña" aria-pressed="false"
                class={`absolute right-2.5 top-1/2 -translate-y-1/2 p-1 text-gray-300 hover:text-brand-200 ${ui.transition} ${ui.focusRing}`}>
                <Icon id="eye-open" name="visibilidad" size="md" />
                <Icon id="eye-closed" name="bloqueo" size="md" class="hidden" />
              </button>
            </div>

            <!-- Checklist de contraseña (solo registro) -->
            <ul id="pass-checklist" class="hidden mt-2 space-y-1">
              <li data-rule="len" class="flex items-center gap-1.5 text-[11px] text-gray-300"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-500"></span>Mínimo 8 caracteres</li>
              <li data-rule="letter" class="flex items-center gap-1.5 text-[11px] text-gray-300"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-500"></span>Al menos una letra</li>
              <li data-rule="num" class="flex items-center gap-1.5 text-[11px] text-gray-300"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-500"></span>Al menos un número</li>
            </ul>
          </div>

          <!-- Confirmar contraseña (solo registro) -->
          <div id="confirm-wrap" class="hidden">
            <label for="confirm-password" class={ui.form.label}>Confirmar contraseña</label>
            <input type="password" id="confirm-password" autocomplete="new-password" placeholder="••••••••"
              class={`${ui.form.input} ${ui.focusRing}`} />
          </div>

          <!-- Formulario de recuperación -->
          <div id="reset-box" class="hidden border border-brand-600/30 bg-brand-900/10 rounded-md p-4 space-y-3">
            <p class={ui.text.caption}>Te enviaremos un enlace para restablecer tu contraseña.</p>
            <button type="button" id="reset-send"
              class={`${ui.btnBase} ${ui.btnSecondary} w-full px-4 py-2.5 text-xs font-black uppercase tracking-widest`}>
              Enviar enlace de recuperación
            </button>
          </div>

          <button type="submit" id="submit-btn"
            class={`${ui.btnBase} ${ui.btnPrimary} w-full px-4 py-3 text-sm font-bold uppercase tracking-widest transform hover:scale-[1.02] disabled:opacity-50 disabled:pointer-events-none`}>
            <span id="submit-spinner" class="hidden" aria-hidden="true"></span>
            <span id="submit-label">Entrar</span>
          </button>
        </form>

        <p id="auth-error" class={`hidden mx-6 mb-4 ${ui.status.error} ${ui.alert}`} role="alert"></p>
        <p id="auth-ok" class={`hidden mx-6 mb-4 ${ui.status.success} ${ui.alert}`} role="status"></p>
      </section>

      <!-- Nueva contraseña (callback de recuperación) -->
      <section id="recovery-panel" class={`hidden ${ui.panel} ${ui.tone.arcane} ${ui.tonePanel} p-4 sm:p-6 shadow-xl shadow-black/30`}>
        <p class={`${ui.text.body} mb-4`}>
          Elige una nueva contraseña para tu cuenta. Después volverás a tu dashboard.
        </p>
        <div class="space-y-4">
          <div>
            <label for="recovery-password" class={ui.form.label}>Nueva contraseña</label>
            <input id="recovery-password" type="password" autocomplete="new-password" required
              class={`${ui.form.input} ${ui.focusRing}`} aria-describedby="recovery-error" />
            <ul class="mt-2 space-y-1">
              <li data-rule="len" class="flex items-center gap-1.5 text-[11px] text-gray-300"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-500"></span>Mínimo 8 caracteres</li>
              <li data-rule="letter" class="flex items-center gap-1.5 text-[11px] text-gray-300"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-500"></span>Al menos una letra</li>
              <li data-rule="num" class="flex items-center gap-1.5 text-[11px] text-gray-300"><span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-500"></span>Al menos un número</li>
            </ul>
          </div>
          <div>
            <label for="recovery-confirm" class={ui.form.label}>Confirmar contraseña</label>
            <input id="recovery-confirm" type="password" autocomplete="new-password" required
              class={`${ui.form.input} ${ui.focusRing}`} />
          </div>
          <button id="recovery-save" type="button"
            class={`${ui.btnBase} ${ui.btnPrimary} w-full px-4 py-3 text-sm font-bold uppercase tracking-widest disabled:opacity-50 disabled:pointer-events-none`}>
            Guardar contraseña
          </button>
          <p id="recovery-error" class={`hidden ${ui.status.error} ${ui.alert}`} role="alert"></p>
          <p id="recovery-ok" class={`hidden ${ui.status.success} ${ui.alert}`} role="status"></p>
        </div>
      </section>

      <p class={`${ui.text.caption} text-center mt-6`}>
        Portal comunitario del addon RaidDominion para WoW 3.3.5a.<br />
        <a href="/" class={`hover:text-brand-300 ${ui.transition}`}>← Volver al portal</a>
      </p>
      <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '@/lib/supabase';
  import { ui } from '@/lib/ui/design';
  import { userError } from '@/lib/ui/userError';

  const tabSignin = document.getElementById('tab-signin') as HTMLButtonElement;
  const tabSignup = document.getElementById('tab-signup') as HTMLButtonElement;
  const formTitle = document.getElementById('form-title') as HTMLElement;
  const submitLabel = document.getElementById('submit-label') as HTMLElement;
  const submitSpinner = document.getElementById('submit-spinner') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const confirmWrap = document.getElementById('confirm-wrap') as HTMLElement;
  const confirmPassword = document.getElementById('confirm-password') as HTMLInputElement;
  const passChecklist = document.getElementById('pass-checklist') as HTMLElement;
  const forgotLink = document.getElementById('forgot-link') as HTMLButtonElement;
  const resetBox = document.getElementById('reset-box') as HTMLElement;
  const resetSend = document.getElementById('reset-send') as HTMLButtonElement;
  const togglePassBtn = document.getElementById('toggle-pass') as HTMLButtonElement;
  const eyeOpen = document.getElementById('eye-open') as HTMLElement;
  const eyeClosed = document.getElementById('eye-closed') as HTMLElement;
  const form = document.getElementById('auth-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const errorBox = document.getElementById('auth-error') as HTMLElement;
  const okBox = document.getElementById('auth-ok') as HTMLElement;
  const authPanel = document.getElementById('auth-panel') as HTMLElement;
  const recoveryPanel = document.getElementById('recovery-panel') as HTMLElement;
  const recoveryPassword = document.getElementById('recovery-password') as HTMLInputElement;
  const recoveryConfirm = document.getElementById('recovery-confirm') as HTMLInputElement;
  const recoverySave = document.getElementById('recovery-save') as HTMLButtonElement;
  const recoveryError = document.getElementById('recovery-error') as HTMLElement;
  const recoveryOk = document.getElementById('recovery-ok') as HTMLElement;

  let mode: 'signin' | 'signup' | 'reset' = 'signin';
  const isRecoveryFlow = document.documentElement.dataset.rdAuthRecovery === '1';

  // Destino tras autenticar (?next=%2Fruta); solo rutas internas seguras
  function nextPath(): string {
    const raw = new URLSearchParams(window.location.search).get('next');
    if (!raw || !raw.startsWith('/') || raw.startsWith('//')) return '/dashboard';
    return raw;
  }

  function setMode(next: 'signin' | 'signup'): void {
    if (mode === 'reset') resetBox.classList.add('hidden');
    mode = next;

    tabSignin.setAttribute('aria-selected', String(mode === 'signin'));
    tabSignup.setAttribute('aria-selected', String(mode === 'signup'));
    tabSignin.tabIndex = mode === 'signin' ? 0 : -1;
    tabSignup.tabIndex = mode === 'signup' ? 0 : -1;
    if (mode === 'signin') {
      formTitle.textContent = 'Iniciar Sesión';
      submitLabel.textContent = 'Entrar';
      passwordInput.setAttribute('autocomplete', 'current-password');
      confirmWrap.classList.add('hidden');
      passChecklist.classList.add('hidden');
      forgotLink.classList.remove('hidden');
    } else {
      formTitle.textContent = 'Crear Cuenta';
      submitLabel.textContent = 'Crear mi cuenta';
      passwordInput.setAttribute('autocomplete', 'new-password');
      confirmWrap.classList.remove('hidden');
      passChecklist.classList.remove('hidden');
      forgotLink.classList.add('hidden');
    }
    errorBox.classList.add('hidden');
    okBox.classList.add('hidden');
  }

  function showError(msg: string): void { errorBox.textContent = msg; errorBox.classList.remove('hidden'); okBox.classList.add('hidden'); }
  function showOk(msg: string): void { okBox.textContent = msg; okBox.classList.remove('hidden'); errorBox.classList.add('hidden'); }

  // ── Visibilidad de contraseña ───────────────────────────────────────────
  togglePassBtn.addEventListener('click', () => {
    const show = passwordInput.type === 'password';
    passwordInput.type = show ? 'text' : 'password';
    togglePassBtn.setAttribute('aria-pressed', String(show));
    eyeOpen.classList.toggle('hidden', show);
    eyeClosed.classList.toggle('hidden', !show);
  });

  // ── Checklist de política de contraseñas ───────────────────────────────
  function passRules(p: string): { len: boolean; letter: boolean; num: boolean } {
    return { len: p.length >= 8, letter: /[a-zA-Záéíóúüñ]/.test(p), num: /\d/.test(p) };
  }
  passwordInput.addEventListener('input', () => {
    if (mode !== 'signup') return;
    const rules = passRules(passwordInput.value);
    passChecklist.querySelectorAll('li').forEach((li) => {
      const key = (li as HTMLElement).dataset.rule as keyof typeof rules;
      const dot = li.querySelector('.rule-dot') as HTMLElement;
      const ok = rules[key];
      li.classList.toggle('text-emerald-400', ok);
      li.classList.toggle('text-gray-300', !ok);
      dot.classList.toggle('bg-emerald-400', ok);
      dot.classList.toggle('bg-gray-500', !ok);
    });
  });

  // ── Bloqueo temporal tras intentos fallidos (disuasivo cliente) ────────
  const MAX_ATTEMPTS = 5;
  const LOCK_SECONDS = 60;
  function lockState(): { count: number; until: number } {
    try {
      return JSON.parse(sessionStorage.getItem('rd_auth_lock') || '') as { count: number; until: number };
    } catch {
      return { count: 0, until: 0 };
    }
  }
  function setLockState(state: { count: number; until: number }): void {
    sessionStorage.setItem('rd_auth_lock', JSON.stringify(state));
  }
  async function guardLock(): Promise<boolean> {
    const st = lockState();
    const wait = Math.ceil((st.until - Date.now()) / 1000);
    if (wait > 0) {
      showError(`Demasiados intentos fallidos. Espera ${wait}s para volver a intentar.`);
      return false;
    }
    return true;
  }
  function registerFail(): void {
    const st = lockState();
    const count = st.count + 1;
    setLockState({ count, until: count >= MAX_ATTEMPTS ? Date.now() + LOCK_SECONDS * 1000 : 0 });
  }

  // ── Recuperación de contraseña (respuesta genérica, sin enumeración) ───
  forgotLink.addEventListener('click', () => {
    mode = 'reset';
    resetBox.classList.remove('hidden');
    submitBtn.closest('form')?.classList.add('space-y-4');
    submitLabel.parentElement?.classList.add('hidden');
    okBox.classList.add('hidden');
    errorBox.classList.add('hidden');
    resetSend.focus();
  });
  tabSignin.addEventListener('click', () => { submitLabel.parentElement?.classList.remove('hidden'); setMode('signin'); });
  tabSignup.addEventListener('click', () => { submitLabel.parentElement?.classList.remove('hidden'); setMode('signup'); });

  // Navegación por teclado del dock de acceso (←/→/Home/End).
  [tabSignin, tabSignup].forEach((tab) => {
    tab.addEventListener('keydown', (e) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
      e.preventDefault();
      const target = e.key === 'ArrowRight' || e.key === 'End' ? tabSignup : tabSignin;
      submitLabel.parentElement?.classList.remove('hidden');
      setMode(target === tabSignin ? 'signin' : 'signup');
      target.focus();
    });
  });

  resetSend.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    if (!email) { showError('Escribe tu correo arriba para enviarte el enlace.'); return; }
    resetSend.disabled = true;
    resetSend.setAttribute('aria-busy', 'true');
    resetSend.textContent = 'Enviando…';
    await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/login?next=${encodeURIComponent(nextPath())}`,
    });
    // Respuesta genérica siempre: no revela si el correo existe ni depende de SMTP activo
    showOk('Si el correo está registrado, recibirás un enlace en unos minutos.');
    resetSend.disabled = false;
    resetSend.removeAttribute('aria-busy');
    resetSend.textContent = 'Enviar enlace de recuperación';
  });

  // ── Recuperación: mostrar el formulario de nueva contraseña ────────────
  function showRecovery(): void {
    authPanel.classList.add('hidden');
    recoveryPanel.classList.remove('hidden');
    formTitle.textContent = 'Nueva contraseña';
    recoveryPassword.focus();
  }

  function showRecoveryError(msg: string): void {
    recoveryError.textContent = msg;
    recoveryError.classList.remove('hidden');
    recoveryOk.classList.add('hidden');
  }

  if (isRecoveryFlow) showRecovery();
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') showRecovery();
  });

  function syncRecoveryRules(): void {
    const rules = passRules(recoveryPassword.value);
    recoveryPanel.querySelectorAll<HTMLElement>('li[data-rule]').forEach((li) => {
      const key = li.dataset.rule as keyof typeof rules;
      const dot = li.querySelector('.rule-dot') as HTMLElement;
      const ok = rules[key];
      li.classList.toggle('text-emerald-400', ok);
      li.classList.toggle('text-gray-300', !ok);
      dot.classList.toggle('bg-emerald-400', ok);
      dot.classList.toggle('bg-gray-500', !ok);
    });
  }
  recoveryPassword.addEventListener('input', syncRecoveryRules);

  recoverySave.addEventListener('click', async () => {
    recoveryError.classList.add('hidden');
    recoveryOk.classList.add('hidden');
    const rules = passRules(recoveryPassword.value);
    if (!rules.len || !rules.letter || !rules.num) {
      showRecoveryError('La contraseña no cumple los requisitos marcados.');
      return;
    }
    if (recoveryPassword.value !== recoveryConfirm.value) {
      showRecoveryError('Las contraseñas no coinciden.');
      return;
    }

    recoverySave.disabled = true;
    recoverySave.setAttribute('aria-busy', 'true');
    recoverySave.textContent = 'Guardando…';
    try {
      const { error } = await supabase.auth.updateUser({ password: recoveryPassword.value });
      if (error) {
        showRecoveryError(userError(error.message, 'No se pudo guardar la contraseña. Solicita un enlace nuevo.'));
        return;
      }
      recoveryOk.textContent = 'Contraseña actualizada. Entrando a tu dashboard…';
      recoveryOk.classList.remove('hidden');
      history.replaceState(null, '', window.location.pathname);
      window.setTimeout(() => window.location.assign(nextPath()), 900);
    } catch {
      showRecoveryError('Error de red; verifica tu conexión e inténtalo de nuevo.');
    } finally {
      recoverySave.disabled = false;
      recoverySave.removeAttribute('aria-busy');
      recoverySave.textContent = 'Guardar contraseña';
    }
  });

  // ── Sesión previa → destino directo (nunca durante recuperación) ───────
  supabase.auth.getSession().then(({ data }) => {
    if (!isRecoveryFlow && data.session?.user) window.location.replace(nextPath());
    if (isRecoveryFlow && !data.session) {
      showRecoveryError('El enlace de recuperación caducó o no es válido. Solicita uno nuevo.');
    }
  });

  // ── Envío principal ────────────────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (mode === 'reset') return;
    errorBox.classList.add('hidden');

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!(await guardLock())) return;
    if (!email || !password) { showError('Completa correo y contraseña.'); return; }

    if (mode === 'signup') {
      const rules = passRules(password);
      if (!rules.len || !rules.letter || !rules.num) { showError('La contraseña no cumple los requisitos marcados.'); return; }
      if (password !== confirmPassword.value) { showError('Las contraseñas no coinciden.'); return; }
    }

    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    submitLabel.textContent = mode === 'signin' ? 'Entrando…' : 'Creando…';
    submitSpinner.className = `${ui.loading.spinner} mr-2`;
    submitSpinner.classList.remove('hidden');

    try {
      if (mode === 'signin') {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) {
          registerFail();
          showError(userError(error.message, 'No se pudo completar la operación. Verifica tus datos e inténtalo de nuevo.'));
          return;
        }
        setLockState({ count: 0, until: 0 });
        window.location.assign(nextPath());
      } else {
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: { emailRedirectTo: `${window.location.origin}/login?next=${encodeURIComponent(nextPath())}` },
        });
        if (error) { registerFail(); showError(userError(error.message, 'No se pudo completar la operación. Verifica tus datos e inténtalo de nuevo.')); return; }

        if (data.session) {
          window.location.assign(nextPath());
          return;
        }
        // Sin sesión: el proyecto puede exigir confirmación de correo
        const retry = await supabase.auth.signInWithPassword({ email, password });
        if (retry.data.session) { window.location.assign(nextPath()); return; }
        showOk('Cuenta creada. Si no entraste directo, confirma tu correo con el enlace que te enviamos.');
        setMode('signin');
      }
    } catch {
      showError('Error de red; verifica tu conexión e inténtalo de nuevo.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.removeAttribute('aria-busy');
      submitLabel.textContent = mode === 'signin' ? 'Entrar' : 'Crear mi cuenta';
      submitSpinner.classList.add('hidden');
    }
  });
</script>